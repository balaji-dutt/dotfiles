#!/bin/sh
":" '''\'
# Probe peer machines over SSH and run audits and tests against a snapshot of this tree.
#
# sh runs this block and never returns; Python reads lines 2-20 as the module
# docstring. Native Windows has no python3 on PATH and ignores shebangs, so the
# interpreter has to come from resolve-python3. Keep the closing quotes directly
# above the __future__ import, and keep single quotes out of this block.
set -eu
entry_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
case $entry_dir in
  */.opencode/bin) resolver=$entry_dir/../../assets/resolve-python3 ;;
  *) resolver=$entry_dir/resolve-python3 ;;
esac
if [ ! -f "$resolver" ]; then
  echo "${0##*/}: missing Python resolver: $resolver" >&2
  exit 127
fi
exec "$resolver" -- "$0" "$@"
'''

