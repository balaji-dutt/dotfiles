def validate_slug(value: str) -> str:
    if not SLUG_RE.match(value) or ".." in value:
        raise Refused(f"invalid slug {value!r}")
    return value


def validate_sha(value: str) -> str:
    if not SHA_RE.match(value):
        raise Refused(f"invalid sha {value!r}")
    return value


def validate_relative_path(value: str) -> str:
    if not value or value.startswith("-") or value.startswith("/") or "\\" in value:
        raise ConfigError(f"invalid repo-relative path {value!r}")
    parts = value.split("/")
    if any(part in ("", ".", "..") for part in parts):
        raise ConfigError(f"invalid repo-relative path {value!r}")
    return value


def kernel_identity(path: str) -> tuple[str, str]:
    def run(flag: str) -> str:
        try:
            return subprocess.run(
                ["uname", flag],
                env={"PATH": path},
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            ).stdout.strip()
        except OSError:
            return ""

    return run("-s"), run("-r")


def serve_path(environ: dict[str, str] | os._Environ[str], home: str) -> str:
    entries = [entry for entry in environ.get("PATH", os.defpath).split(os.pathsep) if entry]
    data_home = environ.get("XDG_DATA_HOME") or f"{home}/.local/share"
    for directory in reversed((*PATH_PREPEND, f"{home}/.local/bin", f"{data_home}/mise/shims")):
        if os.path.isdir(directory) and directory not in entries:
            entries.insert(0, directory)
    return os.pathsep.join(entries)


def wsl_interop_socket() -> str | None:
    for candidate in sorted(glob.glob("/run/WSL/*_interop")):
        try:
            if stat.S_ISSOCK(os.stat(candidate).st_mode):
                return candidate
        except OSError:
            continue
    return None


def scrubbed_environment(environ: dict[str, str] | os._Environ[str], platform: str) -> dict[str, str]:
    home = environ.get("HOME") or str(Path.home())
    env = {
        "PATH": serve_path(environ, home),
        "HOME": home,
        "LANG": "C.UTF-8",
        "TERM": "dumb",
        "PEER_ENV": "1",
    }
    for name in ("USER", "LOGNAME", "SHELL", "TMPDIR"):
        if environ.get(name):
            env[name] = environ[name]
    if platform == "wsl2":
        env["WSL_DISTRO_NAME"] = environ.get("WSL_DISTRO_NAME") or "wsl2"
        interop = environ.get("WSL_INTEROP") or wsl_interop_socket()
        if interop:
            env["WSL_INTEROP"] = interop
    return env


class BusyError(Exception):
    """Another request holds the slug lock; exit 75."""


class Diagnostics:
    def __init__(self, state: Path, slug: str, sha: str, keep: bool) -> None:
        private_directory(state / "runs")
        self.directory = state / "runs" / slug
        self.directory.mkdir(mode=0o700)
        self.remaining = DIAGNOSTIC_LIMIT
        self.manifest = {"run": slug, "sha": sha, "keep": keep, "completed": False,
                         "started": time.time(), "truncated": False}
        self.output = self.open_file("output.log")
        self.save()

    def open_file(self, name: str):
        descriptor = os.open(self.directory / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        return os.fdopen(descriptor, "wb")

    def save(self) -> None:
        temporary = self.directory / "result.tmp"
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(self.manifest, handle, sort_keys=True)
            handle.write("\n")
        os.replace(temporary, self.directory / "result.json")

    def write(self, data: bytes, handle=None) -> None:
        retained = data[:self.remaining]
        (handle or self.output).write(retained)
        self.remaining -= len(retained)
        if len(retained) != len(data):
            self.manifest["truncated"] = True

    def archive(self, worktree: Path, deadline: float) -> None:
        source = worktree / ".cz-audit"
        if not source.exists() or source.is_symlink():
            return
        for index, entry in enumerate(source.iterdir()):
            if time.monotonic() >= deadline:
                raise Refused("diagnostic archival deadline exceeded")
            if index >= 1024:
                self.manifest["truncated"] = True
                break
            if entry.is_symlink() or not entry.is_file():
                continue
            descriptor = os.open(entry, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(descriptor, "rb") as handle:
                if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
                    continue
                with self.open_file("audit-" + entry.name) as destination:
                    while self.remaining:
                        if time.monotonic() >= deadline:
                            raise Refused("diagnostic archival deadline exceeded")
                        data = handle.read(min(65536, self.remaining))
                        if not data:
                            break
                        self.write(data, destination)
                    if handle.read(1):
                        self.manifest["truncated"] = True

    def finish(self, code: int, cleanup: str, deadline: float | None = None) -> None:
        self.output.close()
        self.manifest.update(completed=True, finished=time.time(), exit=code, cleanup=cleanup)
        self.save()
        completed = []
        for entry in self.directory.parent.iterdir():
            if deadline is not None and time.monotonic() >= deadline:
                raise Refused("diagnostic retention deadline exceeded")
            if entry.is_symlink() or not SLUG_RE.fullmatch(entry.name):
                continue
            try:
                result = entry / "result.json"
                if result.is_symlink():
                    continue
                payload = json.loads(result.read_text(encoding="utf-8"))
                if payload.get("completed") is True and not payload.get("children_unverified"):
                    completed.append((payload["finished"], entry))
            except (OSError, ValueError, KeyError):
                continue
        for _, entry in sorted(completed, reverse=True)[DIAGNOSTIC_RUNS:]:
            if deadline is not None and time.monotonic() >= deadline:
                raise Refused("diagnostic retention deadline exceeded")
            shutil.rmtree(entry)


class Serve:
    def __init__(self, root: Path, environ: dict[str, str] | os._Environ[str], restricted: bool) -> None:
        self.root = root.resolve()
        self.environ = environ
        self.restricted = restricted
        self.state = state_dir(environ)
        uname, kernel = kernel_identity(serve_path(environ, environ.get("HOME") or str(Path.home())))
        self.uname = uname
        self.kernel = kernel
        self.platform = platform_from_identity(uname, kernel)
        self.env = scrubbed_environment(environ, self.platform)
        self.deadline: float | None = None
        self.diagnostics: Diagnostics | None = None
        self.children_stopped = True

    def log(self, verb: str, args: list[str], code: int, started: float) -> None:
        try:
            self.state.mkdir(parents=True, exist_ok=True)
            with (self.state / "serve.log").open("a", encoding="utf-8") as handle:
                handle.write(
                    json.dumps(
                        {
                            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                            "client": (self.environ.get("SSH_CLIENT") or "").split(" ")[0],
                            "restricted": self.restricted,
                            "verb": verb,
                            "args": args,
                            "exit": code,
                            "seconds": round(time.monotonic() - started, 3),
                        },
                        sort_keys=True,
                    )
                    + "\n"
                )
        except OSError:
            pass

    def worktree(self, slug: str) -> Path:
        worktree = self.root / f"{WORKTREE_PREFIX}{validate_slug(slug)}"
        if worktree.is_symlink() or worktree.parent.is_symlink():
            raise Refused(f"symlinked worktree path: {worktree}")
        return worktree

    def git(self, *args: str, check: bool = True, cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
        timeout = PREPARE_TIMEOUT if self.deadline is None else max(0.001, self.deadline - time.monotonic())
        result = capture(
            ["git", "-C", str(cwd or self.root), *args],
            env=self.env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
        if check and result.returncode != 0:
            raise Refused(f"git {' '.join(args)} failed: {result.stderr.strip()}")
        return result

    def lock(self, slug: str):
        import fcntl

        private_directory(self.state)
        descriptor = os.open(self.state / f"lock-{validate_slug(slug)}", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        handle = os.fdopen(descriptor, "a+", encoding="utf-8")
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            handle.close()
            raise BusyError(f"{WORKTREE_PREFIX}{slug} is busy with another request")
        return handle

    # verbs -------------------------------------------------------------

    def identity(self, args: list[str]) -> int:
        if args:
            raise Refused("identity takes no arguments")
        tools = {tool: shutil.which(tool, path=self.env["PATH"]) is not None for tool in REMOTE_TOOLS}
        payload = {
            "protocol": PROTOCOL,
            "capabilities": [RUN_CAPABILITY],
            "uname": self.uname,
            "kernel": self.kernel,
            "platform": self.platform,
            "restricted": self.restricted,
            "tools": tools,
            "repo": str(self.root),
        }
        print(IDENTITY_MARKER + json.dumps(payload, sort_keys=True), flush=True)
        return EXIT_OK

    def receive_pack(self, args: list[str]) -> int:
        with tempfile.TemporaryDirectory(prefix="peer-env-hooks-") as hooks:
            hook = Path(hooks) / "pre-receive"
            hook.write_text(
                "#!/bin/sh\n"
                "rc=0\n"
                "while read -r old new ref; do\n"
                "  case \"$ref\" in\n"
                f"    {REF_NAMESPACE}*)\n"
                f"      rest=${{ref#{REF_NAMESPACE}}}\n"
                "      case \"$rest\" in *..*|*/*) rc=1 ;; esac\n"
                f"      printf '%s' \"$rest\" | grep -Eq '{SLUG_PATTERN}' || rc=1\n"
                "      ;;\n"
                "    *) rc=1 ;;\n"
                "  esac\n"
                "  if [ \"$rc\" -ne 0 ]; then\n"
                f"    echo \"{SCRIPT_NAME} serve: refused: ref $ref is outside {REF_NAMESPACE}\" >&2\n"
                "    exit 1\n"
                "  fi\n"
                "done\n"
                "exit 0\n",
                encoding="utf-8",
            )
            hook.chmod(0o755)
            result = subprocess.run(
                ["git", "-c", f"core.hooksPath={hooks}", "receive-pack", str(self.root)],
                env=self.env,
                check=False,
            )
        return result.returncode

    def prepare(self, args: list[str]) -> int:
        if len(args) != 2:
            raise Refused("prepare takes <slug> <sha>")
        slug = validate_slug(args[0])
        sha = validate_sha(args[1])
        with self.lock(slug):
            self.prepare_unlocked(slug, sha)
        return EXIT_OK

    def published_sha(self, slug: str) -> str | None:
        ref = self.git("rev-parse", "--verify", "--quiet", f"{REF_NAMESPACE}{slug}", check=False)
        return ref.stdout.strip() if ref.returncode == 0 else None

    def prepare_unlocked(self, slug: str, sha: str) -> None:
        if self.published_sha(slug) != sha:
            raise Refused(f"{sha} is not {REF_NAMESPACE}{slug}; publish it first")
        worktree = self.worktree(slug)
        if worktree.exists():
            self.owned_worktree(slug)
            self.git("checkout", "--quiet", "--detach", "--force", sha, cwd=worktree)
            self.git("clean", "-fdq", cwd=worktree)
        else:
            worktree.parent.mkdir(exist_ok=True)
            self.git("worktree", "add", "--quiet", "--detach", str(worktree), sha)

    def worktree_records(self) -> dict[str, dict[str, str]]:
        records: dict[str, dict[str, str]] = {}
        record: dict[str, str] = {}
        for field in self.git("worktree", "list", "--porcelain", "-z").stdout.split("\0"):
            if not field:
                if "worktree" in record:
                    records[record["worktree"]] = record
                record = {}
            else:
                key, _, value = field.partition(" ")
                record[key] = value
        return records

    def owned_worktree(self, slug: str, sha: str | None = None) -> dict[str, str] | None:
        worktree = self.worktree(slug)
        record = self.worktree_records().get(str(worktree))
        if record is None:
            if worktree.exists():
                raise Refused(f"unregistered worktree: {worktree}")
            return None
        if "detached" not in record or "locked" in record or (sha and record.get("HEAD") != sha):
            raise Refused(f"worktree ownership mismatch: {worktree}")
        if worktree.exists():
            metadata = worktree / ".git"
            if metadata.is_symlink() or not metadata.is_file():
                raise Refused(f"unsafe worktree metadata: {worktree}")
            common = self.git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=worktree).stdout.strip()
            expected = self.git("rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()
            if Path(common).resolve() != Path(expected).resolve():
                raise Refused(f"foreign repository: {worktree}")
        return record

    def run(self, args: list[str]) -> int:
        if len(args) < 6:
            raise Refused("run takes <slug> <sha> <timeout> cleanup|keep audit|test ...")
        slug, sha = validate_slug(args[0]), validate_sha(args[1])
        try:
            seconds = run_timeout(args[2])
        except ConfigError as error:
            raise Refused(str(error)) from error
        if args[3] not in ("cleanup", "keep"):
            raise Refused("run retention must be cleanup or keep")
        keep = args[3] == "keep"
        code, cleanup = EXIT_FAILED, "not attempted"
        with self.lock(slug):
            if self.published_sha(slug) != sha:
                raise Refused(f"{sha} is not {REF_NAMESPACE}{slug}; publish it first")
            self.diagnostics = Diagnostics(self.state, slug, sha, keep)
            emit(f"diagnostics: {self.diagnostics.directory}")
            previous = {}

            def cancelled(signum, frame):
                for sig in previous:
                    signal.signal(sig, signal.SIG_IGN)
                raise RunCancelled(signum)

            for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
                previous[sig] = signal.signal(sig, cancelled)
            try:
                self.deadline = time.monotonic() + PREPARE_TIMEOUT
                self.prepare_unlocked(slug, sha)
                self.deadline = time.monotonic() + seconds
                commands, scan_errors = self.exec_commands(slug, args[4:])
                code = EXIT_OK
                for command in commands:
                    if time.monotonic() >= self.deadline:
                        code = EXIT_TIMEOUT
                        break
                    result = self.run_streamed(command, self.worktree(slug), scan_errors)
                    if code == EXIT_OK:
                        code = result
                    if result == EXIT_TIMEOUT:
                        code = result
                        break
            except RunCancelled as error:
                code = error.code
            except subprocess.TimeoutExpired:
                code = EXIT_TIMEOUT
            except Refused as error:
                emit(f"run refused: {error}")
                code = EXIT_CONFIG
            except (OSError, BrokenPipeError) as error:
                emit(f"run failed: {error}")
                code = EXIT_FAILED
            finally:
                for sig in previous:
                    signal.signal(sig, signal.SIG_IGN)
                self.deadline = time.monotonic() + CLEANUP_TIMEOUT
                if not self.children_stopped:
                    self.diagnostics.manifest["children_unverified"] = True
                try:
                    try:
                        self.diagnostics.archive(self.worktree(slug), self.deadline)
                    except (OSError, Refused) as error:
                        emit(f"diagnostic archival failed: {error}")
                        self.diagnostics.manifest["archive_error"] = str(error)
                        if code == EXIT_OK:
                            code = EXIT_FAILED
                    if not self.children_stopped:
                        raise Refused("child shutdown is unverified; retaining worktree and ref")
                    if keep:
                        cleanup = "retained"
                        emit(f"retained {self.worktree(slug)} and {REF_NAMESPACE}{slug}")
                    else:
                        self.remove_unlocked(slug, sha)
                        cleanup = "removed"
                except (Refused, OSError, subprocess.TimeoutExpired) as error:
                    cleanup = f"incomplete: {error}"
                    emit(f"cleanup {cleanup}")
                    if code == EXIT_OK:
                        code = EXIT_FAILED
                try:
                    self.diagnostics.finish(code, cleanup, self.deadline)
                except (OSError, Refused) as error:
                    emit(f"diagnostic finalization failed: {error}")
                    if code == EXIT_OK:
                        code = EXIT_FAILED
                finally:
                    self.deadline = None
                    self.diagnostics = None
                    for sig, handler in previous.items():
                        signal.signal(sig, handler)
        return code

    def exec(self, args: list[str]) -> int:
        if len(args) < 2:
            raise Refused("exec takes <slug> audit|test ...")
        slug = validate_slug(args[0])
        worktree = self.worktree(slug)
        if not (worktree / ".git").exists():
            raise Refused(f"{WORKTREE_PREFIX}{slug} is not prepared")
        commands, scan_errors = self.exec_commands(slug, args[1:])
        with self.lock(slug):
            self.deadline = time.monotonic() + DEFAULT_RUN_TIMEOUT
            try:
                exit_code = EXIT_OK
                for command in commands:
                    code = self.run_streamed(command, worktree, scan_errors)
                    if code != EXIT_OK and exit_code == EXIT_OK:
                        exit_code = code
                    if code == EXIT_TIMEOUT:
                        break
                return exit_code
            finally:
                self.deadline = None

    def exec_commands(self, slug: str, args: list[str]) -> tuple[list[list[str]], bool]:
        worktree = self.worktree(slug)
        kind, rest = args[0], args[1:]
        if kind == "audit":
            if not rest:
                raise Refused("audit needs at least one repo-relative path")
            paths = []
            for value in rest:
                try:
                    validate_relative_path(value)
                except ConfigError as error:
                    raise Refused(str(error))
                if not (worktree / value).exists():
                    raise Refused(f"{value} does not exist in the snapshot")
                paths.append(value)
            commands = [["./assets/cz-audit.sh", "check", path] for path in paths]
            scan_errors = True
        elif kind == "test":
            if not rest or rest[0] not in SUITES:
                raise Refused(f"test needs a suite: {', '.join(SUITES)}")
            extra = rest[1:]
            if extra not in ([], ["--require-capabilities"]):
                raise Refused("test accepts only --require-capabilities")
            commands = [["./assets/run-tests.sh", rest[0], *extra]]
            scan_errors = False
        else:
            raise Refused(f"unknown exec kind {kind!r}")
        return commands, scan_errors

    def run_streamed(self, command: list[str], cwd: Path, scan_errors: bool) -> int:
        process = subprocess.Popen(
            command,
            cwd=cwd,
            env=self.env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        self.children_stopped = False
        saw_error = False
        timed_out = False
        prefix = ""
        decoder = codecs.getincrementaldecoder("utf-8")("replace")
        forced_kill = False
        try:
            assert process.stdout is not None
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                while selector.get_map():
                    remaining = (self.deadline or time.monotonic()) - time.monotonic()
                    if remaining <= 0:
                        timed_out = True
                        break
                    for key, _ in selector.select(min(0.2, remaining)):
                        data = os.read(key.fd, 65536)
                        if not data:
                            selector.unregister(key.fileobj)
                            break
                        if self.diagnostics:
                            self.diagnostics.write(data)
                        text = decoder.decode(data)
                        if scan_errors:
                            for fragment in text.splitlines(keepends=True):
                                prefix = (prefix + fragment)[:6]
                                if prefix == "ERROR:":
                                    saw_error = True
                                if fragment.endswith(("\n", "\r")):
                                    prefix = ""
                        sys.stdout.write(text)
                        sys.stdout.flush()
            tail = decoder.decode(b"", final=True)
            if tail:
                sys.stdout.write(tail)
                sys.stdout.flush()
            if timed_out:
                return EXIT_TIMEOUT
            code = process.wait(timeout=max(0.001, (self.deadline or time.monotonic()) - time.monotonic()))
            return EXIT_FAILED if code == 0 and saw_error else code
        finally:
            process.stdout.close()
            for sig, grace in ((signal.SIGTERM, STOP_GRACE), (signal.SIGKILL, 1)):
                if sig == signal.SIGKILL:
                    forced_kill = True
                try:
                    os.killpg(process.pid, sig)
                except ProcessLookupError:
                    self.children_stopped = True
                    break
                until = time.monotonic() + grace
                while time.monotonic() < until:
                    process.poll()
                    if not group_alive(process.pid, self.env):
                        self.children_stopped = True
                        break
                    time.sleep(0.05)
                if self.children_stopped:
                    break
            process.wait(timeout=1)
            if forced_kill and Path(command[0]).name == "run-tests.sh":
                self.children_stopped = False
            if timed_out:
                emit("peer execution deadline exceeded")

    def remove(self, args: list[str]) -> int:
        if len(args) not in (1, 2):
            raise Refused("remove takes <slug> [expected-sha]")
        slug = validate_slug(args[0])
        with self.lock(slug):
            self.deadline = time.monotonic() + CLEANUP_TIMEOUT
            try:
                self.verify_shutdown(slug)
                self.remove_unlocked(slug, validate_sha(args[1]) if len(args) == 2 else self.published_sha(slug))
            finally:
                self.deadline = None
        return EXIT_OK

    def verify_shutdown(self, slug: str) -> None:
        directory = self.state / "runs" / slug
        result = directory / "result.json"
        if any(parent.is_symlink() for parent in (directory, *directory.parents)):
            raise Refused("unsafe diagnostic state during cleanup")
        try:
            descriptor = os.open(result, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        except FileNotFoundError:
            if directory.exists():
                raise Refused("missing lifecycle result; child shutdown is unverified")
            return
        with os.fdopen(descriptor, "r") as handle:
            info = os.fstat(handle.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_size > 16384:
                raise Refused("unsafe lifecycle result during cleanup")
            try:
                manifest = json.load(handle)
            except ValueError as error:
                raise Refused("invalid lifecycle result during cleanup") from error
        if not isinstance(manifest, dict) or manifest.get("completed") is not True or manifest.get("children_unverified"):
            raise Refused("child shutdown is unverified; retaining worktree and ref for operator inspection")

    def remove_unlocked(self, slug: str, sha: str | None) -> None:
        actual = self.published_sha(slug)
        if actual is not None and actual != sha:
            raise Refused(f"ref ownership mismatch: {REF_NAMESPACE}{slug}")
        record = self.owned_worktree(slug, sha)
        if record is not None:
            if sha is None:
                raise Refused(f"no ownership ref for {self.worktree(slug)}")
            self.git("worktree", "remove", "--force", str(self.worktree(slug)))
        if actual is not None:
            self.git("update-ref", "-d", f"{REF_NAMESPACE}{slug}", sha)
        if str(self.worktree(slug)) in self.worktree_records() or self.worktree(slug).exists() or self.published_sha(slug):
            raise Refused(f"cleanup verification failed: {slug}")

    def clean(self, args: list[str]) -> int:
        if args:
            raise Refused("clean takes no arguments")
        self.deadline = time.monotonic() + CLEANUP_TIMEOUT
        code = EXIT_OK
        try:
            refs = self.git("for-each-ref", "--format=%(refname)", REF_NAMESPACE)
            slugs = {validate_slug(ref[len(REF_NAMESPACE):]) for ref in refs.stdout.splitlines()}
            for path in self.worktree_records():
                candidate = Path(path)
                if candidate.parent == self.root / "worktrees" and candidate.name.startswith("peer-env-"):
                    slugs.add(validate_slug(candidate.name[len("peer-env-"):]))
            for slug in sorted(slugs):
                try:
                    with self.lock(slug):
                        self.verify_shutdown(slug)
                        self.remove_unlocked(slug, self.published_sha(slug))
                except BusyError as error:
                    emit(str(error))
                    if code == EXIT_OK:
                        code = EXIT_BUSY
                except Refused as error:
                    emit(str(error))
                    code = EXIT_FAILED
            return code
        finally:
            self.deadline = None


def parse_request(argv_rest: list[str], environ: dict[str, str] | os._Environ[str]) -> tuple[list[str], bool]:
    original = environ.get("SSH_ORIGINAL_COMMAND")
    if original is None:
        return list(argv_rest), False
    try:
        tokens = shlex.split(original)
    except ValueError as error:
        raise Refused(f"unparseable command: {error}")
    if "serve" in tokens:
        return tokens[tokens.index("serve") + 1 :], True
    if tokens and tokens[0] == "git-receive-pack":
        return [PROTOCOL, "receive-pack", *tokens[1:]], True
    raise Refused("only peer-env serve requests are accepted on this key")


def serve_main(argv_rest: list[str], environ: dict[str, str] | os._Environ[str]) -> int:
    started = time.monotonic()
    root = Path(__file__).resolve().parents[1]
    server: Serve | None = None
    verb = "?"
    args: list[str] = []
    try:
        request, restricted = parse_request(argv_rest, environ)
        server = Serve(root, environ, restricted)
        if not request or request[0] != PROTOCOL:
            raise Refused(f"protocol must be {PROTOCOL}")
        if len(request) < 2:
            raise Refused("missing verb")
        verb, args = request[1], request[2:]
        handlers = {
            "identity": server.identity,
            "receive-pack": server.receive_pack,
            "prepare": server.prepare,
            "exec": server.exec,
            "run": server.run,
            "remove": server.remove,
            "clean": server.clean,
        }
        handler = handlers.get(verb)
        if handler is None:
            raise Refused(f"unknown verb {verb!r}")
        code = handler(args)
    except Refused as error:
        print(f"{SCRIPT_NAME} serve: refused: {error}", file=sys.stderr)
        code = EXIT_CONFIG
    except BusyError as error:
        print(f"{SCRIPT_NAME} serve: busy: {error}", file=sys.stderr)
        code = EXIT_BUSY
    except Exception as error:  # noqa: BLE001 - every request must be logged
        try:
            print(f"{SCRIPT_NAME} serve: failed: {error}", file=sys.stderr)
        except OSError:
            pass
        code = EXIT_FAILED
    if server is not None:
        server.log(verb, args, code, started)
    return code


