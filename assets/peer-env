# Snapshot and publish (client side)


def git(
    root: Path,
    *args: str,
    env: dict[str, str] | None = None,
    check: bool = True,
    stdin_text: str | None = None,
    timeout: float = PREPARE_TIMEOUT,
) -> subprocess.CompletedProcess[str]:
    deadline = LOCAL_DEADLINE.get()
    if deadline is not None:
        timeout = min(timeout, max(0.001, deadline - time.monotonic()))
    result = capture(
        ["git", "-C", str(root), *args],
        env=env,
        stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
        input_text=stdin_text,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=timeout,
    )
    if check and result.returncode != 0:
        raise ConfigError(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result


def repo_root(cwd: Path, environ: dict[str, str] | os._Environ[str]) -> Path:
    result = git(cwd, "rev-parse", "--show-toplevel", env=dict(environ), check=False)
    if result.returncode != 0:
        raise ConfigError("run from inside the dotfiles checkout")
    return Path(result.stdout.strip())


def secret_matches(paths: list[str]) -> list[str]:
    flagged = []
    for path in paths:
        name = os.path.basename(path)
        if any(fnmatch.fnmatch(name, pattern) for pattern in SECRET_PATTERNS):
            flagged.append(path)
    return flagged


def snapshot_tree(root: Path, environ: dict[str, str] | os._Environ[str], *, tracked_only: bool) -> str:
    base_env = dict(environ)
    head = git(root, "rev-parse", "--verify", "HEAD", env=base_env, check=False)
    if head.returncode != 0:
        raise ConfigError("HEAD is unborn; commit something before using peer-env")
    head_sha = head.stdout.strip()
    if not tracked_only:
        untracked = git(root, "ls-files", "--others", "--exclude-standard", env=base_env).stdout.splitlines()
        flagged = secret_matches(untracked)
        if flagged:
            listing = "\n  ".join(flagged)
            raise ConfigError(
                "refusing to ship untracked files that look like secrets:\n  "
                f"{listing}\nignore them, remove them, or pass --tracked-only"
            )
    with tempfile.TemporaryDirectory(prefix="peer-env-index-") as temp:
        env = dict(base_env)
        env["GIT_INDEX_FILE"] = str(Path(temp) / "index")
        env.update(SNAPSHOT_IDENTITY)
        git(root, "read-tree", "HEAD", env=env)
        git(root, "add", "-u" if tracked_only else "-A", env=env)
        tree = git(root, "write-tree", env=env).stdout.strip()
        head_tree = git(root, "rev-parse", "HEAD^{tree}", env=env).stdout.strip()
        if tree == head_tree:
            return head_sha
        commit = git(root, "commit-tree", tree, "-p", head_sha, "-m", "peer-env snapshot", env=env)
        return commit.stdout.strip()


def slug_for(root: Path, environ: dict[str, str] | os._Environ[str]) -> str:
    branch = git(root, "symbolic-ref", "--quiet", "--short", "HEAD", env=dict(environ), check=False)
    if branch.returncode == 0 and branch.stdout.strip():
        raw = branch.stdout.strip()
    else:
        short = git(root, "rev-parse", "--short", "HEAD", env=dict(environ)).stdout.strip()
        raw = f"detached-{short}"
    cleaned = re.sub(r"[^A-Za-z0-9._-]", "-", raw)
    cleaned = re.sub(r"\.\.+", "-", cleaned)
    cleaned = cleaned.lstrip("-.")[:64].rstrip(".")
    if cleaned.endswith(".lock"):
        cleaned = cleaned[: -len(".lock")] + "-lock"
    if not cleaned or not SLUG_RE.match(cleaned):
        cleaned = "detached-" + git(root, "rev-parse", "--short", "HEAD", env=dict(environ)).stdout.strip()
    return cleaned


def publish(
    peer: Peer,
    root: Path,
    sha: str,
    slug: str,
    environ: dict[str, str] | os._Environ[str],
) -> None:
    env = dict(environ)
    env["GIT_SSH_COMMAND"] = shlex.join(["ssh", *ssh_options(peer, environ)])
    env["GIT_TERMINAL_PROMPT"] = "0"
    receive_pack = f"{remote_helper(peer)} serve {PROTOCOL} receive-pack"
    result = git(
        root,
        "push",
        "--quiet",
        f"--receive-pack={receive_pack}",
        push_url(peer),
        f"+{sha}:{REF_NAMESPACE}{slug}",
        env=env,
        check=False,
        timeout=PUBLISH_TIMEOUT,
    )
    if result.returncode != 0:
        message = result.stderr.strip() or f"git push exit {result.returncode}"
        if result.returncode == 255 or "ssh:" in message or "Connection" in message:
            raise PeerUnavailable(f"{peer.name}: {message}")
        raise ConfigError(f"{peer.name}: push to {REF_NAMESPACE}{slug} failed: {message}")


def remote_request(
    peer: Peer,
    request: list[str],
    environ: dict[str, str] | os._Environ[str],
    *,
    timeout: float,
    action: str,
) -> None:
    result, timed_out = ssh_capture(peer, request, environ, timeout=timeout)
    if timed_out or result is None:
        raise PeerUnavailable(f"{peer.name}: {action} timed out")
    if result.returncode == EXIT_BUSY:
        raise PeerBusy(f"{peer.name}: {result.stderr.strip() or 'busy'}")
    if result.returncode == 255:
        raise PeerUnavailable(f"{peer.name}: {result.stderr.strip() or 'ssh failed'}")
    if result.returncode != 0:
        raise ConfigError(f"{peer.name}: {action} failed: {result.stderr.strip() or result.stdout.strip()}")


