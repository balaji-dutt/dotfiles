def emit(message: str) -> None:
    print(f"{SCRIPT_NAME}: {message}", file=sys.stderr, flush=True)


def cmd_config(args: argparse.Namespace, environ: dict[str, str] | os._Environ[str]) -> int:
    config = load_config(environ)
    if args.json:
        payload = {
            "path": str(config.path),
            "self_platform": config.self_platform,
            "peers": {
                name: {**asdict(peer), "role": "self" if peer.platform == config.self_platform else "peer"}
                for name, peer in config.peers.items()
            },
        }
        print(json.dumps(payload, indent=2, sort_keys=True))
        return EXIT_OK
    print(f"config   {config.path}")
    print(f"self     {config.self_platform}")
    for name, peer in config.peers.items():
        role = "self" if peer.platform == config.self_platform else "peer"
        extra = f" identity={peer.identity_file}" if peer.identity_file else ""
        print(f"{name:<8} {role:<5} {peer.platform:<7} {peer.ssh_host:<16} {peer.repo}{extra}")
    return EXIT_OK


def cmd_probe(args: argparse.Namespace, environ: dict[str, str] | os._Environ[str]) -> int:
    config = load_config(environ)
    peers = remote_peers(config)
    results, from_cache, checked_at = resolve_probe(
        config,
        peers,
        environ,
        fresh=args.fresh,
        ttl=args.ttl,
        connect_timeout=args.connect_timeout,
    )
    if args.json:
        payload = {
            "schema_version": SCHEMA_VERSION,
            "self_platform": config.self_platform,
            "checked_at": checked_at,
            "from_cache": from_cache,
            "peers": {name: result.to_json() for name, result in results.items()},
        }
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(format_probe(config, results, from_cache))
    usable = any(
        name in config.peers and result.usable_for(config.peers[name])
        for name, result in results.items()
    )
    return EXIT_OK if usable else EXIT_UNREACHABLE


def _run_on_peers(
    args: argparse.Namespace,
    environ: dict[str, str] | os._Environ[str],
    build_request: Callable[[argparse.Namespace], list[str]],
) -> int:
    config = load_config(environ)
    peers = select_peers(config, args.peer)
    if not peers:
        emit("no peer configured for another platform")
        return EXIT_UNREACHABLE
    results, _, _ = resolve_probe(
        config,
        peers,
        environ,
        fresh=args.fresh,
        ttl=args.ttl,
        connect_timeout=None,
    )
    targets: list[Peer] = []
    for peer in peers:
        result = results[peer.name]
        if not result.usable:
            emit(f"{peer.name} {result.status}: {result.detail}")
            emit(f'report "not verified on {peer.platform}: peer unreachable"')
            continue
        if result.restricted is False and not peer.allow_unrestricted:
            emit(f"{peer.name} reachable (unrestricted); refusing to use an unrestricted key")
            emit(f'report "not verified on {peer.platform}: peer unreachable (unrestricted key)"')
            emit(f"only the owner sets allow_unrestricted in {config.path}")
            continue
        targets.append(peer)
    if not targets:
        return EXIT_UNREACHABLE
    root = repo_root(Path.cwd(), environ)
    sha = snapshot_tree(root, environ, tracked_only=args.tracked_only)
    slug = slug_for(root, environ)
    command = build_request(args)
    exit_code = EXIT_OK
    for peer in targets:
        emit(f"{peer.name}: publishing {sha[:12]} as {REF_NAMESPACE}{slug}")
        publish(peer, root, sha, slug, environ)
        remote_request(
            peer,
            [PROTOCOL, "prepare", slug, sha],
            environ,
            timeout=args.timeout,
            action="prepare",
        )
        request = [PROTOCOL, "exec", slug, *command]
        emit(f"{peer.name}: running {' '.join(command)} in {WORKTREE_PREFIX}{slug}")
        code = ssh_stream(peer, request, environ, timeout=args.timeout)
        if code != EXIT_OK:
            emit(f"{peer.name}: exit {code}")
            if exit_code == EXIT_OK:
                exit_code = code
        else:
            emit(f"{peer.name}: ok")
        if args.rm:
            remote_request(
                peer,
                [PROTOCOL, "remove", slug],
                environ,
                timeout=args.timeout,
                action="remove",
            )
    return exit_code


def cmd_audit(args: argparse.Namespace, environ: dict[str, str] | os._Environ[str]) -> int:
    for path in args.paths:
        validate_relative_path(path)
    return _run_on_peers(args, environ, lambda a: ["audit", *a.paths])


def cmd_test(args: argparse.Namespace, environ: dict[str, str] | os._Environ[str]) -> int:
    if args.suite not in SUITES:
        raise ConfigError(f"suite must be one of {', '.join(SUITES)}")

    def build(a: argparse.Namespace) -> list[str]:
        request = ["test", a.suite]
        if a.require_capabilities:
            request.append("--require-capabilities")
        return request

    return _run_on_peers(args, environ, build)


def cmd_clean(args: argparse.Namespace, environ: dict[str, str] | os._Environ[str]) -> int:
    config = load_config(environ)
    peers = select_peers(config, args.peer)
    results, _, _ = resolve_probe(
        config, peers, environ, fresh=args.fresh, ttl=args.ttl, connect_timeout=None
    )
    exit_code = EXIT_OK
    for peer in peers:
        result = results[peer.name]
        if not result.usable:
            emit(f"{peer.name} {result.status}: skipped")
            continue
        try:
            remote_request(peer, [PROTOCOL, "clean"], environ, timeout=args.timeout, action="clean")
            emit(f"{peer.name}: cleaned")
        except (ConfigError, PeerUnavailable, PeerBusy) as error:
            emit(str(error))
            exit_code = EXIT_FAILED
    try:
        cache_path(environ).unlink()
    except FileNotFoundError:
        pass
    return exit_code


