class ConfigError(Exception):
    """Configuration, usage, or refused request; exit 2."""


class PeerUnavailable(Exception):
    """No reachable peer; exit 3."""


class PeerBusy(Exception):
    """The peer worktree is locked by another request; exit 75."""


class Refused(Exception):
    """A request the peer side refuses; exit 2 on the peer."""


class RunCancelled(Exception):
    def __init__(self, signum: int) -> None:
        self.code = 128 + signum
        super().__init__(f"cancelled by signal {signum}")


def run_timeout(value: str | float) -> float:
    try:
        seconds = float(value)
    except (TypeError, ValueError) as error:
        raise ConfigError("timeout must be finite and in (0, 86400] seconds") from error
    if not math.isfinite(seconds) or not 0 < seconds <= 86400:
        raise ConfigError("timeout must be finite and in (0, 86400] seconds")
    return seconds


def private_directory(directory: Path) -> None:
    if directory.is_symlink():
        raise Refused(f"symlinked state directory: {directory}")
    if not directory.exists():
        if not directory.parent.exists():
            private_directory(directory.parent)
        if directory.parent.is_symlink():
            raise Refused(f"symlinked state parent: {directory.parent}")
        directory.mkdir(mode=0o700)
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise Refused(f"state directory must be owned by this user and private: {directory}")
    directory.chmod(0o700)


def capture(argv: list[str], *, timeout: float, input_text: str | None = None, **kwargs) -> subprocess.CompletedProcess[str]:
    process = subprocess.Popen(argv, start_new_session=True, **kwargs)
    try:
        output, error = process.communicate(input_text, timeout=timeout)
        return subprocess.CompletedProcess(argv, process.returncode, output, error)
    except BaseException:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait(timeout=STOP_GRACE)
        raise
    finally:
        for handle in (process.stdin, process.stdout, process.stderr):
            if handle is not None:
                handle.close()


def group_alive(pgid: int, env: dict[str, str]) -> bool:
    result = capture(["ps", "-axo", "pgid=,stat="], env=env, text=True,
                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=2)
    if result.returncode:
        raise Refused("cannot verify child process-group shutdown")
    return any(int(fields[0]) == pgid and not fields[1].startswith("Z")
               for line in result.stdout.splitlines() if len(fields := line.split()) == 2)


@dataclass(frozen=True)
class Peer:
    name: str
    ssh_host: str
    platform: str
    repo: str
    identity_file: str | None
    connect_timeout: int
    allow_unrestricted: bool


@dataclass(frozen=True)
class Config:
    path: Path
    self_platform: str
    peers: dict[str, Peer]
    fingerprint: str


@dataclass
class ProbeResult:
    name: str
    ssh_host: str
    platform: str
    status: str
    detail: str
    restricted: bool | None
    identity: dict | None
    elapsed: float

    def to_json(self) -> dict:
        return asdict(self)

    @classmethod
    def from_json(cls, payload: dict) -> "ProbeResult":
        return cls(**payload)

    @property
    def usable(self) -> bool:
        return self.status == "reachable"

    def usable_for(self, peer: "Peer") -> bool:
        if not self.usable:
            return False
        return self.restricted is not False or peer.allow_unrestricted


# --------------------------------------------------------------------------
# Platform and paths


def current_platform(environ: dict[str, str] | os._Environ[str] = os.environ) -> str:
    if os.name == "nt":
        return "windows"
    if sys.platform == "darwin":
        return "macos"
    if environ.get("WSL_DISTRO_NAME") or environ.get("WSL_INTEROP"):
        return "wsl2"
    return "linux"


def home_dir(environ: dict[str, str] | os._Environ[str] = os.environ) -> Path:
    if os.name == "nt":
        return Path(environ.get("USERPROFILE") or Path.home())
    return Path(environ.get("HOME") or Path.home())


def config_path(environ: dict[str, str] | os._Environ[str] = os.environ) -> Path:
    base = environ.get("XDG_CONFIG_HOME") if os.name != "nt" else None
    root = Path(base) if base else home_dir(environ) / ".config"
    return root / "dotfiles" / "peer-envs.json"


def state_dir(environ: dict[str, str] | os._Environ[str] = os.environ) -> Path:
    base = environ.get("XDG_STATE_HOME") if os.name != "nt" else None
    root = Path(base) if base else home_dir(environ) / ".local" / "state"
    return root.resolve() / "dotfiles" / "peer-env"


def cache_path(environ: dict[str, str] | os._Environ[str] = os.environ) -> Path:
    return state_dir(environ) / "probe.json"


def expand_user_path(value: str, environ: dict[str, str] | os._Environ[str]) -> str:
    if value == "~" or value.startswith("~/"):
        return str(home_dir(environ)) + value[1:]
    return value


# --------------------------------------------------------------------------
# Configuration


def _require_string(value: object, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ConfigError(f"{label} must be a non-empty string")
    return value


def load_config(environ: dict[str, str] | os._Environ[str] = os.environ) -> Config:
    path = config_path(environ)
    if not path.is_file():
        raise ConfigError(
            f"missing peer config {path}; see docs/tooling/peer-environments.md"
        )
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise ConfigError(f"{path}: invalid JSON at line {error.lineno} column {error.colno}")
    if not isinstance(payload, dict):
        raise ConfigError(f"{path}: top level must be an object")
    if payload.get("schema_version") != SCHEMA_VERSION:
        raise ConfigError(f"{path}: schema_version must be {SCHEMA_VERSION}")
    unknown_top = set(payload) - {"schema_version", "peers"}
    if unknown_top:
        raise ConfigError(f"{path}: unknown key(s): {', '.join(sorted(unknown_top))}")
    raw_peers = payload.get("peers")
    if not isinstance(raw_peers, dict) or not raw_peers:
        raise ConfigError(f"{path}: peers must be a non-empty object")
    peers: dict[str, Peer] = {}
    for name, raw in raw_peers.items():
        label = f"{path}: peers.{name}"
        if not SLUG_RE.match(name) or name == "all":
            raise ConfigError(f"{label}: peer name must match {SLUG_PATTERN} and not be 'all'")
        if not isinstance(raw, dict):
            raise ConfigError(f"{label} must be an object")
        unknown = set(raw) - PEER_KEYS
        if unknown:
            raise ConfigError(f"{label}: unknown key(s): {', '.join(sorted(unknown))}")
        platform = _require_string(raw.get("platform"), f"{label}.platform")
        if platform not in PLATFORMS:
            raise ConfigError(f"{label}.platform must be one of {', '.join(PLATFORMS)}")
        if platform == "windows" or raw.get("via") is not None:
            raise ConfigError(f"{label}: {WINDOWS_VIA_MESSAGE}")
        ssh_host = raw.get("ssh_host", name)
        ssh_host = _require_string(ssh_host, f"{label}.ssh_host")
        if any(ch.isspace() for ch in ssh_host) or ssh_host.startswith("-"):
            raise ConfigError(f"{label}.ssh_host must not contain whitespace or start with '-'")
        repo = _require_string(raw.get("repo"), f"{label}.repo")
        if not (repo.startswith("~/") or repo.startswith("/")):
            raise ConfigError(f"{label}.repo must start with ~/ or /")
        if any(ch.isspace() for ch in repo) or ":" in repo:
            raise ConfigError(f"{label}.repo must not contain whitespace or ':'")
        identity_file = raw.get("identity_file")
        if identity_file is not None:
            identity_file = _require_string(identity_file, f"{label}.identity_file")
        connect_timeout = raw.get("connect_timeout", DEFAULT_CONNECT_TIMEOUT)
        if (
            not isinstance(connect_timeout, int)
            or isinstance(connect_timeout, bool)
            or not 1 <= connect_timeout <= 60
        ):
            raise ConfigError(f"{label}.connect_timeout must be an integer from 1 to 60")
        allow_unrestricted = raw.get("allow_unrestricted", False)
        if not isinstance(allow_unrestricted, bool):
            raise ConfigError(f"{label}.allow_unrestricted must be true or false")
        peers[name] = Peer(
            name=name,
            ssh_host=ssh_host,
            platform=platform,
            repo=repo.rstrip("/"),
            identity_file=identity_file,
            connect_timeout=connect_timeout,
            allow_unrestricted=allow_unrestricted,
        )
    info = path.stat()
    fingerprint = f"{info.st_mtime_ns}:{info.st_size}"
    return Config(path=path, self_platform=current_platform(environ), peers=peers, fingerprint=fingerprint)


def remote_peers(config: Config) -> list[Peer]:
    return [peer for peer in config.peers.values() if peer.platform != config.self_platform]


def select_peers(config: Config, target: str) -> list[Peer]:
    if target == "all":
        return remote_peers(config)
    peer = config.peers.get(target)
    if peer is None:
        raise ConfigError(
            f"unknown peer {target!r}; configured: {', '.join(sorted(config.peers))}"
        )
    if peer.platform == config.self_platform:
        raise ConfigError(f"peer {target!r} is this machine ({config.self_platform})")
    return [peer]


# --------------------------------------------------------------------------
# SSH plumbing (client side)


def control_dir() -> Path | None:
    if os.name == "nt":
        return None
    return Path("/tmp") / f"peer-env-{os.getuid()}"


def control_path(directory: Path | None = None) -> str | None:
    if directory is None:
        directory = control_dir()
    if directory is None:
        return None
    candidate = directory / "cm-%C"
    if len(str(candidate)) - 2 + 40 + CONTROL_TEMP_SUFFIX > MAX_SOCKET_PATH:
        return None
    try:
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        info = directory.lstat()
    except OSError:
        return None
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        return None
    return str(candidate)


def ssh_options(
    peer: Peer,
    environ: dict[str, str] | os._Environ[str],
    *,
    connect_timeout: int | None = None,
) -> list[str]:
    timeout = connect_timeout or peer.connect_timeout
    options = [
        "-o",
        "BatchMode=yes",
        "-o",
        f"ConnectTimeout={timeout}",
        "-o",
        "ConnectionAttempts=1",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "LogLevel=ERROR",
        "-o",
        "ForwardAgent=no",
        "-o",
        "ClearAllForwardings=yes",
    ]
    if peer.identity_file:
        options += ["-o", "IdentitiesOnly=yes", "-i", expand_user_path(peer.identity_file, environ)]
    path = control_path()
    if path is not None:
        options += [
            "-o",
            "ControlMaster=auto",
            "-o",
            f"ControlPath={path}",
            "-o",
            f"ControlPersist={CONTROL_PERSIST}",
        ]
    return options


def remote_helper(peer: Peer) -> str:
    """Shell text that resolves to the peer's copy of this helper."""
    if peer.repo.startswith("~/"):
        return '"$HOME"/' + shlex.quote(peer.repo[2:] + "/assets/peer-env")
    return shlex.quote(peer.repo + "/assets/peer-env")


def request_command(peer: Peer, request: list[str]) -> str:
    return f"{remote_helper(peer)} serve {shlex.join(request)}"


def ssh_argv(
    peer: Peer,
    request: list[str],
    environ: dict[str, str] | os._Environ[str],
    *,
    connect_timeout: int | None = None,
) -> list[str]:
    return [
        "ssh",
        "-T",
        *ssh_options(peer, environ, connect_timeout=connect_timeout),
        "--",
        peer.ssh_host,
        request_command(peer, request),
    ]


def push_url(peer: Peer) -> str:
    repo = peer.repo[2:] if peer.repo.startswith("~/") else peer.repo
    return f"{peer.ssh_host}:{repo}"


def ssh_capture(
    peer: Peer,
    request: list[str],
    environ: dict[str, str] | os._Environ[str],
    *,
    timeout: float,
    connect_timeout: int | None = None,
) -> tuple[subprocess.CompletedProcess[str] | None, bool]:
    argv = ssh_argv(peer, request, environ, connect_timeout=connect_timeout)
    try:
        result = capture(
            argv,
            env=dict(environ),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return None, True
    return result, False


def ssh_stream(
    peer: Peer,
    request: list[str],
    environ: dict[str, str] | os._Environ[str],
    *,
    timeout: float,
) -> int:
    argv = ssh_argv(peer, request, environ)
    sys.stdout.flush()
    sys.stderr.flush()
    process = subprocess.Popen(argv, env=dict(environ), stdin=subprocess.DEVNULL, start_new_session=True)
    try:
        return process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()
        print(f"{SCRIPT_NAME}: timed out after {int(timeout)}s on {peer.name}", file=sys.stderr)
        return EXIT_TIMEOUT
    except BaseException:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait(timeout=STOP_GRACE)
        raise


# --------------------------------------------------------------------------
# Probe


def platform_from_identity(uname: str, kernel: str) -> str:
    if uname == "Darwin":
        return "macos"
    if uname == "Linux":
        return "wsl2" if "microsoft" in kernel.lower() else "linux"
    return "unknown"


def parse_identity(stdout: str) -> dict | None:
    for line in reversed(stdout.splitlines()):
        if line.startswith(IDENTITY_MARKER):
            try:
                payload = json.loads(line[len(IDENTITY_MARKER):])
            except json.JSONDecodeError:
                return None
            return payload if isinstance(payload, dict) else None
    return None


def classify(
    peer: Peer,
    result: subprocess.CompletedProcess[str] | None,
    timed_out: bool,
    elapsed: float,
    connect_timeout: int,
) -> ProbeResult:
    def make(status: str, detail: str, *, restricted: bool | None = None, identity: dict | None = None):
        return ProbeResult(
            name=peer.name,
            ssh_host=peer.ssh_host,
            platform=peer.platform,
            status=status,
            detail=detail,
            restricted=restricted,
            identity=identity,
            elapsed=round(elapsed, 3),
        )

    if timed_out or result is None:
        return make("unreachable", f"timeout after {connect_timeout}s")
    stderr_first = next((line for line in result.stderr.splitlines() if line.strip()), "")
    if result.returncode == 255:
        if AUTH_FAILURE_RE.search(result.stderr):
            return make(
                "auth-failed",
                f"{stderr_first}; set IdentitiesOnly yes and IdentityFile ~/.ssh/<key>.pub for {peer.ssh_host}",
            )
        return make("unreachable", stderr_first or "ssh exit 255")
    identity = parse_identity(result.stdout)
    if identity is None:
        if result.returncode != 0:
            detail = stderr_first or f"remote exit {result.returncode}"
        else:
            detail = "no identity marker"
        return make("serve-missing", f"{detail}; the peer checkout lacks assets/peer-env serve or is behind main")
    if identity.get("protocol") != PROTOCOL:
        return make("protocol-mismatch", f"peer speaks {identity.get('protocol')!r}, client speaks {PROTOCOL!r}")
    if RUN_CAPABILITY not in identity.get("capabilities", []):
        return make("protocol-mismatch", f"peer lacks {RUN_CAPABILITY}; server-first rollout required")
    remote_platform = identity.get("platform", "unknown")
    if remote_platform != peer.platform:
        return make(
            "platform-mismatch",
            f"configured {peer.platform}, peer reports {remote_platform}",
            identity=identity,
        )
    tools = identity.get("tools") or {}
    if not tools.get("git") or not (tools.get("python3") or tools.get("python")):
        missing = [tool for tool in ("git", "python3") if not tools.get(tool)]
        return make("tools-missing", f"peer lacks {', '.join(missing)}", identity=identity)
    restricted = bool(identity.get("restricted"))
    found = " ".join(tool for tool in REMOTE_TOOLS if tools.get(tool))
    detail = f"{identity.get('uname', '?')} {identity.get('kernel', '?')}; {found}"
    if not restricted:
        detail += "; unrestricted key"
    return make("reachable", detail, restricted=restricted, identity=identity)


def probe_peer(
    peer: Peer,
    environ: dict[str, str] | os._Environ[str],
    connect_timeout: int | None,
) -> ProbeResult:
    timeout = connect_timeout or peer.connect_timeout
    started = time.monotonic()
    result, timed_out = ssh_capture(
        peer,
        [PROTOCOL, "identity"],
        environ,
        timeout=timeout + 10,
        connect_timeout=timeout,
    )
    return classify(peer, result, timed_out, time.monotonic() - started, timeout)


def probe_all(
    peers: list[Peer],
    environ: dict[str, str] | os._Environ[str],
    connect_timeout: int | None,
) -> dict[str, ProbeResult]:
    if not peers:
        return {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(peers)) as pool:
        futures = {pool.submit(probe_peer, peer, environ, connect_timeout): peer for peer in peers}
        results = {futures[future].name: future.result() for future in futures}
    return {name: results[name] for name in sorted(results)}


def load_cache(
    config: Config,
    environ: dict[str, str] | os._Environ[str],
    ttl: int,
) -> tuple[dict[str, ProbeResult], float, dict] | None:
    path = cache_path(environ)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(payload, dict) or payload.get("cache_version") != CACHE_VERSION:
        return None
    if payload.get("self_platform") != config.self_platform:
        return None
    if payload.get("config_fingerprint") != config.fingerprint:
        return None
    checked_at = payload.get("checked_at")
    if not isinstance(checked_at, (int, float)) or time.time() - checked_at >= ttl:
        return None
    try:
        results = {
            name: ProbeResult.from_json(entry) for name, entry in payload.get("peers", {}).items()
        }
    except TypeError:
        return None
    return results, float(checked_at), payload.get("agent", {})


def save_cache(
    config: Config,
    results: dict[str, ProbeResult],
    environ: dict[str, str] | os._Environ[str],
    checked_at: float,
    agent: dict | None = None,
) -> None:
    path = cache_path(environ)
    private_directory(path.parent)
    payload = {
        "schema_version": SCHEMA_VERSION,
        "cache_version": CACHE_VERSION,
        "self_platform": config.self_platform,
        "config_fingerprint": config.fingerprint,
        "checked_at": checked_at,
        "peers": {name: result.to_json() for name, result in results.items()},
        "agent": agent or {},
    }
    handle = tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False, encoding="utf-8")
    with handle:
        json.dump(payload, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(handle.name, path)


def resolve_probe(
    config: Config,
    peers: list[Peer],
    environ: dict[str, str] | os._Environ[str],
    *,
    fresh: bool,
    ttl: int,
    connect_timeout: int | None,
    agent: dict | None = None,
) -> tuple[dict[str, ProbeResult], bool, float]:
    wanted = {peer.name for peer in peers}
    if not fresh:
        cached = load_cache(config, environ, ttl)
        if cached is not None and wanted <= set(cached[0]):
            if agent and agent.get("healthy") and agent.get("generation") and (
                agent.get("repaired") or cached[2].get("generation") != agent.get("generation")
            ):
                auth_peers = [peer for peer in remote_peers(config)
                              if peer.name in cached[0] and cached[0][peer.name].status == "auth-failed"]
                if auth_peers:
                    cached[0].update(probe_all(auth_peers, environ, connect_timeout))
                    save_cache(config, cached[0], environ, cached[1], agent)
                    return {name: cached[0][name] for name in sorted(wanted)}, False, cached[1]
            return {name: cached[0][name] for name in sorted(wanted)}, True, cached[1]
    all_remote = remote_peers(config)
    checked_at = time.time()
    results = probe_all(all_remote, environ, connect_timeout)
    save_cache(config, results, environ, checked_at, agent)
    return {name: results[name] for name in sorted(wanted)}, False, checked_at


def format_probe(config: Config, results: dict[str, ProbeResult], from_cache: bool) -> str:
    lines = [f"self     {config.self_platform}"]
    for peer in config.peers.values():
        if peer.platform == config.self_platform:
            continue
        result = results.get(peer.name)
        if result is None:
            continue
        status = result.status
        if result.status == "reachable" and result.restricted is False:
            status = "reachable (unrestricted)"
        lines.append(f"{peer.name:<8} {status:<24} {peer.ssh_host:<16} {result.detail}")
    reachable = sum(
        1
        for name, result in results.items()
        if name in config.peers and result.usable_for(config.peers[name])
    )
    source = " (cached)" if from_cache else ""
    lines.append(f"{reachable} reachable, {len(results) - reachable} not{source}")
    return "\n".join(lines)


