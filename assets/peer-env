def emit(message: str) -> None:
    print(f"{SCRIPT_NAME}: {message}", file=sys.stderr, flush=True)


def agent_preflight(args: argparse.Namespace, environ) -> tuple[dict[str, str], dict]:
    env = dict(environ)
    if current_platform(env) != "wsl2":
        return env, {"skipped": True}
    helper = home_dir(env) / "bin/wsl2-pageant.py"
    if helper.is_symlink() or helper.parent.is_symlink() or not helper.is_file() or not os.access(helper, os.X_OK):
        detail = "managed Pageant helper unavailable; no automatic relay repair"
        emit(detail)
        return env, {"detail": detail}
    info = helper.stat()
    if info.st_uid != os.getuid() or info.st_mode & 0o022:
        emit("unsafe Pageant helper ownership or permissions; no automatic repair")
        return env, {"detail": "unsafe helper"}

    def invoke(operation: str) -> dict:
        result = capture([str(helper), operation, "--json"], env=env,
                         stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         text=True, timeout=16)
        payload = json.loads(result.stdout)
        return {key: payload[key] for key in ("socket", "healthy", "repaired", "generation", "skipped", "detail")
                if key in payload}

    try:
        result = invoke("--check")
        if result.get("skipped"):
            return env, result
        if not env.get("SSH_AUTH_SOCK") and result.get("socket"):
            env["SSH_AUTH_SOCK"] = result["socket"]
        if not result.get("healthy") and not args.no_agent_repair:
            result = invoke("--ensure")
        if not result.get("healthy"):
            emit("Pageant preflight: " + result.get("detail", "agent is not reachable"))
        return env, result
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        emit(f"Pageant preflight failed: {error}")
        return env, {"detail": str(error)}


def cmd_config(args: argparse.Namespace, environ: dict[str, str] | os._Environ[str]) -> int:
    config = load_config(environ)
    if args.json:
        payload = {
            "path": str(config.path),
