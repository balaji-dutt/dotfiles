def add_probe_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--fresh", action="store_true", help="ignore the probe cache")
    parser.add_argument("--ttl", type=int, default=DEFAULT_TTL, help="probe cache lifetime in seconds")


def add_run_flags(parser: argparse.ArgumentParser) -> None:
    add_probe_flags(parser)
    parser.add_argument("--timeout", type=float, default=DEFAULT_RUN_TIMEOUT, help="seconds to wait for the remote run")
    parser.add_argument("--rm", action="store_true", help="remove the peer worktree afterwards")
    parser.add_argument("--tracked-only", action="store_true", help="snapshot tracked files only")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=SCRIPT_NAME,
        description="Probe peer machines and run this repo's audit and test suites on them.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    probe = sub.add_parser("probe", help="report which peers are reachable")
    add_probe_flags(probe)
    probe.add_argument("--json", action="store_true", help="machine-readable output")
    probe.add_argument("--connect-timeout", type=int, default=None, help="override the ssh connect timeout")
    probe.set_defaults(func=cmd_probe)

    audit = sub.add_parser("audit", help="run ./assets/cz-audit.sh check on a peer")
    audit.add_argument("peer", help="'all' (what agents use) or one peer label")
    audit.add_argument("paths", nargs="+", help="repo-relative paths to audit")
    add_run_flags(audit)
    audit.set_defaults(func=cmd_audit)

    test = sub.add_parser("test", help="run ./assets/run-tests.sh on a peer")
    test.add_argument("peer", help="'all' (what agents use) or one peer label")
    test.add_argument("suite", nargs="?", default="fast", help="suite name (default fast)")
    test.add_argument("--require-capabilities", action="store_true")
    add_run_flags(test)
    test.set_defaults(func=cmd_test)

    clean = sub.add_parser("clean", help="remove peer-env worktrees and refs on a peer")
    clean.add_argument("peer", help="'all' (what agents use) or one peer label")
    add_probe_flags(clean)
    clean.add_argument("--timeout", type=float, default=DEFAULT_RUN_TIMEOUT, help="seconds to wait for the peer")
    clean.set_defaults(func=cmd_clean)

    config = sub.add_parser("config", help="show the resolved peer configuration")
    config.add_argument("--json", action="store_true", help="machine-readable output")
    config.set_defaults(func=cmd_config)

    serve = sub.add_parser("serve", help="peer side; invoked by ssh, not by hand")
    serve.add_argument("request", nargs=argparse.REMAINDER)
    serve.set_defaults(func=None)
    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    environ = os.environ
    if argv and argv[0] == "serve":
        return serve_main(argv[1:], environ)
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args, environ)
    except ConfigError as error:
        emit(str(error))
        return EXIT_CONFIG
    except PeerUnavailable as error:
        emit(str(error))
        return EXIT_UNREACHABLE
    except PeerBusy as error:
        emit(str(error))
        return EXIT_BUSY
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
