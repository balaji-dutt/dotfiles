def validate_slug(value: str) -> str:
    if not SLUG_RE.match(value) or ".." in value:
        raise Refused(f"invalid slug {value!r}")
    return value


def validate_sha(value: str) -> str:
    if not SHA_RE.match(value):
        raise Refused(f"invalid sha {value!r}")
    return value


def validate_relative_path(value: str) -> str:
    if not value or value.startswith("-") or value.startswith("/") or "\\" in value:
        raise ConfigError(f"invalid repo-relative path {value!r}")
    parts = value.split("/")
    if any(part in ("", ".", "..") for part in parts):
        raise ConfigError(f"invalid repo-relative path {value!r}")
    return value


def kernel_identity(path: str) -> tuple[str, str]:
    def run(flag: str) -> str:
        try:
            return subprocess.run(
                ["uname", flag],
                env={"PATH": path},
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            ).stdout.strip()
        except OSError:
            return ""

    return run("-s"), run("-r")


def serve_path(environ: dict[str, str] | os._Environ[str], home: str) -> str:
    entries = [entry for entry in environ.get("PATH", os.defpath).split(os.pathsep) if entry]
    data_home = environ.get("XDG_DATA_HOME") or f"{home}/.local/share"
    for directory in reversed((*PATH_PREPEND, f"{home}/.local/bin", f"{data_home}/mise/shims")):
        if os.path.isdir(directory) and directory not in entries:
            entries.insert(0, directory)
    return os.pathsep.join(entries)


def wsl_interop_socket() -> str | None:
    for candidate in sorted(glob.glob("/run/WSL/*_interop")):
        try:
            if stat.S_ISSOCK(os.stat(candidate).st_mode):
                return candidate
        except OSError:
            continue
    return None


def scrubbed_environment(environ: dict[str, str] | os._Environ[str], platform: str) -> dict[str, str]:
    home = environ.get("HOME") or str(Path.home())
    env = {
        "PATH": serve_path(environ, home),
        "HOME": home,
        "LANG": "C.UTF-8",
        "TERM": "dumb",
        "PEER_ENV": "1",
    }
    for name in ("USER", "LOGNAME", "SHELL", "TMPDIR"):
        if environ.get(name):
            env[name] = environ[name]
    if platform == "wsl2":
        env["WSL_DISTRO_NAME"] = environ.get("WSL_DISTRO_NAME") or "wsl2"
        interop = environ.get("WSL_INTEROP") or wsl_interop_socket()
        if interop:
            env["WSL_INTEROP"] = interop
    return env


class BusyError(Exception):
    """Another request holds the slug lock; exit 75."""


class Serve:
    def __init__(self, root: Path, environ: dict[str, str] | os._Environ[str], restricted: bool) -> None:
        self.root = root
        self.environ = environ
        self.restricted = restricted
        self.state = state_dir(environ)
        uname, kernel = kernel_identity(serve_path(environ, environ.get("HOME") or str(Path.home())))
        self.uname = uname
        self.kernel = kernel
        self.platform = platform_from_identity(uname, kernel)
        self.env = scrubbed_environment(environ, self.platform)

    def log(self, verb: str, args: list[str], code: int, started: float) -> None:
        try:
            self.state.mkdir(parents=True, exist_ok=True)
            with (self.state / "serve.log").open("a", encoding="utf-8") as handle:
                handle.write(
                    json.dumps(
                        {
                            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                            "client": (self.environ.get("SSH_CLIENT") or "").split(" ")[0],
                            "restricted": self.restricted,
                            "verb": verb,
                            "args": args,
                            "exit": code,
                            "seconds": round(time.monotonic() - started, 3),
                        },
                        sort_keys=True,
                    )
                    + "\n"
                )
        except OSError:
            pass

    def worktree(self, slug: str) -> Path:
        return self.root / f"{WORKTREE_PREFIX}{slug}"

    def git(self, *args: str, check: bool = True, cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
        result = subprocess.run(
            ["git", "-C", str(cwd or self.root), *args],
            env=self.env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if check and result.returncode != 0:
            raise Refused(f"git {' '.join(args)} failed: {result.stderr.strip()}")
        return result

    def lock(self, slug: str):
        import fcntl

        self.state.mkdir(parents=True, exist_ok=True)
        handle = open(self.state / f"lock-{slug}", "a+", encoding="utf-8")
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            handle.close()
            raise BusyError(f"{WORKTREE_PREFIX}{slug} is busy with another request")
        return handle

    # verbs -------------------------------------------------------------

    def identity(self, args: list[str]) -> int:
        if args:
            raise Refused("identity takes no arguments")
        tools = {tool: shutil.which(tool, path=self.env["PATH"]) is not None for tool in REMOTE_TOOLS}
        payload = {
            "protocol": PROTOCOL,
            "uname": self.uname,
            "kernel": self.kernel,
            "platform": self.platform,
            "restricted": self.restricted,
            "tools": tools,
            "repo": str(self.root),
        }
        print(IDENTITY_MARKER + json.dumps(payload, sort_keys=True), flush=True)
        return EXIT_OK

    def receive_pack(self, args: list[str]) -> int:
        with tempfile.TemporaryDirectory(prefix="peer-env-hooks-") as hooks:
            hook = Path(hooks) / "pre-receive"
            hook.write_text(
                "#!/bin/sh\n"
                "rc=0\n"
                "while read -r old new ref; do\n"
                "  case \"$ref\" in\n"
                f"    {REF_NAMESPACE}*)\n"
                f"      rest=${{ref#{REF_NAMESPACE}}}\n"
                "      case \"$rest\" in *..*|*/*) rc=1 ;; esac\n"
                f"      printf '%s' \"$rest\" | grep -Eq '{SLUG_PATTERN}' || rc=1\n"
                "      ;;\n"
                "    *) rc=1 ;;\n"
                "  esac\n"
                "  if [ \"$rc\" -ne 0 ]; then\n"
                f"    echo \"{SCRIPT_NAME} serve: refused: ref $ref is outside {REF_NAMESPACE}\" >&2\n"
                "    exit 1\n"
                "  fi\n"
                "done\n"
                "exit 0\n",
                encoding="utf-8",
            )
            hook.chmod(0o755)
            result = subprocess.run(
                ["git", "-c", f"core.hooksPath={hooks}", "receive-pack", str(self.root)],
                env=self.env,
                check=False,
            )
        return result.returncode

    def prepare(self, args: list[str]) -> int:
        if len(args) != 2:
            raise Refused("prepare takes <slug> <sha>")
        slug = validate_slug(args[0])
        sha = validate_sha(args[1])
        ref = self.git("rev-parse", "--verify", "--quiet", f"{REF_NAMESPACE}{slug}", check=False)
        if ref.returncode != 0 or ref.stdout.strip() != sha:
            raise Refused(f"{sha} is not {REF_NAMESPACE}{slug}; publish it first")
        worktree = self.worktree(slug)
        with self.lock(slug):
            if (worktree / ".git").exists():
                self.git("checkout", "--quiet", "--detach", "--force", sha, cwd=worktree)
                self.git("clean", "-fdq", cwd=worktree)
            else:
                (self.root / "worktrees").mkdir(exist_ok=True)
                self.git("worktree", "prune")
                self.git("worktree", "add", "--quiet", "--detach", str(worktree), sha)
        return EXIT_OK

    def exec(self, args: list[str]) -> int:
        if len(args) < 2:
            raise Refused("exec takes <slug> audit|test ...")
        slug = validate_slug(args[0])
        worktree = self.worktree(slug)
        if not (worktree / ".git").exists():
            raise Refused(f"{WORKTREE_PREFIX}{slug} is not prepared")
        kind, rest = args[1], args[2:]
        if kind == "audit":
            if not rest:
                raise Refused("audit needs at least one repo-relative path")
            paths = []
            for value in rest:
                try:
                    validate_relative_path(value)
                except ConfigError as error:
                    raise Refused(str(error))
                if not (worktree / value).exists():
                    raise Refused(f"{value} does not exist in the snapshot")
                paths.append(value)
            commands = [["./assets/cz-audit.sh", "check", path] for path in paths]
            scan_errors = True
        elif kind == "test":
            if not rest or rest[0] not in SUITES:
                raise Refused(f"test needs a suite: {', '.join(SUITES)}")
            extra = rest[1:]
            if extra not in ([], ["--require-capabilities"]):
                raise Refused("test accepts only --require-capabilities")
            commands = [["./assets/run-tests.sh", rest[0], *extra]]
            scan_errors = False
        else:
            raise Refused(f"unknown exec kind {kind!r}")
        with self.lock(slug):
            exit_code = EXIT_OK
            for command in commands:
                code = self.run_streamed(command, worktree, scan_errors)
                if code != EXIT_OK and exit_code == EXIT_OK:
                    exit_code = code
            return exit_code

    def run_streamed(self, command: list[str], cwd: Path, scan_errors: bool) -> int:
        process = subprocess.Popen(
            command,
            cwd=cwd,
            env=self.env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
            start_new_session=True,
        )
        timed_out = threading.Event()

        def terminate(sig: int) -> None:
            timed_out.set()
            try:
                os.killpg(process.pid, sig)
            except OSError:
                pass

        timers = (
            threading.Timer(DEFAULT_RUN_TIMEOUT, terminate, (signal.SIGTERM,)),
            threading.Timer(DEFAULT_RUN_TIMEOUT + 10, terminate, (signal.SIGKILL,)),
        )
        for timer in timers:
            timer.start()
        saw_error = False
        try:
            assert process.stdout is not None
            for line in process.stdout:
                if scan_errors and line.startswith("ERROR:"):
                    saw_error = True
                sys.stdout.write(line)
                sys.stdout.flush()
            code = process.wait()
        finally:
            for timer in timers:
                timer.cancel()
            if process.poll() is None:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except OSError:
                    pass
                process.wait()
        if timed_out.is_set():
            print(f"{SCRIPT_NAME} serve: timed out after {DEFAULT_RUN_TIMEOUT}s", file=sys.stderr)
            return EXIT_TIMEOUT
        if code == 0 and saw_error:
            return EXIT_FAILED
        return code

    def remove(self, args: list[str]) -> int:
        if len(args) != 1:
            raise Refused("remove takes <slug>")
        slug = validate_slug(args[0])
        with self.lock(slug):
            worktree = self.worktree(slug)
            if worktree.exists():
                self.git("worktree", "remove", "--force", str(worktree))
            self.git("update-ref", "-d", f"{REF_NAMESPACE}{slug}", check=False)
        return EXIT_OK

    def clean(self, args: list[str]) -> int:
        if args:
            raise Refused("clean takes no arguments")
        for path in sorted(self.root.glob(f"{WORKTREE_PREFIX}*")):
            if path.is_dir():
                self.git("worktree", "remove", "--force", str(path), check=False)
                if path.exists():
                    shutil.rmtree(path, ignore_errors=True)
        self.git("worktree", "prune", check=False)
        refs = self.git("for-each-ref", "--format=%(refname)", REF_NAMESPACE, check=False)
        for ref in refs.stdout.split():
            self.git("update-ref", "-d", ref, check=False)
        return EXIT_OK


def parse_request(argv_rest: list[str], environ: dict[str, str] | os._Environ[str]) -> tuple[list[str], bool]:
    original = environ.get("SSH_ORIGINAL_COMMAND")
    if original is None:
        return list(argv_rest), False
    try:
        tokens = shlex.split(original)
    except ValueError as error:
        raise Refused(f"unparseable command: {error}")
    if "serve" in tokens:
        return tokens[tokens.index("serve") + 1 :], True
    if tokens and tokens[0] == "git-receive-pack":
        return [PROTOCOL, "receive-pack", *tokens[1:]], True
    raise Refused("only peer-env serve requests are accepted on this key")


def serve_main(argv_rest: list[str], environ: dict[str, str] | os._Environ[str]) -> int:
    started = time.monotonic()
    root = Path(__file__).resolve().parents[1]
    server: Serve | None = None
    verb = "?"
    args: list[str] = []
    try:
        request, restricted = parse_request(argv_rest, environ)
        server = Serve(root, environ, restricted)
        if not request or request[0] != PROTOCOL:
            raise Refused(f"protocol must be {PROTOCOL}")
        if len(request) < 2:
            raise Refused("missing verb")
        verb, args = request[1], request[2:]
        handlers = {
            "identity": server.identity,
            "receive-pack": server.receive_pack,
            "prepare": server.prepare,
            "exec": server.exec,
            "remove": server.remove,
            "clean": server.clean,
        }
        handler = handlers.get(verb)
        if handler is None:
            raise Refused(f"unknown verb {verb!r}")
        code = handler(args)
    except Refused as error:
        print(f"{SCRIPT_NAME} serve: refused: {error}", file=sys.stderr)
        code = EXIT_CONFIG
    except BusyError as error:
        print(f"{SCRIPT_NAME} serve: busy: {error}", file=sys.stderr)
        code = EXIT_BUSY
    except Exception as error:  # noqa: BLE001 - every request must be logged
        try:
            print(f"{SCRIPT_NAME} serve: failed: {error}", file=sys.stderr)
        except OSError:
            pass
        code = EXIT_FAILED
    if server is not None:
        server.log(verb, args, code, started)
    return code


