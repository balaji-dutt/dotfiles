# advisory by default
CZ_AUDIT_STRICT=0
CZ_AUDIT_SHOW=0

# Enforce a specific advisory check (uncomment to enable)
# CZ_AUDIT_STRICT_SHELLCHECK=1
# CZ_AUDIT_STRICT_ANSIBLE_LINT=1
# CZ_AUDIT_STRICT_YAML=1
# CZ_AUDIT_STRICT_TOML=1
# CZ_AUDIT_STRICT_CHEZMOI_DOCTOR=1

# Show full output for a specific check even when it is advisory (uncomment to enable)
# CZ_AUDIT_SHOW_SHELLCHECK=1
# CZ_AUDIT_SHOW_ANSIBLE_LINT=1
# CZ_AUDIT_SHOW_YAML=1
# CZ_AUDIT_SHOW_TOML=1
# CZ_AUDIT_SHOW_CHEZMOI_DOCTOR=1