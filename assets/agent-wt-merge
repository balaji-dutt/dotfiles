    return pipeline_module().cleanup_main_ci_ref(repo_root, runtime, remote_ref, main_sha)


def ensure_main_ci_state_unchanged(
    repo_root: Path,
    runtime: PipelineRuntime,
    main_branch: str,
    main_sha: str,
    origin_sha: str,
    remote_ref: str | None,
) -> None:
    evidence = (
        f"; temporary CI ref {remote_ref} was retained"
        if remote_ref is not None
        else "; no temporary CI ref was published"
    )
    if current_branch(repo_root) != main_branch or git_output(repo_root, ["rev-parse", "HEAD"]) != main_sha:
        die(f"local {main_branch} moved while CI was checked{evidence}")
    if dirty_paths(repo_root):
        die(f"main worktree became dirty while CI was checked{evidence}")
    current_remote_main = remote_ref_sha(repo_root, runtime.remote_name, runtime.guarded_ref)
    if current_remote_main != origin_sha:
        die(f"{runtime.remote_name}/{main_branch} moved while CI was checked{evidence}")


def cmd_prepare_main_ci(raw_args: list[str], *, helper: HelperProvenance) -> int:
    parser = argparse.ArgumentParser(prog=f"{SCRIPT_NAME} prepare-main-ci")
    parser.add_argument("--poll-interval", type=positive_seconds, default=15)
    parser.add_argument("--poll-timeout", type=positive_seconds, default=900)
    add_local_helper_argument(parser)
    parsed = parser.parse_args(raw_args)
    maximum_checks = max(1, math.ceil(parsed.poll_timeout / parsed.poll_interval))
    if maximum_checks > 60:
        die(
            "poll settings would require more than 60 checks; increase "
            "--poll-interval or reduce --poll-timeout"
        )

    repo_root = resolve_repo_root()
    main_branch = resolve_main_branch(repo_root)
    branch = current_branch(repo_root)
    if branch != main_branch:
        die(f"prepare-main-ci must run from attached {main_branch}; current branch is {branch}")
    main_worktree = resolve_main_worktree(repo_root, main_branch)
    if main_worktree != repo_root:
        die(f"prepare-main-ci must run from the {main_branch} worktree: {main_worktree}")
    runtime = load_pipeline_runtime(helper, main_branch)
    dirty = dirty_paths(repo_root)
    if dirty:
        die("main worktree is dirty; refusing to publish CI evidence:\n" + "\n".join(dirty))
    fetch_ok, fetch_message = maybe_fetch(repo_root, runtime.remote_name)
    if not fetch_ok:
        die(
            f"git fetch from {runtime.remote_name} failed before main CI publication: "
            f"{fetch_message or 'unknown error'}"
        )
    origin_ref, origin_sha, behind_count, ahead_count = origin_status(
        repo_root, main_branch, runtime.remote_name
    )
    if origin_ref is None or origin_sha is None:
        die(f"cannot verify advertised {runtime.remote_name}/{main_branch}")
    if behind_count:
        die(
            f"local {main_branch} is {behind_count} commit(s) behind {origin_ref}; "
            "refusing rewritten-main CI recovery"
        )
    if not ahead_count:
        die(f"local {main_branch} has no unpushed commits ahead of {origin_ref}")
    main_sha = git_output(repo_root, ["rev-parse", "HEAD"])
    if not is_ancestor(repo_root, origin_sha, main_sha):
        die(f"local {main_branch} has diverged from {origin_ref}; refusing CI publication")
    advertised_main_sha = remote_ref_sha(
        repo_root, runtime.remote_name, runtime.guarded_ref
    )
    if advertised_main_sha != origin_sha:
        die(
            f"{runtime.remote_name}/{main_branch} moved after fetch: advertised "
            f"{advertised_main_sha or 'nothing'}, expected {origin_sha}; rerun the command"
        )

    ci_ref = main_ci_remote_ref(main_branch, main_sha)
    initial = check_pipeline(repo_root, runtime, main_sha, ci_ref)
    print_workflow_evidence(initial)
    if getattr(runtime, "provider", None) == "github" and initial["outcome"] in {"terminal", "error"}:
        die(f"main CI blocked for {main_sha}: {initial.get('detail', 'no detail')}; no ref was published")
    if initial["outcome"] == "success":
        ensure_main_ci_state_unchanged(
            repo_root,
            runtime,
            main_branch,
            main_sha,
            origin_sha,
            None,
        )
        persist_evidence(repo_root, runtime, initial, before_sha=origin_sha, landing_sha=main_sha)
        print(
            f"PASS main CI: {runtime.required_job} already succeeded for {main_sha}; "
            "no temporary ref was published"
        )
        return 0

    remote_ref, published = publish_main_ci_ref(repo_root, runtime, main_branch, main_sha)
    action = "Published" if published else "Reusing"
    print(
        f"{action} rewritten main at {main_sha} through "
        f"{runtime.remote_name}/{remote_ref.removeprefix('refs/heads/')}"
    )
    if initial["outcome"] == "bypass":
        print(
            "BYPASS main CI: override is active. The temporary CI ref is retained, "
            "and main/tags were not pushed."
        )
        return 0

    deadline = time.monotonic() + parsed.poll_timeout
    latest = initial
    for attempt in range(1, maximum_checks + 1):
        if attempt > 1 and time.monotonic() >= deadline:
            break
        latest = check_pipeline(repo_root, runtime, main_sha, ci_ref)
        print_workflow_evidence(latest)
        outcome = latest["outcome"]
        detail = str(latest.get("detail") or "no detail")
        if outcome == "success":
            break
        if outcome == "bypass":
            print(
                "BYPASS main CI: override became active while polling. The temporary "
                "CI ref is retained, and main/tags were not pushed."
            )
            return 0
        if outcome in {"terminal", "error"}:
            die(
                f"main CI blocked for {main_sha}: {detail}; temporary CI ref "
                f"{remote_ref} was retained and main/tags were not pushed"
            )
        print(
            f"Waiting for {runtime.required_job} on rewritten main {main_sha} "
            f"({attempt}/{maximum_checks}): {detail}"
        )
        if attempt < maximum_checks:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            time.sleep(min(parsed.poll_interval, remaining))
    if latest.get("outcome") != "success":
        remaining = deadline - time.monotonic()
        if remaining > 0:
            time.sleep(remaining)
        detail = str(latest.get("detail") or "no successful job observed")
        die(
            f"timed out after {parsed.poll_timeout}s waiting for {runtime.required_job} "
            f"on {main_sha}: {detail}; temporary CI ref {remote_ref} was retained and "
            "main/tags were not pushed"
        )

    ensure_main_ci_state_unchanged(
        repo_root,
        runtime,
        main_branch,
        main_sha,
        origin_sha,
        remote_ref,
    )
    persist_evidence(repo_root, runtime, latest, before_sha=origin_sha, landing_sha=main_sha)
    cleanup = cleanup_main_ci_ref(repo_root, runtime, remote_ref, main_sha)
    if not cleanup.get("cleaned"):
        print(
            f"PARTIAL main CI: {runtime.required_job} succeeded for {main_sha}, but temporary "
            f"CI ref cleanup failed: {cleanup.get('reason', 'unknown reason')}"
        )
        print("- Main/tags pushed: no")
        return 1
    qualifier = "already absent" if cleanup.get("already_absent") else "deleted"
    print(f"PASS main CI: {runtime.required_job} succeeded for {main_sha}")
    print(f"- Temporary CI ref: {qualifier} ({remote_ref})")
    print("- Main/tags pushed: no")
    return 0


SEQUENCER_HEADS = ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "REBASE_HEAD")


def sequencer_in_progress(worktree: Path) -> bool:
    return any(
        git_returncode(worktree, ["rev-parse", "-q", "--verify", f"{name}^{{commit}}"]) == 0
        for name in SEQUENCER_HEADS
    )


def ensure_updated_main_provides_helper(ctx: MergeContext) -> None:
    if ctx.origin_ref is None:
        return
    for relative_path in HELPER_RELATIVE_PATHS:
        spec = f"{ctx.origin_ref}:{relative_path.as_posix()}"
        if git_returncode(ctx.main_worktree, ["cat-file", "-e", spec]) == 0:
            return
    advertised = " or ".join(path.as_posix() for path in HELPER_RELATIVE_PATHS)
    die(
        f"refusing to update {ctx.main_branch}: {ctx.origin_ref} carries no merge helper at "
        f"{advertised}; {ctx.main_branch} was not moved and {ctx.feature_branch} was not merged"
    )


def restore_main_after_failed_update(
    ctx: MergeContext,
    *,
    before_sha: str,
    updated_sha: str,
) -> tuple[bool, str]:
    """Undo this run's --update-main fast-forward. Never raises."""
    recovery = f'git -C "{ctx.main_worktree}" reset --hard {before_sha}'
    try:
        head = git_output(ctx.main_worktree, ["rev-parse", "HEAD"])
        if head == before_sha:
            return True, f"{ctx.main_branch} was not moved"
        if head != updated_sha:
            return False, (
                f"{ctx.main_branch} is at {head}, not the {updated_sha} this run created; "
                f"left it untouched. Inspect it, then run: {recovery}"
            )
        if git_returncode(ctx.main_worktree, ["merge-base", "--is-ancestor", before_sha, updated_sha]) != 0:
            return False, (
                f"{before_sha} is not an ancestor of {updated_sha}; left {ctx.main_branch} untouched. "
                f"Inspect it, then run: {recovery}"
            )
        if sequencer_in_progress(ctx.main_worktree):
            abort = run_git(ctx.main_worktree, ["merge", "--abort"], check=False)
            if abort.returncode != 0 or sequencer_in_progress(ctx.main_worktree):
                detail = (abort.stderr or abort.stdout or "git merge --abort failed").strip()
                return False, (
                    f"a merge is in progress in {ctx.main_worktree} and could not be aborted ({detail}); "
                    f"left {ctx.main_branch} at {updated_sha}. Finish or abort it, then run: {recovery}"
                )
            if git_output(ctx.main_worktree, ["rev-parse", "HEAD"]) != updated_sha:
                return False, (
                    f"aborting the merge in {ctx.main_worktree} did not return {ctx.main_branch} to "
                    f"{updated_sha}; left it untouched. Inspect it, then run: {recovery}"
                )
        dirty = dirty_paths(ctx.main_worktree)
        if dirty:
            return False, (
                f"{ctx.main_worktree} is dirty, so {ctx.main_branch} was left at {updated_sha} rather "
                "than discarding:\n" + "\n".join(dirty) + f"\nThen run: {recovery}"
            )
        reset = run_git(ctx.main_worktree, ["reset", "--hard", "--quiet", before_sha], check=False)
        if reset.returncode != 0:
            detail = (reset.stderr or reset.stdout or "git reset --hard failed").strip()
            return False, f"could not restore {ctx.main_branch}: {detail}. Run: {recovery}"
        if git_output(ctx.main_worktree, ["rev-parse", "HEAD"]) != before_sha or dirty_paths(ctx.main_worktree):
            return False, f"{ctx.main_branch} did not return cleanly to {before_sha}. Run: {recovery}"
        return True, f"restored {ctx.main_branch} to {before_sha}"
    except (AgentWtMergeError, OSError, subprocess.SubprocessError) as exc:
        return False, f"rollback could not be completed ({exc}). Run: {recovery}"


def update_main_and_run_updated_helper(
    ctx: MergeContext,
    argv: list[str],
    *,
    remote_name: str,
    expected_contract: tuple[str | None, bytes],
    before_sha: str,
) -> int:
    ensure_updated_main_provides_helper(ctx)
    update_main_from_origin(ctx, remote_name)
    updated_sha = git_output(ctx.main_worktree, ["rev-parse", "HEAD"])

    # Every escape from here has to reach the rollback below, not just the
    # helper's own error type: an interrupt or an unspawnable git would otherwise
    # leave main on the fast-forward with a traceback instead of a recovery path.
    try:
        status = reexec_after_main_update(ctx, argv, expected_contract=expected_contract)
        # A completed merge moves main off the fast-forward it just landed on.
        # Anything else means the feature was not merged, whatever the exit code.
        if git_output(ctx.main_worktree, ["rev-parse", "HEAD"]) != updated_sha:
            return status
    except (AgentWtMergeError, KeyboardInterrupt, OSError, subprocess.SubprocessError) as exc:
        cause = str(exc) or f"interrupted before {ctx.feature_branch} was merged"
    else:
        cause = f"the updated {ctx.main_branch} helper exited {status} without merging {ctx.feature_branch}"

    restored, detail = restore_main_after_failed_update(
        ctx,
        before_sha=before_sha,
        updated_sha=updated_sha,
    )
    if restored:
        die(f"{cause}; {detail}. {ctx.feature_branch} was not merged")
    die(f"{cause}. MANUAL RECOVERY REQUIRED: {detail}. {ctx.feature_branch} was not merged")


def update_main_from_origin(ctx: MergeContext, remote_name: str) -> None:
    if ctx.origin_ref is None:
        die(
            f"cannot update {ctx.main_branch}: "
            f"{remote_name}/{ctx.main_branch} does not exist"
        )
    fetch_ok, fetch_message = maybe_fetch(ctx.main_worktree, remote_name)
    if not fetch_ok:
        die(f"git fetch failed before updating {ctx.main_branch}: {fetch_message or 'unknown error'}")
    result = run_git(ctx.main_worktree, ["merge", "--ff-only", ctx.origin_ref], check=False)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "git merge --ff-only failed").strip()
        die(f"could not fast-forward {ctx.main_branch} from {ctx.origin_ref}: {detail}")


def reexec_after_main_update(ctx: MergeContext, argv: list[str], *, expected_contract: tuple[str | None, bytes]) -> int:
    canonical = canonical_helper_path(ctx.main_worktree)
    if canonical is None:
        die(f"updated {ctx.main_branch}, but it no longer provides an executable merge helper")
    dirty = helper_dirty_paths(ctx.main_worktree, canonical)
    if dirty:
        die(
            f"updated {ctx.main_branch}, but its helper path is dirty:\n"
            + "\n".join(dirty)
        )
    if ci_contract(canonical) != expected_contract:
        die(
            f"updated {ctx.main_branch}, but helper mode changed or its evidence contract changed. "
            "Rediscover helper capabilities and obtain approval before retrying"
        )
    next_argv = [
        item for item in argv if item not in {"--update-main", LOCAL_HELPER_FLAG}
    ]
    return exec_helper(canonical, next_argv, after_main_update=True)


def ensure_merge_preconditions(
    ctx: MergeContext,
    *,
    ci_gated: bool,
    remote_name: str,
    update_main: bool,
) -> MergeContext:
    if ci_gated and (not ctx.fetch_attempted or not ctx.fetch_ok):
        die(
            f"git fetch from {remote_name} failed before merge: "
            f"{ctx.fetch_message or 'unknown error'}"
        )
    if ctx.main_dirty_paths:
        paths = "\n".join(ctx.main_dirty_paths)
        die(f"main worktree is dirty; refusing to merge:\n{paths}")
    if ctx.origin_behind_count and ctx.origin_behind_count > 0:
        if ctx.origin_ahead_count:
            die(f"{ctx.main_branch} has diverged from {ctx.origin_ref}; reconcile it before merging")
        if not update_main:
            die(
                f"{ctx.main_branch} is behind {ctx.origin_ref} by {ctx.origin_behind_count} commit(s); "
                "rerun with --update-main only after user approval"
            )
    if ctx.commits_ahead == 0:
        die(f"{ctx.feature_branch} has no commits ahead of {ctx.main_branch}")
    if ci_gated and ctx.origin_sha is None:
        die(f"cannot verify advertised {remote_name}/{ctx.main_branch}")
    return ctx


def commit_wrapper(actor: str) -> list[str]:
    name = "oc-commit" if actor == "opencode" else "cc-commit"
    if os.name == "nt":
        pwsh = shutil.which("pwsh")
        script = next(
            (candidate for directory in os.get_exec_path()
             if (candidate := Path(directory) / f"{name}.ps1").is_file()),
            None,
        )
        if not pwsh or script is None:
            die(f"no PowerShell commit wrapper available for {actor} (pwsh and {name}.ps1 required)")
        return [pwsh, "-NoProfile", "-Command", str(script)]
    executable = shutil.which(name)
    if not executable:
        die(f"no commit wrapper available for {actor}: {name}")
    return [executable]


def merge_failure_message(ctx: MergeContext, result: subprocess.CompletedProcess[str]) -> str:
    detail = (result.stderr or result.stdout or "git merge failed").strip()
    conflicts = run_git(ctx.main_worktree, ["diff", "--name-only", "--diff-filter=U"], check=False)
    conflict_paths = [line for line in conflicts.stdout.splitlines() if line]
    if conflict_paths:
        detail = f"{detail}\nconflicted paths:\n" + "\n".join(conflict_paths)
    return detail


CLOSE_REFUSALS = (
    ("open child issue(s)", "refused by Beads close policy: the issue has open children"),
    ("cannot close issue with open children", "refused by Beads close policy: the issue has open children"),
    ("cannot close blocked issue", "refused by Beads close policy: the issue has a live blocker"),
    ("reclaim or use --force", "refused by Beads: the issue is assigned to another actor"),
)


def classify_close_refusal(output: str) -> str | None:
    for marker, reason in CLOSE_REFUSALS:
        if marker in output:
            return reason
    return None


def close_beads_issue(
    *,
    ctx: MergeContext,
    actor: str,
    issue_id: str | None,
    before_sha: str,
    after_sha: str,
    preflight: dict[str, Any] | None = None,
) -> dict[str, Any]:
    if issue_id is None:
        return {"requested": False, "closed": False, "reason": "not requested"}

    spec = ACTORS[actor]
    state_file = ctx.original_worktree / ".beads" / spec["state_file"]
    state = inspect_beads_tracking(
        actor=actor, issue_id=issue_id, feature_branch=ctx.feature_branch,
        original_worktree=ctx.original_worktree, repo_root=ctx.original_worktree,
        target_ref=after_sha,
    )
    if (not state["matches"] or not preflight
            or state.get("source") != preflight.get("source")
            or state.get("anchor") != preflight.get("anchor")
            or (state["source"] == "file" and state_identity(state_file) != preflight.get("identity"))
            or not is_ancestor(ctx.main_worktree, ctx.feature_sha, after_sha)):
        return {
            "requested": True,
            "closed": False,
            "state_file": str(state_file),
            "reason": "tracking anchor did not validate after merge",
            "problems": state["problems"],
        }

    started_sha = str(state["started_sha"])
    merged_shas = list_range(
        ctx.main_worktree,
        f"{started_sha}..{after_sha}",
        "%h",
        exclude_refs=(before_sha,),
    )
    if not merged_shas:
        merged_shas = list_range(ctx.main_worktree, f"{before_sha}..{after_sha}", "%h")
    reason_shas = " ".join(merged_shas)
    if not reason_shas:
        reason_shas = git_output(ctx.main_worktree, ["rev-parse", "--short", after_sha])
    reason = f"Fixed with commit(s) {reason_shas}"
    bd_command = shutil.which("bd")
    if bd_command is None:
        return {
            "requested": True,
            "closed": False,
            "state_file": str(state_file),
            "reason": "bd close failed",
            "stderr": "no bd executable was found in PATH",
        }
    try:
        close_argv = ["bd", "close", issue_id, "--reason", reason, "--actor", spec["name"]]
        result = subprocess.run(
            [bd_command, *close_argv[1:]],
            cwd=str(ctx.original_worktree),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        return {
            "requested": True,
            "closed": False,
            "state_file": str(state_file),
            "reason": "bd close failed",
            "stderr": str(exc),
        }
    if result.returncode != 0:
        failure = {
            "requested": True,
            "closed": False,
            "state_file": str(state_file),
            "reason": "bd close failed",
            "stdout": result.stdout.strip(),
            "stderr": result.stderr.strip(),
        }
        refusal = classify_close_refusal(f"{result.stdout}\n{result.stderr}")
        if refusal:
            failure["reason"] = refusal
            failure["next_step"] = (
                f"resolve it, then rerun `{shlex.join(close_argv)}`; this helper never passes --force"
            )
        return failure
    readback, read_error = read_beads_issue(ctx.original_worktree, issue_id)
    if read_error or readback is None or readback.get("status") != "closed" or readback.get("close_reason") != reason:
        return {"requested": True, "closed": False, "source": state["source"],
                "reason": "bd close readback could not confirm status and reason",
                "problems": [read_error] if read_error else []}
    if state["source"] == "note":
        notes = readback.get("notes", "")
        try:
            anchors = [json.loads(line.removeprefix("beads-work anchor: ")) for line in notes.splitlines() if line.startswith("beads-work anchor:")]
        except (AttributeError, ValueError):
            anchors = []
        if anchors != [preflight["anchor"]]:
            return {"requested": True, "closed": False, "source": "note",
                    "reason": "bd close readback did not preserve the tracking anchor"}
        return {"requested": True, "closed": True, "source": "note", "reason": reason}
    if state_identity(state_file) != preflight.get("identity"):
        return {"requested": True, "closed": True, "source": "file", "reason": reason,
                "warning": "state file changed after closure; it was retained"}
    try:
        state_file.unlink()
    except OSError as exc:
        return {
            "requested": True,
            "closed": True,
            "state_file": str(state_file),
            "reason": reason,
            "warning": f"could not remove state file: {exc}",
        }
    return {"requested": True, "closed": True, "state_file": str(state_file), "reason": reason}


def state_identity(state_file: Path) -> tuple[int, int, int, int] | None:
    try:
        meta = state_file.lstat()
    except OSError:
        return None
    return meta.st_dev, meta.st_ino, meta.st_mtime_ns, meta.st_size


def beads_partial_failure(beads: dict[str, Any]) -> bool:
    return bool(beads.get("requested")) and (
        not beads.get("closed") or bool(beads.get("warning"))
    )


def cleanup_remote_feature(
    ctx: MergeContext,
    runtime: PipelineRuntime,
    feature_sha: str,
    pipeline_outcome: str,
) -> dict[str, Any]:
    remote_ref = feature_remote_ref(ctx.feature_branch)
    if pipeline_outcome != "success":
        return {
            "requested": False,
            "cleaned": False,
            "retained": True,
            "remote_ref": remote_ref,
            "reason": "pipeline guard was bypassed; remote evidence retained",
        }

    result: dict[str, Any] = {
        "requested": True,
        "cleaned": False,
        "retained": True,
        "remote_ref": remote_ref,
        "expected_sha": feature_sha,
    }
    try:
        advertised_sha = remote_ref_sha(ctx.original_worktree, runtime.remote_name, remote_ref)
    except (AgentWtMergeError, OSError) as exc:
        result["reason"] = str(exc)
        return result
    result["advertised_sha"] = advertised_sha
    if advertised_sha is None:
        result.update(
            {
                "cleaned": True,
                "retained": False,
                "already_absent": True,
                "reason": "remote feature branch was already absent",
            }
        )
        return result
    if advertised_sha != feature_sha:
        result["reason"] = (
            f"remote feature moved to {advertised_sha}; exact-lease deletion was not attempted"
        )
        return result

    try:
        deletion = run_git(
            ctx.original_worktree,
            [
                "push",
                "--porcelain",
                f"--force-with-lease={remote_ref}:{feature_sha}",
                "--",
                runtime.remote_name,
                f":{remote_ref}",
            ],
            check=False,
        )
    except OSError as exc:
        result["reason"] = f"lease-protected remote deletion failed: {exc}"
        return result
    if deletion.returncode != 0:
        result["reason"] = (
            deletion.stderr or deletion.stdout or "lease-protected remote deletion failed"
        ).strip()
        return result
    try:
        remaining_sha = remote_ref_sha(ctx.original_worktree, runtime.remote_name, remote_ref)
    except (AgentWtMergeError, OSError) as exc:
        result["reason"] = f"deletion ran but verification failed: {exc}"
        return result
    if remaining_sha is not None:
        result["advertised_sha"] = remaining_sha
        result["reason"] = (
            f"deletion verification found {remote_ref} at {remaining_sha}; no second deletion attempted"
        )
        return result
    result.update(
        {
            "cleaned": True,
            "retained": False,
            "advertised_sha": None,
            "reason": "exact-lease deletion succeeded",
        }
    )
    return result


def remote_cleanup_partial_failure(remote_cleanup: dict[str, Any]) -> bool:
    return bool(remote_cleanup.get("requested")) and not bool(
        remote_cleanup.get("cleaned")
    )


def persist_evidence(repo_root: Path, runtime: PipelineRuntime, result: dict[str, Any], **landing) -> str | None:
    if getattr(runtime, "provider", None) != "github":
        return None
    shared = pipeline_module()
    try:
        return shared.save_evidence(repo_root, runtime, result, **landing)
    except (shared.PipelineRuntimeError, OSError) as exc:
        die(f"workflow evidence could not be recorded; remote evidence was retained: {exc}")


def print_cleanup(cleanup: dict[str, Any], *, after_merge: bool) -> None:
    if cleanup["action"] == "defer":
        print(f"- Cleanup deferred to {cleanup['manager']}: {cleanup['note']}")
        return
    qualifier = "not run; " if after_merge else ""
    print(f"- Cleanup suggestion ({qualifier}ask before running; run from workdir below):")
    print(f"  workdir: {cleanup['workdir']}")
    for command in cleanup["commands"]:
        print(f"  command: {command}")


def print_merge_report(report: dict[str, Any]) -> None:
    print(f"Merged {report['feature_branch']} into {report['main_branch']}")
    helper = report["helper"]
    print(f"- Helper: {helper['path']} ({helper['state']})")
    if helper.get("delegated_from"):
        print(f"  - Delegated from: {helper['delegated_from']}")
    if helper.get("reexecuted_after_main_update"):
        print("  - Re-executed after main update: yes")
    print(f"- Merge type: {report['merge_type']}")
    print(f"- Merge mode: {report['mode']}")
    print(f"- Main SHA before: {report['main_sha_before'][:12]}")
    print(f"- Main SHA after: {report['main_sha_after'][:12]}")
    print(f"- Commits merged: {report['commits_merged']}")
    if report.get("merge_commit_author"):
        print(f"- Merge commit author: {report['merge_commit_author']}")
    pipeline = report["pipeline"]
    if pipeline is None:
        print("- Feature CI: not performed (local-only)")
        print("- Feature publication: not performed")
    else:
        print(
            f"- Feature CI: {pipeline['outcome']} "
            f"({pipeline.get('detail') or 'no detail'})"
        )
    if report["main_ci_required"]:
        print(
            f"- Main push requires successful exact-SHA CI for {report['main_sha_after']}. "
            "At batch end, run prepare-main-ci from the main worktree with approval if evidence "
            "is missing, then retry the original push separately. Later commits require new evidence."
        )
    if report["fetch_warning"]:
        print(f"- Fetch warning: {report['fetch_warning']}")
    if report.get("evidence_path"):
        print_workflow_evidence(pipeline)
        print(f"- Workflow evidence record: {report['evidence_path']}")
    if report.get("evidence_error"):
        print(f"- Partial failure: merge landed at {report['main_sha_after']}, but {report['evidence_error']}")
    remote_cleanup = report["remote_cleanup"]
    if pipeline is None:
        print("- Remote feature cleanup: not performed (local-only)")
    elif remote_cleanup.get("cleaned"):
        qualifier = "already absent" if remote_cleanup.get("already_absent") else "deleted"
        print(
            f"- Remote feature cleanup: {qualifier} "
            f"({report['remote_name']}/{report['feature_branch']})"
        )
    elif remote_cleanup.get("retained"):
        print(f"- Remote feature cleanup: retained ({remote_cleanup.get('reason', 'unknown reason')})")
    else:
        print(f"- Remote feature cleanup: not completed ({remote_cleanup.get('reason', 'unknown reason')})")
    beads = report["beads"]
    if beads.get("closed"):
        print(f"- Beads issue closed: yes ({report['close_beads']})")
        print(f"  - Close reason: {beads.get('reason', 'unknown')}")
        if beads.get("warning"):
            print(f"  - Warning: {beads['warning']}")
    elif beads.get("requested"):
        print(f"- Beads issue closed: no ({beads.get('reason', 'unknown reason')})")
        for problem in beads.get("problems", []):
            print(f"  - {problem}")
        if beads.get("stdout"):
            print(f"  - bd stdout: {beads['stdout']}")
        if beads.get("stderr"):
            print(f"  - bd stderr: {beads['stderr']}")
        if beads.get("next_step"):
            print(f"  - Next: {beads['next_step']}")
    else:
        print("- Beads issue closed: no (not requested)")
    print_cleanup(report["cleanup"], after_merge=True)
    print("- Main/tags pushed: no")
    if remote_cleanup_partial_failure(remote_cleanup):
        print(
            "Partial failure: Git merge succeeded, but lease-protected remote feature cleanup did not complete."
        )
    if beads_partial_failure(beads):
        if beads.get("closed"):
            print(
                "Partial failure: Git merge and Beads closure succeeded, but Beads state cleanup did not complete."
            )
        else:
            print("Partial failure: Git merge succeeded, but requested Beads closure did not complete.")


def add_local_helper_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        LOCAL_HELPER_FLAG,
        action="store_true",
        help="use this worktree's helper instead of delegating to main (requires prior approval)",
    )


def perform_merge(
    raw_args: list[str],
    *,
    merge_type: str,
    helper: HelperProvenance,
) -> int:
    parser = argparse.ArgumentParser(prog=f"{SCRIPT_NAME} {merge_type}")
    parser.add_argument("--actor", required=True, choices=tuple(ACTORS), help="agent identity for merge commits")
    parser.add_argument("--update-main", action="store_true", help="fast-forward main from origin/main before merging")
    parser.add_argument("--close-beads", metavar="ISSUE_ID", help="close a matching Beads issue after a successful merge")
    add_local_helper_argument(parser)
    if merge_type == "no-ff":
        parser.add_argument("-m", "--message", action="append", required=True, help="merge commit message paragraph")
    parsed = parser.parse_args(raw_args)

    full_argv = [merge_type, *raw_args]
    repo_root = resolve_repo_root()
    ci_gated = ci_enabled(helper.path)
    expected_contract = ci_contract(helper.path)
    runtime = load_pipeline_runtime(helper, resolve_main_branch(repo_root)) if ci_gated else None
    remote_name = runtime.remote_name if runtime else "origin"
    ctx = ensure_merge_preconditions(
        build_context(fetch=True, helper=helper, remote_name=remote_name, beads_issue=parsed.close_beads),
        ci_gated=ci_gated,
        remote_name=remote_name,
        update_main=parsed.update_main,
    )
    before_sha = ctx.main_sha
    feature_sha = ctx.feature_sha
    preflight = None
    if parsed.close_beads:
        preflight = ctx.beads[parsed.actor]
        if not preflight["matches"]:
            die(f"Beads tracking does not match {parsed.close_beads}: {'; '.join(preflight['problems'])}")
        if preflight["source"] == "file":
            preflight = {**preflight, "identity": state_identity(ctx.original_worktree / ".beads" / ACTORS[parsed.actor]["state_file"])}
    updating_main = bool(ctx.origin_behind_count and parsed.update_main)
    if not updating_main:
        if merge_type == "ff":
            if not ctx.fast_forward_possible:
                die("fast-forward is not possible; use the no-ff command after drafting a merge message")
        else:
            if ctx.fast_forward_possible:
                die("fast-forward is possible; use the ff command instead of creating a no-ff merge commit")

    pipeline_result = None
    if runtime is not None:
        require_remote_feature(ctx, runtime, feature_sha)
        pipeline_result = check_pipeline(ctx.original_worktree, runtime, feature_sha, feature_remote_ref(ctx.feature_branch))
        if pipeline_result["outcome"] not in {"success", "bypass"}:
            detail = str(pipeline_result.get("detail") or "no detail")
            die(f"feature CI blocked for {feature_sha}: {detail}; run prepare-ci and retry")

        advertised_main_sha = remote_ref_sha(
            ctx.original_worktree,
            runtime.remote_name,
            runtime.guarded_ref,
        )
        if advertised_main_sha != ctx.origin_sha:
            die(
                f"{runtime.remote_name}/{ctx.main_branch} moved after fetch: advertised "
                f"{advertised_main_sha or 'nothing'}, expected {ctx.origin_sha}; rerun the command"
            )
    if ctx.origin_behind_count and parsed.update_main:
        return update_main_and_run_updated_helper(
            ctx,
            full_argv,
            remote_name=remote_name,
            expected_contract=expected_contract,
            before_sha=before_sha,
        )

    if git_output(ctx.main_worktree, ["rev-parse", "HEAD"]) != before_sha or dirty_paths(ctx.main_worktree):
        die("main changed while merge evidence was inspected; feature was not merged")
    if ci_contract(helper.path) != expected_contract:
        die("pipeline evidence contract changed; rediscover capabilities before merging")
    if merge_type == "ff":
        result = run_git(ctx.main_worktree, ["merge", "--ff-only", feature_sha], check=False)
    else:
        wrapper = commit_wrapper(parsed.actor)
        result = run_git(ctx.main_worktree, ["merge", "--no-ff", "--no-commit", feature_sha], check=False)
    if result.returncode != 0:
        die(merge_failure_message(ctx, result))
    if merge_type == "no-ff":
        commit_args = []
        for paragraph in parsed.message:
            commit_args.extend(["-m", paragraph])
        if os.name == "nt":
            def quote(value: str) -> str:
                return "'" + value.replace("'", "''") + "'"

            script_command = "& " + quote(wrapper[-1]) + " " + " ".join(quote(value) for value in commit_args)
            commit_args = [*wrapper[:-1], script_command]
        else:
            commit_args = [*wrapper, *commit_args]
        try:
            committed = subprocess.run(
                commit_args, cwd=str(ctx.main_worktree), check=False, text=True,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            )
        except OSError as exc:
            die(f"commit wrapper could not start: {exc}; merge remains pending in {ctx.main_worktree}")
        if committed.returncode != 0:
            detail = (committed.stderr or committed.stdout or "commit wrapper failed").strip()
            die(f"{detail}; merge remains pending in {ctx.main_worktree}")
        parents = git_output(ctx.main_worktree, ["rev-list", "--parents", "-n", "1", "HEAD"]).split()
        merge_head = git_returncode(ctx.main_worktree, ["rev-parse", "-q", "--verify", "MERGE_HEAD"]) == 0
        if len(parents) != 3 or parents[1:] != [before_sha, feature_sha] or merge_head:
            die(f"commit wrapper did not complete the expected merge in {ctx.main_worktree}; inspect main before retrying")
        spec = ACTORS[parsed.actor]
        identity = git_output(ctx.main_worktree, ["log", "-1", "--format=%an <%ae>|%cn <%ce>"])
        expected = f"{spec['name']} <{spec['email']}>"
        if identity != f"{expected}|{expected}":
            die(f"merge commit identity did not match {spec['name']}; inspect main before retrying")

    after_sha = git_output(ctx.main_worktree, ["rev-parse", "HEAD"])
    commits_merged = count_range(ctx.main_worktree, f"{before_sha}..HEAD")
    merge_commit_author = None
    if merge_type == "no-ff":
        merge_commit_author = git_output(ctx.main_worktree, ["log", "-1", "--format=%an <%ae>"])

    remote_cleanup = {"requested": False}
    evidence_path = None
    evidence_error = None
    if runtime is not None and pipeline_result is not None:
        try:
            evidence_path = persist_evidence(ctx.original_worktree, runtime, pipeline_result, before_sha=before_sha, landing_sha=after_sha)
        except AgentWtMergeError as exc:
            evidence_error = str(exc)
        if evidence_error is None:
            remote_cleanup = cleanup_remote_feature(ctx, runtime, feature_sha, str(pipeline_result["outcome"]))
        else:
            remote_cleanup = {"requested": False, "retained": True, "reason": evidence_error}
    try:
        beads_result = close_beads_issue(
            ctx=ctx,
            actor=parsed.actor,
            issue_id=parsed.close_beads,
            before_sha=before_sha,
            after_sha=after_sha,
            preflight=preflight,
        )
    except (AgentWtMergeError, OSError) as exc:
        beads_result = {
            "requested": parsed.close_beads is not None,
            "closed": False,
            "reason": f"Beads closure could not be evaluated: {exc}",
        }
    report = {
        "mode": "CI-gated" if ci_gated else "local-only",
        "main_ci_required": ci_gated and merge_type == "no-ff" and before_sha != ctx.origin_sha,
        "fetch_warning": ctx.fetch_message if not ctx.fetch_ok else None,
        "merge_type": merge_type,
        "main_branch": ctx.main_branch,
        "feature_branch": ctx.feature_branch,
        "main_sha_before": before_sha,
        "main_sha_after": after_sha,
        "commits_merged": commits_merged,
        "merge_commit_author": merge_commit_author,
        "pipeline": pipeline_result,
        "remote_name": remote_name,
        "remote_cleanup": remote_cleanup,
        "evidence_path": evidence_path,
        "evidence_error": evidence_error,
        "close_beads": parsed.close_beads,
        "beads": beads_result,
        "cleanup": ctx.cleanup,
        "helper": helper_provenance_dict(helper),
    }
    print_merge_report(report)
    return 1 if (
        remote_cleanup_partial_failure(remote_cleanup)
        or beads_partial_failure(beads_result)
        or evidence_error is not None
    ) else 0


def cmd_inspect(raw_args: list[str], *, helper: HelperProvenance) -> int:
    parser = argparse.ArgumentParser(prog=f"{SCRIPT_NAME} inspect")
    parser.add_argument("--fetch", action="store_true", help="run best-effort git fetch before reporting origin status")
    parser.add_argument("--json", action="store_true", help="print machine-readable JSON")
    parser.add_argument("--beads-issue", metavar="ISSUE_ID", help="validate a selected issue's tracking anchor")
    add_local_helper_argument(parser)
    parsed = parser.parse_args(raw_args)
    provider = ci_provider(helper.path)
    runtime = load_pipeline_runtime(helper, resolve_main_branch(resolve_repo_root())) if provider == "github" else None
    ctx = build_context(fetch=parsed.fetch, helper=helper, remote_name=runtime.remote_name if runtime else "origin", beads_issue=parsed.beads_issue)
    payload = context_dict(ctx)
    if runtime is not None:
        shared = pipeline_module()
        try:
            store = shared.EvidenceStore(ctx.original_worktree)
            store.records()
            payload["pipeline"] = {"provider": provider, "policy_fingerprint": runtime.policy.fingerprint, "evidence_store": str(store.path)}
        except shared.PipelineRuntimeError as exc:
            die(str(exc))
    if parsed.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print_context_text(ctx)
        if "pipeline" in payload:
            print(f"- Workflow evidence store: {payload['pipeline']['evidence_store']}")
    return 0


def cmd_prune_evidence(raw_args: list[str], *, helper: HelperProvenance) -> int:
    parser = argparse.ArgumentParser(prog=f"{SCRIPT_NAME} prune-evidence")
    parser.add_argument("--apply", action="store_true", help="remove only freshly verified eligible local evidence records")
    parser.add_argument("--json", action="store_true")
    add_local_helper_argument(parser)
    parsed = parser.parse_args(raw_args)
    if ci_provider(helper.path) != "github":
        die("prune-evidence is unsupported by this helper's policy contract")
    shared = pipeline_module()
    try:
        root = resolve_repo_root()
        runtime = load_pipeline_runtime(helper, resolve_main_branch(root))
        report = shared.EvidenceStore(root).prune(runtime.policy, apply=parsed.apply)
    except (shared.PipelineRuntimeError, OSError) as exc:
        die(str(exc))
    if parsed.json:
        print(json.dumps(report, sort_keys=True, indent=2))
    else:
        print(f"Workflow evidence store: {report['evidence_store']}")
        print(f"Evidence pruning: {'apply' if parsed.apply else 'preview only'}")
        for item in report["records"]:
            print(f"- {item['key']}: {item['action']} ({item['reason']})")
        if report["error"]:
            eprint(report["error"])
    return 1 if report["error"] else 0


def usage() -> str:
    text = f"""Usage:
  ./assets/{SCRIPT_NAME} inspect [--fetch] [--json] [--beads-issue <issue-id>] [{LOCAL_HELPER_FLAG}]
  ./assets/{SCRIPT_NAME} prepare-ci [--poll-interval <seconds>] [--poll-timeout <seconds>] [{LOCAL_HELPER_FLAG}]
  ./assets/{SCRIPT_NAME} prepare-main-ci [--poll-interval <seconds>] [--poll-timeout <seconds>] [{LOCAL_HELPER_FLAG}]
  ./assets/{SCRIPT_NAME} ff --actor <opencode|claude> [--update-main] [--close-beads <issue-id>] [{LOCAL_HELPER_FLAG}]
  ./assets/{SCRIPT_NAME} no-ff --actor <opencode|claude> -m <subject> [-m <body>] [--update-main] [--close-beads <issue-id>] [{LOCAL_HELPER_FLAG}]

Commands:
  inspect  Report merge target facts and cleanup suggestions.
  prepare-ci  Publish the exact feature tip and wait for required CI.
  prepare-main-ci  Publish an unpushed main tip to a temporary ref and wait for CI.
  ff       Fast-forward main/master to the current feature branch.
  no-ff    Create a no-ff merge commit on main/master.
"""
    provider = ci_provider(running_helper_path())
    if provider == "github":
        text = text.replace("\nCommands:\n", f"  ./assets/{SCRIPT_NAME} prune-evidence [--apply] [--json] [{LOCAL_HELPER_FLAG}]\n\nCommands:\n")
        text += "  prune-evidence  Preview or explicitly prune landed, remote-confirmed evidence.\n"
    if provider is None:
        text = "".join(
            line for line in text.splitlines(keepends=True)
            if "prepare-ci" not in line and "prepare-main-ci" not in line
        )
    return text


def dispatch(command: str, raw_args: list[str], helper: HelperProvenance) -> int:
    if command == "inspect":
        return cmd_inspect(raw_args, helper=helper)
    if command == "prepare-ci":
        return cmd_prepare_ci(raw_args, helper=helper)
    if command == "prepare-main-ci":
        return cmd_prepare_main_ci(raw_args, helper=helper)
    if command == "prune-evidence":
        return cmd_prune_evidence(raw_args, helper=helper)
    if command in {"ff", "no-ff"}:
        return perform_merge(raw_args, merge_type=command, helper=helper)
    die(f"unknown command: {command}")


def main(argv: list[str]) -> int:
    try:
        if not argv or argv[0] in {"-h", "--help"}:
            print(usage(), end="")
            return 0
        command, raw_args = argv[0], argv[1:]
        helper = prepare_helper_execution(
            argv,
            allow_main=command in {"prepare-main-ci", "prune-evidence"},
        )
        if ci_provider(helper.path) != "github" or command not in {"prepare-ci", "prepare-main-ci", "ff", "no-ff"}:
            return dispatch(command, raw_args, helper)
        shared = pipeline_module()
        try:
            store = shared.EvidenceStore(resolve_repo_root())
            os.environ.pop(EVIDENCE_OPERATION_ENV, None)
            # Ownership of an evidence marker is recorded by pid, so a delegated
            # child must start its own rather than inherit this one.
            token = store.start_operation()
        except (shared.PipelineRuntimeError, OSError) as exc:
            die(str(exc))
        result = 2
        try:
            result = dispatch(command, raw_args, helper)
        finally:
            try:
                store.finish_operation(token)
            except (shared.PipelineRuntimeError, OSError) as exc:
                eprint(f"Partial failure: evidence operation marker retained: {exc}; do not retry a landed merge")
                if result == 0:
                    result = 1
        return result
    except AgentWtMergeError as exc:
        eprint(str(exc))
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
