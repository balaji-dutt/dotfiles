sys.dont_write_bytecode = True
_SCRIPT_PATH = Path(__file__).resolve()
if _SCRIPT_PATH.parent.name == "assets":
    _RUNTIME_DIR = _SCRIPT_PATH.parent
elif _SCRIPT_PATH.parent.name == "bin" and _SCRIPT_PATH.parent.parent.name == ".opencode":
    _RUNTIME_DIR = _SCRIPT_PATH.parent.parent.parent / "assets"
else:
    _RUNTIME_DIR = _SCRIPT_PATH.parent
if str(_RUNTIME_DIR) not in sys.path:
    sys.path.insert(0, str(_RUNTIME_DIR))

if TYPE_CHECKING:
    from gitlab_pipeline_runtime import PipelineRuntime


SCRIPT_NAME = Path(sys.argv[0]).name
MAIN_BRANCH_CANDIDATES = ("main", "master")
LOCAL_HELPER_FLAG = "--use-local-helper"
EXEC_CHAIN_ENV = "AGENT_WT_MERGE_EXEC_CHAIN"
DELEGATED_FROM_ENV = "AGENT_WT_MERGE_DELEGATED_FROM"
REEXEC_AFTER_UPDATE_ENV = "AGENT_WT_MERGE_REEXEC_AFTER_UPDATE"
HELPER_RELATIVE_PATHS = (
    Path("assets/agent-wt-merge"),
    Path(".opencode/bin/agent-wt-merge"),
)
FEATURE_BRANCH_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$")

ACTORS = {
    "opencode": {
        "name": "OpenCode",
        "email": "noreply@opencode.ai",
        "state_file": "in-progress-opencode.json",
    },
    "claude": {
        "name": "Claude",
        "email": "noreply@anthropic.com",
        "state_file": "in-progress-claude.json",
    },
}


class AgentWtMergeError(Exception):
    """User-facing helper error."""


@dataclass
class WorktreeEntry:
    path: Path
    branch: str | None = None
    head: str | None = None
    bare: bool = False
    detached: bool = False
    locked: bool = False
    lock_reason: str | None = None


@dataclass(frozen=True)
class HelperProvenance:
    path: Path
    state: str
    canonical_path: Path | None
    delegated_from: Path | None
    reexecuted_after_main_update: bool


@dataclass
class MergeContext:
    original_worktree: Path
    feature_worktree: WorktreeEntry
    main_worktree: Path
    main_branch: str
    feature_branch: str
    main_sha: str
    feature_sha: str
    commits_ahead: int
    fast_forward_possible: bool
    main_dirty_paths: list[str]
    origin_ref: str | None
    origin_sha: str | None
    origin_behind_count: int | None
    origin_ahead_count: int | None
    fetch_attempted: bool
    fetch_ok: bool | None
    fetch_message: str | None
    ai_wt_session: dict[str, Any] | None
    cleanup: dict[str, Any]
    beads: dict[str, Any]
    helper: HelperProvenance


def eprint(message: str) -> None:
    print(f"{SCRIPT_NAME}: {message}", file=sys.stderr)


def die(message: str) -> None:
    raise AgentWtMergeError(message)


def run_git(
    cwd: Path,
    args: list[str],
    *,
    check: bool = True,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=str(cwd),
        check=check,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def git_output(cwd: Path, args: list[str]) -> str:
    result = run_git(cwd, args)
    return result.stdout.strip()


def git_returncode(cwd: Path, args: list[str]) -> int:
    return run_git(cwd, args, check=False).returncode


def resolve_repo_root() -> Path:
    try:
        return Path(git_output(Path.cwd(), ["rev-parse", "--show-toplevel"])).resolve()
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "not a Git repository").strip()
        die(detail)


def local_branch_exists(repo_root: Path, branch: str) -> bool:
    return git_returncode(repo_root, ["show-ref", "--verify", "--quiet", f"refs/heads/{branch}"]) == 0


def resolve_main_branch(repo_root: Path) -> str:
    for branch in MAIN_BRANCH_CANDIDATES:
        if local_branch_exists(repo_root, branch):
            return branch
    die("neither main nor master exists locally")


def current_branch(repo_root: Path) -> str:
    branch = git_output(repo_root, ["rev-parse", "--abbrev-ref", "HEAD"])
    if branch == "HEAD":
        die("detached HEAD; there is no feature branch to merge")
    return branch


def parse_worktrees(repo_root: Path) -> list[WorktreeEntry]:
    raw = git_output(repo_root, ["worktree", "list", "--porcelain"])
    entries: list[WorktreeEntry] = []
    current: dict[str, Any] = {}

    def flush() -> None:
        if "path" not in current:
            return
        entries.append(
            WorktreeEntry(
                path=Path(str(current["path"])).resolve(),
                branch=current.get("branch"),
                head=current.get("head"),
                bare=bool(current.get("bare", False)),
                detached=bool(current.get("detached", False)),
                locked=bool(current.get("locked", False)),
                lock_reason=current.get("lock_reason"),
            )
        )
        current.clear()

    for line in raw.splitlines():
        if not line:
            flush()
            continue
        if line.startswith("worktree "):
            flush()
            current["path"] = line.removeprefix("worktree ")
        elif line.startswith("HEAD "):
            current["head"] = line.removeprefix("HEAD ")
        elif line.startswith("branch "):
            current["branch"] = line.removeprefix("branch ")
        elif line == "bare":
            current["bare"] = True
        elif line == "detached":
            current["detached"] = True
        elif line == "locked":
            current["locked"] = True
        elif line.startswith("locked "):
            current["locked"] = True
            current["lock_reason"] = line.removeprefix("locked ")
    flush()
    return entries


def resolve_worktree_entry(entries: list[WorktreeEntry], worktree: Path) -> WorktreeEntry:
    target = worktree.resolve()
    for entry in entries:
        if entry.path == target:
            return entry
    die(f"current worktree is absent from git worktree list: {target}")


def resolve_main_worktree(
    repo_root: Path,
    main_branch: str,
    entries: list[WorktreeEntry] | None = None,
) -> Path:
    wanted = f"refs/heads/{main_branch}"
    matches = [entry for entry in (entries or parse_worktrees(repo_root)) if entry.branch == wanted]
    if len(matches) > 1:
        locations = ", ".join(str(entry.path) for entry in matches)
        die(f"multiple worktrees are checked out on {main_branch}: {locations}")
    if not matches:
        die(f"{main_branch} is not checked out in any worktree")
    return matches[0].path


def running_helper_path() -> Path:
    return Path(__file__).resolve()


def canonical_helper_path(main_worktree: Path, *, strict: bool = True) -> Path | None:
    unusable: list[str] = []
    for relative_path in HELPER_RELATIVE_PATHS:
        candidate = main_worktree / relative_path
        if not candidate.exists():
            continue
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate.resolve()
        unusable.append(str(candidate))
    if unusable and strict:
        die("main helper exists but is not an executable file: " + ", ".join(unusable))
    return None


def is_known_worktree_helper(helper_path: Path, worktree: Path) -> bool:
    return any(helper_path == (worktree / relative_path).resolve() for relative_path in HELPER_RELATIVE_PATHS)


def helper_dirty_paths(main_worktree: Path, helper_path: Path) -> list[str]:
    try:
        relative_path = helper_path.relative_to(main_worktree)
    except ValueError:
        die(f"resolved main helper is outside the main worktree: {helper_path}")
    result = run_git(
        main_worktree,
        ["status", "--porcelain", "--untracked-files=all", "--", str(relative_path)],
        check=False,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "git status failed").strip()
        die(f"could not inspect the main helper path: {detail}")
    return [line for line in result.stdout.splitlines() if line]


def read_exec_chain() -> list[str]:
    raw = os.environ.get(EXEC_CHAIN_ENV)
    if not raw:
        return []
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        die(f"{EXEC_CHAIN_ENV} is not valid JSON")
    if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
        die(f"{EXEC_CHAIN_ENV} must be a JSON array of paths")
    return value


ACTIVE_EVIDENCE_TOKEN: str | None = None
EVIDENCE_OPERATION_ENV = "AGENT_WT_MERGE_EVIDENCE_OPERATION"


def exec_helper(target: Path, argv: list[str], *, after_main_update: bool = False) -> None:
    current = running_helper_path()
    target = target.resolve()
    if not target.is_file() or not os.access(target, os.X_OK):
        die(f"cannot execute helper: {target}")

    chain = read_exec_chain()
    target_text = str(target)
    if target != current and target_text in {*chain, str(current)}:
        die(f"helper delegation loop detected for {target}")

    env = os.environ.copy()
    if target != current:
        env.setdefault(DELEGATED_FROM_ENV, str(current))
        chain.append(str(current))
        env[EXEC_CHAIN_ENV] = json.dumps(chain)
    if after_main_update:
        env[REEXEC_AFTER_UPDATE_ENV] = "1"
    if ACTIVE_EVIDENCE_TOKEN is not None:
        env[EVIDENCE_OPERATION_ENV] = ACTIVE_EVIDENCE_TOKEN

    try:
        os.execve(target_text, [target_text, *argv], env)
    except OSError as exc:
        die(f"could not execute helper {target}: {exc}")


def prepare_helper_execution(
    argv: list[str],
    *,
    allow_main: bool = False,
) -> HelperProvenance:
    original_worktree = resolve_repo_root()
    main_branch = resolve_main_branch(original_worktree)
    feature_branch = current_branch(original_worktree)
    if feature_branch in MAIN_BRANCH_CANDIDATES and not allow_main:
        die(f"already on {feature_branch}; there is nothing to merge")
    main_worktree = resolve_main_worktree(original_worktree, main_branch)
    current = running_helper_path()
    delegated_from_raw = os.environ.get(DELEGATED_FROM_ENV)
    delegated_from = Path(delegated_from_raw).resolve() if delegated_from_raw else None
    reexecuted = os.environ.get(REEXEC_AFTER_UPDATE_ENV) == "1"

    if LOCAL_HELPER_FLAG in argv:
        if not is_known_worktree_helper(current, original_worktree):
            die(f"local helper override is limited to a worktree helper path: {current}")
        canonical = canonical_helper_path(main_worktree, strict=False)
        return HelperProvenance(
            path=current,
            state="override",
            canonical_path=canonical,
            delegated_from=delegated_from,
            reexecuted_after_main_update=reexecuted,
        )

    canonical = canonical_helper_path(main_worktree)
    if canonical is not None:
        dirty = helper_dirty_paths(main_worktree, canonical)
        if dirty:
            die("main helper path is dirty; refusing to execute it:\n" + "\n".join(dirty))
        if current != canonical:
            exec_helper(canonical, argv)
        return HelperProvenance(
            path=current,
            state="delegated" if delegated_from else "canonical",
            canonical_path=canonical,
            delegated_from=delegated_from,
            reexecuted_after_main_update=reexecuted,
        )

    if delegated_from is not None:
        die("delegated helper could not resolve a canonical helper on main")
    if not is_known_worktree_helper(current, original_worktree):
        die(f"main has no helper and the running helper is not a recognized worktree copy: {current}")
    return HelperProvenance(
        path=current,
        state="fallback",
        canonical_path=None,
        delegated_from=None,
        reexecuted_after_main_update=reexecuted,
    )


def helper_source_root(helper_path: Path) -> Path:
    resolved = helper_path.resolve()
    if resolved.parent.name == "assets":
        return resolved.parent.parent
    if resolved.parent.name == "bin" and resolved.parent.parent.name == ".opencode":
        return resolved.parent.parent.parent
    die(f"cannot resolve source root for helper: {resolved}")


def ci_provider(helper_path: Path) -> str | None:
    found = []
    for provider, name in (("gitlab", "gitlab-pipeline-guard.json"), ("github", "pipeline-guard.json")):
        policy = helper_source_root(helper_path) / "configs" / name
        try:
            policy.lstat()
        except FileNotFoundError:
            if policy.parent.is_symlink() and not policy.parent.exists():
                die(f"cannot inspect pipeline policy through broken path: {policy.parent}")
            continue
        except OSError as exc:
            die(f"cannot inspect pipeline policy {policy}: {exc}")
        found.append(provider)
    if len(found) > 1:
        die("conflicting pipeline policies; configure exactly one policy")
    return found[0] if found else None


def ci_enabled(helper_path: Path) -> bool:
    return ci_provider(helper_path) is not None


def ci_contract(helper_path: Path) -> tuple[str | None, bytes]:
    provider = ci_provider(helper_path)
    if provider is None:
        return None, b""
    name = "pipeline-guard.json" if provider == "github" else "gitlab-pipeline-guard.json"
    try:
        with (helper_source_root(helper_path) / "configs" / name).open("rb") as stream:
            contents = stream.read(65537)
        if len(contents) > 65536:
            die("pipeline policy exceeds 64 KiB")
        return provider, contents
    except OSError as exc:
        die(f"cannot read pipeline evidence contract: {exc}")


def pipeline_module() -> ModuleType:
    if ci_provider(running_helper_path()) == "github":
        try:
            import pipeline_runtime
        except (ImportError, SyntaxError) as exc:
            die(f"cannot load provider pipeline runtime; restore the documented assets runtime files: {exc}")
        return pipeline_runtime
    try:
        import gitlab_pipeline_runtime
    except (ImportError, SyntaxError) as exc:
        die(f"cannot load GitLab pipeline runtime; restore assets/gitlab_pipeline_runtime.py: {exc}")
    return gitlab_pipeline_runtime


def load_pipeline_runtime(helper: HelperProvenance, main_branch: str) -> PipelineRuntime:
    if not ci_enabled(helper.path):
        die("CI preparation is unsupported: this helper has no pipeline policy")
    shared = pipeline_module()
    try:
        return shared.load_pipeline_runtime(helper_source_root(helper.path), main_branch)
    except shared.PipelineRuntimeError as exc:
        die(str(exc))


def commit_exists(repo_root: Path, ref: str) -> bool:
    return git_returncode(
        repo_root, ["cat-file", "-e", f"{ref}^{{commit}}"]
    ) == 0


def is_ancestor(repo_root: Path, ancestor: str, descendant: str) -> bool:
    return git_returncode(repo_root, ["merge-base", "--is-ancestor", ancestor, descendant]) == 0


def count_range(repo_root: Path, commit_range: str) -> int:
    raw = git_output(repo_root, ["rev-list", "--count", commit_range])
    try:
        return int(raw)
    except ValueError:
        die(f"git rev-list returned a non-integer count for {commit_range}: {raw}")


def list_range(
    repo_root: Path,
    commit_range: str,
    fmt: str = "%h",
    *,
    exclude_refs: tuple[str, ...] = (),
) -> list[str]:
    exclusions = [f"^{ref}" for ref in exclude_refs]
    raw = git_output(repo_root, ["log", commit_range, *exclusions, f"--format={fmt}"])
    return [line for line in raw.splitlines() if line]


def dirty_paths(worktree: Path) -> list[str]:
    result = run_git(worktree, ["status", "--porcelain", "--untracked-files=all"], check=False)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "git status failed").strip()
        die(detail)
    return [line for line in result.stdout.splitlines() if line]


def origin_status(
    main_worktree: Path,
    main_branch: str,
    remote_name: str,
) -> tuple[str | None, str | None, int | None, int | None]:
    origin_ref = f"{remote_name}/{main_branch}"
    tracking_ref = f"refs/remotes/{origin_ref}"
    if git_returncode(main_worktree, ["show-ref", "--verify", "--quiet", tracking_ref]) != 0:
        return None, None, None, None
    origin_sha = git_output(main_worktree, ["rev-parse", tracking_ref])
    behind_count = count_range(main_worktree, f"{main_branch}..{tracking_ref}")
    ahead_count = count_range(main_worktree, f"{tracking_ref}..{main_branch}")
    return origin_ref, origin_sha, behind_count, ahead_count


def maybe_fetch(main_worktree: Path, remote_name: str = "origin") -> tuple[bool, str | None]:
    result = run_git(main_worktree, ["fetch", "--", remote_name], check=False)
    message = (result.stderr or result.stdout).strip() or None
    return result.returncode == 0, message


def read_json(path: Path) -> dict[str, Any] | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError) as exc:
        return {"_read_error": str(exc)}
    return value if isinstance(value, dict) else {"_read_error": "JSON root is not an object"}


def resolve_state_worktree(raw_path: Any) -> Path | None:
    if not isinstance(raw_path, str) or not raw_path.strip():
        return None
    return Path(raw_path).expanduser().resolve()


def inspect_beads_state(
    *,
    state_file: Path,
    expected_issue_id: str | None,
    feature_branch: str,
    original_worktree: Path,
    repo_root: Path,
    target_ref: str,
) -> dict[str, Any]:
    info: dict[str, Any] = {
        "state_file": str(state_file),
        "exists": state_file.exists(),
        "issue_id": None,
        "branch": None,
        "worktree_path": None,
        "started_sha": None,
        "matches": False,
        "problems": [],
    }
    data = read_json(state_file)
    if data is None:
        info["problems"].append("state file is absent")
        return info
    if "_read_error" in data:
        info["problems"].append(f"could not read state file: {data['_read_error']}")
        return info

    issue_id = str(data.get("id", "")).strip()
    info["issue_id"] = issue_id or None
    if not issue_id:
        info["problems"].append("state file has no issue id")
    elif expected_issue_id is not None and issue_id != expected_issue_id:
        info["problems"].append(f"state issue id is {issue_id}, expected {expected_issue_id}")

    state_branch = str(data.get("branch", "")).strip()
    info["branch"] = state_branch or None
    if not state_branch:
        info["problems"].append("state file has no branch")
    elif state_branch != feature_branch:
        if state_branch == original_worktree.name:
            info["problems"].append(
                f"state branch is {state_branch}, which matches the worktree directory name; "
                f"expected Git branch {feature_branch}"
            )
        else:
            info["problems"].append(f"state branch is {state_branch}, expected {feature_branch}")

    state_worktree = resolve_state_worktree(data.get("worktree_path"))
    info["worktree_path"] = str(state_worktree) if state_worktree else None
    if state_worktree is None:
        info["problems"].append("state file has no worktree_path")
    elif state_worktree != original_worktree.resolve():
        info["problems"].append(f"state worktree is {state_worktree}, expected {original_worktree}")

    started_sha = str(data.get("started_sha", "")).strip()
    info["started_sha"] = started_sha or None
    if not started_sha:
        info["problems"].append("state file has no started_sha")
    elif not commit_exists(repo_root, started_sha):
        info["problems"].append(f"started_sha is not a commit: {started_sha}")
    elif not is_ancestor(repo_root, started_sha, target_ref):
        info["problems"].append(f"started_sha {started_sha} is not an ancestor of {target_ref}")

    info["matches"] = not info["problems"]
    return info


def inspect_all_beads(
    *,
    original_worktree: Path,
    repo_root: Path,
    feature_branch: str,
    target_ref: str,
) -> dict[str, Any]:
    return {
        actor: inspect_beads_state(
            state_file=original_worktree / ".beads" / spec["state_file"],
            expected_issue_id=None,
            feature_branch=feature_branch,
            original_worktree=original_worktree,
            repo_root=repo_root,
            target_ref=target_ref,
        )
        for actor, spec in ACTORS.items()
    }


def find_ai_wt_session(main_worktree: Path, original_worktree: Path) -> dict[str, Any] | None:
    sessions_dir = main_worktree / ".ai-wt" / "sessions"
    if not sessions_dir.exists():
        return None
    target = original_worktree.resolve()
    for metadata_path in sorted(sessions_dir.glob("*.json")):
        data = read_json(metadata_path)
        if not data or "_read_error" in data:
            continue
        raw_worktree_path = data.get("worktree_path")
        worktree_path = resolve_state_worktree(raw_worktree_path)
        if worktree_path != target:
            continue
        session_id = str(data.get("session_id") or metadata_path.stem)
        return {
            "session_id": session_id,
            "metadata_path": str(metadata_path),
            "branch_created": bool(data.get("branch_created", False)),
        }
    return None


def shell_command(parts: list[str]) -> str:
    return shlex.join(parts)


def cleanup_policy(
    *,
    main_worktree: Path,
    original_worktree: Path,
    feature_branch: str,
    feature_worktree: WorktreeEntry,
    ai_wt_session: dict[str, Any] | None,
    is_windows: bool | None = None,
) -> dict[str, Any]:
    if is_windows is None:
        is_windows = os.name == "nt"
    if feature_worktree.lock_reason and "aoe-managed" in feature_worktree.lock_reason.casefold():
        return {
            "action": "defer",
            "manager": "aoe",
            "workdir": str(main_worktree),
            "commands": [],
            "note": (
                "Cleanup belongs to Agent of Empires. Do not remove this worktree or branch; "
                "AoE will tear down its managed worktree."
            ),
        }
    if is_windows:
        manager = "ai-wt" if ai_wt_session else "user"
        note = (
            "Cleanup belongs to ai-wt after the active agent exits. Do not remove the "
            "worktree from inside this native Windows session."
            if ai_wt_session
            else "Cleanup must be performed outside this native Windows session after the "
            "active agent exits and releases the worktree directory."
        )
        return {
            "action": "defer",
            "manager": manager,
            "workdir": str(main_worktree),
            "commands": [],
            "note": note,
        }
    if ai_wt_session:
        command = ["ai-wt", "cleanup", str(ai_wt_session["session_id"]), "--delete", "--yes"]
        return {
            "action": "suggest",
            "manager": "ai-wt",
            "workdir": str(main_worktree),
            "commands": [shell_command(command)],
            "note": "Ask the user before running cleanup. Do not add --force unless explicitly requested.",
        }
    return {
        "action": "suggest",
        "manager": "git",
        "workdir": str(main_worktree),
        "commands": [
            shell_command(["git", "worktree", "remove", str(original_worktree)]),
            shell_command(["git", "branch", "-d", feature_branch]),
        ],
        "note": "Ask the user before running cleanup. Never use git branch -D for this workflow.",
    }


def build_context(
    *,
    fetch: bool,
    helper: HelperProvenance,
    remote_name: str = "origin",
) -> MergeContext:
    original_worktree = resolve_repo_root()
    worktrees = parse_worktrees(original_worktree)
    feature_worktree = resolve_worktree_entry(worktrees, original_worktree)
    main_branch = resolve_main_branch(original_worktree)
    feature_branch = current_branch(original_worktree)
    if feature_branch in MAIN_BRANCH_CANDIDATES:
        die(f"already on {feature_branch}; there is nothing to merge")
    main_worktree = resolve_main_worktree(original_worktree, main_branch, worktrees)

    fetch_attempted = False
    fetch_ok: bool | None = None
    fetch_message: str | None = None
    if fetch:
        fetch_attempted = True
        fetch_ok, fetch_message = maybe_fetch(main_worktree, remote_name)

    main_sha = git_output(main_worktree, ["rev-parse", "HEAD"])
    feature_sha = git_output(original_worktree, ["rev-parse", feature_branch])
    commits_ahead = count_range(original_worktree, f"{main_branch}..{feature_branch}")
    fast_forward_possible = is_ancestor(original_worktree, main_branch, feature_branch)
    dirty = dirty_paths(main_worktree)
    origin_ref, origin_sha, behind_count, ahead_count = origin_status(
        main_worktree, main_branch, remote_name
    )
    ai_wt_session = find_ai_wt_session(main_worktree, original_worktree)
    cleanup = cleanup_policy(
        main_worktree=main_worktree,
        original_worktree=original_worktree,
        feature_branch=feature_branch,
        feature_worktree=feature_worktree,
        ai_wt_session=ai_wt_session,
    )
    beads = inspect_all_beads(
        original_worktree=original_worktree,
        repo_root=original_worktree,
        feature_branch=feature_branch,
        target_ref=feature_branch,
    )
    return MergeContext(
        original_worktree=original_worktree,
        feature_worktree=feature_worktree,
        main_worktree=main_worktree,
        main_branch=main_branch,
        feature_branch=feature_branch,
        main_sha=main_sha,
        feature_sha=feature_sha,
        commits_ahead=commits_ahead,
        fast_forward_possible=fast_forward_possible,
        main_dirty_paths=dirty,
        origin_ref=origin_ref,
        origin_sha=origin_sha,
        origin_behind_count=behind_count,
        origin_ahead_count=ahead_count,
        fetch_attempted=fetch_attempted,
        fetch_ok=fetch_ok,
        fetch_message=fetch_message,
        ai_wt_session=ai_wt_session,
        cleanup=cleanup,
        beads=beads,
        helper=helper,
    )


def helper_provenance_dict(helper: HelperProvenance) -> dict[str, Any]:
    return {
        "path": str(helper.path),
        "state": helper.state,
        "canonical_path": str(helper.canonical_path) if helper.canonical_path else None,
        "delegated_from": str(helper.delegated_from) if helper.delegated_from else None,
        "reexecuted_after_main_update": helper.reexecuted_after_main_update,
    }


def context_dict(ctx: MergeContext) -> dict[str, Any]:
    return {
        "original_worktree": str(ctx.original_worktree),
        "feature_worktree": {
            "locked": ctx.feature_worktree.locked,
            "lock_reason": ctx.feature_worktree.lock_reason,
        },
        "main_worktree": str(ctx.main_worktree),
        "main_branch": ctx.main_branch,
        "feature_branch": ctx.feature_branch,
        "main_sha": ctx.main_sha,
        "feature_sha": ctx.feature_sha,
        "feature": {
            "commits_ahead": ctx.commits_ahead,
            "fast_forward_possible": ctx.fast_forward_possible,
            "commits": list_range(ctx.original_worktree, f"{ctx.main_branch}..{ctx.feature_branch}", "%h %s"),
        },
        "main_dirty": bool(ctx.main_dirty_paths),
        "main_dirty_paths": ctx.main_dirty_paths,
        "origin": {
            "ref": ctx.origin_ref,
            "sha": ctx.origin_sha,
            "behind_count": ctx.origin_behind_count,
            "ahead_count": ctx.origin_ahead_count,
        },
        "fetch": {
            "attempted": ctx.fetch_attempted,
            "ok": ctx.fetch_ok,
            "message": ctx.fetch_message,
        },
        "ai_wt": ctx.ai_wt_session,
        "beads": ctx.beads,
        "cleanup": ctx.cleanup,
        "helper": helper_provenance_dict(ctx.helper),
    }


def print_context_text(ctx: MergeContext) -> None:
    print("Worktree merge inspection")
    print(f"- Helper: {ctx.helper.path} ({ctx.helper.state})")
    if ctx.helper.delegated_from:
        print(f"  - Delegated from: {ctx.helper.delegated_from}")
    if ctx.helper.reexecuted_after_main_update:
        print("  - Re-executed after main update: yes")
    print(f"- Feature branch: {ctx.feature_branch} ({ctx.feature_sha[:12]})")
    print(f"- Main branch: {ctx.main_branch} ({ctx.main_sha[:12]})")
    print(f"- Original worktree: {ctx.original_worktree}")
    if ctx.feature_worktree.locked:
        reason = ctx.feature_worktree.lock_reason or "reason not provided"
        print(f"  - Locked: yes ({reason})")
    else:
        print("  - Locked: no")
    print(f"- Main worktree: {ctx.main_worktree}")
    print(f"- Commits ahead of {ctx.main_branch}: {ctx.commits_ahead}")
    print(f"- Fast-forward possible: {'yes' if ctx.fast_forward_possible else 'no'}")
    if ctx.main_dirty_paths:
        print("- Main dirty: yes")
        for item in ctx.main_dirty_paths:
            print(f"  - {item}")
    else:
        print("- Main dirty: no")
    if ctx.origin_ref is None:
        print("- Origin status: no origin/<main> ref")
    else:
        print(
            f"- Origin status: local {ctx.main_branch} is {ctx.origin_ahead_count} commit(s) ahead "
            f"and {ctx.origin_behind_count} commit(s) behind {ctx.origin_ref}"
        )
    if ctx.fetch_attempted and not ctx.fetch_ok:
        print(f"- Fetch warning: {ctx.fetch_message or 'git fetch failed'}")
    if ctx.ai_wt_session:
        print(f"- ai-wt session: {ctx.ai_wt_session['session_id']}")
    else:
        print("- ai-wt session: none")
    for actor, info in ctx.beads.items():
        issue = info.get("issue_id") or "none"
        matches = "matches" if info.get("matches") else "not matching"
        print(f"- Beads ({actor}): {issue} ({matches})")
        for problem in info.get("problems", []):
            if problem != "state file is absent":
                print(f"  - {problem}")
    print_cleanup(ctx.cleanup, after_merge=False)


def remote_ref_sha(
    repo_root: Path,
    remote_name: str,
    remote_ref: str,
) -> str | None:
    shared = pipeline_module()
    try:
        return shared.remote_ref_sha(repo_root, remote_name, remote_ref)
    except shared.PipelineRuntimeError as exc:
        die(str(exc))


def feature_remote_ref(feature_branch: str) -> str:
    if FEATURE_BRANCH_PATTERN.fullmatch(feature_branch) is None:
        die(f"feature branch name is unsafe for publication: {feature_branch!r}")
    return f"refs/heads/{feature_branch}"


def require_remote_feature(
    ctx: MergeContext,
    runtime: PipelineRuntime,
    expected_sha: str,
) -> None:
    remote_ref = feature_remote_ref(ctx.feature_branch)
    advertised_sha = remote_ref_sha(ctx.original_worktree, runtime.remote_name, remote_ref)
    if advertised_sha is None:
        die(
            f"{runtime.remote_name}/{ctx.feature_branch} is absent; run prepare-ci with user approval"
        )
    if advertised_sha != expected_sha:
        die(
            f"{runtime.remote_name}/{ctx.feature_branch} advertises {advertised_sha}, "
            f"expected pinned feature SHA {expected_sha}"
        )


def check_pipeline(
    repo_root: Path,
    runtime: PipelineRuntime,
    sha: str,
    source_ref: str,
) -> dict[str, Any]:
    shared = pipeline_module()
    try:
        if getattr(runtime, "provider", None) == "github":
            return shared.check_pipeline(repo_root, runtime, sha, source_ref)
        return shared.check_pipeline(repo_root, runtime, sha)
    except shared.PipelineRuntimeError as exc:
        die(str(exc))


def publish_feature(ctx: MergeContext, runtime: PipelineRuntime, feature_sha: str) -> bool:
    remote_ref = feature_remote_ref(ctx.feature_branch)
    if getattr(runtime, "provider", None) == "github":
        shared = pipeline_module()
        try:
            shared.validate_remote(ctx.original_worktree, runtime.policy)
        except shared.PipelineRuntimeError as exc:
            die(str(exc))
    remote_check = run_git(
        ctx.original_worktree,
        ["remote", "get-url", runtime.remote_name],
        check=False,
    )
    if remote_check.returncode != 0:
        detail = (remote_check.stderr or remote_check.stdout or "remote not found").strip()
        die(f"cannot publish through remote {runtime.remote_name!r}: {detail}")
    already_present = remote_ref_sha(ctx.original_worktree, runtime.remote_name, remote_ref) == feature_sha
    result = run_git(
        ctx.original_worktree,
        [
            "push",
            "--porcelain",
            "--",
            runtime.remote_name,
            f"{feature_sha}:{remote_ref}",
        ],
        check=False,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "git push failed").strip()
        die(
            f"could not publish pinned feature SHA {feature_sha} to "
            f"{runtime.remote_name}/{ctx.feature_branch}: {detail}"
        )
    advertised_sha = remote_ref_sha(ctx.original_worktree, runtime.remote_name, remote_ref)
    if advertised_sha != feature_sha:
        die(
            f"published feature verification failed: {runtime.remote_name}/{ctx.feature_branch} "
            f"advertises {advertised_sha or 'nothing'}, expected {feature_sha}"
        )
    return not already_present


def positive_seconds(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("must be an integer number of seconds") from None
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return parsed


def print_workflow_evidence(result: dict[str, Any]) -> None:
    if result.get("provider") != "github":
        return
    print(f"GitHub evidence: {result['host']}/{result['repository']} {result['source_ref']} at {result['sha']}")
    for workflow in result["workflows"]:
        print(
            f"- Workflow {workflow['workflow_id']} {workflow['path']}: "
            f"run {workflow.get('run_id')}, attempt {workflow.get('run_attempt')}, {workflow['outcome']}"
        )
        for job in workflow.get("jobs", []):
            if job.get("conclusion") != "success":
                print(f"  Job diagnostic: {json.dumps(job, ensure_ascii=True)}")


def cmd_prepare_ci(raw_args: list[str], *, helper: HelperProvenance) -> int:
    parser = argparse.ArgumentParser(prog=f"{SCRIPT_NAME} prepare-ci")
    parser.add_argument("--poll-interval", type=positive_seconds, default=15)
    parser.add_argument("--poll-timeout", type=positive_seconds, default=900)
    add_local_helper_argument(parser)
    parsed = parser.parse_args(raw_args)
    maximum_checks = max(1, math.ceil(parsed.poll_timeout / parsed.poll_interval))
    if maximum_checks > 60:
        die(
            "poll settings would require more than 60 checks; increase "
            "--poll-interval or reduce --poll-timeout"
        )
    ctx = build_context(fetch=False, helper=helper)
    runtime = load_pipeline_runtime(helper, ctx.main_branch)
    feature_sha = ctx.feature_sha
    published = publish_feature(ctx, runtime, feature_sha)
    action = "Published" if published else "Reusing already published"
    print(
        f"{action} {ctx.feature_branch} at {feature_sha} to "
        f"{runtime.remote_name}/{ctx.feature_branch}"
    )

    deadline = time.monotonic() + parsed.poll_timeout
    latest: dict[str, Any] | None = None
    for attempt in range(1, maximum_checks + 1):
        if attempt > 1 and time.monotonic() >= deadline:
            break
        latest = check_pipeline(ctx.original_worktree, runtime, feature_sha, feature_remote_ref(ctx.feature_branch))
        print_workflow_evidence(latest)
        outcome = latest["outcome"]
        detail = str(latest.get("detail") or "no detail")
        if outcome == "success":
            persist_evidence(ctx.original_worktree, runtime, latest)
            pipeline_url = latest.get("pipeline_url")
            suffix = f" ({pipeline_url})" if pipeline_url else ""
            print(
                f"PASS feature CI: {runtime.required_job} succeeded for {feature_sha}{suffix}"
            )
            return 0
        if outcome == "bypass":
            print(
                f"BYPASS feature CI: {detail}. The remote feature branch must be retained."
            )
            return 0
        if outcome in {"terminal", "error"}:
            die(f"feature CI blocked for {feature_sha}: {detail}")
        print(
            f"Waiting for {runtime.required_job} on {feature_sha} "
            f"({attempt}/{maximum_checks}): {detail}"
        )
        if attempt < maximum_checks:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            time.sleep(min(parsed.poll_interval, remaining))

    remaining = deadline - time.monotonic()
    if remaining > 0:
        time.sleep(remaining)
    detail = str((latest or {}).get("detail") or "no successful job observed")
    die(
        f"timed out after {parsed.poll_timeout}s waiting for {runtime.required_job} "
        f"on {feature_sha}: {detail}; feature remains published and main was not changed"
    )


def main_ci_remote_ref(main_branch: str, main_sha: str) -> str:
    shared = pipeline_module()
    try:
        return shared.main_ci_remote_ref(main_branch, main_sha)
    except shared.PipelineRuntimeError as exc:
        die(str(exc))


def publish_main_ci_ref(
    repo_root: Path,
    runtime: PipelineRuntime,
    main_branch: str,
    main_sha: str,
) -> tuple[str, bool]:
    shared = pipeline_module()
    try:
        return shared.publish_main_ci_ref(repo_root, runtime, main_branch, main_sha)
    except shared.PipelineRuntimeError as exc:
        die(str(exc))


def cleanup_main_ci_ref(
    repo_root: Path,
    runtime: PipelineRuntime,
    remote_ref: str,
    main_sha: str,
) -> dict[str, Any]:
    return pipeline_module().cleanup_main_ci_ref(repo_root, runtime, remote_ref, main_sha)


def ensure_main_ci_state_unchanged(
    repo_root: Path,
    runtime: PipelineRuntime,
    main_branch: str,
    main_sha: str,
    origin_sha: str,
    remote_ref: str | None,
) -> None:
    evidence = (
        f"; temporary CI ref {remote_ref} was retained"
        if remote_ref is not None
        else "; no temporary CI ref was published"
    )
    if current_branch(repo_root) != main_branch or git_output(repo_root, ["rev-parse", "HEAD"]) != main_sha:
        die(f"local {main_branch} moved while CI was checked{evidence}")
    if dirty_paths(repo_root):
        die(f"main worktree became dirty while CI was checked{evidence}")
    current_remote_main = remote_ref_sha(repo_root, runtime.remote_name, runtime.guarded_ref)
    if current_remote_main != origin_sha:
        die(f"{runtime.remote_name}/{main_branch} moved while CI was checked{evidence}")


def cmd_prepare_main_ci(raw_args: list[str], *, helper: HelperProvenance) -> int:
    parser = argparse.ArgumentParser(prog=f"{SCRIPT_NAME} prepare-main-ci")
    parser.add_argument("--poll-interval", type=positive_seconds, default=15)
    parser.add_argument("--poll-timeout", type=positive_seconds, default=900)
    add_local_helper_argument(parser)
    parsed = parser.parse_args(raw_args)
    maximum_checks = max(1, math.ceil(parsed.poll_timeout / parsed.poll_interval))
    if maximum_checks > 60:
        die(
            "poll settings would require more than 60 checks; increase "
            "--poll-interval or reduce --poll-timeout"
        )

    repo_root = resolve_repo_root()
    main_branch = resolve_main_branch(repo_root)
    branch = current_branch(repo_root)
    if branch != main_branch:
        die(f"prepare-main-ci must run from attached {main_branch}; current branch is {branch}")
    main_worktree = resolve_main_worktree(repo_root, main_branch)
    if main_worktree != repo_root:
        die(f"prepare-main-ci must run from the {main_branch} worktree: {main_worktree}")
    runtime = load_pipeline_runtime(helper, main_branch)
    dirty = dirty_paths(repo_root)
    if dirty:
        die("main worktree is dirty; refusing to publish CI evidence:\n" + "\n".join(dirty))
    fetch_ok, fetch_message = maybe_fetch(repo_root, runtime.remote_name)
    if not fetch_ok:
        die(
            f"git fetch from {runtime.remote_name} failed before main CI publication: "
            f"{fetch_message or 'unknown error'}"
        )
    origin_ref, origin_sha, behind_count, ahead_count = origin_status(
        repo_root, main_branch, runtime.remote_name
    )
    if origin_ref is None or origin_sha is None:
        die(f"cannot verify advertised {runtime.remote_name}/{main_branch}")
    if behind_count:
        die(
            f"local {main_branch} is {behind_count} commit(s) behind {origin_ref}; "
            "refusing rewritten-main CI recovery"
        )
    if not ahead_count:
        die(f"local {main_branch} has no unpushed commits ahead of {origin_ref}")
    main_sha = git_output(repo_root, ["rev-parse", "HEAD"])
    if not is_ancestor(repo_root, origin_sha, main_sha):
        die(f"local {main_branch} has diverged from {origin_ref}; refusing CI publication")
    advertised_main_sha = remote_ref_sha(
        repo_root, runtime.remote_name, runtime.guarded_ref
    )
    if advertised_main_sha != origin_sha:
        die(
            f"{runtime.remote_name}/{main_branch} moved after fetch: advertised "
            f"{advertised_main_sha or 'nothing'}, expected {origin_sha}; rerun the command"
        )

    ci_ref = main_ci_remote_ref(main_branch, main_sha)
    initial = check_pipeline(repo_root, runtime, main_sha, ci_ref)
    print_workflow_evidence(initial)
    if getattr(runtime, "provider", None) == "github" and initial["outcome"] in {"terminal", "error"}:
        die(f"main CI blocked for {main_sha}: {initial.get('detail', 'no detail')}; no ref was published")
    if initial["outcome"] == "success":
        ensure_main_ci_state_unchanged(
            repo_root,
            runtime,
            main_branch,
            main_sha,
            origin_sha,
            None,
        )
        persist_evidence(repo_root, runtime, initial, before_sha=origin_sha, landing_sha=main_sha)
        print(
            f"PASS main CI: {runtime.required_job} already succeeded for {main_sha}; "
            "no temporary ref was published"
        )
        return 0

    remote_ref, published = publish_main_ci_ref(repo_root, runtime, main_branch, main_sha)
    action = "Published" if published else "Reusing"
    print(
        f"{action} rewritten main at {main_sha} through "
        f"{runtime.remote_name}/{remote_ref.removeprefix('refs/heads/')}"
    )
    if initial["outcome"] == "bypass":
        print(
            "BYPASS main CI: override is active. The temporary CI ref is retained, "
            "and main/tags were not pushed."
        )
        return 0

    deadline = time.monotonic() + parsed.poll_timeout
    latest = initial
    for attempt in range(1, maximum_checks + 1):
        if attempt > 1 and time.monotonic() >= deadline:
            break
        latest = check_pipeline(repo_root, runtime, main_sha, ci_ref)
        print_workflow_evidence(latest)
        outcome = latest["outcome"]
        detail = str(latest.get("detail") or "no detail")
        if outcome == "success":
            break
        if outcome == "bypass":
            print(
                "BYPASS main CI: override became active while polling. The temporary "
                "CI ref is retained, and main/tags were not pushed."
            )
            return 0
        if outcome in {"terminal", "error"}:
            die(
                f"main CI blocked for {main_sha}: {detail}; temporary CI ref "
                f"{remote_ref} was retained and main/tags were not pushed"
            )
        print(
            f"Waiting for {runtime.required_job} on rewritten main {main_sha} "
            f"({attempt}/{maximum_checks}): {detail}"
        )
        if attempt < maximum_checks:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            time.sleep(min(parsed.poll_interval, remaining))
    if latest.get("outcome") != "success":
        remaining = deadline - time.monotonic()
        if remaining > 0:
            time.sleep(remaining)
        detail = str(latest.get("detail") or "no successful job observed")
        die(
            f"timed out after {parsed.poll_timeout}s waiting for {runtime.required_job} "
            f"on {main_sha}: {detail}; temporary CI ref {remote_ref} was retained and "
            "main/tags were not pushed"
        )

    ensure_main_ci_state_unchanged(
        repo_root,
        runtime,
        main_branch,
        main_sha,
        origin_sha,
        remote_ref,
    )
    persist_evidence(repo_root, runtime, latest, before_sha=origin_sha, landing_sha=main_sha)
    cleanup = cleanup_main_ci_ref(repo_root, runtime, remote_ref, main_sha)
    if not cleanup.get("cleaned"):
        print(
            f"PARTIAL main CI: {runtime.required_job} succeeded for {main_sha}, but temporary "
            f"CI ref cleanup failed: {cleanup.get('reason', 'unknown reason')}"
        )
        print("- Main/tags pushed: no")
        return 1
    qualifier = "already absent" if cleanup.get("already_absent") else "deleted"
    print(f"PASS main CI: {runtime.required_job} succeeded for {main_sha}")
    print(f"- Temporary CI ref: {qualifier} ({remote_ref})")
    print("- Main/tags pushed: no")
    return 0


def update_main_from_origin(ctx: MergeContext, remote_name: str) -> None:
    if ctx.origin_ref is None:
        die(
            f"cannot update {ctx.main_branch}: "
            f"{remote_name}/{ctx.main_branch} does not exist"
        )
    fetch_ok, fetch_message = maybe_fetch(ctx.main_worktree, remote_name)
    if not fetch_ok:
        die(f"git fetch failed before updating {ctx.main_branch}: {fetch_message or 'unknown error'}")
    result = run_git(ctx.main_worktree, ["merge", "--ff-only", ctx.origin_ref], check=False)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "git merge --ff-only failed").strip()
        die(f"could not fast-forward {ctx.main_branch} from {ctx.origin_ref}: {detail}")


def reexec_after_main_update(ctx: MergeContext, argv: list[str], *, expected_contract: tuple[str | None, bytes]) -> None:
    canonical = canonical_helper_path(ctx.main_worktree)
    if canonical is None:
        die(
            f"updated {ctx.main_branch}, but it no longer provides an executable merge helper; "
            "the feature branch was not merged"
        )
    dirty = helper_dirty_paths(ctx.main_worktree, canonical)
    if dirty:
        die(
            f"updated {ctx.main_branch}, but its helper path is dirty; the feature branch was not merged:\n"
            + "\n".join(dirty)
        )
    if ci_contract(canonical) != expected_contract:
        die(
            f"updated {ctx.main_branch}, but helper mode changed or its evidence contract changed; the feature branch was not merged. "
            "Rediscover helper capabilities and obtain approval before retrying"
        )
    next_argv = [
        item for item in argv if item not in {"--update-main", LOCAL_HELPER_FLAG}
    ]
    exec_helper(canonical, next_argv, after_main_update=True)
    die("failed to re-execute the helper after updating main")


def ensure_merge_preconditions(
    ctx: MergeContext,
    *,
    ci_gated: bool,
    remote_name: str,
    update_main: bool,
) -> MergeContext:
    if ci_gated and (not ctx.fetch_attempted or not ctx.fetch_ok):
        die(
            f"git fetch from {remote_name} failed before merge: "
            f"{ctx.fetch_message or 'unknown error'}"
        )
    if ctx.main_dirty_paths:
        paths = "\n".join(ctx.main_dirty_paths)
        die(f"main worktree is dirty; refusing to merge:\n{paths}")
    if ctx.origin_behind_count and ctx.origin_behind_count > 0:
        if ctx.origin_ahead_count:
            die(f"{ctx.main_branch} has diverged from {ctx.origin_ref}; reconcile it before merging")
        if not update_main:
            die(
                f"{ctx.main_branch} is behind {ctx.origin_ref} by {ctx.origin_behind_count} commit(s); "
                "rerun with --update-main only after user approval"
            )
    if ctx.commits_ahead == 0:
        die(f"{ctx.feature_branch} has no commits ahead of {ctx.main_branch}")
    if ci_gated and ctx.origin_sha is None:
        die(f"cannot verify advertised {remote_name}/{ctx.main_branch}")
    return ctx


def actor_env(actor: str) -> dict[str, str]:
    spec = ACTORS[actor]
    env = os.environ.copy()
    env.update(
        {
            "GIT_AUTHOR_NAME": spec["name"],
            "GIT_AUTHOR_EMAIL": spec["email"],
            "GIT_COMMITTER_NAME": spec["name"],
            "GIT_COMMITTER_EMAIL": spec["email"],
        }
    )
    return env


def merge_failure_message(ctx: MergeContext, result: subprocess.CompletedProcess[str]) -> str:
    detail = (result.stderr or result.stdout or "git merge failed").strip()
    conflicts = run_git(ctx.main_worktree, ["diff", "--name-only", "--diff-filter=U"], check=False)
    conflict_paths = [line for line in conflicts.stdout.splitlines() if line]
    if conflict_paths:
        detail = f"{detail}\nconflicted paths:\n" + "\n".join(conflict_paths)
    return detail


def close_beads_issue(
    *,
    ctx: MergeContext,
    actor: str,
    issue_id: str | None,
    before_sha: str,
    after_sha: str,
) -> dict[str, Any]:
    if issue_id is None:
        return {"requested": False, "closed": False, "reason": "not requested"}

    spec = ACTORS[actor]
    state_file = ctx.original_worktree / ".beads" / spec["state_file"]
    state = inspect_beads_state(
        state_file=state_file,
        expected_issue_id=issue_id,
        feature_branch=ctx.feature_branch,
        original_worktree=ctx.original_worktree,
        repo_root=ctx.original_worktree,
        target_ref=after_sha,
    )
    if not state["matches"]:
        return {
            "requested": True,
            "closed": False,
            "state_file": str(state_file),
            "reason": "state did not validate",
            "problems": state["problems"],
        }

    started_sha = str(state["started_sha"])
    merged_shas = list_range(
        ctx.main_worktree,
        f"{started_sha}..{after_sha}",
        "%h",
        exclude_refs=(before_sha,),
    )
    if not merged_shas:
        merged_shas = list_range(ctx.main_worktree, f"{before_sha}..{after_sha}", "%h")
    reason_shas = " ".join(merged_shas)
    if not reason_shas:
        reason_shas = git_output(ctx.main_worktree, ["rev-parse", "--short", after_sha])
    reason = f"Fixed with commit(s) {reason_shas}"
    try:
        result = subprocess.run(
            ["bd", "close", issue_id, "--reason", reason, "--actor", spec["name"]],
            cwd=str(ctx.original_worktree),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        return {
            "requested": True,
            "closed": False,
            "state_file": str(state_file),
            "reason": "bd close failed",
            "stderr": str(exc),
        }
    if result.returncode != 0:
        return {
            "requested": True,
            "closed": False,
            "state_file": str(state_file),
            "reason": "bd close failed",
            "stdout": result.stdout.strip(),
            "stderr": result.stderr.strip(),
        }
    try:
        state_file.unlink()
    except OSError as exc:
        return {
            "requested": True,
            "closed": True,
            "state_file": str(state_file),
            "reason": reason,
            "warning": f"could not remove state file: {exc}",
        }
    return {"requested": True, "closed": True, "state_file": str(state_file), "reason": reason}


def beads_partial_failure(beads: dict[str, Any]) -> bool:
    return bool(beads.get("requested")) and (
        not beads.get("closed") or bool(beads.get("warning"))
    )


def cleanup_remote_feature(
    ctx: MergeContext,
    runtime: PipelineRuntime,
    feature_sha: str,
    pipeline_outcome: str,
) -> dict[str, Any]:
    remote_ref = feature_remote_ref(ctx.feature_branch)
    if pipeline_outcome != "success":
        return {
            "requested": False,
            "cleaned": False,
            "retained": True,
            "remote_ref": remote_ref,
            "reason": "pipeline guard was bypassed; remote evidence retained",
        }

    result: dict[str, Any] = {
        "requested": True,
        "cleaned": False,
        "retained": True,
        "remote_ref": remote_ref,
        "expected_sha": feature_sha,
    }
    try:
        advertised_sha = remote_ref_sha(ctx.original_worktree, runtime.remote_name, remote_ref)
    except (AgentWtMergeError, OSError) as exc:
        result["reason"] = str(exc)
        return result
    result["advertised_sha"] = advertised_sha
    if advertised_sha is None:
        result.update(
            {
                "cleaned": True,
                "retained": False,
                "already_absent": True,
                "reason": "remote feature branch was already absent",
            }
        )
        return result
    if advertised_sha != feature_sha:
        result["reason"] = (
            f"remote feature moved to {advertised_sha}; exact-lease deletion was not attempted"
        )
        return result

    try:
        deletion = run_git(
            ctx.original_worktree,
            [
                "push",
                "--porcelain",
                f"--force-with-lease={remote_ref}:{feature_sha}",
                "--",
                runtime.remote_name,
                f":{remote_ref}",
            ],
            check=False,
        )
    except OSError as exc:
        result["reason"] = f"lease-protected remote deletion failed: {exc}"
        return result
    if deletion.returncode != 0:
        result["reason"] = (
            deletion.stderr or deletion.stdout or "lease-protected remote deletion failed"
        ).strip()
        return result
    try:
        remaining_sha = remote_ref_sha(ctx.original_worktree, runtime.remote_name, remote_ref)
    except (AgentWtMergeError, OSError) as exc:
        result["reason"] = f"deletion ran but verification failed: {exc}"
        return result
    if remaining_sha is not None:
        result["advertised_sha"] = remaining_sha
        result["reason"] = (
            f"deletion verification found {remote_ref} at {remaining_sha}; no second deletion attempted"
        )
        return result
    result.update(
        {
            "cleaned": True,
            "retained": False,
            "advertised_sha": None,
            "reason": "exact-lease deletion succeeded",
        }
    )
    return result


def remote_cleanup_partial_failure(remote_cleanup: dict[str, Any]) -> bool:
    return bool(remote_cleanup.get("requested")) and not bool(
        remote_cleanup.get("cleaned")
    )


def persist_evidence(repo_root: Path, runtime: PipelineRuntime, result: dict[str, Any], **landing) -> str | None:
    if getattr(runtime, "provider", None) != "github":
        return None
    shared = pipeline_module()
    try:
        return shared.save_evidence(repo_root, runtime, result, **landing)
    except (shared.PipelineRuntimeError, OSError) as exc:
        die(f"workflow evidence could not be recorded; remote evidence was retained: {exc}")


def print_cleanup(cleanup: dict[str, Any], *, after_merge: bool) -> None:
    if cleanup["action"] == "defer":
        print(f"- Cleanup deferred to {cleanup['manager']}: {cleanup['note']}")
        return
    qualifier = "not run; " if after_merge else ""
    print(f"- Cleanup suggestion ({qualifier}ask before running; run from workdir below):")
    print(f"  workdir: {cleanup['workdir']}")
    for command in cleanup["commands"]:
        print(f"  command: {command}")


def print_merge_report(report: dict[str, Any]) -> None:
    print(f"Merged {report['feature_branch']} into {report['main_branch']}")
    helper = report["helper"]
    print(f"- Helper: {helper['path']} ({helper['state']})")
    if helper.get("delegated_from"):
        print(f"  - Delegated from: {helper['delegated_from']}")
    if helper.get("reexecuted_after_main_update"):
        print("  - Re-executed after main update: yes")
    print(f"- Merge type: {report['merge_type']}")
    print(f"- Merge mode: {report['mode']}")
    print(f"- Main SHA before: {report['main_sha_before'][:12]}")
    print(f"- Main SHA after: {report['main_sha_after'][:12]}")
    print(f"- Commits merged: {report['commits_merged']}")
    if report.get("merge_commit_author"):
        print(f"- Merge commit author: {report['merge_commit_author']}")
    pipeline = report["pipeline"]
    if pipeline is None:
        print("- Feature CI: not performed (local-only)")
        print("- Feature publication: not performed")
    else:
        print(
            f"- Feature CI: {pipeline['outcome']} "
            f"({pipeline.get('detail') or 'no detail'})"
        )
    if report["main_ci_required"]:
        print(
            f"- Main push requires successful exact-SHA CI for {report['main_sha_after']}. "
            "At batch end, run prepare-main-ci from the main worktree with approval if evidence "
            "is missing, then retry the original push separately. Later commits require new evidence."
        )
    if report["fetch_warning"]:
        print(f"- Fetch warning: {report['fetch_warning']}")
    if report.get("evidence_path"):
        print_workflow_evidence(pipeline)
        print(f"- Workflow evidence record: {report['evidence_path']}")
    if report.get("evidence_error"):
        print(f"- Partial failure: merge landed at {report['main_sha_after']}, but {report['evidence_error']}")
    remote_cleanup = report["remote_cleanup"]
    if pipeline is None:
        print("- Remote feature cleanup: not performed (local-only)")
    elif remote_cleanup.get("cleaned"):
        qualifier = "already absent" if remote_cleanup.get("already_absent") else "deleted"
        print(
            f"- Remote feature cleanup: {qualifier} "
            f"({report['remote_name']}/{report['feature_branch']})"
        )
    elif remote_cleanup.get("retained"):
        print(f"- Remote feature cleanup: retained ({remote_cleanup.get('reason', 'unknown reason')})")
    else:
        print(f"- Remote feature cleanup: not completed ({remote_cleanup.get('reason', 'unknown reason')})")
    beads = report["beads"]
    if beads.get("closed"):
        print(f"- Beads issue closed: yes ({report['close_beads']})")
        print(f"  - Close reason: {beads.get('reason', 'unknown')}")
        if beads.get("warning"):
            print(f"  - Warning: {beads['warning']}")
    elif beads.get("requested"):
        print(f"- Beads issue closed: no ({beads.get('reason', 'unknown reason')})")
        for problem in beads.get("problems", []):
            print(f"  - {problem}")
        if beads.get("stdout"):
            print(f"  - bd stdout: {beads['stdout']}")
        if beads.get("stderr"):
            print(f"  - bd stderr: {beads['stderr']}")
    else:
        print("- Beads issue closed: no (not requested)")
    print_cleanup(report["cleanup"], after_merge=True)
    print("- Main/tags pushed: no")
    if remote_cleanup_partial_failure(remote_cleanup):
        print(
            "Partial failure: Git merge succeeded, but lease-protected remote feature cleanup did not complete."
        )
    if beads_partial_failure(beads):
        if beads.get("closed"):
            print(
                "Partial failure: Git merge and Beads closure succeeded, but Beads state cleanup did not complete."
            )
        else:
            print("Partial failure: Git merge succeeded, but requested Beads closure did not complete.")


def add_local_helper_argument(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        LOCAL_HELPER_FLAG,
        action="store_true",
        help="use this worktree's helper instead of delegating to main (requires prior approval)",
    )


def perform_merge(
    raw_args: list[str],
    *,
    merge_type: str,
    helper: HelperProvenance,
) -> int:
    parser = argparse.ArgumentParser(prog=f"{SCRIPT_NAME} {merge_type}")
    parser.add_argument("--actor", required=True, choices=tuple(ACTORS), help="agent identity for merge commits")
    parser.add_argument("--update-main", action="store_true", help="fast-forward main from origin/main before merging")
    parser.add_argument("--close-beads", metavar="ISSUE_ID", help="close a matching Beads issue after a successful merge")
    add_local_helper_argument(parser)
    if merge_type == "no-ff":
        parser.add_argument("-m", "--message", action="append", required=True, help="merge commit message paragraph")
    parsed = parser.parse_args(raw_args)

    full_argv = [merge_type, *raw_args]
    repo_root = resolve_repo_root()
    ci_gated = ci_enabled(helper.path)
    expected_contract = ci_contract(helper.path)
    runtime = load_pipeline_runtime(helper, resolve_main_branch(repo_root)) if ci_gated else None
    remote_name = runtime.remote_name if runtime else "origin"
    ctx = ensure_merge_preconditions(
        build_context(fetch=True, helper=helper, remote_name=remote_name),
        ci_gated=ci_gated,
        remote_name=remote_name,
        update_main=parsed.update_main,
    )
    before_sha = ctx.main_sha
    feature_sha = ctx.feature_sha
    updating_main = bool(ctx.origin_behind_count and parsed.update_main)
    if not updating_main:
        if merge_type == "ff":
            if not ctx.fast_forward_possible:
                die("fast-forward is not possible; use the no-ff command after drafting a merge message")
        else:
            if ctx.fast_forward_possible:
                die("fast-forward is possible; use the ff command instead of creating a no-ff merge commit")

    pipeline_result = None
    if runtime is not None:
        require_remote_feature(ctx, runtime, feature_sha)
        pipeline_result = check_pipeline(ctx.original_worktree, runtime, feature_sha, feature_remote_ref(ctx.feature_branch))
        if pipeline_result["outcome"] not in {"success", "bypass"}:
            detail = str(pipeline_result.get("detail") or "no detail")
            die(f"feature CI blocked for {feature_sha}: {detail}; run prepare-ci and retry")

        advertised_main_sha = remote_ref_sha(
            ctx.original_worktree,
            runtime.remote_name,
            runtime.guarded_ref,
        )
        if advertised_main_sha != ctx.origin_sha:
            die(
                f"{runtime.remote_name}/{ctx.main_branch} moved after fetch: advertised "
                f"{advertised_main_sha or 'nothing'}, expected {ctx.origin_sha}; rerun the command"
            )
    if ctx.origin_behind_count and parsed.update_main:
        update_main_from_origin(ctx, remote_name)
        reexec_after_main_update(ctx, full_argv, expected_contract=expected_contract)

    if git_output(ctx.main_worktree, ["rev-parse", "HEAD"]) != before_sha or dirty_paths(ctx.main_worktree):
        die("main changed while merge evidence was inspected; feature was not merged")
    if ci_contract(helper.path) != expected_contract:
        die("pipeline evidence contract changed; rediscover capabilities before merging")
    if merge_type == "ff":
        result = run_git(ctx.main_worktree, ["merge", "--ff-only", feature_sha], check=False)
    else:
        merge_args = ["merge", "--no-ff"]
        if parsed.actor == "opencode":
            message = "\n\n".join(parsed.message) + "\n"
            formatted = subprocess.run(
                [
                    "git", "-c", "trailer.separators=:",
                    "-c", "trailer.Co-authored-by.key=Co-authored-by",
                    "-c", "trailer.Co-authored-by.where=start",
                    "-c", "trailer.Co-authored-by.ifexists=addIfDifferent",
                    "-c", "trailer.Co-authored-by.ifmissing=add",
                    "-c", "trailer.Co-authored-by.cmd=printf %s",
                    "interpret-trailers", "--no-divider", "--trailer",
                    "Co-authored-by: opencode-agent[bot] <opencode-agent[bot]@users.noreply.github.com>",
                ],
                cwd=str(ctx.main_worktree),
                input=message,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            if formatted.returncode != 0:
                die(f"could not format OpenCode merge message: {formatted.stderr.strip()}")
            merge_args.extend(["-m", formatted.stdout.rstrip("\n")])
        else:
            for paragraph in parsed.message:
                merge_args.extend(["-m", paragraph])
        merge_args.append(feature_sha)
        result = run_git(ctx.main_worktree, merge_args, check=False, env=actor_env(parsed.actor))
    if result.returncode != 0:
        die(merge_failure_message(ctx, result))

    after_sha = git_output(ctx.main_worktree, ["rev-parse", "HEAD"])
    commits_merged = count_range(ctx.main_worktree, f"{before_sha}..HEAD")
    merge_commit_author = None
    if merge_type == "no-ff":
        merge_commit_author = git_output(ctx.main_worktree, ["log", "-1", "--format=%an <%ae>"])

    remote_cleanup = {"requested": False}
    evidence_path = None
    evidence_error = None
    if runtime is not None and pipeline_result is not None:
        try:
            evidence_path = persist_evidence(ctx.original_worktree, runtime, pipeline_result, before_sha=before_sha, landing_sha=after_sha)
        except AgentWtMergeError as exc:
            evidence_error = str(exc)
        if evidence_error is None:
            remote_cleanup = cleanup_remote_feature(ctx, runtime, feature_sha, str(pipeline_result["outcome"]))
        else:
            remote_cleanup = {"requested": False, "retained": True, "reason": evidence_error}
    try:
        beads_result = close_beads_issue(
            ctx=ctx,
            actor=parsed.actor,
            issue_id=parsed.close_beads,
            before_sha=before_sha,
            after_sha=after_sha,
        )
    except (AgentWtMergeError, OSError) as exc:
        beads_result = {
            "requested": parsed.close_beads is not None,
            "closed": False,
            "reason": f"Beads closure could not be evaluated: {exc}",
        }
    report = {
        "mode": "CI-gated" if ci_gated else "local-only",
        "main_ci_required": ci_gated and merge_type == "no-ff" and before_sha != ctx.origin_sha,
        "fetch_warning": ctx.fetch_message if not ctx.fetch_ok else None,
        "merge_type": merge_type,
        "main_branch": ctx.main_branch,
        "feature_branch": ctx.feature_branch,
        "main_sha_before": before_sha,
        "main_sha_after": after_sha,
        "commits_merged": commits_merged,
        "merge_commit_author": merge_commit_author,
        "pipeline": pipeline_result,
        "remote_name": remote_name,
        "remote_cleanup": remote_cleanup,
        "evidence_path": evidence_path,
        "evidence_error": evidence_error,
        "close_beads": parsed.close_beads,
        "beads": beads_result,
        "cleanup": ctx.cleanup,
        "helper": helper_provenance_dict(helper),
    }
    print_merge_report(report)
    return 1 if (
        remote_cleanup_partial_failure(remote_cleanup)
        or beads_partial_failure(beads_result)
        or evidence_error is not None
    ) else 0


def cmd_inspect(raw_args: list[str], *, helper: HelperProvenance) -> int:
    parser = argparse.ArgumentParser(prog=f"{SCRIPT_NAME} inspect")
    parser.add_argument("--fetch", action="store_true", help="run best-effort git fetch before reporting origin status")
    parser.add_argument("--json", action="store_true", help="print machine-readable JSON")
    add_local_helper_argument(parser)
    parsed = parser.parse_args(raw_args)
    provider = ci_provider(helper.path)
    runtime = load_pipeline_runtime(helper, resolve_main_branch(resolve_repo_root())) if provider == "github" else None
    ctx = build_context(fetch=parsed.fetch, helper=helper, remote_name=runtime.remote_name if runtime else "origin")
    payload = context_dict(ctx)
    if runtime is not None:
        shared = pipeline_module()
        try:
            store = shared.EvidenceStore(ctx.original_worktree)
            store.records()
            payload["pipeline"] = {"provider": provider, "policy_fingerprint": runtime.policy.fingerprint, "evidence_store": str(store.path)}
        except shared.PipelineRuntimeError as exc:
            die(str(exc))
    if parsed.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print_context_text(ctx)
        if "pipeline" in payload:
            print(f"- Workflow evidence store: {payload['pipeline']['evidence_store']}")
    return 0


def cmd_prune_evidence(raw_args: list[str], *, helper: HelperProvenance) -> int:
    parser = argparse.ArgumentParser(prog=f"{SCRIPT_NAME} prune-evidence")
    parser.add_argument("--apply", action="store_true", help="remove only freshly verified eligible local evidence records")
    parser.add_argument("--json", action="store_true")
    add_local_helper_argument(parser)
    parsed = parser.parse_args(raw_args)
    if ci_provider(helper.path) != "github":
        die("prune-evidence is unsupported by this helper's policy contract")
    shared = pipeline_module()
    try:
        root = resolve_repo_root()
        runtime = load_pipeline_runtime(helper, resolve_main_branch(root))
        report = shared.EvidenceStore(root).prune(runtime.policy, apply=parsed.apply)
    except (shared.PipelineRuntimeError, OSError) as exc:
        die(str(exc))
    if parsed.json:
        print(json.dumps(report, sort_keys=True, indent=2))
    else:
        print(f"Workflow evidence store: {report['evidence_store']}")
        print(f"Evidence pruning: {'apply' if parsed.apply else 'preview only'}")
        for item in report["records"]:
            print(f"- {item['key']}: {item['action']} ({item['reason']})")
        if report["error"]:
            eprint(report["error"])
    return 1 if report["error"] else 0


def usage() -> str:
    text = f"""Usage:
  ./assets/{SCRIPT_NAME} inspect [--fetch] [--json] [{LOCAL_HELPER_FLAG}]
  ./assets/{SCRIPT_NAME} prepare-ci [--poll-interval <seconds>] [--poll-timeout <seconds>] [{LOCAL_HELPER_FLAG}]
  ./assets/{SCRIPT_NAME} prepare-main-ci [--poll-interval <seconds>] [--poll-timeout <seconds>] [{LOCAL_HELPER_FLAG}]
  ./assets/{SCRIPT_NAME} ff --actor <opencode|claude> [--update-main] [--close-beads <issue-id>] [{LOCAL_HELPER_FLAG}]
  ./assets/{SCRIPT_NAME} no-ff --actor <opencode|claude> -m <subject> [-m <body>] [--update-main] [--close-beads <issue-id>] [{LOCAL_HELPER_FLAG}]

Commands:
  inspect  Report merge target facts and cleanup suggestions.
  prepare-ci  Publish the exact feature tip and wait for required CI.
  prepare-main-ci  Publish an unpushed main tip to a temporary ref and wait for CI.
  ff       Fast-forward main/master to the current feature branch.
  no-ff    Create a no-ff merge commit on main/master.
"""
    provider = ci_provider(running_helper_path())
    if provider == "github":
        text = text.replace("\nCommands:\n", f"  ./assets/{SCRIPT_NAME} prune-evidence [--apply] [--json] [{LOCAL_HELPER_FLAG}]\n\nCommands:\n")
        text += "  prune-evidence  Preview or explicitly prune landed, remote-confirmed evidence.\n"
    if provider is None:
        text = "".join(
            line for line in text.splitlines(keepends=True)
            if "prepare-ci" not in line and "prepare-main-ci" not in line
        )
    return text


def dispatch(command: str, raw_args: list[str], helper: HelperProvenance) -> int:
    if command == "inspect":
        return cmd_inspect(raw_args, helper=helper)
    if command == "prepare-ci":
        return cmd_prepare_ci(raw_args, helper=helper)
    if command == "prepare-main-ci":
        return cmd_prepare_main_ci(raw_args, helper=helper)
    if command == "prune-evidence":
        return cmd_prune_evidence(raw_args, helper=helper)
    if command in {"ff", "no-ff"}:
        return perform_merge(raw_args, merge_type=command, helper=helper)
    die(f"unknown command: {command}")


def main(argv: list[str]) -> int:
    global ACTIVE_EVIDENCE_TOKEN
    try:
        if not argv or argv[0] in {"-h", "--help"}:
            print(usage(), end="")
            return 0
        command, raw_args = argv[0], argv[1:]
        helper = prepare_helper_execution(
            argv,
            allow_main=command in {"prepare-main-ci", "prune-evidence"},
        )
        if ci_provider(helper.path) != "github" or command not in {"prepare-ci", "prepare-main-ci", "ff", "no-ff"}:
            return dispatch(command, raw_args, helper)
        shared = pipeline_module()
        try:
            store = shared.EvidenceStore(resolve_repo_root())
            inherited_token = os.environ.pop(EVIDENCE_OPERATION_ENV, None)
            token = store.resume_operation(inherited_token) if inherited_token else store.start_operation()
            ACTIVE_EVIDENCE_TOKEN = token
        except (shared.PipelineRuntimeError, OSError) as exc:
            die(str(exc))
        result = 2
        try:
            result = dispatch(command, raw_args, helper)
        finally:
            ACTIVE_EVIDENCE_TOKEN = None
            try:
                store.finish_operation(token)
            except (shared.PipelineRuntimeError, OSError) as exc:
                eprint(f"Partial failure: evidence operation marker retained: {exc}; do not retry a landed merge")
                if result == 0:
                    result = 1
        return result
    except AgentWtMergeError as exc:
        eprint(str(exc))
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
