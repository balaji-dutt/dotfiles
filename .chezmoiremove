{{- /* SECTION 1: Remove MacOS files if found on Linux/Windows */ -}}
{{ if ne .chezmoi.os "darwin" }}
.gitignore_global
.zpreztorc
.zshrc
.p10k.zsh
.zsh_plugins.txt
.local/config/.p10k.zsh
Library
{{ end }}

{{- /* SECTION 2: Remove Linux files if found on macOS/Windows */ -}}
{{ if ne .chezmoi.os "linux" }}
.config/lazygit
.config/sublime-merge
{{ end }}

{{- /* SECTION 2a: Remove Doom files if NOT on macOS or Ubuntu WSL2 */ -}}
{{- /* This cleans up Doom files on platforms where they should not exist */ -}}
{{ if and (ne .chezmoi.os "darwin") (not (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") (.chezmoi.kernel.osrelease | lower | contains "microsoft"))) }}
.config/doom/
.config/doom/**
{{ end }}

{{- /* SECTION 3: Remove files on Ubuntu 22.04 WSL */ -}}
{{ if eq .chezmoi.os "linux" }}
{{   if and (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.versionID "22.04") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
Documents/development/container-dotfiles
{{   end }}
{{ end }}

{{- /* SECTION 4: Remove Global Repo Metadata */ -}}
ansible/
ansible/**
assets/
assets/**
archive/
archive/**
configs/
configs/**
docs/
docs/**
brewfile.txt
bootstrap-wsl.sh
.local/config/gitignore_global.txt
.ansible.cfg
README.md
PLAN.md
AGENTS.md
CLAUDE.md