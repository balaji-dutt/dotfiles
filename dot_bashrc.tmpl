{{-   $isWSL = or (get . "isWSL" | default false) ($osrel | contains "microsoft") -}}
{{- end -}}

{{- if $isWSL }}

# Set language variables
export LANG=en_GB.UTF-8
export LC_MESSAGES=en_GB.UTF-8
export LC_TIME=en_SG.UTF-8
export LC_NUMERIC=en_SG.UTF-8
export LC_MONETARY=en_SG.UTF-8
export LANGUAGE=en_GB:en_US

# Update path for local binaries
export PATH=~/.local/bin:$HOME/bin:$PATH

{{- if and (eq .chezmoi.osRelease.id "ubuntu") $isWSL }}
# Set Browser variable for WSL browser integration
export BROWSER=wslview
{{- end }}

# Set $EDITOR to nano if available else fallback to vi
# else in a WSLg environment set $EDITOR & $VISUAL to VSCode
# and SUDO_EDITOR to visudo
EDITOR="$(command -v nano 2>/dev/null || command -v vi)"

if command -v code >/dev/null 2>&1 \
&& [ "$SSH_TTY$DISPLAY" = "${DISPLAY#*:[1-9][0-9]}" ]; then
  export VISUAL="$(command -v code) --wait"
  EDITOR="$VISUAL"
  SUDO_EDITOR="$(command -v visudo)"
else
  SUDO_EDITOR="$(command -v visudo)"
fi

# Pageant/WSL2 inter-op (via npiperelay + socat)

WSL2_PAGEANT_SSH_AUTH_SOCK=${WSL2_PAGEANT_SSH_AUTH_SOCK:-/tmp/wsl2-ssh-agent/ssh-agent.sock}
NPIPERELAY_EXE="/mnt/c/Users/{{ .homelab.windows_user }}/{{ .homelab.npiperelay_path }}"
PAGEANT_PIPE='//./pipe/ssh-pageant'
WSL2_PAGEANT_PGREP_PATTERN='socat.*npiperelay\.exe.*ssh-pageant'

_wsl2_pageant_agent_ok() {
  [ -n "${SSH_AUTH_SOCK:-}" ] || return 1
  [ -S "$SSH_AUTH_SOCK" ] || return 1

  if command -v ssh-add >/dev/null 2>&1; then
    ssh-add -l >/dev/null 2>&1
    case $? in
      0|1) return 0 ;;
      *) return 1 ;;
    esac
  fi

  return 0
}

_wsl2_pageant_kill() {
  local pattern="${1:-$WSL2_PAGEANT_PGREP_PATTERN}"

  if command -v pkill >/dev/null 2>&1; then
    pkill -f "$pattern" >/dev/null 2>&1 || true
  else
    local pids
    pids="$(pgrep -f "$pattern" 2>/dev/null)"
    [ -n "$pids" ] && kill $pids >/dev/null 2>&1 || true
  fi
}

_wsl2_pageant_start() {
  if command -v setsid >/dev/null 2>&1; then
    setsid -f socat \
      EXEC:"$NPIPERELAY_EXE -ei -s $PAGEANT_PIPE" \
      UNIX-LISTEN:"$SSH_AUTH_SOCK",unlink-close,fork \
      </dev/null >/dev/null 2>&1
  else
    nohup socat \
      EXEC:"$NPIPERELAY_EXE -ei -s $PAGEANT_PIPE" \
      UNIX-LISTEN:"$SSH_AUTH_SOCK",unlink-close,fork \
      </dev/null >/dev/null 2>&1 &
  fi
}

pageant_ensure() {
  command -v socat >/dev/null 2>&1 || return 1
  [ -x "$NPIPERELAY_EXE" ] || return 1

  mkdir -p "$(dirname "$SSH_AUTH_SOCK")"

  if _wsl2_pageant_agent_ok; then
    return 0
  fi

  local attempt
  for (( attempt = 0; attempt < 6; attempt++ )); do
    _wsl2_pageant_kill "$WSL2_PAGEANT_PGREP_PATTERN"
    rm -f "$SSH_AUTH_SOCK" >/dev/null 2>&1 || true
    _wsl2_pageant_start

    local i
    for (( i = 0; i < 50; i++ )); do
      _wsl2_pageant_agent_ok && return 0
      sleep 0.1
    done

    sleep 0.5
  done

  return 1
}

export SSH_AUTH_SOCK="$WSL2_PAGEANT_SSH_AUTH_SOCK"
pageant_ensure

# Wrap the previous commands in a function so that we can reconnect to Pageant
# in case of socat crash.

sset () {
  export SSH_AUTH_SOCK="$WSL2_PAGEANT_SSH_AUTH_SOCK"

  _wsl2_pageant_kill "$WSL2_PAGEANT_PGREP_PATTERN"

  rm -f "$SSH_AUTH_SOCK" >/dev/null 2>&1 || true

  if pageant_ensure; then
    echo "Pageant socket reconnected: $SSH_AUTH_SOCK"
  else
    echo "Failed to reconnect Pageant socket."
    return 1
  fi
}

# Custom aliases
alias sunset=' unset SSH_AUTH_SOCK'

# Prompt for 1Password sign-in
alias ops=' eval $(op signin)'

{{ end -}}

{{- if or (eq .chezmoi.os "darwin")
          $isWSL }}

# OpenCode env (trusted file)
case $- in
  *a*)
    set +a
    _opencode_restore_allexport=1
    ;;
  *)
    unset _opencode_restore_allexport
    ;;
esac

OPENCODE_ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.env"
if [ -n "${_opencode_restore_allexport:-}" ]; then
  export OPENCODE_ENV_FILE
fi

if [ -r "$OPENCODE_ENV_FILE" ]; then
  set -a
  . "$OPENCODE_ENV_FILE"

  if [ -z "${_opencode_restore_allexport:-}" ]; then
    set +a
  fi
elif [ -n "${_opencode_restore_allexport:-}" ]; then
  set -a
fi

: "${PLANNOTATOR_PORT:={{ .plannotator_port }}}"
export PLANNOTATOR_PORT

{{- if $isWSL }}
: "${PLANNOTATOR_REMOTE:=1}"
export PLANNOTATOR_REMOTE

{{- end }}

: "${PLANNOTATOR_PORTS_BUILD:={{ .plannotator_ports.host.build | join "," }}}"
: "${PLANNOTATOR_PORTS_CLAUDE:={{ .plannotator_ports.host.claude | join "," }}}"
: "${PLANNOTATOR_PORTS_CUSTOM:={{ .plannotator_ports.host.custom | join "," }}}"
export PLANNOTATOR_PORTS_BUILD PLANNOTATOR_PORTS_CLAUDE PLANNOTATOR_PORTS_CUSTOM

_opencode_profile_helpers="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode-profile.sh"
if [ -r "$_opencode_profile_helpers" ]; then
  . "$_opencode_profile_helpers"
fi
unset _opencode_profile_helpers

unset _opencode_restore_allexport

{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# Force the 1Password CLI to use the desktop-app (biometric) integration instead
# of falling back to account-based sign-in. Without this, op can report
# "No accounts configured" and prompt for the account password every session.
export OP_BIOMETRIC_UNLOCK_ENABLED="${OP_BIOMETRIC_UNLOCK_ENABLED:-true}"
{{- end }}

# This is added at the end of the file to avoid potential conflicts
eval "$(direnv hook bash)"
