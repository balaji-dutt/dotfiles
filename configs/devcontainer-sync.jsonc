{
  "$schema": "./schemas/devcontainer-sync.v1.schema.json",
  "schema_version": 1,
  // Declarative source of truth for host->container-dotfiles synchronization.
  //
  // Categories:
  // - mirrors: deterministic file/directory copying
  // - derived: deterministic generated artifacts
  // - renders: runtime/secret materialization (future wiring)
  "shared": {
    "mirrors": [
      {
        "name": "opencode-user-config",
        "source_root": "private_dot_config/opencode",
        "target_root": "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode",
        "cleanup_managed": true,
        "include": [
          "AGENTS.md",
          "agents/**",
          "commands/**",
          "modes/**",
          "plugins/**",
          "skills/**",
          "tools/**",
          "themes/**",
          "prompts/**",
          "prompts/generated/**",
          "opencode-quota/**"
        ],
        "exclude": [
          "opencode.jsonc",
          "opencode-profile.sh",
          "opencode-sync-workspace-overrides.sh",
          "tui.json",
          "private_opencode.env.tmpl",
          "profiles/**",
          "opencode-notifier.json.tmpl"
        ]
      },
      {
        "name": "claude-user-config",
        "source_root": "dot_claude",
        "target_root": "private_Documents/development/container-dotfiles/dotfiles/dot_claude",
        "cleanup_managed": true,
        "include": [
          "AGENTS.md",
          "no-ai-isms.md",
          "symlink_CLAUDE.md",
          "settings-base.json",
          "agents/**",
          "skills/**",
          "hooks/**",
          "commands/**"
        ],
        "exclude": [
          "commands/todo.md",
          "executable_commit-docs.sh"
        ]
      },
      {
        "name": "github-cli-config",
        "source_root": "private_dot_config/gh",
        "target_root": "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/gh",
        "cleanup_managed": true,
        "include": [
          "**"
        ],
        "exclude": []
      },
      {
        "name": "gitlab-cli-config",
        "source_root": "private_dot_config/glab-cli",
        "target_root": "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/glab-cli",
        "cleanup_managed": true,
        "include": [
          "**"
        ],
        "exclude": []
      },
      {
        "name": "agent-of-empires-config",
        "source_root": "private_dot_config/agent-of-empires",
        "target_root": "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/agent-of-empires",
        "cleanup_managed": true,
        "include": [
          "**"
        ],
        "exclude": []
      },
      {
        "name": "user-bin-selected-wrappers",
        "source_root": "bin",
        "target_root": "private_Documents/development/container-dotfiles/dotfiles/dot_local/bin",
        "cleanup_managed": false,
        "include": [
          "executable_aoe-notify.tmpl",
          "executable_ai-wt.tmpl",
          "executable_cc-commit",
          "executable_claude-token-check",
          "executable_oc-commit"
        ],
        "exclude": []
      },
      {
        "name": "user-share-shell-helpers",
        "source_root": "dot_local/share",
        "target_root": "private_Documents/development/container-dotfiles/dotfiles/dot_local/share",
        "cleanup_managed": false,
        "include": [
          "beads-helpers.zsh",
          "beads-helpers.bash"
        ],
        "exclude": []
      }
    ],
    "derived": [],
    "renders": [
      {
        "name": "container-env",
        "description": "Reserved for manifest-driven render refactor"
      },
      {
        "name": "opencode-env",
        "description": "Reserved for manifest-driven render refactor"
      }
    ]
  },
  "devcontainers": {
    "homelab-IaC": {
      "overlay_root": "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer",
      "launcher": {
        "enabled": true,
        "display_name": "Homelab IaC Devcontainer",
        "aliases": ["homelab"],
        "env_prefix": "HOMELAB_IAC",
        "shell": ["zsh", "-l"],
        "platforms": {
          "darwin": {
            "workspace_folder": "/Users/balaji/Documents/development/homelab-IaC",
            "config": "{home}/Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/.devcontainer/devcontainer.json",
            "identity_labels": {
              "devcontainer.local_folder": "{workspace}",
              "devcontainer.config_file": "{config}"
            }
          },
          "wsl2-debian": {
            "workspace_folder": "/mnt/devdrive/homelab-IaC",
            "config": "{workspace}/.devcontainer/personal-wsl/devcontainer.json",
            "identity_labels": {
              "devcontainer.local_folder": "\\\\wsl.localhost\\Debian{workspace_backslashes}",
              "devcontainer.config_file": "{config}"
            }
          }
        }
      },
      "mirrors": [],
      "derived": [],
      "renders": []
    }
  }
}
