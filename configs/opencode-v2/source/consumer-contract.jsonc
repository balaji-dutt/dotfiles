  "policyContract": {
    "authority": "Frozen committed source bytes and separately recorded checkout EOL evidence in inventory, including global configuration, global agent Markdown and project overrides; source-visible grants are not a computed native effective policy.",
    "preserve": ["ordered allow/ask/deny rules", "wildcard and unmatched defaults", "scope precedence and scalar-versus-map interactions", "parent/child inheritance and depth limits", "named delegates and leaf restrictions", "credential/env/path scopes", "read-only intent including mutating shell flags", "unavailable-tool and fallback behavior"],
    "legacySpecialistShell": "Generated Markdown bash: ask leaves visible project Bash grants inert in the current composition. They must not become new native auto-allows.",
    "credentialScopes": ["dotenv reads/edits with existing example exceptions", "SSH", "AWS", "Ansible", "GnuPG", "Kubernetes", "Docker", "Azure", "GitHub CLI", "gcloud", "keyrings", "password-store", "1Password"],
    "externalDirectoryScopes": "Retain source order, trusted host development roots versus container /workspaces/** and /workspace/**, default ask and sensitive-root denies; no universal allow or deny substitution.",
    "nativeDeclaredSemantics": [
      "Ordered permissions arrays use action/resource/effect; last matching rule wins, unmatched asks and the native base contributes wildcard allow.",
      "Top-level rules precede appended agent rules; scalar fields replace, request headers/body merge shallowly and a later layer can recreate a disabled identity.",
      "Native children inherit the full parent session rule array; v1 child construction copies denies and external-directory rules. Neither implies blanket parent/agent policy intersection.",
      "Native experimental.subagent_depth defaults to 1; explicit child model override outranks agent preference and parent model; hidden is not an execution deny."
    ],
    "translationBoundaries": ["bash to shell requires semantic mapping", "task to subagent requires target and inheritance mapping", "write/patch to edit requires action/resource mapping", "individual MCP action is not mcp.use", "skill is not skill.use", "plugin loading is not integration.use"],
    "nativeReadiness": "blocked; known declared shapes are not accepted consumer operational mappings",
    "policyChangeApproval": "Any widening, tightening, default, fallback or unsupported behavior loss requires an explicit per-row decision; no convenient hard global policy."
  },
