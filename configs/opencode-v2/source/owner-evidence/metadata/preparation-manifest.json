  "blockers": [
    {
      "id": "policy-layers-unqualified",
      "description": "Effective global, project, agent, session, saved-approval and system policy composition is not runtime-qualified."
    },
    {
      "id": "model-effort-unqualified",
      "description": "Preserve source OpenAI, DeepSeek or inherited routing; native catalog and per-model effort support are unqualified. No fallback is synthesized."
    },
    {
      "id": "claude-agent-catalog-unqualified",
      "description": "Anthropic-backed OpenCode roles are selected for native Claude Agent migration; exact catalog IDs and per-model effort support are unknown."
    },
    {
      "id": "sampling-unqualified",
      "description": "Source sampling requires an effective provider/model mapping or explicit per-row loss approval. Ineffective request.body storage is not preservation."
    },
    {
      "id": "inert-overlay-preservation",
      "description": "Specialist source-effective Bash ask must not become new auto-allows from presently inert project overlays."
    },
    {
      "id": "child-session-delta",
      "description": "Referenced v1 and v2 child-session inheritance, model override and fallback differ; operational equivalence remains blocked."
    },
    {
      "id": "target-disabled-source",
      "description": "Canary is canonical-enabled but target-disabled in v1; an independent canonical base must not activate it."
    },
    {
      "id": "skill-guidance-blocked",
      "description": "Agent-engineer depends on native plugin and live evaluator guidance that is withheld pending a reviewed projection."
    },
    {
      "id": "native-plugin-guidance-unqualified",
      "description": "The canonical plugin-developer bundle contains legacy OpenCode API examples. Native operational guidance requires a complete evidenced projection, not token renaming."
    },
    {
      "id": "native-live-evaluator-unqualified",
      "description": "The prompt-evaluator bundle's native SDK/live route is unqualified. Generic in-session judging remains separately usable; this native bundle is withheld."
    },
    {
      "id": "harness-neutral-retain",
      "description": "Retain the canonical skill bundle bytes; this content disposition is not a runtime loading or capability claim."
    },
    {
      "id": "aggregate-withheld",
      "description": "One blocked row withholds the whole operational fragment."
    }
  ],
  "overallReady": false
}
