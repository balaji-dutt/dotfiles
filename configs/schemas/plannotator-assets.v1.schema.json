{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dotfiles:schema:plannotator-assets:v1",
  "title": "Plannotator artifact manifest v1",
  "description": "Integrity locks for Plannotator assets mirrored at the shared chezmoi release pin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "artifacts", "name", "schema_version", "upstream"],
  "properties": {
    "$schema": {"const": "./schemas/plannotator-assets.v1.schema.json"},
    "schema_version": {"const": 1},
    "name": {"const": "plannotator"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo"],
      "properties": {"repo": {"const": "backnotprop/plannotator"}}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "source_path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
