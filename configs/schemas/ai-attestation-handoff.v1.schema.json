{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dotfiles:schema:ai-attestation-handoff:v1",
  "title": "AI attestation handoff v1",
  "description": "Transient participant metadata passed from an AI harness to a Git commit wrapper.",
  "type": "object",
  "additionalProperties": false,
  "required": ["participants", "schemaVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/participant"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sourceDefinition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]*(?:/[A-Za-z0-9][A-Za-z0-9._@+-]*)*$"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "dependentRequired": {
        "sourceDefinition": ["sourceDigest"],
        "sourceDigest": ["sourceDefinition"]
      },
      "properties": {
        "tool": {"$ref": "#/$defs/identifier"},
        "agent": {"$ref": "#/$defs/identifier"},
        "role": {"$ref": "#/$defs/role"},
        "model": {"$ref": "#/$defs/identifier"},
        "sourceDefinition": {"$ref": "#/$defs/sourceDefinition"},
        "sourceDigest": {"$ref": "#/$defs/sourceDigest"}
      }
    }
  }
}
