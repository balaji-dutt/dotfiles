{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dotfiles:schema:ai-tooling-support:v1",
  "title": "AI tooling support policy v1",
  "description": "Repository discovery sources and dependency aliases for AI tooling drift checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "dependencies", "matrix", "schema_version", "sources"],
  "properties": {
    "$schema": {"const": "./schemas/ai-tooling-support.v1.schema.json"},
    "schema_version": {"const": 1},
    "matrix": {"$ref": "#/$defs/path"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "patterns"],
        "properties": {
          "format": {"type": "string", "enum": ["claude-agent-frontmatter", "claude-mcp-json", "opencode-jsonc"]},
          "patterns": {"$ref": "#/$defs/paths"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_aliases", "id", "matrix_row", "mcp_server_aliases"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "matrix_row": {"type": "string", "minLength": 1},
          "command_aliases": {"$ref": "#/$defs/strings"},
          "mcp_server_aliases": {"$ref": "#/$defs/strings"}
        }
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1},
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
