{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dotfiles:schema:pipeline-guard:v1",
  "title": "Provider-aware pipeline guard policy v1",
  "description": "Explicit GitHub Actions workflow gating; legacy GitLab policy remains a separate contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "provider", "host", "repository", "guarded_remote", "guarded_ref", "workflows", "timeout_seconds", "max_pages"],
  "properties": {
    "$schema": {"const": "./schemas/pipeline-guard.v1.schema.json"},
    "schema_version": {"const": 1},
    "provider": {"const": "github"},
    "host": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "guarded_remote": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "guarded_ref": {"type": "string", "pattern": "^refs/heads/", "maxLength": 1024},
    "workflows": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*\\.ya?ml$"}
      ]}
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "max_pages": {"type": "integer", "minimum": 1, "maximum": 20}
  }
}
