{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dotfiles:schema:packages:v1",
  "title": "WSL package policy v1",
  "description": "Ansible variables for release archive pins and apt package sets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_apt_packages", "ubuntu_apt_packages", "versions"],
  "properties": {
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aoe", "gh", "glab", "lazydocker", "openusage"],
      "properties": {
        "aoe": {"$ref": "#/$defs/version"},
        "gh": {"$ref": "#/$defs/version"},
        "glab": {"$ref": "#/$defs/version"},
        "lazydocker": {"$ref": "#/$defs/version"},
        "openusage": {"$ref": "#/$defs/version"}
      }
    },
    "base_apt_packages": {"$ref": "#/$defs/packages"},
    "ubuntu_apt_packages": {"$ref": "#/$defs/packages"}
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)+$"},
    "packages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
