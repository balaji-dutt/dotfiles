{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dotfiles:schema:test-suites:v1",
  "title": "Canonical test suite registry v1",
  "description": "Capabilities and argv-based steps consumed by assets/run-tests.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "capabilities", "schema_version", "steps"],
  "properties": {
    "$schema": {"const": "./schemas/test-suites.v1.schema.json"},
    "schema_version": {"const": 1},
    "capabilities": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/$defs/capability"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "probe": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "covers", "id", "suites"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "suites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["fast", "integration", "platform", "provenance", "render"]}
        },
        "argv": {"$ref": "#/$defs/nonEmptyStringArray"},
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["linux", "macos", "windows", "wsl2"]}
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
