{
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/dev/assets/oh-my-opencode.schema.json",
    "claude_code": {
        "hooks": false,
        "agents": false,
        "skills": true,
        "commands": false,
        "mcp": false,
        "plugins": false
    },
    "ralph_loop": {
        "enabled": false,
        "default_max_iterations": 100
    },
    "sisyphus_agent": {
        "disabled": true
    },
    "disabled_commands": [
        "init-deep",
        "start-work"
    ],
    "disabled_agents": [
        "sisyphus",
        "prometheus",
        "hephaestus",
        "metis",
        "momus",
        "atlas",
        "multimodal-looker",
        "oracle",
        "librarian",
        "explore"
    ],
    "disabled_hooks": [
        "keyword-detector",
        "auto-slash-command",
        "ralph-loop",
        "todo-continuation-enforcer",
        "comment-checker",
        "directory-agents-injector",
        "directory-readme-injector",
        "think-mode",
        "rules-injector",
        "startup-toast",
        "agent-usage-reminder",
        "non-interactive-env",
        "interactive-bash-session"
    ],
    "disabled_mcps": [
        "websearch",
        "grep_app"
    ]
}