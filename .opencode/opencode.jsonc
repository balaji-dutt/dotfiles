{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/instructions/mcp-usage.md"],
  // ----------------------------
  // Project specific plugins
  // ----------------------------
  // "plugin": [
  //   "oh-my-opencode@3.5.2"
  // ],
  // ----------------------------
  // MCP Servers (repo-specific)
  // ----------------------------
  "mcp": {
    "tempograph": {
      "type": "local",
      "command": ["tempograph-server"]
    }
  },
  // Disable all TempoGraph tools by default to avoid context pollution (24 tools).
  // Agents below selectively enable the tools they need.
  "tools": {
    "tempograph_*": false
  },
  // ----------------------------
  // Project specific permissions
  // ----------------------------
  "permission": {
    "skill": {
      "*": "allow",
      "refresh-docs": "allow"
    },
    "bash": {
      // allow safe chezmoi ops
      "chezmoi doctor*": "allow",
      "chezmoi apply --dry-run --verbose*": "allow",
      "chezmoi --use-builtin-diff --no-pager diff*": "allow",
      "chezmoi target-path*": "allow",
      "./assets/commit-docs.sh*": "allow",
      "./assets/cz-audit.sh*": "allow",
      "pwsh ./assets/cz-audit.ps1*": "allow",
      "pwsh -NoProfile -Command \"./assets/cz-audit.ps1*\"": "allow",
      // deny destructive chezmoi ops (keep these after allows)
      "chezmoi destroy*": "deny",
      "chezmoi purge*": "deny",
      "chezmoi unmanage*": "deny",
      "chezmoi state delete*": "deny",
      "chezmoi state reset*": "deny",
      "chezmoi upgrade*": "deny",
    }
  },
  "agent": {
    // Customize global agents for this project
    "plan": {
      "tools": {
        "tempograph_prepare_context": true,
        "tempograph_overview": true,
        "tempograph_hotspots": true,
        "tempograph_file_map": true
      },
      "permission": {
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow"
        }
      }
    },
    "plan-GPT-xhigh": {
      "tools": {
        "tempograph_prepare_context": true,
        "tempograph_overview": true,
        "tempograph_hotspots": true,
        "tempograph_file_map": true
      },
      "permission": {
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow"
        }
      }
    },
    "build": {
      "prompt": "{file:./prompts/build.md}",
      "tools": {
        "tempograph_prepare_context": true,
        "tempograph_blast_radius": true,
        "tempograph_focus": true,
        "tempograph_diff_context": true,
        "tempograph_hotspots": true,
        "tempograph_dead_code": true,
        "tempograph_symbols": true,
        "tempograph_file_map": true,
        "tempograph_overview": true,
        "tempograph_dependencies": true
      },
      "permission": {
        "bash": {
          "./assets/sync-opencode-copilot-profiles.sh*": "allow",
          "./assets/sync-devcontainer-assets.sh*": "allow",
        },
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow"
        }
      }
    },
    "agent-engineer": {
      "tools": {
        "tempograph_prepare_context": true,
        "tempograph_blast_radius": true,
        "tempograph_focus": true,
        "tempograph_diff_context": true,
        "tempograph_symbols": true,
        "tempograph_file_map": true
      },
      "permission": {
        "bash": {
          "./assets/sync-opencode-copilot-profiles.sh*": "allow",
          "./assets/sync-devcontainer-assets.sh*": "allow",
        },
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow"
        }
      }
    },
    "special-builder": {
      "tools": {
        "tempograph_prepare_context": true,
        "tempograph_blast_radius": true,
        "tempograph_focus": true,
        "tempograph_diff_context": true,
        "tempograph_symbols": true,
        "tempograph_file_map": true
      },
      "permission": {
        "bash": {
          "./assets/sync-opencode-copilot-profiles.sh*": "allow",
          "./assets/sync-devcontainer-assets.sh*": "allow",
        },
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow"
        }
      }
    },
    // Project specific agents
    "dotfiles-reviewer": {
      "mode": "subagent",
      "description": "Fast read-only review for dotfiles/chezmoi changes.",
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high",
      // "model": "anthropic/claude-opus-4-6",
      // Anthropic does not support temperature modification with thinking budgets
      // "temperature": 0.1,
      // Anthropic extended thinking (medium-ish)
      // "thinking": {
      //   "type": "enabled",
      //   "budgetTokens": 10000
      // },
    },
    // "dotfiles-reviewer-deep": {
    //   "mode": "subagent",
    //   "description": "Deep read-only review for risky cross-platform dotfiles changes.",
    //   "model": "anthropic/claude-opus-4-6",
    //   // Anthropic does not support temperature modification with thinking budgets
    //   // "temperature": 0.1,
    //   // Anthropic extended thinking (high-ish)
    //   "thinking": {
    //     "type": "enabled",
    //     "budgetTokens": 20000
    //   },
    //   "tools": {
    //     "write": false,
    //     "edit": false,
    //     "bash": false
    //   }
    // },
  }
}
