{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/instructions/mcp-usage.md",
    ".opencode/instructions/beads-plan-handoff.md",
    ".opencode/instructions/beads-backlog-workflow.md"
  ],
  // ----------------------------
  // MCP Servers (repo-specific)
  // ----------------------------
  "mcp": {
    "cbm": {
      "type": "local",
      "command": ["codebase-memory-mcp"]
    }
  },
  // Keep CBM's full tool surface out of agent context by default.
  "tools": {
    "cbm_*": false
  },
  // ----------------------------
  // Project specific permissions
  // ----------------------------
  "permission": {
    "skill": {
      "*": "allow",
      "refresh-docs": "allow"
    },
    "bash": {
      // allow safe chezmoi ops
      "chezmoi doctor*": "allow",
      "chezmoi apply --dry-run --verbose*": "allow",
      "chezmoi --use-builtin-diff --no-pager diff*": "allow",
      "chezmoi target-path*": "allow",
      "./assets/cz-audit.sh*": "allow",
      "bash ./assets/sync-devcontainer-assets.sh*": "allow",
      "pwsh ./assets/cz-audit.ps1*": "allow",
      // agent worktree merge helper; publication and cleanup remain ask-gated
      "*/dotfiles/assets/agent-wt-merge inspect*": "allow",
      "\"*/dotfiles/assets/agent-wt-merge\" inspect*": "allow",
      "'*/dotfiles/assets/agent-wt-merge' inspect*": "allow",
      "*/dotfiles/assets/agent-wt-merge ff*": "allow",
      "\"*/dotfiles/assets/agent-wt-merge\" ff*": "allow",
      "'*/dotfiles/assets/agent-wt-merge' ff*": "allow",
      "*/dotfiles/assets/agent-wt-merge no-ff*": "allow",
      "\"*/dotfiles/assets/agent-wt-merge\" no-ff*": "allow",
      "'*/dotfiles/assets/agent-wt-merge' no-ff*": "allow",
      "*/dotfiles/.opencode/bin/agent-wt-merge inspect*": "allow",
      "\"*/dotfiles/.opencode/bin/agent-wt-merge\" inspect*": "allow",
      "'*/dotfiles/.opencode/bin/agent-wt-merge' inspect*": "allow",
      "*/dotfiles/.opencode/bin/agent-wt-merge ff*": "allow",
      "\"*/dotfiles/.opencode/bin/agent-wt-merge\" ff*": "allow",
      "'*/dotfiles/.opencode/bin/agent-wt-merge' ff*": "allow",
      "*/dotfiles/.opencode/bin/agent-wt-merge no-ff*": "allow",
      "\"*/dotfiles/.opencode/bin/agent-wt-merge\" no-ff*": "allow",
      "'*/dotfiles/.opencode/bin/agent-wt-merge' no-ff*": "allow",
      "*/dotfiles/assets/agent-wt-merge prepare-ci*": "ask",
      "\"*/dotfiles/assets/agent-wt-merge\" prepare-ci*": "ask",
      "'*/dotfiles/assets/agent-wt-merge' prepare-ci*": "ask",
      "*/dotfiles/.opencode/bin/agent-wt-merge prepare-ci*": "ask",
      "\"*/dotfiles/.opencode/bin/agent-wt-merge\" prepare-ci*": "ask",
      "'*/dotfiles/.opencode/bin/agent-wt-merge' prepare-ci*": "ask",
      "*/dotfiles/assets/agent-wt-merge prepare-main-ci*": "ask",
      "\"*/dotfiles/assets/agent-wt-merge\" prepare-main-ci*": "ask",
      "'*/dotfiles/assets/agent-wt-merge' prepare-main-ci*": "ask",
      "*/dotfiles/.opencode/bin/agent-wt-merge prepare-main-ci*": "ask",
      "\"*/dotfiles/.opencode/bin/agent-wt-merge\" prepare-main-ci*": "ask",
      "'*/dotfiles/.opencode/bin/agent-wt-merge' prepare-main-ci*": "ask",
      "ai-wt cleanup*": "ask",
      "git worktree remove*": "ask",
      "git branch -d *": "ask",
      // deny destructive chezmoi ops (keep these after allows)
      "chezmoi destroy*": "deny",
      "chezmoi purge*": "deny",
      "chezmoi unmanage*": "deny",
      "chezmoi state delete*": "deny",
      "chezmoi state reset*": "deny",
      "chezmoi upgrade*": "deny",
    }
  },
  "agent": {
    // Customize global agents for this project
    "plan": {
      "tools": {
        "cbm_get_graph_schema": true,
        "cbm_get_architecture": true,
        "cbm_search_graph": true,
        "cbm_trace_path": true,
        "cbm_list_projects": true,
        "cbm_index_status": true,
        "cbm_index_repository": true
      },
      "permission": {
        "cbm_index_repository": "ask",
        "bash": {
          "bd*": "ask",
          "bd show*": "allow",
          "bd list*": "allow",
          "bd create*": "deny",
          "bd update*": "deny",
          "bd close*": "deny",
          "bd delete*": "deny",
          "bd edit*": "deny"
        },
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow"
        }
      }
    },
    "plan-GPT-xhigh": {
      "tools": {
        "cbm_get_graph_schema": true,
        "cbm_get_architecture": true,
        "cbm_search_graph": true,
        "cbm_trace_path": true,
        "cbm_list_projects": true,
        "cbm_index_status": true,
        "cbm_index_repository": true
      },
      "permission": {
        "cbm_index_repository": "ask",
        "bash": {
          "bd*": "ask",
          "bd show*": "allow",
          "bd list*": "allow",
          "bd create*": "deny",
          "bd update*": "deny",
          "bd close*": "deny",
          "bd delete*": "deny",
          "bd edit*": "deny"
        },
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow"
        }
      }
    },
    "build": {
      "prompt": "{file:./prompts/build.md}",
      "tools": {
        "cbm_index_repository": true,
        "cbm_list_projects": true,
        "cbm_index_status": true,
        "cbm_get_graph_schema": true,
        "cbm_get_architecture": true,
        "cbm_search_graph": true,
        "cbm_trace_path": true,
        "cbm_detect_changes": true,
        "cbm_get_code_snippet": true
      },
      "permission": {
        "cbm_index_repository": "ask",
        "bash": {
          "bd close*--actor \"OpenCode\"*": "allow",
          "./assets/sync-devcontainer-assets.sh*": "allow",
          "bash ./assets/sync-devcontainer-assets.sh*": "allow",
          "*/dotfiles/assets/agent-wt-merge inspect*": "allow",
          "\"*/dotfiles/assets/agent-wt-merge\" inspect*": "allow",
          "'*/dotfiles/assets/agent-wt-merge' inspect*": "allow",
          "*/dotfiles/assets/agent-wt-merge ff*": "allow",
          "\"*/dotfiles/assets/agent-wt-merge\" ff*": "allow",
          "'*/dotfiles/assets/agent-wt-merge' ff*": "allow",
          "*/dotfiles/assets/agent-wt-merge no-ff*": "allow",
          "\"*/dotfiles/assets/agent-wt-merge\" no-ff*": "allow",
          "'*/dotfiles/assets/agent-wt-merge' no-ff*": "allow",
          "*/dotfiles/.opencode/bin/agent-wt-merge inspect*": "allow",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" inspect*": "allow",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' inspect*": "allow",
          "*/dotfiles/.opencode/bin/agent-wt-merge ff*": "allow",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" ff*": "allow",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' ff*": "allow",
          "*/dotfiles/.opencode/bin/agent-wt-merge no-ff*": "allow",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" no-ff*": "allow",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' no-ff*": "allow",
          "*/dotfiles/assets/agent-wt-merge prepare-ci*": "ask",
          "\"*/dotfiles/assets/agent-wt-merge\" prepare-ci*": "ask",
          "'*/dotfiles/assets/agent-wt-merge' prepare-ci*": "ask",
          "*/dotfiles/.opencode/bin/agent-wt-merge prepare-ci*": "ask",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" prepare-ci*": "ask",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' prepare-ci*": "ask",
          "*/dotfiles/assets/agent-wt-merge prepare-main-ci*": "ask",
          "\"*/dotfiles/assets/agent-wt-merge\" prepare-main-ci*": "ask",
          "'*/dotfiles/assets/agent-wt-merge' prepare-main-ci*": "ask",
          "*/dotfiles/.opencode/bin/agent-wt-merge prepare-main-ci*": "ask",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" prepare-main-ci*": "ask",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' prepare-main-ci*": "ask",
          "ai-wt cleanup*": "ask",
          "git worktree remove*": "ask",
          "git branch -d *": "ask",
        },
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow",
          "beads-issue-author": "allow",
          "beads-backlog-manager": "allow"
        }
      }
    },
    "agent-engineer": {
      "tools": {
        "cbm_list_projects": true,
        "cbm_index_status": true,
        "cbm_index_repository": true,
        "cbm_get_graph_schema": true,
        "cbm_search_graph": true,
        "cbm_trace_path": true,
        "cbm_detect_changes": true,
        "cbm_get_architecture": true,
        "cbm_get_code_snippet": true
      },
      "permission": {
        "cbm_index_repository": "ask",
        "bash": {
          "bd close*--actor \"OpenCode\"*": "allow",
          "./assets/sync-devcontainer-assets.sh*": "allow",
          "bash ./assets/sync-devcontainer-assets.sh*": "allow",
          "*/dotfiles/assets/agent-wt-merge inspect*": "allow",
          "\"*/dotfiles/assets/agent-wt-merge\" inspect*": "allow",
          "'*/dotfiles/assets/agent-wt-merge' inspect*": "allow",
          "*/dotfiles/assets/agent-wt-merge ff*": "allow",
          "\"*/dotfiles/assets/agent-wt-merge\" ff*": "allow",
          "'*/dotfiles/assets/agent-wt-merge' ff*": "allow",
          "*/dotfiles/assets/agent-wt-merge no-ff*": "allow",
          "\"*/dotfiles/assets/agent-wt-merge\" no-ff*": "allow",
          "'*/dotfiles/assets/agent-wt-merge' no-ff*": "allow",
          "*/dotfiles/.opencode/bin/agent-wt-merge inspect*": "allow",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" inspect*": "allow",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' inspect*": "allow",
          "*/dotfiles/.opencode/bin/agent-wt-merge ff*": "allow",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" ff*": "allow",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' ff*": "allow",
          "*/dotfiles/.opencode/bin/agent-wt-merge no-ff*": "allow",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" no-ff*": "allow",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' no-ff*": "allow",
          "*/dotfiles/assets/agent-wt-merge prepare-ci*": "ask",
          "\"*/dotfiles/assets/agent-wt-merge\" prepare-ci*": "ask",
          "'*/dotfiles/assets/agent-wt-merge' prepare-ci*": "ask",
          "*/dotfiles/.opencode/bin/agent-wt-merge prepare-ci*": "ask",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" prepare-ci*": "ask",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' prepare-ci*": "ask",
          "*/dotfiles/assets/agent-wt-merge prepare-main-ci*": "ask",
          "\"*/dotfiles/assets/agent-wt-merge\" prepare-main-ci*": "ask",
          "'*/dotfiles/assets/agent-wt-merge' prepare-main-ci*": "ask",
          "*/dotfiles/.opencode/bin/agent-wt-merge prepare-main-ci*": "ask",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" prepare-main-ci*": "ask",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' prepare-main-ci*": "ask",
          "ai-wt cleanup*": "ask",
          "git worktree remove*": "ask",
          "git branch -d *": "ask",
        },
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow",
          "beads-issue-author": "allow",
          "beads-backlog-manager": "allow"
        }
      }
    },
    "special-builder": {
      "tools": {
        "cbm_list_projects": true,
        "cbm_index_status": true,
        "cbm_index_repository": true,
        "cbm_get_graph_schema": true,
        "cbm_search_graph": true,
        "cbm_trace_path": true,
        "cbm_detect_changes": true,
        "cbm_get_architecture": true,
        "cbm_get_code_snippet": true
      },
      "permission": {
        "cbm_index_repository": "ask",
        "bash": {
          "bd close*--actor \"OpenCode\"*": "allow",
          "./assets/sync-devcontainer-assets.sh*": "allow",
          "bash ./assets/sync-devcontainer-assets.sh*": "allow",
          "*/dotfiles/assets/agent-wt-merge inspect*": "allow",
          "\"*/dotfiles/assets/agent-wt-merge\" inspect*": "allow",
          "'*/dotfiles/assets/agent-wt-merge' inspect*": "allow",
          "*/dotfiles/assets/agent-wt-merge ff*": "allow",
          "\"*/dotfiles/assets/agent-wt-merge\" ff*": "allow",
          "'*/dotfiles/assets/agent-wt-merge' ff*": "allow",
          "*/dotfiles/assets/agent-wt-merge no-ff*": "allow",
          "\"*/dotfiles/assets/agent-wt-merge\" no-ff*": "allow",
          "'*/dotfiles/assets/agent-wt-merge' no-ff*": "allow",
          "*/dotfiles/.opencode/bin/agent-wt-merge inspect*": "allow",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" inspect*": "allow",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' inspect*": "allow",
          "*/dotfiles/.opencode/bin/agent-wt-merge ff*": "allow",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" ff*": "allow",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' ff*": "allow",
          "*/dotfiles/.opencode/bin/agent-wt-merge no-ff*": "allow",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" no-ff*": "allow",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' no-ff*": "allow",
          "*/dotfiles/assets/agent-wt-merge prepare-ci*": "ask",
          "\"*/dotfiles/assets/agent-wt-merge\" prepare-ci*": "ask",
          "'*/dotfiles/assets/agent-wt-merge' prepare-ci*": "ask",
          "*/dotfiles/.opencode/bin/agent-wt-merge prepare-ci*": "ask",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" prepare-ci*": "ask",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' prepare-ci*": "ask",
          "*/dotfiles/assets/agent-wt-merge prepare-main-ci*": "ask",
          "\"*/dotfiles/assets/agent-wt-merge\" prepare-main-ci*": "ask",
          "'*/dotfiles/assets/agent-wt-merge' prepare-main-ci*": "ask",
          "*/dotfiles/.opencode/bin/agent-wt-merge prepare-main-ci*": "ask",
          "\"*/dotfiles/.opencode/bin/agent-wt-merge\" prepare-main-ci*": "ask",
          "'*/dotfiles/.opencode/bin/agent-wt-merge' prepare-main-ci*": "ask",
          "ai-wt cleanup*": "ask",
          "git worktree remove*": "ask",
          "git branch -d *": "ask",
        },
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow",
          "beads-issue-author": "allow",
          "beads-backlog-manager": "allow"
        }
      }
    },
    // Project specific agents
    "dotfiles-reviewer": {
      "mode": "subagent",
      "description": "Fast read-only review for dotfiles/chezmoi changes.",
      "model": "anthropic/claude-opus-5",
      "reasoningEffort": "high",
    },
  }
}
