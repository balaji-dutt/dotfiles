{
  "$schema": "https://opencode.ai/config.json",
  // ----------------------------
  // Project specific plugins
  // ----------------------------
  "plugin": [
    "oh-my-opencode@3.5.3"
  ],
  // ----------------------------
  // Project specific permissions
  // ----------------------------
  "permission": {
    "bash": {
      // allow safe chezmoi ops
      "chezmoi doctor*": "allow",
      "chezmoi apply --dry-run --verbose*": "allow",
      "chezmoi --use-builtin-diff --no-pager diff*": "allow",
      "chezmoi target-path*": "allow",
      "./assets/commit-docs.sh*": "allow",
      "./assets/cz-audit.sh*": "allow",
      "pwsh ./assets/cz-audit.ps1*": "allow",
      "pwsh -NoProfile -Command \"./assets/cz-audit.ps1*\"": "allow",
      // deny destructive chezmoi ops (keep these after allows)
      "chezmoi destroy*": "deny",
      "chezmoi purge*": "deny",
      "chezmoi unmanage*": "deny",
      "chezmoi state delete*": "deny",
      "chezmoi state reset*": "deny",
      "chezmoi upgrade*": "deny",
    }
  },
  "agent": {
    // Customize global agents for this project
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow",
          "dotfiles-reviewer-deep": "allow"
        }
      }
    },
    "plan-GPT5.2-xhigh": {
      "permission": {
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow",
          "dotfiles-reviewer-deep": "allow"
        }
      }
    },
    // "code-manager": {
    //   "permission": {
    //     "task": {
    //       "*": "deny",
    //       "dotfiles-reviewer": "allow",
    //       "dotfiles-reviewer-deep": "allow"
    //     }
    //   }
    // },
    // Project specific agents
    "dotfiles-reviewer": {
      "mode": "subagent",
      "description": "Fast read-only review for dotfiles/chezmoi changes.",
      "model": "anthropic/claude-opus-4-5",
      // Anthropic does not support temperature modification with thinking budgets
      // "temperature": 0.1,
      // Anthropic extended thinking (medium-ish)
      "thinking": {
        "type": "enabled",
        "budgetTokens": 10000
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "dotfiles-reviewer-deep": {
      "mode": "subagent",
      "description": "Deep read-only review for risky cross-platform dotfiles changes.",
      "model": "anthropic/claude-opus-4-5",
      // Anthropic does not support temperature modification with thinking budgets
      // "temperature": 0.1,
      // Anthropic extended thinking (high-ish)
      "thinking": {
        "type": "enabled",
        "budgetTokens": 20000
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
    // "dotfiles-reviewer": {
    //   "mode": "subagent",
    //   "description": "Fast read-only review for dotfiles/chezmoi changes.",
    //   "model": "openai/gpt-5.2",
    //   "reasoningEffort": "medium",
    //   "temperature": 0.1,
    //   "tools": {
    //     "write": false,
    //     "edit": false,
    //     "bash": false
    //   }
    // },
    // "dotfiles-reviewer-deep": {
    //   "mode": "subagent",
    //   "description": "Deep read-only review for risky cross-platform dotfiles changes.",
    //   "model": "openai/gpt-5.2",
    //   "reasoningEffort": "high",
    //   "temperature": 0.1,
    //   "tools": {
    //     "write": false,
    //     "edit": false,
    //     "bash": false
    //   }
    // }
  }
}