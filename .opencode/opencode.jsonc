{
  "$schema": "https://opencode.ai/config.json",
  // ----------------------------
  // Plugins
  // ----------------------------
  "plugin": [
    "oh-my-opencode@3.0.0-beta.11"
  ],
  "agent": {
    // Customize global agents for this project
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow",
          "dotfiles-reviewer-deep": "allow"
        }
      }
    },
    "plan-GPT5.2-xhigh": {
      "permission": {
        "task": {
          "*": "deny",
          "dotfiles-reviewer": "allow",
          "dotfiles-reviewer-deep": "allow"
        }
      }
    },
    // Project specific agents
    "dotfiles-reviewer": {
      "mode": "subagent",
      "description": "Fast read-only review for dotfiles/chezmoi changes.",
      "model": "openai/gpt-5.2",
      "reasoningEffort": "medium",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "dotfiles-reviewer-deep": {
      "mode": "subagent",
      "description": "Deep read-only review for risky cross-platform dotfiles changes.",
      "model": "openai/gpt-5.2",
      "reasoningEffort": "high",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  }
}