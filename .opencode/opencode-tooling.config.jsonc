{
  // Agent key in .opencode/config.json that performs the dotfiles review.
  "reviewerAgent": "dotfiles-reviewer",

  // The reviewer must end with exactly one of:
  //   DOTFILES_REVIEWER_RESULT=PASS
  //   DOTFILES_REVIEWER_RESULT=FAIL
  "resultMarkerPrefix": "DOTFILES_REVIEWER_RESULT",

  // Base filename for the session-scoped sentinel under .opencode/.
  "sentinelBase": ".needs_dotfiles_review",

  // Base filename for enforcer state JSON under .opencode/.
  "enforcerStateBase": ".dotfiles_review_enforcer_state",

  // Label used in toast messages and log output.
  "reviewLabel": "Dotfiles",

  // Files that should NOT trigger a review mark.
  // docs/** is exempt (generated/informational docs), except docs/agents/
  // which contains agent-facing docs that ARE reviewed.
  // .beads/** is backlog/issue state, not dotfiles content.
  "exemptPaths": [
    "docs/**",
    "!docs/agents/**",
    "assets/README.md",
    ".beads/**"
  ],

  // Changes can also arise from deletions, renames, and moves.
  "watchEvents": [
    "file.edited",
    "file.deleted",
    "file.renamed",
    "file.moved"
  ],

  // Legacy sentinel path written by the old Claude Code plugin.
  // Cleared on PASS during migration period.
  "legacyGatePaths": [
    ".claude/.needs_dotfiles_review"
  ],

  // Set to "DOTFILES_REVIEW_GATE_DEBUG" and export it as "1" to enable
  // debug logging in the gate plugin.
  "debugEnvVar": "DOTFILES_REVIEW_GATE_DEBUG",

  // Comment injected at the top of temp .md files opened by the /editor command.
  // Prevents the VSCode markdownlint extension from firing spurious warnings.
  "editorSuppressHeader": "<!-- markdownlint-disable MD041 MD013 MD034 MD009 MD047 -->"
}
