<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.nfs-dot-clean</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ .chezmoi.homeDir }}/bin/nfs_dot_clean.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StartOnMount</key>
    <true/>

    <key>WatchPaths</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.config/nfs-dot-clean</string>
        <string>{{ .chezmoi.homeDir }}/.config/nfs-dot-clean/paths</string>
    </array>

    <key>LowPriorityIO</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/com.user.nfs-dot-clean.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/com.user.nfs-dot-clean.err.log</string>
</dict>
</plist>
