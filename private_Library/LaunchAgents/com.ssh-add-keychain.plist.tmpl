<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    {{- $sshAddKeyFiles := (index . "SSH_ADD_KEYFILES") | default (list) -}}
    {{- $keyDir := joinPath .chezmoi.homeDir ".ssh" "keys" -}}
    <key>Label</key>
    <string>com.ssh-add-keychain</string>

    <key>ProgramArguments</key>
    <array>
      {{- if gt (len $sshAddKeyFiles) 0 }}
      <string>/usr/bin/ssh-add</string>
      <string>--apple-use-keychain</string>
      {{- range $keyFile := $sshAddKeyFiles }}
      <string>{{ joinPath $keyDir $keyFile }}</string>
      {{- end }}
      {{- else }}
      <string>/usr/bin/true</string>
      {{- end }}
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/ssh-add-loadkeychain.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ssh-add-loadkeychain.err</string>
  </dict>
</plist>
