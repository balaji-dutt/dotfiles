{{- if eq .chezmoi.os "darwin" -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.ccr</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ .chezmoi.homeDir }}/bin/ccr_launcher.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!--
      `ccr start` typically daemonizes. If we set KeepAlive=true here,
      launchd may repeatedly re-run the launcher. We keep this false and
      make the launcher idempotent.
    -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.claude-code-router/logs/launchagent.out</string>

    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.claude-code-router/logs/launchagent.err</string>
</dict>
</plist>
{{- end -}}
