{{- /* chezmoi:modify-template */ -}}
{{- /*
     Ownership split for ~/.claude/settings.json:

       chezmoi owns  - dot_claude/settings-base.json (env, permissions,
                       statusLine, ...), the PreToolUse/Bash
                       gate-bd-destructive.sh hook declared in it, the
                       agent-wt-merge allow rules added below (they need
                       this checkout's absolute path, which the plain-JSON
                       base cannot hold), and the macOS-only OpenUsage
                       telemetry hooks added below.
       aoe owns      - every hook group whose command carries the trailing
                       `# aoe-hooks` sentinel. Those are adopted verbatim from
                       the file on disk so `chezmoi apply` never reverts what
                       agent-of-empires injected, and aoe never re-prompts.

     A hook *group* is aoe-owned iff any of its hooks[].command contains
     "aoe-hooks". Verified that no group mixes owners: PreToolUse holds one
     chezmoi group (matcher "Bash") and one aoe group.

     The base lives in its own plain-JSON file rather than inline here because
     the homelab-IaC devcontainer symlinks it straight to ~/.claude/settings.json
     without running chezmoi (see devcontainer-common.sh
     install_claude_managed_asset_links) - it needs parseable JSON, not this
     template. That file is .chezmoiignore'd so chezmoi never applies it to
     ~/.claude/settings-base.json on the host.

     On a fresh machine the target does not exist yet, stdin is empty, and only
     the base hooks are written. aoe prompts once on first launch, adds its
     hooks, and they stick from then on.

     If a future aoe release stops emitting the sentinel, its hooks will stop
     being adopted and apply will silently drop them - see
     docs/agents/aoe-notifications.md.
*/ -}}
{{- $input := .chezmoi.stdin | default "" -}}
{{- $live := dict -}}
{{- if gt (len (trim $input)) 0 -}}
{{-   $live = ($input | fromJson) | default dict -}}
{{- end -}}
{{- $settings := include "dot_claude/settings-base.json" | fromJson -}}
{{- $permissions := (index $settings "permissions") | default dict -}}
{{- $allow := (index $permissions "allow") | default list -}}
{{- /* printf, not joinPath: joinPath emits backslashes on Windows, but Git Bash commands use drive-letter paths such as F:/. */ -}}
{{- range $helperPath := list "assets/agent-wt-merge" ".opencode/bin/agent-wt-merge" -}}
{{-   $helper := printf "%s/%s" $.chezmoi.workingTree $helperPath -}}
{{-   range $sub := list "inspect" "ff" "no-ff" -}}
{{-     $allow = concat $allow (list (printf "Bash(%s %s:*)" $helper $sub) (printf "Bash(\"%s\" %s:*)" $helper $sub) (printf "Bash('%s' %s:*)" $helper $sub)) -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $permissions "allow" $allow -}}
{{- $_ := set $settings "permissions" $permissions -}}
{{- $hooks := (index $settings "hooks") | default dict -}}
{{- range $event, $groups := ((index $live "hooks") | default dict) -}}
{{-   $adopted := list -}}
{{-   range $groups -}}
{{-     $isAoe := false -}}
{{-     range ((index . "hooks") | default list) -}}
{{-       if contains "aoe-hooks" ((index . "command") | default "") -}}
{{-         $isAoe = true -}}
{{-       end -}}
{{-     end -}}
{{-     if $isAoe -}}{{- $adopted = append $adopted . -}}{{- end -}}
{{-   end -}}
{{-   if $adopted -}}
{{-     $_ := set $hooks $event (concat ((index $hooks $event) | default list) $adopted) -}}
{{-   end -}}
{{- end -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $openUsageHook := joinPath .chezmoi.homeDir ".config/openusage/hooks/claude-hook.sh" -}}
{{-   range $event := list "Stop" "SubagentStop" -}}
{{-     $hook := dict "type" "command" "command" $openUsageHook "timeout" 30 -}}
{{-     $group := dict "matcher" "*" "hooks" (list $hook) -}}
{{-     $_ := set $hooks $event (concat ((index $hooks $event) | default list) (list $group)) -}}
{{-   end -}}
{{-   $asyncHook := dict "type" "command" "command" $openUsageHook "timeout" 30 "async" true -}}
{{-   $asyncGroup := dict "matcher" "*" "hooks" (list $asyncHook) -}}
{{-   $_ := set $hooks "PostToolUse" (concat ((index $hooks "PostToolUse") | default list) (list $asyncGroup)) -}}
{{- end -}}
{{- $_ := set $settings "hooks" $hooks -}}
{{- $settings | toPrettyJson -}}
