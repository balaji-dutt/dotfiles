{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "npm"],
  "labels": ["dependencies", "renovate"],
  "dependencyDashboard": true,
  "rangeStrategy": "replace",
  "npm": {
    "managerFilePatterns": [
      "/^configs\\/promptfoo-runtime\\/package\\.json$/",
      "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/configs\\/promptfoo-runtime\\/package\\.json$/"
    ]
  },
  // Keep release-age checks internal. Do not set prCreation to "not-pending"
  // with minimumReleaseAge; Renovate disables the not-pending timeout and can
  // leave updates stuck in Dashboard "Pending Status Checks" when stability
  // status publication is disabled.
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "automerge": false,
  // Zero disables Renovate's hourly and concurrent rate limits.
  "commitHourlyLimit": 0,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "commitMessagePrefix": "chore(deps): ",

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^configs\\/browser-policies\\/justthebrowser\\/manifest\\.json$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "corbindavenport/just-the-browser",
      "matchStrings": [
        "(?<prefix>^|\\r?\\n)(?<indent>[ \\t]*)\\\"version\\\":[ \\t]*\\\"(?<currentValue>v?[^\\\"]+)\\\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^configs\\/packages\\.yaml$/",
        "/^\\.chezmoidata\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*\\w+:[ \\t]*\\\"(?<currentValue>[^\\\"]+)\\\"[ \\t]+#[ \\t]*renovate:[ \\t]+datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?[ \\t]*",
        "(?:^|\\r?\\n)[ \\t]*\\\"github:[^\\\"\\s]+\\\"[ \\t]*=[ \\t]*\\\"(?<currentValue>[^\\\"]+)\\\"[ \\t]+#[ \\t]*renovate:[ \\t]+datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?[ \\t]*"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/dot_devcontainer\\/devcontainer\\.json\\.tmpl$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*\\\"[A-Z_]+\\\":[ \\t]*\\\"(?<currentValue>[^\\\"]+)\\\",[ \\t]*\\/\\/[ \\t]*renovate:[ \\t]+datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?[ \\t]*"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/dot_devcontainer\\/postCreate\\.sh$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*python3[ \\t]+-m[ \\t]+pip[ \\t]+install[ \\t]+--user[ \\t]+\\\"[^\\\"=]+==(?<currentValue>[^\\\"]+)\\\"[ \\t]+#[ \\t]*renovate:[ \\t]+datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+versioning=(?<versioning>\\S+))?[ \\t]*"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/configs\\/uv_tools\\.txt$/"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440",
      "matchStrings": [
        "(?:^|\\r?\\n)(?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[0-9][^\\s#]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/configs\\/npm_packages\\.txt$/"
      ],
      "datasourceTemplate": "npm",
      "matchStrings": [
        "(?:^|\\r?\\n)(?<depName>(?:@[^\\/\\s]+\\/)?[^@\\s]+)@(?<currentValue>[0-9][^\\s#]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_dot_config\\/opencode\\/opencode\\.jsonc$/",
        "/^private_dot_config\\/opencode\\/tui\\.json$/",
        "/^private_Documents\\/development\\/container-dotfiles\\/dotfiles\\/private_dot_config\\/opencode\\/opencode\\.jsonc$/",
        "/^private_Documents\\/development\\/container-dotfiles\\/dotfiles\\/private_dot_config\\/opencode\\/tui\\.json$/"
      ],
      "datasourceTemplate": "npm",
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*\\\"(?<depName>(?:@[^\\/\\\"\\s]+\\/)?[^@\\\"\\s]+)@(?<currentValue>[0-9][^\\\"\\s]*)\\\",?[ \\t]*",
        "(?:^|\\r?\\n)[ \\t]*\\[[ \\t]*\\\"(?<depName>(?:@[^\\/\\\"\\s]+\\/)?[^@\\\"\\s]+)@(?<currentValue>[0-9][^\\\"\\s]*)\\\"[ \\t]*,"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dot_claude\\/executable_statusline\\.sh$/",
        "/^private_Documents\\/development\\/container-dotfiles\\/dotfiles\\/dot_claude\\/executable_statusline\\.sh$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Astro-Han/claude-pace",
      "matchStrings": [
        "(?:^|\\r?\\n)CLAUDE_PACE_VERSION=\\\"(?<currentValue>v[^\\\"]+)\\\"[ \\t]*"
      ]
    },
    {
      // Only the version is pinned; the tag (v<version>) and asset name
      // (better-beads-kanban-<version>.vsix) are derived in each script.
      // EXPECTED_SHA cannot be computed by Renovate — assets/sync-beads-kanban-pin.sh
      // rewrites it on renovate/beads-kanban-* branches. See .gitlab-ci.yml.
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.chezmoiscripts\\/run_onchange_after_install_better_beads_kanban\\.sh\\.tmpl$/",
        "/^\\.chezmoiscripts\\/run_onchange_after_install_better_beads_kanban\\.ps1\\.tmpl$/",
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/dot_devcontainer\\/devcontainer-common\\.sh$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "balajidutt/better-beads-kanban",
      // Strips the v from release tags so currentValue stays bare semver. Also
      // excludes the retired bd-fixes-v* prereleases, which cannot match.
      "extractVersionTemplate": "^v(?<version>.+)$",
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*(?:\\$ForkVersion[ \\t]*=|FORK_VERSION=|fork_version=)[ \\t]*\\\"(?<currentValue>[0-9][^\\\"]*)\\\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^configs\\/host-ai-plugin-refresh\\.jsonc$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*\\\"version\\\":[ \\t]*\\\"(?<currentValue>[^\\\"]+)\\\"[ \\t]*,?[ \\t]*\\/\\/[ \\t]*renovate:[ \\t]+datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?(?:[ \\t]+versioning=(?<versioning>\\S+))?[ \\t]*"
      ]
    }
  ],

  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["@tarquinen/opencode-dcp"],
      // Keep the incompatible 3.1.14 release blocked and review DCP updates.
      "allowedVersions": "!/^3\\.1\\.14$/",
      "automerge": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_dot_config/opencode/opencode.jsonc",
        "private_dot_config/opencode/tui.json",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/tui.json"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "minimumReleaseAge": null,
      "groupName": "opencode plugins (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_dot_config/opencode/opencode.jsonc",
        "private_dot_config/opencode/tui.json",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/tui.json"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "opencode plugins (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_dot_config/opencode/opencode.jsonc",
        "private_dot_config/opencode/tui.json",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/tui.json"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "opencode plugins (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/host-ai-plugin-refresh.jsonc"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "host ai plugin refresh (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/host-ai-plugin-refresh.jsonc"],
      "matchUpdateTypes": ["minor"],
      "groupName": "host ai plugin refresh (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/host-ai-plugin-refresh.jsonc"],
      "matchUpdateTypes": ["major"],
      "groupName": "host ai plugin refresh (major)"
    },
    {
      // Keep DCP runtime and TUI registrations aligned with the host refresh
      // sentinel so dependency updates also trigger cache refreshes.
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["@tarquinen/opencode-dcp"],
      "matchFileNames": [
        "configs/host-ai-plugin-refresh.jsonc",
        "private_dot_config/opencode/opencode.jsonc",
        "private_dot_config/opencode/tui.json",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/tui.json"
      ],
      "groupName": "opencode dcp"
    },
    {
      // Match the runtime patch policy so strict release-age filtering cannot
      // omit the host sentinel from the DCP update group.
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["@tarquinen/opencode-dcp"],
      "matchFileNames": ["configs/host-ai-plugin-refresh.jsonc"],
      "matchUpdateTypes": ["patch", "digest"],
      "minimumReleaseAge": null
    },
    {
      // Keep the Windows-safe quota cache key aligned with both runtime
      // registrations, the devcontainer pins, and the host refresh sentinel.
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["@slkiser/opencode-quota"],
      "matchFileNames": [
        "configs/host-ai-plugin-refresh.jsonc",
        "private_dot_config/opencode/opencode.jsonc",
        "private_dot_config/opencode/tui.json",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/tui.json"
      ],
      "groupName": "opencode quota"
    },
    {
      // Match the runtime patch policy so strict release-age filtering cannot
      // omit the host sentinel from the quota update group.
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["@slkiser/opencode-quota"],
      "matchFileNames": ["configs/host-ai-plugin-refresh.jsonc"],
      "matchUpdateTypes": ["patch", "digest"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "container npm tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "container npm tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "container npm tools (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/uv_tools.txt",
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postCreate.sh"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "container python tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/uv_tools.txt",
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postCreate.sh"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "container python tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/uv_tools.txt",
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postCreate.sh"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "container python tools (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/devcontainer.json.tmpl"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "container bootstrap tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/devcontainer.json.tmpl"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "container bootstrap tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/devcontainer.json.tmpl"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "container bootstrap tools (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/browser-policies/justthebrowser/manifest.json"],
      "automerge": false,
      "groupName": "justthebrowser browser policies",
      "additionalBranchPrefix": "browser-policies-"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/packages.yaml"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "wsl tool versions (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/packages.yaml"],
      "matchUpdateTypes": ["minor"],
      "groupName": "wsl tool versions (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/packages.yaml"],
      "matchUpdateTypes": ["major"],
      "groupName": "wsl tool versions (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "dot_claude/executable_statusline.sh",
        "private_Documents/development/container-dotfiles/dotfiles/dot_claude/executable_statusline.sh"
      ],
      "groupName": "claude-pace statusline",
      "additionalBranchPrefix": "statusline-"
    },
    {
      // The branch prefix is what beads-kanban-pin-sync dispatches on to
      // refresh EXPECTED_SHA before automerge can fire.
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["balajidutt/better-beads-kanban"],
      "groupName": "better beads kanban vsix",
      "additionalBranchPrefix": "beads-kanban-"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".chezmoidata.yaml"],
      "matchDepNames": ["backnotprop/plannotator"],
      "groupName": "plannotator cli"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "@anthropic-ai/claude-code",
        "uv",
        "dolthub/dolt",
        "backnotprop/plannotator",
        "@plannotator/opencode",
        "agent-of-empires/agent-of-empires"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "fast moving tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "@anthropic-ai/claude-code",
        "uv",
        "dolthub/dolt",
        "backnotprop/plannotator",
        "@plannotator/opencode",
        "agent-of-empires/agent-of-empires"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "fast moving tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "@anthropic-ai/claude-code",
        "uv",
        "dolthub/dolt",
        "backnotprop/plannotator",
        "@plannotator/opencode",
        "agent-of-empires/agent-of-empires"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "fast moving tools (major)"
    },
    {
      "matchManagers": ["npm"],
      "matchDepNames": [
        "promptfoo",
        "@opencode-ai/sdk",
        "@anthropic-ai/claude-agent-sdk",
        "@anthropic-ai/sdk"
      ],
      "matchFileNames": [
        "configs/promptfoo-runtime/package.json"
      ],
      "groupName": "promptfoo host runtime",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchDepNames": [
        "promptfoo",
        "@opencode-ai/sdk",
        "@anthropic-ai/claude-agent-sdk",
        "@anthropic-ai/sdk"
      ],
      "matchFileNames": [
        "configs/promptfoo-runtime/package.json"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchDepNames": [
        "promptfoo",
        "@opencode-ai/sdk",
        "@anthropic-ai/claude-agent-sdk",
        "@anthropic-ai/sdk"
      ],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/promptfoo-runtime/package.json"
      ],
      "groupName": "promptfoo devcontainer runtime",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchDepNames": [
        "promptfoo",
        "@opencode-ai/sdk",
        "@anthropic-ai/claude-agent-sdk",
        "@anthropic-ai/sdk"
      ],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/promptfoo-runtime/package.json"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      // Keep the host and devcontainer clients together. The branch prefix is
      // the dispatch contract for the Beads release-note CI guard.
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["@beads/bd", "gastownhall/beads"],
      "allowedVersions": "!/^(1\\.0\\.5|1\\.2\\.0|1\\.2\\.1)$/",
      "minimumReleaseAge": "14 days",
      "minimumGroupSize": 2,
      "groupName": "beads clients",
      "groupSlug": "clients",
      "additionalBranchPrefix": "beads-core-",
      "platformAutomerge": false
    }
  ]
}
