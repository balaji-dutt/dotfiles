{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "labels": ["dependencies", "renovate"],
  "dependencyDashboard": true,
  "rangeStrategy": "replace",
  // Keep release-age checks internal. GitLab commit-status updates for
  // renovate/stability-days can fail when GitLab returns a non-string API
  // error body, which Renovate 43.233.4 mishandles while logging the error.
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "automerge": false,
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 5,
  "commitMessagePrefix": "chore(deps): ",

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^configs\\/browser-policies\\/justthebrowser\\/manifest\\.json$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "corbindavenport/just-the-browser",
      "matchStrings": [
        "(?<prefix>^|\\r?\\n)(?<indent>[ \\t]*)\\\"version\\\":[ \\t]*\\\"(?<currentValue>v?[^\\\"]+)\\\",[ \\t]*\\r?\\n[ \\t]*\\\"release_url\\\":[ \\t]*\\\"https://github\\\\.com/corbindavenport/just-the-browser/releases/tag/[^\\\"]+\\\",[ \\t]*\\r?\\n[ \\t]*\\\"source_base_url\\\":[ \\t]*\\\"https://raw\\\\.githubusercontent\\\\.com/corbindavenport/just-the-browser/[^\\\"]+/\\\""
      ],
      "autoReplaceStringTemplate": "{{{prefix}}}{{{indent}}}\\\"version\\\": \\\"{{{newValue}}}\\\",\\n{{{indent}}}\\\"release_url\\\": \\\"https://github.com/corbindavenport/just-the-browser/releases/tag/{{{newValue}}}\\\",\\n{{{indent}}}\\\"source_base_url\\\": \\\"https://raw.githubusercontent.com/corbindavenport/just-the-browser/{{{newValue}}}/\\\""
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^configs\\/packages\\.yaml$/",
        "/^\\.chezmoidata\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*\\w+:[ \\t]*\\\"(?<currentValue>[^\\\"]+)\\\"[ \\t]+#[ \\t]*renovate:[ \\t]+datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?[ \\t]*(?:\\r?\\n|$)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/dot_devcontainer\\/devcontainer\\.json\\.tmpl$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*\\\"[A-Z_]+\\\":[ \\t]*\\\"(?<currentValue>[^\\\"]+)\\\",[ \\t]*\\/\\/[ \\t]*renovate:[ \\t]+datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?[ \\t]*(?:\\r?\\n|$)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/dot_devcontainer\\/postCreate\\.sh$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*python3[ \\t]+-m[ \\t]+pip[ \\t]+install[ \\t]+--user[ \\t]+\\\"[^\\\"=]+==(?<currentValue>[^\\\"]+)\\\"[ \\t]+#[ \\t]*renovate:[ \\t]+datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+versioning=(?<versioning>\\S+))?[ \\t]*(?:\\r?\\n|$)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/configs\\/uv_tools\\.txt$/"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440",
      "matchStrings": [
        "(?:^|\\r?\\n)(?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[0-9][^\\s#]*)(?:\\r?\\n|$)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/configs\\/npm_packages\\.txt$/"
      ],
      "datasourceTemplate": "npm",
      "matchStrings": [
        "(?:^|\\r?\\n)(?<depName>(?:@[^\\/\\s]+\\/)?[^@\\s]+)@(?<currentValue>[0-9][^\\s#]*)(?:\\r?\\n|$)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_dot_config\\/opencode\\/opencode\\.jsonc$/",
        "/^private_Documents\\/development\\/container-dotfiles\\/dotfiles\\/private_dot_config\\/opencode\\/opencode\\.jsonc$/"
      ],
      "datasourceTemplate": "npm",
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*\\\"(?<depName>(?:@[^\\/\\\"\\s]+\\/)?[^@\\\"\\s]+)@(?<currentValue>[0-9][^\\\"\\s]*)\\\",?[ \\t]*(?:\\r?\\n|$)",
        "(?:^|\\r?\\n)[ \\t]*\\[[ \\t]*\\\"(?<depName>(?:@[^\\/\\\"\\s]+\\/)?[^@\\\"\\s]+)@(?<currentValue>[0-9][^\\\"\\s]*)\\\"[ \\t]*,"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dot_claude\\/executable_statusline\\.sh$/",
        "/^private_Documents\\/development\\/container-dotfiles\\/dotfiles\\/dot_claude\\/executable_statusline\\.sh$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Astro-Han/claude-pace",
      "matchStrings": [
        "(?:^|\\r?\\n)CLAUDE_PACE_VERSION=\\\"(?<currentValue>v[^\\\"]+)\\\"[ \\t]*(?:\\r?\\n|$)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^configs\\/host-ai-plugin-refresh\\.jsonc$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*\\\"version\\\":[ \\t]*\\\"(?<currentValue>[^\\\"]+)\\\"[ \\t]*,?[ \\t]*\\/\\/[ \\t]*renovate:[ \\t]+datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?(?:[ \\t]+versioning=(?<versioning>\\S+))?[ \\t]*(?:\\r?\\n|$)"
      ]
    }
  ],

  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["@beads/bd"],
      "allowedVersions": "!/^1\\.0\\.5$/"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "minimumReleaseAge": null,
      "groupName": "opencode plugins (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "opencode plugins (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "opencode plugins (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/host-ai-plugin-refresh.jsonc"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "host ai plugin refresh (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/host-ai-plugin-refresh.jsonc"],
      "matchUpdateTypes": ["minor"],
      "groupName": "host ai plugin refresh (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/host-ai-plugin-refresh.jsonc"],
      "matchUpdateTypes": ["major"],
      "groupName": "host ai plugin refresh (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "container npm tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "container npm tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "container npm tools (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/uv_tools.txt",
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postCreate.sh"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "container python tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/uv_tools.txt",
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postCreate.sh"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "container python tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/uv_tools.txt",
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postCreate.sh"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "container python tools (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/devcontainer.json.tmpl"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "container bootstrap tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/devcontainer.json.tmpl"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "container bootstrap tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/devcontainer.json.tmpl"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "container bootstrap tools (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/browser-policies/justthebrowser/manifest.json"],
      "automerge": false,
      "groupName": "justthebrowser browser policies",
      "additionalBranchPrefix": "browser-policies-"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/packages.yaml"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "wsl tool versions (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/packages.yaml"],
      "matchUpdateTypes": ["minor"],
      "groupName": "wsl tool versions (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/packages.yaml"],
      "matchUpdateTypes": ["major"],
      "groupName": "wsl tool versions (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "dot_claude/executable_statusline.sh",
        "private_Documents/development/container-dotfiles/dotfiles/dot_claude/executable_statusline.sh"
      ],
      "groupName": "claude-pace statusline",
      "additionalBranchPrefix": "statusline-"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".chezmoidata.yaml"],
      "matchDepNames": ["backnotprop/plannotator"],
      "groupName": "plannotator cli"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "@anthropic-ai/claude-code",
        "uv",
        "dolthub/dolt",
        "backnotprop/plannotator",
        "@plannotator/opencode",
        "agent-of-empires/agent-of-empires"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "fast moving tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "@anthropic-ai/claude-code",
        "uv",
        "dolthub/dolt",
        "backnotprop/plannotator",
        "@plannotator/opencode",
        "agent-of-empires/agent-of-empires"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "fast moving tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "@anthropic-ai/claude-code",
        "uv",
        "dolthub/dolt",
        "backnotprop/plannotator",
        "@plannotator/opencode",
        "agent-of-empires/agent-of-empires"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "fast moving tools (major)"
    }
  ]
}
