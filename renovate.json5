{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "labels": ["dependencies", "renovate"],
  "dependencyDashboard": true,
  "rangeStrategy": "replace",
  "minimumReleaseAge": "7 days",
  "automerge": false,
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 5,
  "commitMessagePrefix": "chore(deps): ",

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^configs\\/browser-policies\\/justthebrowser\\/manifest\\.json$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "corbindavenport/just-the-browser",
      "matchStrings": [
        "(?m)^\\s*\\\"version\\\":\\s*\\\"(?<currentValue>v?[^\\\"]+)\\\",\\s*$"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^configs\\/packages\\.yaml$/",
        "/^\\.chezmoidata\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*\\w+:\\s*\\\"(?<currentValue>[^\\\"]+)\\\"\\s+#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*$"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/dot_devcontainer\\/devcontainer\\.json\\.tmpl$/"
      ],
      "matchStrings": [
        "(?m)^\\s*\\\"[A-Z_]+\\\":\\s*\\\"(?<currentValue>[^\\\"]+)\\\",\\s*\\/\\/\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*$"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/dot_devcontainer\\/postCreate\\.sh$/"
      ],
      "matchStrings": [
        "(?m)^\\s*python3\\s+-m\\s+pip\\s+install\\s+--user\\s+\\\"[^\\\"=]+==(?<currentValue>[^\\\"]+)\\\"\\s+#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*$"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/configs\\/uv_tools\\.txt$/"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440",
      "matchStrings": [
        "(?m)^(?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[0-9][^\\s#]*)$"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_Documents\\/development\\/container-dotfiles\\/devcontainers\\/gitlab\\.com\\/servers-homelab\\/homelab-IaC\\/configs\\/npm_packages\\.txt$/"
      ],
      "datasourceTemplate": "npm",
      "matchStrings": [
        "(?m)^(?<depName>(?:@[^\\/\\s]+\\/)?[^@\\s]+)@(?<currentValue>[0-9][^\\s#]*)$"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^private_dot_config\\/opencode\\/opencode\\.jsonc$/",
        "/^private_Documents\\/development\\/container-dotfiles\\/dotfiles\\/private_dot_config\\/opencode\\/opencode\\.jsonc$/"
      ],
      "datasourceTemplate": "npm",
      "matchStrings": [
        "(?m)^\\s*\\\"(?<depName>(?:@[^\\/\\\"\\s]+\\/)?[^@\\\"\\s]+)@(?<currentValue>[0-9][^\\\"\\s]*)\\\",?\\s*$",
        "(?m)^\\s*\\[\\s*\\\"(?<depName>(?:@[^\\/\\\"\\s]+\\/)?[^@\\\"\\s]+)@(?<currentValue>[0-9][^\\\"\\s]*)\\\"\\s*,"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dot_claude\\/executable_statusline\\.sh$/",
        "/^private_Documents\\/development\\/container-dotfiles\\/dotfiles\\/dot_claude\\/executable_statusline\\.sh$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Astro-Han/claude-pace",
      "matchStrings": [
        "(?m)^CLAUDE_PACE_VERSION=\\\"(?<currentValue>v[^\\\"]+)\\\"\\s*$"
      ]
    }
  ],

  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "minimumReleaseAge": null,
      "groupName": "opencode plugins (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "opencode plugins (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_dot_config/opencode/opencode.jsonc",
        "private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/opencode.jsonc"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "opencode plugins (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "container npm tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "container npm tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "container npm tools (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/uv_tools.txt",
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postCreate.sh"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "container python tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/uv_tools.txt",
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postCreate.sh"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "container python tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/uv_tools.txt",
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postCreate.sh"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "container python tools (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/devcontainer.json.tmpl"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "container bootstrap tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/devcontainer.json.tmpl"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "container bootstrap tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/devcontainer.json.tmpl"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "container bootstrap tools (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/browser-policies/justthebrowser/manifest.json"],
      "automerge": false,
      "groupName": "justthebrowser browser policies"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/packages.yaml"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "wsl tool versions (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/packages.yaml"],
      "matchUpdateTypes": ["minor"],
      "groupName": "wsl tool versions (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["configs/packages.yaml"],
      "matchUpdateTypes": ["major"],
      "groupName": "wsl tool versions (major)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "dot_claude/executable_statusline.sh",
        "private_Documents/development/container-dotfiles/dotfiles/dot_claude/executable_statusline.sh"
      ],
      "groupName": "claude-pace statusline",
      "additionalBranchPrefix": "statusline-"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".chezmoidata.yaml"],
      "matchDepNames": ["backnotprop/plannotator"],
      "groupName": "plannotator cli"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt"
      ],
      "matchDepNames": ["opencode-ai"],
      "enabled": false,
      "description": "TODO: remove once OpenCode > 1.15.12 fixes issues related to not being able to accept agent permission prompts & missing session history. Pinned to 1.15.11 as a workaround."
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "@anthropic-ai/claude-code",
        "uv",
        "dolthub/dolt",
        "backnotprop/plannotator",
        "@plannotator/opencode",
        "njbrake/agent-of-empires"
      ],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "fast moving tools (patch)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "@anthropic-ai/claude-code",
        "uv",
        "dolthub/dolt",
        "backnotprop/plannotator",
        "@plannotator/opencode",
        "njbrake/agent-of-empires"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "fast moving tools (minor)"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "@anthropic-ai/claude-code",
        "uv",
        "dolthub/dolt",
        "backnotprop/plannotator",
        "@plannotator/opencode",
        "njbrake/agent-of-empires"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "fast moving tools (major)"
    }
  ]
}
