# Container rendered configs (exclude all files, keep .gitkeep to preserve directory structure)
private_Documents/development/container-dotfiles/dotfiles/configs/*
!private_Documents/development/container-dotfiles/dotfiles/configs/.gitkeep

# Override global gitignore to allow VS Code workspace files
!*.code-workspace

# Override global gitignore ([Bb]in) to allow repo scripts
!bin/
!bin/**

# Python runtime artifacts
__pycache__/
*.pyc

# Ignore coding harness files
.claude/.needs_dotfiles_review*
.cz-audit
.opencode/*dotfiles*
.opencode/review-loop.seed.json
.ai-wt/
.ai-wt/**
.tempograph/
.tempograph/**
.codebase-memory/
worktrees/
worktrees/**

### Beads / Dolt runtime artifacts
.beads/interactions.jsonl
.beads/issues.jsonl
# Secret-bearing local config and the transient hold `beads-sync init`
# creates while hiding it from bd init (belt-and-braces; .beads/.gitignore
# covers only the exact unsuffixed name and bd may regenerate that file).
.beads/config.local.yaml*

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
