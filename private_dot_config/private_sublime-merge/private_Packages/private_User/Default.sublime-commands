[
    {
        "caption": "Cleanup Repo",
        "command": "git",
        "args": {"argv": ["gc"]}
    },
    {
        "caption": "Check Next Tag Version",
        "command": "git",
        "args": {"argv": ["mkver", "next"]}
    },
    {
        "caption": "Tag Next Version",
        "command": "git",
        "args": {"argv": ["mkver", "tag"]}
    },
    {
        "caption": "Git: Arm GPT co-author for next commit",
        "command": "git",
        "args": {"argv": ["config", "--global", "coauthor.gptNext", "true"]}
    },
    {
        "caption": "Git: Disarm GPT co-author",
        "command": "git",
        "args": {"argv": ["config", "--global", "--unset-all", "coauthor.gptNext"]}
    },
    {
        "caption": "Git: Set default GPT co-author trailer",
        "command": "git",
        "args": {
            "argv": [
                "config",
                "--global",
                "coauthor.gptTrailer",
                "Co-authored-by: GPT-5.2 (High Reasoning mode) <noreply@openai.com>"
            ]
        }
    },
    {
        "caption": "Git: Amend author to OpenCode (ocauth)",
        "command": "git",
        "args": {"argv": ["ocauth"]}
    }
]
