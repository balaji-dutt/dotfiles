{{- $os := .chezmoi.os -}}
{{- $isLinux := eq $os "linux" -}}
{{- $isWindows := eq $os "windows" -}}
{{- $isDarwin := eq $os "darwin" -}}
{{- $osrel := "" -}}
{{- $isWSL := false -}}
{{- $isWSL2 := false -}}
{{- if $isLinux -}}
  {{- $osrel = (get .chezmoi.kernel "osrelease" | default "" | lower) -}}
  {{- $isWSL = or (get . "isWSL" | default false) ($osrel | contains "microsoft") -}}
  {{- $isWSL2 = or (get . "isWSL2" | default false) (and $isWSL ($osrel | contains "wsl2")) -}}
{{- end -}}
{{- $useWindowsWorkaround := or $isWindows $isWSL2 -}}
{{- $useBridge := or $isDarwin $isWSL2 -}}
{{- $useCommandPath := or $useWindowsWorkaround $isDarwin -}}
{
  "sound": false,
  "notification": {{ if $useCommandPath }}false{{ else }}true{{ end }},
  "bell": false,
  "showProjectName": true,
  "showSessionTitle": true,
  "suppressWhenFocused": {{ if $isDarwin }}false{{ else }}true{{ end }},
  "command": {
    "enabled": {{ if $useCommandPath }}true{{ else }}false{{ end }},
{{- if $useBridge }}
    "path": "opencode-notifier-bridge",
    "args": [
      "--title",
      "OpenCode - {event}",
      "--message",
      "{message}",
      "--event",
      "{event}"
    ],
{{- else }}
    "path": "powershell.exe",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "{{ .chezmoi.homeDir | replace "\\" "/" }}/.local/windows-notify.ps1",
      "-Title",
      "OpenCode - {event}",
      "-Message",
      "{message}"
    ],
{{- end }}
    "minDuration": 0
  },
  "events": {
    "subagent_complete": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "user_cancelled": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "session_started": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "user_message": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "client_connected": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    }
  }
}
