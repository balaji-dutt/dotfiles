{{- $os := .chezmoi.os -}}
{{- $isLinux := eq $os "linux" -}}
{{- $isWindows := eq $os "windows" -}}
{{- $isDarwin := eq $os "darwin" -}}
{{- $osrel := "" -}}
{{- $isWSL := false -}}
{{- $isWSL2 := false -}}
{{- if $isLinux -}}
  {{- $osrel = (get .chezmoi.kernel "osrelease" | default "" | lower) -}}
  {{- $isWSL = or (get . "isWSL" | default false) ($osrel | contains "microsoft") -}}
  {{- $isWSL2 = or (get . "isWSL2" | default false) (and $isWSL ($osrel | contains "wsl2")) -}}
{{- end -}}
{{- $useWindowsWorkaround := or $isWindows $isWSL2 -}}
{{- $useBridge := or $isDarwin $isWSL2 -}}
{{- /* macOS uses terminal-notifier via the command path for the same reason
        aoe-notify does: osascript-based notifications attribute to
        "Script Editor", which never registers in System Settings >
        Notifications, so banners silently no-op. WSL2 uses the same bridge so
        OpenCode notifications can be suppressed inside AoE while staying
        enabled for native OpenCode runs. */ -}}
{{- $useCommandPath := or $useWindowsWorkaround $isDarwin -}}
{
  "sound": false,
  "notification": {{ if $useCommandPath }}false{{ else }}true{{ end }},
  "bell": false,
  "showProjectName": true,
  "showSessionTitle": true,
  "suppressWhenFocused": {{ if $isDarwin }}false{{ else }}true{{ end }},
  "command": {
    "enabled": {{ if $useCommandPath }}true{{ else }}false{{ end }},
{{- if $useBridge }}
    "path": "opencode-notifier-bridge",
    "args": [
      "--title",
      "OpenCode - {event}",
      "--message",
      "{message}",
      "--event",
      "{event}"
    ],
{{- else }}
    "path": "powershell.exe",
    "args": [
      "-NoProfile",
      "-Command",
      "$wshell = New-Object -ComObject Wscript.Shell; $wshell.Popup('{message}', 5, 'OpenCode - {event}', 0+64)"
    ],
{{- end }}
    "minDuration": 0
  },
  "events": {
    "subagent_complete": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "user_cancelled": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "session_started": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "user_message": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "client_connected": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    }
  }
}
