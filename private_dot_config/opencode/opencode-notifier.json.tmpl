{{- $os := .chezmoi.os -}}
{{- $isLinux := eq $os "linux" -}}
{{- $isWindows := eq $os "windows" -}}
{{- $isDarwin := eq $os "darwin" -}}
{{- $osrel := "" -}}
{{- $isWSL2 := false -}}
{{- if $isLinux -}}
  {{- $osrel = (get .chezmoi.kernel "osrelease" | default "" | lower) -}}
  {{- $isWSL2 = and ($osrel | contains "microsoft") ($osrel | contains "wsl2") -}}
{{- end -}}
{{- $useWindowsWorkaround := or $isWindows $isWSL2 -}}
{{- /* macOS uses terminal-notifier via the command path for the same reason
       aoe-notify does: osascript-based notifications attribute to
       "Script Editor", which never registers in System Settings >
       Notifications, so banners silently no-op. */ -}}
{{- $useCommandPath := or $useWindowsWorkaround $isDarwin -}}
{
  "sound": false,
  "notification": {{ if $useCommandPath }}false{{ else }}true{{ end }},
  "bell": false,
  "showProjectName": true,
  "showSessionTitle": true,
  "suppressWhenFocused": {{ if $isDarwin }}false{{ else }}true{{ end }},
  "command": {
    "enabled": {{ if $useCommandPath }}true{{ else }}false{{ end }},
{{- if $isDarwin }}
    "path": "terminal-notifier",
    "args": [
      "-title",
      "OpenCode - {event}",
      "-message",
      "{message}",
      "-group",
      "opencode"
    ],
{{- else }}
    "path": "powershell.exe",
    "args": [
      "-NoProfile",
      "-Command",
      "$wshell = New-Object -ComObject Wscript.Shell; $wshell.Popup('{message}', 5, 'OpenCode - {event}', 0+64)"
    ],
{{- end }}
    "minDuration": 0
  },
  "events": {
    "subagent_complete": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "user_cancelled": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "session_started": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "user_message": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "client_connected": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    }
  }
}
