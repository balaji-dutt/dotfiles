;; Customizing centaur-tabs to bring everything into a single frame and
;; hide windows that tend to be noisy
(after! centaur-tabs
  (setq! centaur-tabs-show-navigation-buttons t)
  (setq! centaur-tabs-down-tab-text " ▼ ")

  ;; Ctrl + click on these icons allows for tabs to reordered.
  ;; (setq! centaur-tabs-forward-tab-text " ▶")
  ;; (setq! centaur-tabs-backward-tab-text " ◀")
  (defun centaur-tabs-hide-tab (x)
    "Disable tabs for certain buffer types"
    (let ((name (format "%s" x)))
      (or
      (window-dedicated-p (selected-window))
      ;; (string-prefix-p "*epc" name)
      ;; (string-prefix-p "*helm" name)
      ;; (string-prefix-p "*Helm" name)
      ;; (string-prefix-p "*which-key*" name)
      (string-prefix-p " *Org todo*" name)
      (string-prefix-p "*Async-native-compile-log*" name)
      (string-prefix-p "*Native-compile-Log*" name)
      (string-prefix-p "*compilation*" name)
      (string-prefix-p "*lsp" name)
      (string-prefix-p "*markdown-output" name)
      (string-prefix-p "*httpd" name)
      (string-prefix-p " *" name)
      (string-prefix-p "*eshell" name)
      (string-prefix-p "*flyspell-region*" name)
      (string-prefix-p "*Default-eshell" name)
      (string-prefix-p "*Calendar*" name)
      (string-prefix-p "init.org" name) ;;Although org-agenda will load this file, this should prevent it showing up in the list of tabs.
      (string-prefix-p "memorybanks.org" name) ;;Since this file is only used to archive tasks, it can be hidden.
      ;; (string-prefix-p "zotero.bib" name)
      (and (string-prefix-p "magit" name)
      ))))

  (defun centaur-tabs-buffer-groups ()
    "`centaur-tabs-buffer-groups' control buffers' group rules."
    (list
    "DEFAULT"))
)


;; Setup spellcheck
(after! spell-fu
  (setq ispell-program-name "hunspell")
  (ispell-check-version)
  (setq ispell-dictionary-alist
      '((nil "[A-Za-z]" "[^A-Za-z]" "[']" t
            ("-d" "en_GB" "-i" "utf-8") nil utf-8)
        ("american"
        "[A-Za-z]" "[^A-Za-z]" "[']" nil
        ("-d" "en_US") nil utf-8)
        ("english"
        "[A-Za-z]" "[^A-Za-z]" "[']" nil
        ("-d" "en_GB") nil utf-8)
        ("british"
        "[A-Za-z]" "[^A-Za-z]" "[']" nil
        ("-d" "en_GB") nil utf-8)))
  (progn
    (
    setq ispell-dictionary "british"
    ;; ispell-change-dictionary "english"
    ;; ispell-local-dictionary "en_US,en_GB"
    ispell-extra-args '("-a" "-i" "utf-8")
    ispell-silently-savep t
    ))
  (add-to-list 'ispell-skip-region-alist '("^#+BEGIN_SRC" . "^#+END_SRC"))
  (setq ispell-personal-dictionary "~/.emacs.d/.local/etc/ispell/.pws")
)

