;; Configure org-mode
(after! org
  (add-hook! 'org-mode-hook #'emojify-mode)

  ;; Setup org-todos
  (setq org-todo-keywords
        (quote ((sequence "TODO(t)" "NEXT(n)" "WIP(i)" "MAYBE(e)" "|" "DONE(d)")
                (sequence "WAITING(w@/!)" "HOLD(h@/!)" "|" "CANCELLED(c@/!)"))))
  (setq org-todo-keyword-faces
        '(("PROJ" :background "blue" :foreground "black" :weight bold :box (:line-width 2 :style released-button))
          ("TODO" :background "red1" :foreground "black" :weight bold :box (:line-width 2 :style released-button))
          ("NEXT" :background "red2" :foreground "black" :weight bold :box (:line-width 2 :style released-button))
          ("WIP" :background "orange" :foreground "black" :weight bold :box (:line-width 2 :style released-button))
          ("WAITING" :background "yellow" :foreground "black" :weight bold :box (:line-width 2 :style released-button))
          ("HOLD" :background "gold" :foreground "black" :weight bold :box (:line-width 2 :style released-button))
          ("DELEGATED" :background "gold" :foreground "black" :weight bold :box (:line-width 2 :style released-button))
          ("MAYBE" :background "gray" :foreground "black" :weight bold :box (:line-width 2 :style released-button))
          ("APPT" :background "red1" :foreground "black" :weight bold :box (:line-width 2 :style released-button))
          ("DONE" :background "forest green" :weight bold :box (:line-width 2 :style released-button))
          ("CANCELLED" :background "#b1cfff" :foreground "black" :weight bold :box (:line-width 2 :style released-button))))

  ;; Setup org capture templates
  ;; :kill-buffer t
  (setq org-default-notes-file (concat org-directory "inbox.org"))
  ;; Ugly hack to allow all .org files in the org-directory to be used as refile targets
  ;; without expecting org-agenda to also be available.
  (setq org-targets (file-expand-wildcards (concat org-directory "*.org")))
  (setq org-refile-targets '((org-targets :maxlevel . 2)
                             (nil :maxlevel . 5)))
  (setq org-outline-path-complete-in-steps nil)         ; Refile in a single go
  (setq org-refile-use-outline-path t)                  ; Show full paths for refiling
  (setq org-capture-templates `(
                                 ("n" "Do Now" entry (file+headline org-default-notes-file "TASKS")
                                 "** NEXT %u:  %?" :prepend t)
                                ("t" "ToDo" entry (file+headline org-default-notes-file "TASKS")
                                 "** TODO %u:  %?" :prepend t)
                                ("l" "Research ToDo" entry (file+headline org-default-notes-file "RESEARCH")
                                 "** TODO  %?\n   +Notes\n    - %u: %(org-cliplink-capture)" :prepend t)
                                ("m" "Maybe" entry (file+headline org-default-notes-file "TASKS")
                                 "** MAYBE %u:  %?" :prepend t)
                                ("e" "Research Maybe" entry (file+headline org-default-notes-file "RESEARCH")
                                 "** MAYBE  %?\n   +Notes\n    - %u: %(org-cliplink-capture)" :prepend t)
                                ))

)

