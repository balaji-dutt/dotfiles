# Claude Code env (scoped to claude invocation)
function Invoke-WithScopedEnv {
  param(
    [Parameter(Mandatory)][hashtable]$Env,
    [Parameter(Mandatory)][scriptblock]$ScriptBlock
  )

  $had = @{}
  $prev = @{}

  foreach ($k in $Env.Keys) {
    $had[$k] = Test-Path "Env:$k"
    $prev[$k] = if ($had[$k]) { (Get-Item "Env:$k").Value } else { $null }
    Set-Item -Path "Env:$k" -Value $Env[$k]
  }

  try {
    & $ScriptBlock
  } finally {
    foreach ($k in $Env.Keys) {
      if ($had[$k]) {
        Set-Item -Path "Env:$k" -Value $prev[$k]
      } else {
        Remove-Item -Path "Env:$k" -ErrorAction SilentlyContinue
      }
    }
  }
}

function Resolve-ExternalCommandSource {
  param([Parameter(Mandatory)][string]$Name)

  $commands = @(Get-Command $Name -CommandType Application,ExternalScript -All -ErrorAction SilentlyContinue)
  if (-not $commands -or $commands.Count -eq 0) {
    return $null
  }

  $preferred = $commands | Where-Object { $_.Source -match '\.exe$' } | Select-Object -First 1
  if ($preferred) {
    return $preferred.Source
  }

  return ($commands | Select-Object -First 1).Source
}

function global:claude {
  param([Parameter(ValueFromRemainingArguments = $true)][object[]]$Args)

  $cmdSource = Resolve-ExternalCommandSource -Name 'claude'
  if (-not $cmdSource) {
    Write-Error "claude executable not found in PATH"
    return
  }

  $cliArgs = $Args

  Invoke-WithScopedEnv -Env @{
    ANTHROPIC_API_KEY     = ''
    DISABLE_TELEMETRY     = 'true'
    DISABLE_COST_WARNINGS = 'true'
    API_TIMEOUT_MS        = '600000'
  } -ScriptBlock { & $cmdSource @cliArgs }
}

function global:claude_raw {
  param([Parameter(ValueFromRemainingArguments = $true)][object[]]$Args)

  $cmdSource = Resolve-ExternalCommandSource -Name 'claude'
  if (-not $cmdSource) {
    Write-Error "claude executable not found in PATH"
    return
  }

  & $cmdSource @Args
}
{{- end -}}
