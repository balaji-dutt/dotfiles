#!/bin/sh
set -eu

msgfile="$1"

# Only run when armed (one-shot flag stored in global config)
armed="$(git config --global --bool --get coauthor.gptNext 2>/dev/null || true)"
[ "$armed" = "true" ] || exit 0

# Disarm immediately (one-shot)
git config --global --unset-all coauthor.gptNext 2>/dev/null || true

if [ ! -f "$msgfile" ]; then
  echo "ERROR: commit message file does not exist: $msgfile" >&2
  exit 1
fi

# Local trailer overrides global trailer
co="$(git config --local --get coauthor.gptTrailer 2>/dev/null || true)"
if [ -z "$co" ]; then
  co="$(git config --global --get coauthor.gptTrailer 2>/dev/null || true)"
fi
[ -n "$co" ] || co='Co-authored-by: GPT-5.5 (High Reasoning mode) <noreply@openai.com>'

# Avoid duplicates (handle CRLF too)
if tr -d '\r' <"$msgfile" | grep -F -q "$co"; then
  exit 0
fi

# Insert before scissors line if present (so it does not get cut off)
scissors='# ------------------------ >8 ------------------------'
CR="$(printf '\r')"
tmp="$(git rev-parse --git-path gpt-coauthor-tmp.$$)"
trap 'rm -f "$tmp"' EXIT

inserted=0
: >"$tmp"

while IFS= read -r line || [ -n "$line" ]; do
  norm="${line%$CR}"

  if [ "$inserted" -eq 0 ] && [ "$norm" = "$scissors" ]; then
    printf '\n%s\n\n' "$co" >>"$tmp"
    inserted=1
  fi

  printf '%s\n' "$norm" >>"$tmp"
done <"$msgfile"

[ "$inserted" -eq 1 ] || printf '\n\n%s\n' "$co" >>"$tmp"

mv "$tmp" "$msgfile"
trap - EXIT
