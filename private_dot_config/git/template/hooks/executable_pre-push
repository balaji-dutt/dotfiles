#!/bin/sh
set -eu

remote_name=${1:-}
remote_url=${2:-}

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
policy="$repo_root/configs/gitlab-pipeline-guard.json"
helper="$repo_root/assets/check-gitlab-pipeline.py"

if [ ! -f "$policy" ]; then
  exit 0
fi

common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
  echo "ERROR: pipeline guard cannot resolve the Git common directory." >&2
  exit 1
}
override="$common_dir/pipeline-guard.override"
if [ -f "$override" ]; then
  echo "WARNING: bypassing GitLab pipeline guard because $override exists" >&2
  exit 0
fi

if [ ! -f "$helper" ]; then
  echo "ERROR: pipeline guard helper is missing: $helper" >&2
  exit 1
fi

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$helper" --repo-root "$repo_root" --policy "$policy" "$remote_name" "$remote_url"
fi
if command -v py >/dev/null 2>&1; then
  exec py -3 "$helper" --repo-root "$repo_root" --policy "$policy" "$remote_name" "$remote_url"
fi
if command -v python >/dev/null 2>&1 &&
   python -c 'import sys; raise SystemExit(sys.version_info[0] != 3)' >/dev/null 2>&1; then
  exec python "$helper" --repo-root "$repo_root" --policy "$policy" "$remote_name" "$remote_url"
fi

echo "ERROR: pipeline guard requires Python 3; create $override to bypass temporarily." >&2
exit 1
