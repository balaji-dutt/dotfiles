# Set HISTFILE with platform-specific naming
{{- if eq .chezmoi.os "darwin" }}
HISTFILE=${ZDOTDIR:-$HOME}/.m4mbp_zsh_history
{{- else if and (eq .chezmoi.osRelease.id "ubuntu") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
HISTFILE=${ZDOTDIR:-$HOME}/.ubuntuwsl2_zsh_history
{{- else if and (eq .chezmoi.osRelease.id "debian") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
HISTFILE=${ZDOTDIR:-$HOME}/.debianwsl2_zsh_history
{{- else }}
HISTFILE=${ZDOTDIR:-$HOME}/.${(%):-%n}_zsh_history
{{- end }}

# Set language variables
export LC_ALL=en_GB.UTF-8
export LANG=en_GB.UTF-8
export LC_MESSAGES=en_GB.UTF-8
export LC_TIME=en_SG.UTF-8
export LC_NUMERIC=en_SG.UTF-8
export LC_MONETARY=en_SG.UTF-8
export LANGUAGE=en_GB:en_US

{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
{{- if eq .chezmoi.osRelease.id "ubuntu" }}
# Set Browser variable for WSL browser integration
export BROWSER=wslview
{{- end }}
{{- end }}

# Set parameters for zsh-autosuggestions
export ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# Set autoload for ZSH prompt
autoload -Uz promptinit && promptinit
# Set prompt to powerlevel10k
prompt powerlevel10k

# Plugin customizations
# Customize MichaelAquilina/zsh-you-should-use message position
export YSU_MESSAGE_POSITION="after"
# Remove ISO8601 timestamps in search when using joshskidmore/zsh-fzf-history-search
export ZSH_FZF_HISTORY_SEARCH_DATES_IN_SEARCH=0
# Set keywords to be excluded from ZSH History using MichaelAquilina/zsh-history-filter
export HISTORY_FILTER_EXCLUDE=("_KEY" "Bearer")
