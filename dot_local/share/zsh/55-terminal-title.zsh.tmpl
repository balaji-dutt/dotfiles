# Terminal title for AI agent sessions.
#
# iTerm2's "Job" title component, and tmux's automatic rename, both name the
# tab after the deepest foreground job on the tty. MCP servers such as
# codebase-memory-mcp are foreground children of `claude` / `opencode`, so they
# win that race and the tab reads `codebase-memory-mcp` instead of the agent.
#
# Emit an explicit title on launch instead. A matching precmd hook writes the
# idle cwd title through OSC 0 after the command exits; this uses the same title
# channel and avoids leaving an application name behind.
#
# This registers after antidote loads oh-my-zsh (see dot_zshrc.tmpl ordering),
# so this preexec hook runs last and wins.
#
# Requires the iTerm2 profile setting "Applications in terminal may change the
# title"; see docs/tooling/iterm-titles.md.

autoload -Uz add-zsh-hook

# Commands whose tabs get an agent title. ai-wt is deliberately absent: it sets
# a better title from inside, using the real worktree branch.
_agent_title_commands=(
    claude
    claude-plannotator
    opencode
    opencode-plannotator
    opencode-plannotator-custom
)

# Branch when it is a feature branch, otherwise the repo directory name.
_agent_title_context() {
    emulate -L zsh

    local branch repo
    repo=$(command git rev-parse --show-toplevel 2>/dev/null)
    if [[ -z $repo ]]; then
        print -r -- "${PWD:t}"
        return 0
    fi

    branch=$(command git symbolic-ref --quiet --short HEAD 2>/dev/null)
    case $branch in
        ''|main|master) print -r -- "${repo:t}" ;;
        *) print -r -- "$branch" ;;
    esac
}

_agent_title_precmd() {
    emulate -L zsh

    [[ "${DISABLE_AUTO_TITLE:-}" != true ]] || return 0
    [[ -t 1 ]] || return 0

    # Match oh-my-zsh's idle titles, but reset the tab through OSC 0. Its title
    # helper emits separate OSC 1 and OSC 2 sequences, which do not reliably
    # clear a stale iTerm Session Name after an application exits. OSC 0 also
    # changes the window title, so restore the longer idle value with OSC 2.
    local tab_title=${ZSH_THEME_TERM_TAB_TITLE_IDLE:-'%15<..<%~%<<'}
    local window_title=${ZSH_THEME_TERM_TITLE_IDLE:-'%n@%m:%~'}
    print -Pn "\e]0;${tab_title}\a\e]2;${window_title}\a"
}

_agent_title_preexec() {
    emulate -L zsh

    [[ "${DISABLE_AUTO_TITLE:-}" != true ]] || return 0
    # Keep escape bytes out of redirected output, e.g. `zsh -ic claude | tee log`.
    [[ -t 1 ]] || return 0

    local -a cmdargs
    cmdargs=("${(z)2}")
    local command_name=${cmdargs[1]:t}
    (( ${_agent_title_commands[(Ie)$command_name]} )) || return 0

    local tool=$command_name
    case $tool in
        claude*) tool=claude ;;
        opencode*) tool=opencode ;;
    esac

    # OSC 0 sets both the window and icon/tab name. Deliberately not oh-my-zsh's
    # `title` helper: inside tmux that emits screen's `\ek...\e\\`, which sets
    # the tmux window name. This OSC 0 reaches no further than the pane either:
    # tmux records it as pane_title and deliberately forwards nothing out.
    # See docs/tooling/iterm-titles.md.
    printf '\033]0;%s\007' "${tool} · $(_agent_title_context)"
}

add-zsh-hook precmd _agent_title_precmd
add-zsh-hook preexec _agent_title_preexec
