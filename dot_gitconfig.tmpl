{{- /* Convenience flags */ -}}
{{- $isWSL := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $osrel := (get .chezmoi.kernel "osrelease" | default "" | lower) -}}
{{-   $isWSL = or (get . "isWSL" | default false) ($osrel | contains "microsoft") -}}
{{- end -}}
{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isWindows := eq .chezmoi.os "windows" -}}
{{- /* Opt in via [data.gitlab] use_glab_credential_helper = true. */ -}}
{{- $gitlab := (get . "gitlab" | default dict) -}}
{{- $useGlabCredentialHelper := (get $gitlab "use_glab_credential_helper" | default false) -}}
{{- $glabPath := lookPath "glab" -}}

[init]
    defaultBranch = main
    templateDir = ~/.config/git/template
[transfer]
    fsckobjects = true
[fetch]
    fsckobjects = true
    prune = true
[receive]
    fsckobjects = true

[core]
{{- if $isWSL }}
    excludesfile = /mnt/c/Users/{{ .homelab.windows_user }}/.gitignore_global
    # Works when VS Code sets PATH inside WSL shells
    editor = code --wait
    # Don't consider trailing space change as a cause for merge conflicts
    whitespace = -trailing-space
    preloadindex = true
    # fsmonitor disabled on typical WSL Git; enable if >= 2.37
    # fsmonitor = true
{{- else if $isDarwin }}
    excludesfile = ~/.gitignore_global
    editor = code --wait
    whitespace = -trailing-space
    preloadindex = true
    pager = diff-so-fancy | less --tabs=4 -RFX
{{- else if $isWindows }}
    excludesfile = {{ .chezmoi.homeDir | replace "\\" "/" }}/.gitignore_global
    editor = code --wait
    whitespace = -trailing-space
    preloadindex = true
{{- else }}
    # Generic Linux / Other Unix
    excludesfile = $HOME/.gitignore
    whitespace = -trailing-space
    preloadindex = true
    fsmonitor = true
{{ end }}

{{- $opCmd := .chezmoi.config.onepassword.command -}}
{{- $opPath := lookPath $opCmd -}}
{{- $opEmail := "" -}}
{{- if $opPath -}}
  {{- if $isWindows -}}
    {{- $opEmail = (output "powershell.exe" "-NoProfile" "-Command" (printf "$ErrorActionPreference='SilentlyContinue'; $v = & '%s' read --no-newline op://private/gitlab.com/email 2>$null; if ($LASTEXITCODE -eq 0) { $v }" $opPath)) | trim -}}
  {{- else -}}
    {{- $opEmail = (output "sh" "-lc" (printf "%q read --no-newline op://private/gitlab.com/email 2>/dev/null || true" $opPath)) | trim -}}
  {{- end -}}
{{- end }}

[user]
    name = {{ .name }}
{{- if $opEmail }}
    email = {{ $opEmail }}
{{- else }}
    email = {{ .email }}
{{- end }}

[merge]
    defaultToUpstream = true
    keepBackup = false
[rebase]
    autosquash = true
[branch]
    autosetupmerge = always
[push]
    default = matching
[http]
    postBuffer = 52428800
[log]
    # Use abbrev SHAs when possible
    abbrevCommit = true
[color "diff"]
    new = green bold
    meta = 11
    frag = magenta bold
    func = 146 bold
    commit = yellow bold
    old = red bold
    whitespace = red reverse
[color "status"]
    updated = green bold
[color "branch"]
    current = green bold
[alias]
    plog = log --graph --decorate --pretty=oneline --abbrev-commit --all
    co = checkout
    sw = switch
    br = branch -vv
    ci = commit
    amend = commit --amend --no-edit
    clauth = commit --amend --author=\"Claude <claude@anthropic.com>\" --no-edit
    ocauth = commit --amend --author=\"OpenCode <noreply@opencode.ai>\" --no-edit
    unstage = restore --staged --
    last = log -1 --stat
    lg = log --graph --decorate --pretty=format:'%C(auto)%h%d %s %C(black)%C(bold)%cr'
    done = push --follow-tags origin HEAD

# ========= Platform-specific tools and safe dirs =========
{{- if $isWSL }}
[diff]
    mnemonicPrefix = true
    colorMoved = zebra
    renames = true
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE
[difftool]
    prompt = false
[merge]
    tool = smerge
[mergetool "smerge"]
    cmd = smerge mergetool $BASE $LOCAL $REMOTE -o $MERGED
    keepTemporaries = false
    trustExitCode = true
[mergetool]
    prompt = false
    keepBackup = false
[safe]
    directory = /mnt/devdrive/homelab-IaC
    directory = /mnt/devdrive/hosted-servers-iac
    directory = /mnt/devdrive/agentic-tooling
    directory = /mnt/devdrive/agentic-tooling/.git
    directory = /mnt/devdrive/Beads-Kanban
    directory = /mnt/devdrive/Beads-Kanban/.git
{{- else if $isDarwin }}
[diff]
    mnemonicPrefix = true
    colorMoved = zebra
    renames = true
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE
[difftool]
    prompt = false
[merge]
    tool = smerge
[mergetool "smerge"]
    cmd = '/Applications/Sublime Merge.app/Contents/SharedSupport/bin/smerge' mergetool $BASE $LOCAL $REMOTE -o $MERGED
    keepTemporaries = false
    trustExitCode = true
[mergetool]
    prompt = false
    keepBackup = false
[interactive]
    diffFilter = diff-so-fancy --patch
[color "diff-highlight"]
    oldNormal = red bold
    oldHighlight = red bold 52
    newNormal = green bold
    newHighlight = green bold 22
[color]
    ui = true
[safe]
    directory = /Volumes/devdrive/homelab-IaC
    directory = /Volumes/devdrive/hosted-servers-iac
    directory = /Volumes/devdrive/agentic-tooling
{{- else if $isWindows }}
[diff]
    mnemonicPrefix = true
    colorMoved = zebra
    renames = true
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE
[difftool]
    prompt = false
[merge]
    tool = vscode
[mergetool "vscode"]
    cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
    keepTemporaries = false
    trustExitCode = true
[mergetool]
    prompt = false
    keepBackup = false
{{- else }}
# Generic Linux / Other Unix
[diff]
    mnemonicPrefix = true
    colorMoved = zebra
    renames = true
    tool = vimdiff
[merge]
    tool = vimdiff
{{- end }}
{{- if and $useGlabCredentialHelper $glabPath }}
[credential "https://gitlab.com"]
    helper =
    helper = !{{ $glabPath }} auth git-credential
{{ end -}}
