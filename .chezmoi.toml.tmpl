{{- $name := promptStringOnce . "name" "Name" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $CERTPATH := promptStringOnce . "CERTPATH" "Path to Internal SSL Cert Directory" "" -}}
{{- $CERTFILES_RAW := promptStringOnce . "CERTFILES_RAW" "Certificate filenames (comma-separated, e.g. root.pem, inter.crt)" "" -}}
{{- $SSH_ADD_KEYFILES_RAW := "" -}}
{{- $ansible_key := "" -}}
{{- /* When required, replace the line above with:
      $ansible_key := promptStringOnce . "ansible_key" "Path to Ansible SSH Private Key" ""
*/ -}}
{{- $org_dir := promptStringOnce . "org_dir" "Path to Emacs org-mode directory" "" -}}

{{- /* WSL-specific prompts */ -}}
{{- $nfsServer := "" -}}
{{- $nfsPath := "" -}}
{{- $windowsUser := "" -}}
{{- $npiperelayPath := "" -}}
{{- $opEmail := "" -}}
{{- $opURL := "" -}}
{{- /* Windows specific prompts */ -}}
{{- $windowsPuttyKeysDir := "" -}}
{{- $windowsPageantKeysAllowlist := "" -}}

{{- $isWSL := false -}}
{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
{{-   $isWSL = true -}}
{{- end -}}

{{- if $isWSL -}}
{{-   $nfsServer = promptStringOnce . "homelab.nfs_server" "NFS server IP (leave empty to skip)" -}}
{{-   $nfsPath = promptStringOnce . "homelab.nfs_path" "NFS export path (leave empty to skip)" -}}
{{-   $windowsUser = promptStringOnce . "homelab.windows_user" "Windows username" -}}
{{-   $npiperelayPath = promptStringOnce . "homelab.npiperelay_path" "npiperelay.exe relative to C:\\Users\\<username> (default: Applications/npiperelay.exe)" "Applications/npiperelay.exe" -}}
{{-   $opURL = promptStringOnce . "onepassword.url" "1Password account URL e.g. my.1password.com (leave empty to skip)" -}}
{{-   $opEmail = promptStringOnce . "onepassword.email" "1Password email (leave empty to skip)" -}}
{{- end -}}

{{- if eq .chezmoi.os "windows" -}}
{{-   $windowsPuttyKeysDir = promptStringOnce . "windows.putty_keys_dir" "Path to PuTTY keys directory (leave empty to skip)" "" -}}
{{-   $windowsPageantKeysAllowlist = promptStringOnce . "windows.pageant_keys_allowlist" "Path to pageant-keys.txt allowlist (leave empty to skip)" "" -}}
{{- end -}}

{{- if eq .chezmoi.os "darwin" -}}
{{-   $SSH_ADD_KEYFILES_RAW = promptStringOnce . "SSH_ADD_KEYFILES_RAW" "SSH key filenames for ssh-add (comma-separated, e.g. id_ed25519, prod_rsa)" "" -}}
{{- end -}}

{{- /* sourceDir: prompt once; default on everything except Windows */ -}}
{{- $defaultSourceDir := "" -}}
{{- if ne .chezmoi.os "windows" -}}
  {{- $defaultSourceDir = joinPath .chezmoi.homeDir "Documents" "development" "dotfiles" -}}
{{- end -}}

{{- $sourceDir := promptStringOnce . "sourceDirInput" "Path to dotfiles repo (sourceDir)" $defaultSourceDir -}}

# Chezmoi config (other templates/scripts can use this via {{ "{{ .chezmoi.sourceDir }}" }})
sourceDir = {{ $sourceDir | toToml }}

{{ if lookPath "code" -}}
[diff]
command = "code"
{{- if $isWSL }}
args = ["--reuse-window", "--wait", "--diff"]
{{- else }}
args = ["--wait", "--diff"]
{{- end }}

[merge]
{{- if eq .chezmoi.os "windows" }}
command = "powershell.exe"
args = [
  "-NoProfile",
  "-Command",
  {{ printf "%q" "Copy-Item -LiteralPath {{ .Target | quote }} -Destination ({{ printf \"%s.base\" .Target | quote }}) -Force; code --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},
]
{{- else }}
command = "bash"
args = [
  "-c",
  {{- if $isWSL }}
  {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --reuse-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},
  {{- else }}
  {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},
  {{- end }}
]
{{- end }}
{{ end -}}

{{- $CERTFILES := list -}}
{{- range $f := splitList "," $CERTFILES_RAW -}}
{{-   $f = $f | trim -}}
{{-   if $f -}}
{{-     $CERTFILES = append $CERTFILES $f -}}
{{-   end -}}
{{- end }}

{{- $SSH_ADD_KEYFILES := list -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   range $f := splitList "," $SSH_ADD_KEYFILES_RAW -}}
{{-     $f = $f | trim -}}
{{-     if $f -}}
{{-       $SSH_ADD_KEYFILES = append $SSH_ADD_KEYFILES $f -}}
{{-     end -}}
{{-   end -}}
{{- end }}

{{- if $isWSL }}
[onepassword]
command = "op.exe"
{{- end }}

[data]
    email = {{ $email | toToml }}
    name = {{ $name | toToml }}
    CERTPATH = {{ $CERTPATH | toJson }}
    CERTFILES_RAW = {{ $CERTFILES_RAW | quote }}
    CERTFILES = {{ $CERTFILES | toToml }}
    SSH_ADD_KEYFILES_RAW = {{ $SSH_ADD_KEYFILES_RAW | quote }}
    SSH_ADD_KEYFILES = {{ $SSH_ADD_KEYFILES | toToml }}
    org_dir = {{ $org_dir | quote }}
    isWSL = {{ $isWSL }}
    {{- if $ansible_key }}
    ansible_key = {{ $ansible_key | toToml }}
    {{- else }}
    # ansible_key = ""  # Path to Ansible SSH Private Key
    {{- end }}
    # Ensures chezmoi will not reprompt on init.
    sourceDirInput = {{ $sourceDir | toToml }}

{{ if $isWSL -}}
[data.homelab]
    nfs_server = {{ $nfsServer | quote }}
    nfs_path = {{ $nfsPath | quote }}
    windows_user = {{ $windowsUser | quote }}
    npiperelay_path = {{ $npiperelayPath | quote }}

[data.onepassword]
    url = {{ $opURL | quote }}
    email = {{ $opEmail | quote }}
{{- end}}

{{- if eq .chezmoi.os "windows" }}
[data.windows]
    powershell_dir = ""
    powershell_scripts_dir = ""
    putty_dir = {{ "C:\\Program Files\\PuTTY" | toToml }}
    wsl_ssh_pageant_exe = {{ "C:\\Program Files\\PuTTY\\wsl-ssh-pageant-amd64-gui.exe" | toToml }}
    wsl_agent_sock = {{ (joinPath .chezmoi.homeDir ".wsl-ssh-pageant" "ssh-agent.sock") | toToml }}
    putty_keys_dir = {{ $windowsPuttyKeysDir | toToml }}
    pageant_keys_allowlist = {{ $windowsPageantKeysAllowlist | toToml }}
{{- end }}
