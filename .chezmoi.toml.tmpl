{{- $name := promptStringOnce . "name" "Name" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $CERTPATH := promptStringOnce . "~/certpath" "Path to Internal SSL Cert Directory" -}}
{{- $CERTFILES := promptStringOnce . "rootca.pem" "Certificate filenames (space-separated, e.g. 'root.pem inter.crt')" -}}
{{- $ansible_key := promptStringOnce . "ansible_key" "Path to Ansible SSH Private Key" -}}
{{- $org_dir := promptStringOnce . "Org-mode Directory" "Path to Emacs org-mode directory" -}}


{{- /* WSL-specific prompts */ -}}
{{- $nfsServer := "" -}}
{{- $nfsPath := "" -}}
{{- $windowsUser := "" -}}
{{- $opAccount := "" -}}
{{- $opEmail := "" -}}

{{- $isWSL := false -}}
{{- if stat "/proc/sys/fs/binfmt_misc/WSLInterop" -}}
{{-   $isWSL = true -}}
{{- end -}}

{{- if $isWSL -}}
{{-   $nfsServer = promptStringOnce . "homelab.nfs_server" "NFS server IP (leave empty to skip)" -}}
{{-   $nfsPath = promptStringOnce . "homelab.nfs_path" "NFS export path (leave empty to skip)" -}}
{{-   $windowsUser = promptStringOnce . "homelab.windows_user" "Windows username" -}}
{{-   $opAccount = promptStringOnce . "onepassword.account" "1Password account URL e.g. my.1password.com (leave empty to skip)" -}}
{{-   $opEmail = promptStringOnce . "onepassword.email" "1Password email (leave empty to skip)" -}}
{{- end -}}

{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
sourceDir = "/home/balaji/Documents/development/dotfiles"
{{- else if eq .chezmoi.os "darwin" -}}
sourceDir = "/Users/balaji/Documents/development/dotfiles"
{{ else }}
# other operating system
{{ end }}

{{- $hasCode := false -}}
{{- if lookPath "code" -}}
{{-   $hasCode = true -}}
{{- end -}}
{{if $hasCode}}
[diff]
command = "code"
args = ["--wait", "--diff"]

[merge]
command = "bash"
args = [
    "-c",
    "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}",
]

{{- end}}

[data]
    email = {{ $email | toToml }}
    name = {{ $name | toToml }}
    CERTPATH = {{ $CERTPATH | quote }}
    CERTFILES = {{ $CERTFILES | quote }}
    ansible_key = {{ $ansible_key | quote }}
    org_dir = {{ $org_dir | quote }}
    isWSL = {{ $isWSL }}

[data.homelab]
    nfs_server = {{ $nfsServer | quote }}
    nfs_path = {{ $nfsPath | quote }}
    windows_user = {{ $windowsUser | quote }}

[data.onepassword]
    account = {{ $opAccount | quote }}
    email = {{ $opEmail | quote }}
