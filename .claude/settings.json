{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/mark-needs-review.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-beads-on-plan-approval.sh\"",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-review-on-stop.sh\"",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/clear-needs-review-on-pass.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(chezmoi doctor)",
      "Bash(cz doctor)",
      "Bash(chezmoi apply --dry-run --verbose:*)",
      "Bash(cz apply --dry-run --verbose:*)",
      "Bash(cz apply --use-builtin-diff --no-pager --dry-run --verbose:*)",
      "Bash(cz --use-builtin-diff --no-pager apply --dry-run --verbose:*)",
      "Bash(chezmoi apply --use-builtin-diff --no-pager --dry-run --verbose:*)",
      "Bash(chezmoi --use-builtin-diff --no-pager apply --dry-run --verbose:*)",
      "Bash(chezmoi --use-builtin-diff --no-pager diff:*)",
      "Bash(cz --use-builtin-diff --no-pager diff:*)",
      "Bash(chezmoi target-path:*)",
      "Bash(cz target-path:*)",
      "Bash(./assets/cz-audit.sh:*)",
      "Bash(pwsh ./assets/cz-audit.ps1:*)",
      "PowerShell(pwsh ./assets/cz-audit.ps1 *)",
      "PowerShell(pwsh -NoProfile -Command \"./assets/cz-audit.ps1 *)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)"
    ],
    "deny": [
      "Bash(chezmoi destroy:*)",
      "Bash(chezmoi edit-config:*)",
      "Bash(chezmoi encrypt:*)",
      "Bash(chezmoi forget:*)",
      "Bash(chezmoi git:*)",
      "Bash(chezmoi purge:*)",
      "Bash(chezmoi ssh:*)",
      "Bash(chezmoi state delete:*)",
      "Bash(chezmoi state delete-bucket:*)",
      "Bash(chezmoi state reset)",
      "Bash(chezmoi state set:*)",
      "Bash(chezmoi unmanage:*)",
      "Bash(chezmoi upgrade)",
      "Bash(cz destroy:*)",
      "Bash(cz edit-config:*)",
      "Bash(cz encrypt:*)",
      "Bash(cz forget:*)",
      "Bash(cz git:*)",
      "Bash(cz purge:*)",
      "Bash(cz ssh:*)",
      "Bash(cz state delete:*)",
      "Bash(cz state delete-bucket:*)",
      "Bash(cz state reset)",
      "Bash(cz state set:*)",
      "Bash(cz unmanage:*)",
      "Bash(cz upgrade)"
    ]
  }
}
