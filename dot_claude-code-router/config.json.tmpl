{
  "NON_INTERACTIVE_MODE": {{ env "NON_INTERACTIVE_MODE" | default "false" }},
  "LOG": true,
  "LOG_LEVEL": "debug",
  "CLAUDE_PATH": "",
  "HOST": "127.0.0.1",
  "PORT": 3456,
  "APIKEY": "",
  "API_TIMEOUT_MS": "600000",
  "PROXY_URL": "",
  "transformers": [
    {
      "path": "{{ if (env "FOR_CONTAINER") }}/home/vscode{{ else }}{{ .chezmoi.homeDir }}{{ end }}/.claude-code-router/plugins/perplexity-websearch-fix.js"
    }
  ],
  "Providers": [
    {
      "name": "openai",
      "api_base_url": "https://api.openai.com/v1/chat/completions",
      "api_key": "{{ onepasswordRead "op://Private/ryptv6jhozhiod5sl4ha6mctqa/credential" }}",
      "models": [
        "gpt-5.2",
        "gpt-5.2-reasoning",
        "gpt-5.2-reasoning-extra",
        "gpt-5.1-codex-max",
        "gpt-4o-mini"
      ],
      "gpt-5.2": {
        "description": "Default modified for reasoning quality medium",
        "model_id": "gpt-5.1",
        "params": {
          "reasoning": {
            "effort": "medium"
          }
        }
      },
      "gpt-5.2-reasoning": {
        "model_id": "gpt-5.1",
        "params": {
          "reasoning": {
            "effort": "high"
          }
        }
      },
      "gpt-5.2-reasoning-extra": {
        "model_id": "gpt-5.1",
        "params": {
          "reasoning": {
            "effort": "xhigh"
          }
        }
      },
      "transformer": {
        "use": [
          "OpenAI"
        ],
        "gpt-4o-mini": {
          "use": [
            [
              "maxtoken",
              {
                "max_tokens": 16384
              }
            ]
          ]
        }
      }
    },
    {
      "name": "anthropic",
      "api_base_url": "https://api.anthropic.com/v1/messages",
      "api_key": "{{ onepasswordRead "op://Private/qwhr7uxduofl3gr66imqwer35m/credential" }}",
      "models": [
        "claude-haiku-4-5",
        "claude-sonnet-4-5",
        "claude-opus-4-5"
      ],
      "transformer": {
        "use": [
          "Anthropic"
        ]
      }
    },
    {
      "name": "google",
      "api_base_url": "https://generativelanguage.googleapis.com/v1beta/models/",
      "api_key": "{{ onepasswordRead "op://Private/x24pktz5hmyap3lhv36mcfohju/credential" }}",
      "models": [
        "gemini-3-pro-preview",
        "gemini-3-flash-preview",
        "gemini-3-pro-image-preview"
      ],
      "transformer": {
        "use": [
          "gemini"
        ]
      }
    },
    {
      "name": "moonshot",
      "api_base_url": "https://api.moonshot.ai/v1/chat/completions",
      "api_key": "{{ onepasswordRead "op://Private/wdnptbrsun7slb4oe7zaoucbau/credential" }}",
      "models": [
        "kimi-k2-0905-preview",
        "kimi-k2-thinking"
      ],
      "transformer": {
        "use": [
          "OpenAI"
        ],
        "kimi-k2-thinking": {
          "use": [
            "OpenAI",
            "reasoning"
          ]
        }
      },
      "kimi-k2-thinking": {
        "params": {
          "reasoning": true
        }
      }
    },
    {
      "name": "perplexity",
      "api_base_url": "https://api.perplexity.ai/chat/completions",
      "api_key": "{{ onepasswordRead "op://Private/gtf4i56alcsol4kgqepnwbicdu/credential" }}",
      "models": [
        "sonar-reasoning-pro"
      ],
      "transformer": {
        "use": [
          "OpenAI",
          "reasoning",
          "perplexity-websearch-fix",
          "cleancache"
        ]
      }
    },
    {
      "name": "openrouter",
      "api_base_url": "https://openrouter.ai/api/v1/chat/completions",
      "api_key": "{{ onepasswordRead "op://Private/w2sbpeyiuzclapxbhzraouhdna/credential" }}",
      "models": [
        "deepseek/deepseek-v3.1-terminus:exacto",
        "deepseek/deepseek-r1"
      ],
      "transformer": {
        "use": [
          "openrouter"
        ],
        "deepseek/deepseek-v3.1-terminus:exacto": {
          "use": [
            "openrouter",
            "reasoning",
            "enhancetool"
          ]
        },
        "deepseek/deepseek-r1": {
          "use": [
            "openrouter",
            "reasoning",
            "enhancetool"
          ]
        }
      },
      "deepseek/deepseek-v3.1-terminus:exacto": {
        "params": {
          "reasoning": {
            "enabled": true,
            "exclude": false
          }
        }
      },
      "deepseek/deepseek-r1": {
        "params": {
          "reasoning": {
            "enabled": true,
            "exclude": false
          }
        }
      }
    }
  ],
  "StatusLine": {
    "enabled": true,
    "currentStyle": "powerline",
    "default": {
      "modules": []
    },
    "powerline": {
      "modules": [
        {
          "type": "model",
          "icon": "🤖",
          "text": "{{ "{{" }}model{{ "}}" }}",
          "color": "bright_yellow"
        }
      ]
    },
    "fontFamily": "JetBrainsMono Nerd Font Mono"
  },
  "Router": {
    "default": "anthropic,claude-sonnet-4-5",
    "background": "openai,gpt-4o-mini",
    "think": "google,gemini-3-flash-preview",
    "longContext": "google,gemini-3-flash-preview",
    "longContextThreshold": 60000,
    "webSearch": "anthropic,claude-haiku-4-5",
    "image": "google,gemini-3-pro-image-preview"
  },
  "CUSTOM_ROUTER_PATH": ""
}