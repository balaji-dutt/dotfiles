{
  "name": "Homelab IaC - Container (Personalized)",
  "image": "homelab-iac:base",

  "containerEnv": {
    "DEVCONTAINER": "1", // Additional environment variable for use with chezmoi
    "FZF_VERSION": "0.66.0",
    "ZOXIDE_VERSION": "0.9.8",
    "LAZYGIT_VERSION": "latest",
    "DEVCONTAINER_CLIPBOARD_MODE": "osc52",
    "CERTPATH": "/home/vscode/development/keys",
    "NVM_VERSION": "0.40.3",
    "NODE_VERSION": "lts/*",
    "CCR_PORT": "{{ .ccr_port }}",
    {{- if hasKey . "homelab" }}
    {{- if .homelab.windows_user }}
    "SSH_AUTH_SOCK": "/tmp/wsl-ssh-pageant/ssh-agent.sock",
    {{- end }}
    {{- end }}
    "ANSIBLE_SSH_COMMON_ARGS": "-o IdentitiesOnly=yes -o IdentityFile=/home/vscode/.ssh/root_terraform_ansible.pub"
  },

  "mounts": [
    // String syntax used here as the object syntax does not support readonly mounting.
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/container-dotfiles/dotfiles,target=/home/vscode/.host-dotfiles,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/dotfiles/dot_markdownlint-cli2.jsonc,target=/home/vscode/.markdownlint-cli2.jsonc,type=bind,readonly",
    // --- Mount for Claude Code configs and package lists ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/dot_claude/AGENTS.md,target=/tmp/claude-agents.md,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/dotfiles/dot_claude/commands/todo.md,target=/tmp/claude-todo-command.md,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/dotfiles/dot_claude/executable_commit-docs.sh,target=/tmp/claude-commit-docs.sh,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/dotfiles/dot_claude/private_settings.json,target=/tmp/claude-private-settings.json,type=bind,readonly",
    // --- Mount for Claude Code Router configs ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/dotfiles/configs/config.json,target=/tmp/claude-router-config.json,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/dotfiles/dot_claude-code-router/plugins,target=/tmp/claude-router-plugins,type=bind,readonly",
    // --- Mount for Container Env Variables ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/dotfiles/configs/container_env,target=/tmp/container_env,type=bind,readonly",
    // --- Mount for OpenCode config ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_dot_config/opencode/opencode.jsonc,target=/tmp/opencode.jsonc,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/dotfiles/configs/opencode.env,target=/tmp/opencode.env,type=bind,readonly",
    // --- Mount for package lists ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/npm_packages.txt,target=/tmp/container_packages/npm.txt,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs/uv_tools.txt,target=/tmp/container_packages/uv.txt,type=bind,readonly",
    // --- Mount for Container post(*)Command scripts ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postCreate.sh,target=/tmp/homelab-postCreate.sh,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer/postStart.sh,target=/tmp/homelab-postStart.sh,type=bind,readonly",
    // --- Mount for Internal SSL Certs ---
    {{- if hasKey . "homelab" }}
    {{- if .homelab.windows_user }}
    "source=/mnt/c/Users/{{ .homelab.windows_user }}/.wsl-ssh-pageant,target=/tmp/wsl-ssh-pageant,type=bind",
    {{- end }}
    {{- end }}
    {
      "source": "{{ .CERTPATH }}",
      "target": "/home/vscode/development/keys",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/Documents/development/vscode-workspace/container-homelab-IaC.code-workspace",
      "target": "${containerWorkspaceFolder}/container-homelab-IaC.code-workspace",
      "type": "bind"
    },
    // --- Mount for persistent data (using a named volume) ---
    {
      "source": "homelab-iac-data-volume",
      "target": "/home/vscode/persistent-data",
      "type": "volume"
    }
  ],

  "postCreateCommand": ["bash", "/tmp/homelab-postCreate.sh"],

  "postStartCommand": ["bash", "/tmp/homelab-postStart.sh"],

  "customizations": {
    "vscode": {
      "workspaceFile": "${containerWorkspaceFolder}/container-homelab-IaC.code-workspace",
      "settings": {
        "homelab.isHomelabWorkspace": true,  // Special parameter added to enable per workspace keybinding
        "terminal.integrated.profiles.linux": {
          "Container zsh": {
            "path": "/bin/zsh",
            "icon": "symbol-method",
            "color": "terminal.ansiBlue",
            "overrideName": true
          }
        },
        "terminal.integrated.defaultProfile.linux": "Container zsh",
        "markdownlint.configFile": "/home/vscode/.markdownlint-cli2.jsonc"
      },
      "extensions": [
        // --- Coding Agents ---
        "sst-dev.opencode",

        // --- High-Quality General Purpose ---
        "mikestead.dotenv",
        "gruntfuggly.todo-tree",
        "ionutvmi.path-autocomplete",
        "shardulm94.trailing-spaces",
        "davidanson.vscode-markdownlint",

        // --- Minor extensions for formatting ---
        "annsk.alignment",
        "lmcarreiro.vscode-smart-column-indenter",
        "redlin.remove-tabs-on-save",
        "rubymaniac.vscode-paste-and-indent"
      ]
    }
  },
  "remoteUser": "vscode"
}
