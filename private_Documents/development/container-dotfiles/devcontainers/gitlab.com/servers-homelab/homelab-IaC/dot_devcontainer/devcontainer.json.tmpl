{
  "name": "Homelab IaC - Container (Personalized)",
  "image": "homelab-iac:base",

  "containerEnv": {
    "DEVCONTAINER": "1", // Additional environment variable for use with chezmoi
    "FZF_VERSION": "0.66.0",
    "ZOXIDE_VERSION": "0.9.8",
    "LAZYGIT_VERSION": "latest",
    "DEVCONTAINER_CLIPBOARD_MODE": "osc52",
    "CERTPATH": "/home/vscode/development/keys",
    "NVM_VERSION": "0.40.3",
    "NODE_VERSION": "lts/*",
    "PLANNOTATOR_REMOTE": "1",
    "PLANNOTATOR_PORT": "9999",
    "CCR_PORT": "{{ .ccr_port }}",
    {{- if hasKey . "homelab" }}
    {{- if .homelab.windows_user }}
    "SSH_AUTH_SOCK": "/tmp/wsl-ssh-pageant/ssh-agent.sock",
    {{- end }}
    {{- end }}
    "ANSIBLE_SSH_COMMON_ARGS": "-o IdentitiesOnly=yes -o IdentityFile=/home/vscode/.ssh/root_terraform_ansible.pub"
  },

  "mounts": [
    // String syntax used here as the object syntax does not support readonly mounting.
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/container-dotfiles/dotfiles,target=/home/vscode/.host-dotfiles,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/dotfiles,target=/tmp/host-dotfiles,type=bind,readonly",
    // --- Mount for Claude Code configs and package lists ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/dot_claude,target=/tmp/host-claude,type=bind,readonly",
    // --- Mount for Claude Code Router configs ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/dot_claude-code-router,target=/tmp/host-claude-code-router,type=bind,readonly",
    // --- Mount for Container generated configs ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/dotfiles/configs,target=/tmp/host-container-configs,type=bind,readonly",
    // --- Mount for OpenCode config ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_dot_config/opencode,target=/tmp/host-opencode-config,type=bind,readonly",
    // --- Mount for package lists ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs,target=/tmp/host-homelab-configs,type=bind,readonly",
    // --- Mount for Container post(*)Command scripts ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer,target=/tmp/host-homelab-devcontainer,type=bind,readonly",
    // --- Mount for workspace files ---
    "source=${localEnv:HOME}/Documents/development/vscode-workspace,target=/tmp/host-vscode-workspace,type=bind,readonly",
    // --- Mount for Internal SSL Certs ---
    {{- if hasKey . "homelab" }}
    {{- if .homelab.windows_user }}
    "source=/tmp/wsl2-ssh-agent,target=/tmp/wsl-ssh-pageant,type=bind",
    {{- end }}
    {{- end }}
    {
      "source": "{{ .CERTPATH }}",
      "target": "/home/vscode/development/keys",
      "type": "bind"
    },
    // --- Mount for persistent data (using a named volume) ---
    {
      "source": "homelab-iac-data-volume",
      "target": "/home/vscode/persistent-data",
      "type": "volume"
    }
  ],

  {{- if hasKey . "homelab" }}
  {{- if .homelab.windows_user }}
  "initializeCommand": ["bash", "-lc", "mkdir -p /tmp/wsl2-ssh-agent; zsh -lic 'sset >/dev/null 2>&1 || true' >/dev/null 2>&1 || true"],
  {{- end }}
  {{- end }}

  "postCreateCommand": ["bash", "/tmp/host-homelab-devcontainer/postCreate.sh"],

  "postStartCommand": ["bash", "/tmp/host-homelab-devcontainer/postStart.sh"],

  "forwardPorts": [9999],

  "customizations": {
    "vscode": {
      "workspaceFile": "/tmp/host-vscode-workspace/container-homelab-IaC.code-workspace",
      "settings": {
        "homelab.isHomelabWorkspace": true,  // Special parameter added to enable per workspace keybinding
        "terminal.integrated.profiles.linux": {
          "Container zsh": {
            "path": "/bin/zsh",
            "icon": "symbol-method",
            "color": "terminal.ansiBlue",
            "overrideName": true
          }
        },
        "terminal.integrated.defaultProfile.linux": "Container zsh",
        "markdownlint.configFile": "/tmp/host-dotfiles/dot_markdownlint-cli2.jsonc"
      },
      "extensions": [
        // --- Coding Agents ---
        "sst-dev.opencode",

        // --- High-Quality General Purpose ---
        "mikestead.dotenv",
        "gruntfuggly.todo-tree",
        "ionutvmi.path-autocomplete",
        "shardulm94.trailing-spaces",
        "davidanson.vscode-markdownlint",

        // --- Minor extensions for formatting ---
        "annsk.alignment",
        "lmcarreiro.vscode-smart-column-indenter",
        "redlin.remove-tabs-on-save",
        "rubymaniac.vscode-paste-and-indent"
      ]
    }
  },
  "remoteUser": "vscode"
}
