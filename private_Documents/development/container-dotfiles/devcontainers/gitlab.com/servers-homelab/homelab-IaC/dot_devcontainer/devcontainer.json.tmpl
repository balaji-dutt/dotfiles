{
  "name": "Homelab IaC - Container (Personalized)",
  "image": "homelab-iac:base",

  "runArgs": [
    "--label=image_retention=retain"
  ],

  "containerEnv": {
    "DEVCONTAINER": "1", // Additional environment variable for use with chezmoi
    "FZF_VERSION": "0.74.1", // renovate: datasource=github-releases depName=junegunn/fzf extractVersion=^v(?<version>.*)$
    "GH_VERSION": "2.93.0", // renovate: datasource=github-releases depName=cli/cli extractVersion=^v(?<version>.*)$
    "GLAB_VERSION": "1.107.0", // renovate: datasource=gitlab-releases depName=gitlab-org/cli extractVersion=^v(?<version>.*)$
    "ZOXIDE_VERSION": "0.9.9", // renovate: datasource=github-releases depName=ajeetdsouza/zoxide extractVersion=^v(?<version>.*)$
    "LAZYGIT_VERSION": "latest",
    "AOE_VERSION": "1.12.1", // renovate: datasource=github-releases depName=agent-of-empires/agent-of-empires extractVersion=^v(?<version>.*)$
    "DOLT_VERSION": "2.2.1", // renovate: datasource=github-releases depName=dolthub/dolt extractVersion=^v(?<version>.*)$
    "CLAUDE_CODE_VERSION": "2.1.219", // renovate: datasource=npm depName=@anthropic-ai/claude-code
    "MNEMO_VERSION": "1.3.8", // renovate: datasource=github-releases depName=Pilan-AI/mnemo extractVersion=^v(?<version>.*)$
    "SNIP_VERSION": "0.18.0", // renovate: datasource=github-releases depName=edouard-claude/snip extractVersion=^v(?<version>.*)$
    "HOP_VERSION": "1.9.1", // renovate: datasource=github-releases depName=danmartuszewski/hop extractVersion=^v(?<version>.*)$
    "TF_MCP_VERSION": "0.5.2", // renovate: datasource=github-releases depName=hashicorp/terraform-mcp-server extractVersion=^v(?<version>.*)$
    "DEVCONTAINER_CLIPBOARD_MODE": "osc52",
    "CERTPATH": "/home/vscode/development/keys",
    "CERTFILES_RAW": {{ .CERTFILES_RAW | toJson }},
    "NVM_VERSION": "0.40.6", // renovate: datasource=github-tags depName=nvm-sh/nvm extractVersion=^v(?<version>.*)$
    "NODE_VERSION": "lts/*",
    "TF_DATA_ROOT": "/home/vscode/persistent-data/terraform-data",
    "PLANNOTATOR_VERSION": "{{ .plannotator_version }}", // source of truth: .chezmoidata.yaml (renovate-tracked there)
    "PLANNOTATOR_REMOTE": "1",
    "PLANNOTATOR_PORT": "9999",
    "PLANNOTATOR_PORTS_BUILD": "{{ .plannotator_ports.devcontainer.build | join "," }}",
    "PLANNOTATOR_PORTS_CLAUDE": "{{ .plannotator_ports.devcontainer.claude | join "," }}",
    "PLANNOTATOR_PORTS_CUSTOM": "{{ .plannotator_ports.devcontainer.custom | join "," }}",
    "OPENSPEC_TELEMETRY": "0",
    {{- if eq .chezmoi.os "darwin" }}
    "SSH_AUTH_SOCK": "/tmp/orbstack-ssh-agent/ssh-auth.sock",
    "ORBSTACK_HOST_SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock",
    {{- else if hasKey . "homelab" }}
    {{- if .homelab.windows_user }}
    "SSH_AUTH_SOCK": "/tmp/wsl-ssh-pageant/ssh-agent.sock",
    "WSL_NPIPERELAY_PATH": "/mnt/c/Users/{{ .homelab.windows_user }}/{{ .homelab.npiperelay_path }}",
    "ANSIBLE_FORKS": "1",
    {{- end }}
    {{- end }}
    "ANSIBLE_SSH_COMMON_ARGS": "-o IdentitiesOnly=yes -o IdentityFile=/home/vscode/.ssh/root_terraform_ansible.pub"
  },

  "mounts": [
    // String syntax used here as the object syntax does not support readonly mounting.
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,readonly",
    {{- if stat (joinPath .chezmoi.homeDir ".config" "unslop") }}
    // --- Optional: mount Unslop numeric voice profile ---
    "source=${localEnv:HOME}/.config/unslop,target=/home/vscode/.config/unslop,type=bind,readonly",
    {{- end }}
    "source=${localEnv:HOME}/Documents/development/container-dotfiles/dotfiles,target=/home/vscode/.host-dotfiles,type=bind,readonly",
    "source=${localEnv:HOME}/Documents/development/dotfiles,target=/tmp/host-dotfiles,type=bind,readonly",
    // --- Mount for Claude Code configs and package lists ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/dot_claude,target=/tmp/host-claude,type=bind,readonly",
    // --- Mount for Container generated configs ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/dotfiles/configs,target=/tmp/host-container-configs,type=bind,readonly",
    // --- Mount for package lists ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/configs,target=/tmp/host-homelab-configs,type=bind,readonly",
    // --- Mount for Container post(*)Command scripts ---
    "source=${localEnv:HOME}/Documents/development/dotfiles/private_Documents/development/container-dotfiles/devcontainers/gitlab.com/servers-homelab/homelab-IaC/dot_devcontainer,target=/tmp/host-homelab-devcontainer,type=bind,readonly",
    // --- Mount for workspace file ---
    "source=${localEnv:HOME}/Documents/development/vscode-workspace/container-homelab-IaC.code-workspace,target=${containerWorkspaceFolder}/container-homelab-IaC.code-workspace,type=bind,readonly",
    {{- if eq .chezmoi.os "darwin" }}
    // --- macOS-only: mount OrbStack's native SSH agent socket for relay access ---
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind",
    // --- macOS-only: keep Git metadata on local Docker volume ---
    // "source=homelab-iac-gitmeta-macos,target=${containerWorkspaceFolder}/.git,type=volume",
    // --- macOS-only: expose shared workspace Git metadata for one-time seed ---
    // "source=${localWorkspaceFolder}/.git,target=/tmp/host-workspace-git,type=bind,readonly",
    {{- else if hasKey . "homelab" }}
    {{- if .homelab.windows_user }}
    "source=/tmp/wsl2-ssh-agent,target=/tmp/wsl-ssh-pageant,type=bind",
    {{- end }}
    {{- end }}
    // --- Mount for Internal SSL Certs ---
    {
      "source": "{{ .CERTPATH }}",
      "target": "/home/vscode/development/keys",
      "type": "bind"
    },
    // --- Mount for persistent data (using a named volume) ---
    {
      "source": "homelab-iac-data-volume",
      "target": "/home/vscode/persistent-data",
      "type": "volume"
    }
  ],

  {{- if hasKey . "homelab" }}
  {{- if .homelab.windows_user }}
  "initializeCommand": ["bash", "-lc", "umask 077; mkdir -p /tmp/wsl2-ssh-agent; chmod 700 /tmp/wsl2-ssh-agent >/dev/null 2>&1 || true; SOCK=/tmp/wsl2-ssh-agent/ssh-agent.sock; NPIPERELAY=\"/mnt/c/Users/{{ .homelab.windows_user }}/{{ .homelab.npiperelay_path }}\"; if command -v socat >/dev/null 2>&1 && [ -x \"$NPIPERELAY\" ]; then pkill -f 'socat.*npiperelay\\.exe.*ssh-pageant' >/dev/null 2>&1 || true; rm -f \"$SOCK\" >/dev/null 2>&1 || true; if command -v setsid >/dev/null 2>&1; then setsid -f socat EXEC:\"\\\"$NPIPERELAY\\\" -ei -s //./pipe/ssh-pageant\" UNIX-LISTEN:\"$SOCK\",unlink-close,fork,mode=600 </dev/null >/dev/null 2>&1; else nohup socat EXEC:\"\\\"$NPIPERELAY\\\" -ei -s //./pipe/ssh-pageant\" UNIX-LISTEN:\"$SOCK\",unlink-close,fork,mode=600 </dev/null >/dev/null 2>&1 & fi; for ((i=0; i<50; i++)); do SSH_AUTH_SOCK=\"$SOCK\" ssh-add -l >/dev/null 2>&1; rc=$?; if [ \"$rc\" -eq 0 ] || [ \"$rc\" -eq 1 ]; then break; fi; sleep 0.1; done; fi"],
  {{- end }}
  {{- end }}

  "postCreateCommand": ["bash", "/tmp/host-homelab-devcontainer/postCreate.sh", "${containerWorkspaceFolder}"],

  "postStartCommand": ["bash", "/tmp/host-homelab-devcontainer/postStart.sh", "${containerWorkspaceFolder}"],

  "customizations": {
    "vscode": {
      "workspaceFile": "${containerWorkspaceFolder}/container-homelab-IaC.code-workspace",
      "settings": {
        "homelab.isHomelabWorkspace": true,  // Special parameter added to enable per workspace keybinding
        "terminal.integrated.profiles.linux": {
          "Container zsh": {
            "path": "/bin/zsh",
            "icon": "symbol-method",
            "color": "terminal.ansiBlue",
            "overrideName": true
          }
        },
        "terminal.integrated.defaultProfile.linux": "Container zsh",
        "markdownlint.configFile": "/home/vscode/.markdownlint-cli2.jsonc"
      },
      "extensions": [
        // --- Coding Agents ---
        "sst-dev.opencode",
        // Beads Kanban BD Fixes is installed from the pinned VSIX in postCreate/postStart.

        // --- High-Quality General Purpose ---
        "mikestead.dotenv",
        "FanaticPythoner.better-todo-tree",
        "ionutvmi.path-autocomplete",
        "shardulm94.trailing-spaces",
        "davidanson.vscode-markdownlint",

        // --- Minor extensions for formatting ---
        "bierner.markdown-mermaid",
        "annsk.alignment",
        "lmcarreiro.vscode-smart-column-indenter",
        "redlin.remove-tabs-on-save",
        "rubymaniac.vscode-paste-and-indent"
      ]
    }
  },
  "remoteUser": "vscode"
}
