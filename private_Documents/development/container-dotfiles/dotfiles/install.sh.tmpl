# Helper: semantic version greater-or-equal check using sort -V.
version_ge() {
  local a b
  a="$1"
  b="$2"
  [ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | sed -n '1p')" = "$b" ]
}

# aoe: install latest/pinned Linux release archive by default.
# Set AOE_INSTALL_MODE=source only when debugging release-binary issues.
# Set AOE_VERSION as a container variable to a tag like "1.4.6" or "latest".
aoe_cli_version() {
  aoe --version 2>/dev/null | sed -n 's/[^0-9]*\([0-9][0-9.]*\).*/\1/p'
}

check_aoe_release_glibc() {
  local min_glibc="2.28"
  local sys_glibc

  # Upstream AoE Linux releases are built in manylinux_2_28 containers.
  # Fail fast only when the runtime glibc can be detected.
  [ "$(uname -s)" = "Linux" ] || return 0
  need_cmd ldd || return 0

  sys_glibc="$(ldd --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+$' | head -1 || true)"
  [ -n "$sys_glibc" ] || return 0

  if ! version_ge "$sys_glibc" "$min_glibc"; then
    echo "!! aoe release binary requires glibc ${min_glibc}+; found ${sys_glibc}."
    echo "!! Set AOE_INSTALL_MODE=source to build aoe from source on this image."
    return 1
  fi
}

install_aoe_from_release() {
  local want_version="${AOE_VERSION:-latest}"
  local arch norm_arch asset url tmpd expected actual curr installed binpath

  if [ "$(uname -s)" != "Linux" ]; then
    echo "!! Unsupported OS for aoe Linux release archive: $(uname -s)"
    return 1
  fi

  arch="$(uname -m)"
  case "$arch" in
    x86_64|amd64) norm_arch="amd64" ;;
    aarch64|arm64) norm_arch="arm64" ;;
    *) echo "!! Unsupported arch for aoe binary: $arch"; return 1 ;;
  esac

  # Resolve "latest" using GitHub API (requires jq)
  if [ "$want_version" = "latest" ]; then
    if ! need_cmd jq; then
      echo "!! jq not available; cannot resolve latest aoe. Install jq or set AOE_VERSION."
      return 1
    fi
    echo "==> Resolving latest aoe version from GitHub..."
    local tag
    tag="$(curl -fsSL https://api.github.com/repos/agent-of-empires/agent-of-empires/releases/latest | jq -r '.tag_name' | sed 's/^v//')"
    [ -n "$tag" ] && [ "$tag" != "null" ] || { echo "!! Unable to resolve latest aoe version."; return 1; }
    want_version="$tag"
  else
    want_version="${want_version#v}"
  fi

  # If already installed and version matches, skip.
  if need_cmd aoe; then
    curr="$(aoe_cli_version)"
    if [ -n "$curr" ] && [ "$curr" = "$want_version" ]; then
      echo "==> aoe $curr already installed; skipping."
      return 0
    elif [ -n "$curr" ]; then
      echo "==> aoe $curr found; upgrading to $want_version"
    else
      echo "==> aoe found; upgrading to $want_version"
    fi
  fi

  need_cmd curl || { echo "!! curl is required for aoe release install."; return 1; }
  need_cmd tar  || { echo "!! tar is required for aoe release install."; return 1; }
  need_cmd sha256sum || { echo "!! sha256sum is required for aoe checksum verification."; return 1; }
  check_aoe_release_glibc || return 1

  tmpd="$(mktemp -d)"
  asset="aoe-linux-${norm_arch}"
  url="https://github.com/agent-of-empires/agent-of-empires/releases/download/v${want_version}/${asset}.tar.gz"

  echo "==> Installing aoe ${want_version} (${asset})"
  if ! curl -fsSL "${url}.sha256" -o "${tmpd}/${asset}.tar.gz.sha256"; then
    rm -rf "$tmpd"
    echo "!! Failed to download aoe checksum for v${want_version}."
    return 1
  fi
  if ! curl -fsSL "$url" -o "${tmpd}/${asset}.tar.gz"; then
    rm -rf "$tmpd"
    echo "!! Failed to download aoe release archive for v${want_version}."
    return 1
  fi

  expected="$(awk '{print $1}' "${tmpd}/${asset}.tar.gz.sha256")"
  actual="$(sha256sum "${tmpd}/${asset}.tar.gz" | awk '{print $1}')"
  if [ "$expected" != "$actual" ]; then
    echo "!! aoe checksum mismatch for ${asset}.tar.gz"
    echo "!! expected: $expected"
    echo "!! actual:   $actual"
    rm -rf "$tmpd"
    return 1
  fi

  if ! tar -xzf "${tmpd}/${asset}.tar.gz" -C "$tmpd"; then
    rm -rf "$tmpd"
    echo "!! Failed to extract aoe release archive."
    return 1
  fi
  binpath="${tmpd}/${asset}"
  if [ ! -f "$binpath" ]; then
    echo "!! aoe binary not found in archive: $asset"
    rm -rf "$tmpd"
    return 1
  fi

  as_root "install -m 0755 '$binpath' /usr/local/bin/aoe"
  rm -rf "$tmpd"

  if ! need_cmd aoe; then
    echo "!! aoe not found after install."
    return 1
  fi
  installed="$(aoe_cli_version)"
  if [ -z "$installed" ] || [ "$installed" != "$want_version" ]; then
    echo "!! aoe version mismatch after install (wanted: ${want_version}, got: ${installed:-unknown})."
    return 1
  fi
  echo "==> aoe installed: ${installed}"
}

install_aoe_from_source() {
  local want_version="${AOE_VERSION:-latest}"
  local min_rust="1.85.0"
  local rust_ver curr installed tmpd srcdir
  local build_cargo_home build_rustup_home build_npm_cache rustup_init

  # Resolve "latest" using GitHub API (requires jq)
  if [ "$want_version" = "latest" ]; then
    if ! need_cmd jq; then
      echo "!! jq not available; cannot resolve latest aoe. Install jq or set AOE_VERSION."
      return 1
    fi
    echo "==> Resolving latest aoe version from GitHub..."
    local tag
    tag="$(curl -fsSL https://api.github.com/repos/agent-of-empires/agent-of-empires/releases/latest | jq -r '.tag_name' | sed 's/^v//')"
    [ -n "$tag" ] && [ "$tag" != "null" ] || { echo "!! Unable to resolve latest aoe version."; return 1; }
    want_version="$tag"
  else
    want_version="${want_version#v}"
  fi

  # If already installed and version matches, skip.
  if need_cmd aoe; then
    curr="$(aoe_cli_version)"
    if [ -n "$curr" ] && [ "$curr" = "$want_version" ]; then
      echo "==> aoe $curr already installed; skipping."
      return 0
    elif [ -n "$curr" ]; then
      echo "==> aoe $curr found; upgrading to $want_version"
    else
      echo "==> aoe found; upgrading to $want_version"
    fi
  fi

  need_cmd npm  || { echo "!! npm is required for aoe web build."; return 1; }
  need_cmd curl || { echo "!! curl is required for aoe source install."; return 1; }
  need_cmd tar  || { echo "!! tar is required for aoe source install."; return 1; }

  tmpd="$(mktemp -d)"
  srcdir="${tmpd}/agent-of-empires-${want_version}"
  build_cargo_home="${tmpd}/cargo-home"
  build_rustup_home="${tmpd}/rustup-home"
  build_npm_cache="${tmpd}/npm-cache"
  rustup_init="${tmpd}/rustup-init"
  mkdir -p "$build_cargo_home" "$build_rustup_home" "$build_npm_cache"

  echo "==> Building aoe ${want_version} from source"
  if ! curl -fsSL "https://github.com/agent-of-empires/agent-of-empires/archive/refs/tags/v${want_version}.tar.gz" -o "${tmpd}/aoe-src.tgz"; then
    rm -rf "$tmpd"
    echo "!! Failed to download aoe source tarball for v${want_version}."
    return 1
  fi

  if ! tar -xzf "${tmpd}/aoe-src.tgz" -C "$tmpd"; then
    rm -rf "$tmpd"
    echo "!! Failed to extract aoe source tarball."
    return 1
  fi

  if [ ! -d "$srcdir" ]; then
    rm -rf "$tmpd"
    echo "!! aoe source directory not found after extract: $srcdir"
    return 1
  fi

  if ! (
    set -e
    export CARGO_HOME="$build_cargo_home"
    export RUSTUP_HOME="$build_rustup_home"
    export npm_config_cache="$build_npm_cache"
    export PATH="$CARGO_HOME/bin:$PATH"

    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o "$rustup_init"
    sh "$rustup_init" -y --profile minimal --default-toolchain stable --no-modify-path

    rust_ver="$(rustc --version 2>/dev/null | sed -n 's/^rustc \([0-9][0-9.]*\).*/\1/p')"
    if [ -z "$rust_ver" ] || ! version_ge "$rust_ver" "$min_rust"; then
      echo "!! Rust toolchain too old for aoe build (found: ${rust_ver:-unknown}, need: ${min_rust}+)."
      exit 1
    fi

    cd "$srcdir/web"
    npm install
    npm run build
    cd "$srcdir"
    cargo build --release --features serve
  ); then
    rm -rf "$tmpd"
    echo "!! aoe source build failed."
    return 1
  fi

  if [ ! -f "$srcdir/target/release/aoe" ]; then
    rm -rf "$tmpd"
    echo "!! aoe binary missing after source build."
    return 1
  fi

  as_root "install -m 0755 '$srcdir/target/release/aoe' /usr/local/bin/aoe"
  rm -rf "$tmpd"

  # Verify
  if ! need_cmd aoe; then
    echo "!! aoe not found after install."
    return 1
  fi
  local installed
  installed="$(aoe_cli_version)"
  if [ -z "$installed" ] || [ "$installed" != "$want_version" ]; then
    echo "!! aoe version mismatch after install (wanted: ${want_version}, got: ${installed:-unknown})."
    return 1
  fi
  echo "==> aoe installed: ${installed}"
}

install_aoe() {
  local install_mode="${AOE_INSTALL_MODE:-release}"

  case "$install_mode" in
    release)
      install_aoe_from_release
      ;;
    source)
      install_aoe_from_source
      ;;
    *)
      echo "!! Unsupported AOE_INSTALL_MODE: $install_mode"
      echo "!! Supported values: release, source"
      return 1
      ;;
  esac
}
install_aoe || echo "!! aoe install failed; continuing"

# git-mkver: install latest release from GitHub
# - amd64: native Linux binary
# - arm64: universal zip (JVM launcher + jars), requires java runtime
install_git_mkver_gh() {
  echo "==> Resolving latest git-mkver version from GitHub..."
  if ! need_cmd jq; then
    echo "!! jq not available; cannot resolve latest git-mkver. Install jq."
    return 1
  fi

  local tag
  tag="$(curl -fsSL https://api.github.com/repos/idc101/git-mkver/releases/latest | jq -r '.tag_name' | sed 's/^v//')"
  [ -n "$tag" ] && [ "$tag" != "null" ] || { echo "!! Unable to resolve latest git-mkver version."; return 1; }

  # If already installed and executable, skip
  if need_cmd git-mkver && git-mkver -help >/dev/null 2>&1; then
    echo "==> git-mkver already installed and runnable; skipping."
    if ! need_cmd mkver; then
      as_root "ln -sfn /usr/local/bin/git-mkver /usr/local/bin/mkver"
    fi
    return 0
  fi

  local arch tmpd asset url
  arch="$(uname -m)"
  tmpd="$(mktemp -d)"

  case "$arch" in
    x86_64|amd64)
      asset="git-mkver-linux-x86_64-${tag}.tar.gz"
      url="https://github.com/idc101/git-mkver/releases/download/v${tag}/${asset}"
      echo "==> Installing git-mkver ${tag} (linux-x86_64 native)"
      curl -fsSL "$url" -o "${tmpd}/mkver.tgz"
      as_root "tar -xzf '${tmpd}/mkver.tgz' -C /usr/local/bin git-mkver"
      as_root "chmod 0755 /usr/local/bin/git-mkver"
      ;;
    aarch64|arm64)
      asset="git-mkver-${tag}.zip"
      url="https://github.com/idc101/git-mkver/releases/download/v${tag}/${asset}"
      echo "==> Installing git-mkver ${tag} (universal zip for ${arch})"

      if need_cmd apt-get; then
        pkgs=()
        need_cmd java  || pkgs+=("default-jre-headless")
        need_cmd unzip || pkgs+=("unzip")
        if [ "${#pkgs[@]}" -gt 0 ]; then
          echo "==> Installing dependencies for git-mkver: ${pkgs[*]}"
          apt_install "${pkgs[@]}"
        fi
      fi

      need_cmd java  || { echo "!! java not found; install a headless JRE and retry."; rm -rf "$tmpd"; return 1; }
      need_cmd unzip || { echo "!! unzip not found; install unzip and retry."; rm -rf "$tmpd"; return 1; }

      curl -fsSL "$url" -o "${tmpd}/mkver.zip"
      unzip -q "${tmpd}/mkver.zip" -d "${tmpd}"

      local extracted_dir
      extracted_dir="${tmpd}/git-mkver-${tag}"
      [ -x "${extracted_dir}/bin/git-mkver" ] || { echo "!! git-mkver launcher not found in archive."; rm -rf "$tmpd"; return 1; }

      as_root "rm -rf /usr/local/lib/git-mkver && mkdir -p /usr/local/lib && cp -R '${extracted_dir}' /usr/local/lib/git-mkver"
      as_root "ln -sfn /usr/local/lib/git-mkver/bin/git-mkver /usr/local/bin/git-mkver"
      as_root "chmod 0755 /usr/local/bin/git-mkver /usr/local/lib/git-mkver/bin/git-mkver"
      ;;
    *)
      echo "!! Unsupported arch for git-mkver: ${arch}"
      rm -rf "$tmpd"
      return 1
      ;;
  esac

  # Provide direct mkver command in addition to git subcommand form
  as_root "ln -sfn /usr/local/bin/git-mkver /usr/local/bin/mkver"
  rm -rf "$tmpd"

  # Verify
  if ! need_cmd git-mkver || ! git-mkver -help >/dev/null 2>&1; then
    echo "!! git-mkver not runnable after install."
    return 1
  fi
  if ! need_cmd mkver; then
    echo "!! mkver symlink not found after install."
    return 1
  fi
  echo "==> git-mkver installed"
}
install_git_mkver_gh || echo "!! git-mkver install failed; continuing"

# Make zsh default shell (best-effort; VS Code settings can also set terminal default)
if need_cmd zsh; then
  current_shell="$(getent passwd "$(id -un)" | cut -d: -f7 || echo "")"
  zsh_path="$(command -v zsh)"
  if [ -n "$zsh_path" ] && [ "$current_shell" != "$zsh_path" ]; then
    echo "==> Setting default shell to zsh for $(id -un)"
    as_root "chsh -s '$zsh_path' '$(id -un)'" || true
  fi
fi

install_and_patch_terraform_py() {
  echo "==> Setting up terraform.py"

  # Define variables for clarity and easy maintenance
  local url="https://raw.githubusercontent.com/nbering/terraform-inventory/master/terraform.py"
  local target_dir="$HOME/.local/bin"
  local target_file="$target_dir/terraform.py"
  local patch_file="/home/vscode/.host-dotfiles/terraform.patch"

  # Ensure the target directory exists
  mkdir -p "$target_dir"

  echo "==> Downloading terraform.py..."
  curl -fsSL -o "$target_file" "$url"

  # Make it executable
  chmod +x "$target_file"

  # Apply the patch if it exists
  if [ -f "$patch_file" ]; then
      echo "==> Applying patch from $patch_file..."
      # Use process substitution to feed the patch to stdin after stripping the git diff header
      patch -i <(sed '1d' "$patch_file") -r - -s -d "$(dirname "$target_file")" "$(basename "$target_file")"
      echo "==> Patch applied successfully."
  else
      echo "!! Warning: Patch file not found at $patch_file. Skipping patch."
  fi
}

configure_devcontainer_clipboard() {
  local mode local_bin helper
  mode="${DEVCONTAINER_CLIPBOARD_MODE:-off}"
  local_bin="$HOME/.local/bin"
  helper="$local_bin/devcontainer-clipboard-osc52"

  mkdir -p "$local_bin"

  remove_clipboard_shim_links() {
    local link_name link_path
    for link_name in xclip xsel wl-copy; do
      link_path="$local_bin/$link_name"
      if [ -L "$link_path" ] && [ "$(readlink "$link_path")" = "$helper" ]; then
        rm -f "$link_path"
      fi
    done
  }

  case "$mode" in
    ""|off)
      remove_clipboard_shim_links
      ;;
    osc52)
      if [ ! -x "$helper" ]; then
        echo "!! DEVCONTAINER_CLIPBOARD_MODE=osc52 but helper is missing: $helper"
        return 0
      fi
      ln -sfn "$helper" "$local_bin/xclip"
      ln -sfn "$helper" "$local_bin/xsel"
      ln -sfn "$helper" "$local_bin/wl-copy"
      echo "==> Enabled devcontainer clipboard shim (osc52)"
      ;;
    *)
      echo "!! Unknown DEVCONTAINER_CLIPBOARD_MODE '$mode'; skipping clipboard shim setup"
      ;;
  esac
}

# Copy dotfiles from the mounted host folder if present
SRC="/home/vscode/.host-dotfiles"
if [ -d "$SRC" ]; then
  echo "==> Syncing dotfiles from $SRC"
  # Use rsync to be more efficient and exclude setup files from being copied to $HOME.
  # Claude and OpenCode config/state are owned by devcontainer lifecycle scripts
  # and persistent-data; do not write through their managed symlinks.
  rsync -a \
  --keep-dirlinks \
  --exclude='.git' \
  --exclude='.claude/' \
  --exclude='.claude.json' \
  --exclude='dot_claude/' \
  --exclude='.config/opencode/' \
  --exclude='install.sh' \
  --exclude='assets/' \
  --exclude='.zcompdump*' \
  --exclude='.DS_Store' \
  --exclude='*.patch' \
  "$SRC/" "$HOME/"
  # Now, run the custom installer for terraform.py which needs the patch file from the source
  install_and_patch_terraform_py || echo "!! terraform.py setup failed; continuing"
fi

configure_devcontainer_clipboard

# Append environment variables needed during devcontainer sessions
if [ "${DEVCONTAINER:-}" = "1" ]; then
  echo "==> Configuring devcontainer environment"
  for f in "$HOME/.bashrc" "$HOME/.zshrc"; do
    [ -f "$f" ] || continue
    sed -i -e '$a\' "$f"
    {
      [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && echo "export OP_SERVICE_ACCOUNT_TOKEN=\"$OP_SERVICE_ACCOUNT_TOKEN\""
    } >> "$f"
  done

  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$repo_root" ]; then
    if [ -n "${WORKSPACE_FOLDER:-}" ] && [ -d "$WORKSPACE_FOLDER/.git" ]; then
      repo_root="$WORKSPACE_FOLDER"
    elif [ -n "${REMOTE_CONTAINERS_WORKSPACE_FOLDER:-}" ] && [ -d "$REMOTE_CONTAINERS_WORKSPACE_FOLDER/.git" ]; then
      repo_root="$REMOTE_CONTAINERS_WORKSPACE_FOLDER"
    elif [ -d /workspaces ]; then
      repo_count=0
      repo_candidate=""
      for workspace in /workspaces/*; do
        [ -d "$workspace/.git" ] || continue
        repo_candidate="$workspace"
        repo_count=$((repo_count + 1))
      done
      if [ "$repo_count" -eq 1 ]; then
        repo_root="$repo_candidate"
      elif [ "$repo_count" -gt 1 ]; then
        echo "!! multiple git repos under /workspaces; skipping .opencode seeding"
      fi
    fi
  fi

  if [ -n "$repo_root" ]; then
    repo_name="$(basename "$repo_root")"
    seed_dir="$SRC/assets/workspace-templates/$repo_name/.opencode"
    workspace_opencode="$repo_root/.opencode"
    legacy_managed_manifest="$workspace_opencode/.template-managed-files"
    git_exclude_file="$repo_root/.git/info/exclude"
    # Keep local sync bookkeeping in git metadata, not in workspace content.
    managed_manifest="$repo_root/.git/info/dotfiles-workspace-opencode-managed"
    local_exclude_begin="# BEGIN DOTFILES WORKSPACE OPENCODE"
    local_exclude_end="# END DOTFILES WORKSPACE OPENCODE"
    previous_managed_manifest="$managed_manifest"
    if [ ! -f "$previous_managed_manifest" ] && [ -f "$legacy_managed_manifest" ]; then
      previous_managed_manifest="$legacy_managed_manifest"
    fi

    if [ -d "$seed_dir" ] || [ -f "$previous_managed_manifest" ]; then
      mkdir -p "$workspace_opencode"

      current_managed="$(mktemp)"
      if [ -d "$seed_dir" ]; then
        (
          cd "$seed_dir"
          find . \( -type f -o -type l \) -print \
            | sed 's#^\./##' \
            | sort
        ) > "$current_managed"

        rsync -a "$seed_dir/." "$workspace_opencode/"
      else
        : > "$current_managed"
      fi

      current_excludes="$(mktemp)"
      while IFS= read -r relpath || [ -n "$relpath" ]; do
        [ -z "$relpath" ] && continue
        printf '.opencode/%s\n' "$relpath"
      done < "$current_managed" > "$current_excludes"

      mkdir -p "$(dirname "$git_exclude_file")"
      touch "$git_exclude_file"

      cleaned_exclude="$(mktemp)"
      awk -v begin="$local_exclude_begin" -v end="$local_exclude_end" '
        $0 == begin { in_block = 1; next }
        $0 == end { in_block = 0; next }
        !in_block { print }
      ' "$git_exclude_file" > "$cleaned_exclude"

      if [ -s "$current_excludes" ]; then
        {
          cat "$cleaned_exclude"
          printf '%s\n' "$local_exclude_begin"
          cat "$current_excludes"
          printf '%s\n' "$local_exclude_end"
        } > "$git_exclude_file"
      else
        cat "$cleaned_exclude" > "$git_exclude_file"
      fi

      rm -f "$cleaned_exclude" "$current_excludes"

      if [ -f "$previous_managed_manifest" ]; then
        while IFS= read -r relpath || [ -n "$relpath" ]; do
          [ -z "$relpath" ] && continue
          if ! grep -Fxq "$relpath" "$current_managed"; then
            if git -C "$repo_root" ls-files --error-unmatch ".opencode/$relpath" >/dev/null 2>&1; then
              echo "!! preserving repo-tracked .opencode/$relpath"
            else
              rm -f "$workspace_opencode/$relpath"
            fi
          fi
        done < "$previous_managed_manifest"
      fi

      if [ -s "$current_managed" ]; then
        install -m 0644 "$current_managed" "$managed_manifest"
      else
        rm -f "$managed_manifest" >/dev/null 2>&1 || true
      fi
      rm -f "$legacy_managed_manifest" >/dev/null 2>&1 || true

      rm -f "$current_managed"
    else
      echo "!! .opencode seed directory not found for $repo_name; skipping"
    fi
  else
    echo "!! repo root not found; skipping .opencode seeding"
  fi
fi

echo "==> Dotfiles install complete."
