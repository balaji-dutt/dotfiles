{
  // Container-dotfiles OpenCode user config for homelab-IaC devcontainers.
  "$schema": "https://opencode.ai/config.json",

  // ----------------------------
  // General defaults
  // ----------------------------
  "autoupdate": false,

  // Pick what you want OpenCode to start as.
  "default_agent": "build",

  // Default model (agents override this).
  // OpenCode selects models as `provider_id/model_id`.
  "model": "openai/gpt-5.5",
  "small_model": "google/gemini-3-flash-preview",

  // ----------------------------
  // Global permissions
  // ----------------------------
  "permission": {
    // Keep edits gated by default; coder subagent will override to allow.
    "edit": "ask",

    // Prevent “oops” reads of env files by default (OpenCode shows this pattern).
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },

    // Safety guards (OpenCode calls these out specifically).
    "doom_loop": "ask",
    "external_directory": "ask",

    // Bash is pattern-matchable and supports wildcards; "last matching rule wins".
    "bash": {
      "*": "ask",

      // ---- git (Claude-style; notably NOT allowing push by default)
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git switch*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "git stash*": "allow",
      "git remote*": "allow",
      "git add*": "allow",
      "git commit*": "deny",
      "oc-commit*": "ask",
      "git rev-parse*": "allow",
      "git merge*": "allow",
      "git worktree*": "allow",
      "git push*": "ask",

      // ---- filesystem + text inspection
      "ls*": "allow",
      "pwd*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "tree*": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "chmod *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",

      // (optional; safer to keep ask)
      "chown *": "ask",
      "rm *": "ask",

      // ---- node toolchain
      "node -v*": "allow",
      "node --version*": "allow",
      "npm install*": "allow",
      "npm run*": "allow",
      "npm test*": "allow",
      "npm list*": "allow",
      "npx*": "allow", // if you want Claude parity; otherwise set this to "ask"
      "bun install*": "allow",
      "bun run*": "allow",

      // ---- misc
      "echo *": "allow",
      "printenv*": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "ps aux*": "allow",
      "pgrep*": "allow",
      "date*": "allow",
      "whoami*": "allow",
      "hostname*": "allow",
      "uname*": "allow",
      "which *": "allow",
      "whereis *": "allow",
      "df -h*": "allow",
      "du -sh*": "allow",
      "uptime*": "allow",
      "curl -s*": "allow",
      "curl --version*": "allow",
      "wget --version*": "allow",

      // ---- keep your existing DENIES after the allows (last-match wins)
      "rm -rf /": "deny",
      "rm -rf / *": "deny",
      "sudo rm -rf /": "deny",
      "sudo rm -rf / *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "fdisk*": "deny",
      "parted*": "deny",
      "passwd*": "deny",
      "sudo passwd*": "deny",
      "sudo useradd*": "deny",
      "sudo userdel*": "deny",
      "sudo chmod 777*": "deny",
      "nmap*": "deny",
      "masscan*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "exec < /dev/tcp/*": "deny",
      "exec > /dev/tcp/*": "deny"
    }
  },

  // ----------------------------
  // Plugins
  // ----------------------------

  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.6",
    "@tarquinen/opencode-dcp@3.1.11",
    "@mohak34/opencode-notifier@0.2.5",
    ["@plannotator/opencode@0.19.21", {
      "workflow": "plan-agent",
      "planningAgents": [
        "plan",
        "plan-GPT-xhigh",
        "special-builder",
        "agent-engineer"
      ]
    }],
    "@gotgenes/opencode-agent-identity@3.1.1",
    "cc-safety-net@0.8.2",
    "envsitter-guard@0.0.4",
    "opencode-claude-bridge@1.10.10",
    "@slkiser/opencode-quota@3.7.1",
    "opencode-snip@1.6.1"
  ],

  // ----------------------------
  // Providers
  // ----------------------------
  "provider": {
    "openai": {
      // OpenAI auth: OAuth via `/connect` / `opencode auth login`.
      // Do not set apiKey here.
      "options": {
        "timeout": 600000,
        // Required by the local websearch_cited compatibility shim:
        // This tells the shim which OpenAI model to use when it runs the tool.
        "websearch_cited": {
          "model": "gpt-5.5"
        }
      }
    },

    // Anthropic: built-in auth/models.dev; API key use is in anthropic-api.
    "anthropic": {
      "options": {
        "timeout": 600000,
        // Anthropic OAuth fallback for the local websearch_cited compatibility shim.
        // OpenAI remains selected first while its provider option above exists.
        "websearch_cited": {
          "model": "claude-haiku-4-6"
        }
      }
    },

    "anthropic-api": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic API",
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
        "timeout": 600000,
        // Anthropic API-key fallback for the local websearch_cited compatibility shim.
        // OpenAI remains selected first while its provider option above exists.
        "websearch_cited": {
          "model": "claude-haiku-4-6"
        }
      },
      "models": {
        "claude-haiku-4-6": {
          "name": "Haiku 4.6"
        },
        "claude-sonnet-4-6": {
          "name": "Sonnet 4.6",
          "variants": {
            "medium": {
              "effort": "medium"
            },
            "high": {
              "effort": "high"
            },
            "xhigh": {
              "effort": "xhigh"
            }
          }
        },
        "claude-opus-4-6": {
          "name": "Opus 4.6",
          "variants": {
            "medium": {
              "effort": "medium"
            },
            "high": {
              "effort": "high"
            },
            "xhigh": {
              "effort": "xhigh"
            }
          }
        },
        "claude-haiku-4-7": {
          "name": "Haiku 4.7"
        },
        "claude-sonnet-4-7": {
          "name": "Sonnet 4.7",
          "variants": {
            "medium": {
              "effort": "medium"
            },
            "high": {
              "effort": "high"
            },
            "xhigh": {
              "effort": "xhigh"
            }
          }
        },
        "claude-opus-4-7": {
          "name": "Opus 4.7",
          "variants": {
            "medium": {
              "effort": "medium"
            },
            "high": {
              "effort": "high"
            },
            "xhigh": {
              "effort": "xhigh",
              "maxOutputTokens": 64000
            }
          }
        }
      }
    },

    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_API_KEY}",
        "timeout": 600000
      }
    },

    // Google: API key from env
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "gemini-3-pro-preview": {},
        "gemini-3-flash-preview": {},
        "gemini-3-pro-image-preview": {}
      }
    },

    // Moonshot/Kimi (OpenAI-compatible)
    "moonshot": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Moonshot",
      "options": {
        "baseURL": "https://api.moonshot.ai/v1",
        "apiKey": "{env:MOONSHOT_API_KEY}",
        "timeout": 600000
      },
      "models": {
        // NOTE: provider-specific reasoning flags are not standardized in OpenCode docs.
        "kimi-k2-thinking": {
          "options": {
            "reasoning": true
          }
        },
        "kimi-k2.5": {
          "options": {
            "reasoning": true
          }
        },
        "kimi-k2.6": {
          "options": {
            "reasoning": true
          }
        }
      }
    },

    // Perplexity (OpenAI-compatible) for search-capable planning
    "perplexity": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Perplexity",
      "options": {
        "baseURL": "https://api.perplexity.ai",
        "apiKey": "{env:PERPLEXITY_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "sonar-reasoning-pro": {}
      }
    },

    // OpenRouter (API key from env)
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "timeout": 600000
      },
      "models": {
        // OpenCode will pass "options" to the provider, but vendor-specific keys may or may not be honored.
        // Validate by testing the model and checking if reasoning behavior changes.
        "deepseek/deepseek-v4-pro:exacto": {
          "name": "DeepSeek V4 Pro (Exacto)",
          "options": {
            "reasoning": {
              "enabled": true
            }
          }
        },
        "deepseek/deepseek-v4-flash:exacto": {
          "name": "DeepSeek V4 Flash (Exacto)",
          "options": {
            "reasoning": {
              "enabled": true
            }
          }
        },
        "z-ai/glm-5.1:exacto": {
          "name": "GLM 5.1 (Exacto)",
          "options": {
            "reasoning": {
              "effort": "high",
              "enabled": true
            }
          }
        },
        "moonshotai/kimi-k2.5": {
          "name": "Kimi K2.5",
          "options": {
            "reasoning": {
              "enabled": true
            }
          }
        },
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6",
          "options": {
            "reasoning": {
              "enabled": true
            }
          }
        },
      }
    }
  },

  // ----------------------------
  // Agents
  // ----------------------------
  "agent": {
    // Overwrite built-in Plan agent: search-capable planning manager.
    // Permissions support websearch/webfetch tools too, but your plan model itself is search-capable.
    "plan": {
      "mode": "primary",
      "description": "Planning manager (Latest GPT model/high reasoning + websearch). Read/grep/list OK; no edits.",
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high",
      "temperature": 0.4,
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "websearch_cited": "allow",
        "codesearch": "allow",
        "task": {
          "*": "deny"
        }
      }
    },

    "plan-GPT-xhigh": {
      "mode": "primary",
      "description": "Planning manager (Latest GPT model/xhigh reasoning + websearch). Read/grep/list OK; no edits.",
      "model": "openai/gpt-5.5",
      "reasoningEffort": "xhigh",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "websearch_cited": "allow",
        "codesearch": "allow",
        "task": {
          "*": "deny"
        }
      }
    },

    // Keep Build as a “manual interactive” agent.
    "build": {
      "mode": "primary",
      "description": "Default editing agent",
      // TEMPORARY: openai/gpt-5.3-codex hangs silently on tool calls in OpenCode >= 1.14.29.
      // Commented out until anomalyco/opencode#24899 is fixed. Restore after upgrading past the fix.
      // "model": "openai/gpt-5.3-codex",
      "reasoningEffort": "high",
      "temperature": 0.2,
      "permission": {
        "edit": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        }
      }
    },

    "special-builder": {
      "mode": "primary",
      "description": "Agent for meta-level and infrastructural work ",
      "model": "openai/gpt-5.5",
      "reasoningEffort": "xhigh",
      "temperature": 0.2,
      // Anthropic does not support temperature modification with thinking budgets
      // "temperature": 0.1,
      // Anthropic extended thinking (high-ish)
      // "model": "github-copilot/claude-sonnet-4.6",
      // "thinking": {
      //   "type": "enabled",
      //   "budgetTokens": 20000
      // },
      "prompt": "{file:./prompts/generated/special-builder.md}",
      "permission": {
        "webfetch": "allow",
        "websearch_cited": "allow",
        "codesearch": "allow",
        "edit": {
          "*": "ask",
          "*.env": "deny",
          "*.env.*": "deny"
        }
      }
    },

    "agent-engineer": {
      "mode": "primary",
      "description": "meta-agent that designs, builds, evaluates, and packages AI agent systems",
      "model": "openai/gpt-5.5",
      "reasoningEffort": "xhigh",
      "temperature": 0.2,
      "prompt": "{file:./prompts/generated/agent-engineer.md}",
      "permission": {
        "webfetch": "allow",
        "websearch_cited": "allow",
        "codesearch": "allow",
        "edit": {
          "*": "ask",
          "*.env": "deny",
          "*.env.*": "deny"
        }
      }
    }
  }
}
