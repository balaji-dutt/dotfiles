{
  // Container-dotfiles OpenCode user config for homelab-IaC devcontainers.
  "$schema": "https://opencode.ai/config.json",

  // ----------------------------
  // General defaults
  // ----------------------------
  "autoupdate": false,

  // Pick what you want OpenCode to start as.
  "default_agent": "build",

  // Default model (agents override this).
  // OpenCode selects models as `provider_id/model_id`.
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",

  // ----------------------------
  // Global permissions
  // ----------------------------
  "permission": {
    // Keep edits gated by default; coder subagent will override to allow.
    "edit": "ask",

    // Prevent “oops” reads of env files by default (OpenCode shows this pattern).
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",

      // Defense in depth for common credential and cloud state stores.
      "~/.ssh": "deny",
      "~/.ssh/**": "deny",
      "~/.aws": "deny",
      "~/.aws/**": "deny",
      "~/.ansible": "deny",
      "~/.ansible/**": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube": "deny",
      "~/.kube/**": "deny",
      "~/.docker": "deny",
      "~/.docker/**": "deny",
      "~/.azure": "deny",
      "~/.azure/**": "deny",
      "~/.config/gh": "deny",
      "~/.config/gh/**": "deny",
      "~/.config/gcloud": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.local/share/keyrings": "deny",
      "~/.local/share/keyrings/**": "deny",
      "~/.password-store": "deny",
      "~/.password-store/**": "deny",
      "~/.1password": "deny",
      "~/.1password/**": "deny"
    },

    // Safety guards (OpenCode calls these out specifically).
    "doom_loop": "ask",
    "external_directory": {
      // Ask for anything outside the launch workspace unless a trusted
      // worktree root below matches. Last matching rule wins.
      "*": "ask",
      "/workspaces/**": "allow",
      "/workspace/**": "allow",

      // Never auto-enter common credential and cloud state stores.
      "~/.ssh": "deny",
      "~/.ssh/**": "deny",
      "~/.aws": "deny",
      "~/.aws/**": "deny",
      "~/.ansible": "deny",
      "~/.ansible/**": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube": "deny",
      "~/.kube/**": "deny",
      "~/.docker": "deny",
      "~/.docker/**": "deny",
      "~/.azure": "deny",
      "~/.azure/**": "deny",
      "~/.config/gh": "deny",
      "~/.config/gh/**": "deny",
      "~/.config/gcloud": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.local/share/keyrings": "deny",
      "~/.local/share/keyrings/**": "deny",
      "~/.password-store": "deny",
      "~/.password-store/**": "deny",
      "~/.1password": "deny",
      "~/.1password/**": "deny"
    },

    // Bash is pattern-matchable and supports wildcards; "last matching rule wins".
    "bash": {
      "*": "ask",

      // ---- git (Claude-style; notably NOT allowing push by default)
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git switch*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "git stash*": "allow",
      "git remote*": "allow",
      "git add*": "allow",
      "git commit*": "deny",
      "oc-commit*": "ask",
      "git rev-parse*": "allow",
      "git merge*": "allow",
      "git worktree*": "allow",
      "git rev-list*": "allow",
      "git push*": "ask",

      // ---- filesystem + text inspection
      "ls*": "allow",
      "pwd*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "tree*": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "chmod *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "command -v *": "allow",

      // (optional; safer to keep ask)
      "chown *": "ask",
      "rm *": "ask",

      // ---- node toolchain
      "node -v*": "allow",
      "node --version*": "allow",
      "node --check *": "allow",
      "npm install*": "allow",
      "npm run*": "allow",
      "npm test*": "allow",
      "npm list*": "allow",
      "npm view *": "allow",
      "npx*": "allow", // if you want Claude parity; otherwise set this to "ask"
      "bun install*": "allow",
      "bun run*": "allow",

      // ---- misc
      "echo *": "allow",
      "printf *": "allow",
      "test *": "allow",
      "true": "allow",
      "false": "allow",
      "printenv*": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "ps aux*": "allow",
      "pgrep*": "allow",
      "date*": "allow",
      "whoami*": "allow",
      "hostname*": "allow",
      "uname*": "allow",
      "which *": "allow",
      "whereis *": "allow",
      "df -h*": "allow",
      "du -sh*": "allow",
      "uptime*": "allow",
      "curl -s*": "allow",
      "curl --version*": "allow",
      "wget --version*": "allow",

      // ---- keep your existing DENIES after the allows (last-match wins)
      "rm -rf /": "deny",
      "rm -rf / *": "deny",
      "sudo rm -rf /": "deny",
      "sudo rm -rf / *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "fdisk*": "deny",
      "parted*": "deny",
      "passwd*": "deny",
      "sudo passwd*": "deny",
      "sudo useradd*": "deny",
      "sudo userdel*": "deny",
      "sudo chmod 777*": "deny",
      "nmap*": "deny",
      "masscan*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "exec < /dev/tcp/*": "deny",
      "exec > /dev/tcp/*": "deny"
    }
  },

  // ----------------------------
  // Plugins
  // ----------------------------

  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.6",
    "@tarquinen/opencode-dcp@3.1.15",
    "@mohak34/opencode-notifier@0.2.8",
    ["@plannotator/opencode@0.27.12", {
      "workflow": "plan-agent",
      "runtime": "cli",
      "planningAgents": [
        "plan",
        "plan-GPT-xhigh",
        "special-builder",
        "agent-engineer"
      ]
    }],
    "@gotgenes/opencode-agent-identity@3.1.1",
    "cc-safety-net@2.2.2",
    "envsitter-guard@0.0.4",
    "opencode-claude-bridge@1.10.12",
    "@slkiser/opencode-quota@4.8.2"
  ],

  // ----------------------------
  // Providers
  // ----------------------------
  "provider": {
    "openai": {
      // OpenAI auth: OAuth via `/connect` / `opencode auth login`.
      // Do not set apiKey here.
      "options": {
        "timeout": 600000,
        // Required by the local websearch_cited compatibility shim:
        // This tells the shim which OpenAI model to use when it runs the tool.
        "websearch_cited": {
          "model": "gpt-5.6-sol"
        }
      }
    },

    // Anthropic: built-in auth/models.dev; API key use is in anthropic-api.
    "anthropic": {
      "options": {
        "timeout": 600000,
        // Anthropic OAuth fallback for the local websearch_cited compatibility shim.
        // OpenAI remains selected first while its provider option above exists.
        "websearch_cited": {
          "model": "claude-haiku-4-5"
        }
      }
    },

    "anthropic-api": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic API",
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
        "timeout": 600000,
        // Anthropic API-key fallback for the local websearch_cited compatibility shim.
        // OpenAI remains selected first while its provider option above exists.
        "websearch_cited": {
          "model": "claude-haiku-4-5"
        }
      },
      "models": {
        "claude-haiku-4-5": {
          "name": "Haiku 4.5"
        },
        "claude-sonnet-4-6": {
          "name": "Sonnet 4.6",
          "variants": {
            "medium": {
              "effort": "medium"
            },
            "high": {
              "effort": "high"
            },
            "xhigh": {
              "effort": "xhigh"
            }
          }
        },
        "claude-sonnet-5": {
          "name": "Sonnet 5",
          "variants": {
            "medium": {
              "effort": "medium"
            },
            "high": {
              "effort": "high"
            },
            "xhigh": {
              "effort": "xhigh",
              "max_tokens": 64000
            },
            "ultra": {
              "effort": "max",
              "max_tokens": 128000
            }
          }
        },
        "claude-opus-4-8": {
          "name": "Opus 4.8",
          "variants": {
            "medium": {
              "effort": "medium"
            },
            "high": {
              "effort": "high"
            },
            "xhigh": {
              "effort": "xhigh",
              "max_tokens": 64000
            },
            "ultra": {
              "effort": "max",
              "max_tokens": 128000
            }
          }
        },
        "claude-opus-5": {
          "name": "Opus 5",
          "variants": {
            "medium": {
              "effort": "medium"
            },
            "high": {
              "effort": "high"
            },
            "xhigh": {
              "effort": "xhigh",
              "max_tokens": 64000
            },
            "ultra": {
              "effort": "max",
              "max_tokens": 128000
            }
          }
        }
      }
    },

    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_API_KEY}",
        "timeout": 600000
      }
    },

    // Google: API key from env
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "gemini-3.5-flash": {},
        "gemini-3.5-flash-lite": {},
        "gemini-3.6-flash": {},
        "gemini-flash-latest": {},
        "gemini-flash-lite-latest": {}
      }
    },

    // Moonshot/Kimi (OpenAI-compatible)
    "moonshot": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Moonshot",
      "options": {
        "baseURL": "https://api.moonshot.ai/v1",
        "apiKey": "{env:MOONSHOT_API_KEY}",
        "timeout": 600000
      },
      "models": {
        // NOTE: provider-specific reasoning flags are not standardized in OpenCode docs.
        "kimi-k3": {
          "options": {
            "reasoning": true
          }
        },
        "kimi-k2.7-code": {
          "options": {
            "reasoning": true
          }
        },
        "kimi-k2.6": {
          "options": {
            "reasoning": true
          }
        }
      }
    },

    // Perplexity (OpenAI-compatible) for search-capable planning
    "perplexity": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Perplexity",
      "options": {
        "baseURL": "https://api.perplexity.ai",
        "apiKey": "{env:PERPLEXITY_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "sonar-reasoning-pro": {}
      }
    },

    // OpenRouter (API key from env)
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "timeout": 600000
      },
      "models": {
        // OpenCode will pass "options" to the provider, but vendor-specific keys may or may not be honored.
        // Validate by testing the model and checking if reasoning behavior changes.
        "deepseek/deepseek-v4-pro:exacto": {
          "name": "DeepSeek V4 Pro (Exacto)",
          "options": {
            "reasoning": {
              "enabled": true
            }
          }
        },
        "deepseek/deepseek-v4-flash:exacto": {
          "name": "DeepSeek V4 Flash (Exacto)",
          "options": {
            "reasoning": {
              "enabled": true
            }
          }
        },
        "z-ai/glm-5.2:exacto": {
          "name": "GLM 5.2 (Exacto)",
          "options": {
            "reasoning": {
              "effort": "high",
              "enabled": true
            }
          }
        },
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6",
          "options": {
            "reasoning": {
              "enabled": true
            }
          }
        },
        "moonshotai/kimi-k3": {
          "name": "Kimi K3",
          "options": {
            "reasoning": {
              "enabled": true
            }
          }
        },
      }
    }
  },

  // ----------------------------
  // Agents
  // ----------------------------
  "agent": {
    // Overwrite built-in Plan agent: search-capable planning manager.
    // Permissions support websearch/webfetch tools too, but your plan model itself is search-capable.
    "plan": {
      "mode": "primary",
      "description": "Planning manager (Latest GPT model/high reasoning + websearch). Read/grep/list OK; no edits.",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "temperature": 0.4,
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "websearch_cited": "allow",
        "codesearch": "allow",
        "task": {
          "*": "deny"
        }
      }
    },

    "plan-GPT-xhigh": {
      "mode": "primary",
      "description": "Planning manager (Latest GPT model/xhigh reasoning + websearch). Read/grep/list OK; no edits.",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "temperature": 0.4,
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "websearch_cited": "allow",
        "codesearch": "allow",
        "task": {
          "*": "deny"
        }
      }
    },

    // Keep Build as a “manual interactive” agent.
    "build": {
      "mode": "primary",
      "description": "Default editing agent",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "temperature": 0.2,
      "permission": {
        "edit": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        }
      }
    },

    "special-builder": {
      "mode": "primary",
      "description": "Agent for meta-level and infrastructural work ",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "temperature": 0.2,
      "permission": {
        "webfetch": "allow",
        "websearch_cited": "allow",
        "codesearch": "allow",
        "edit": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        }
      }
    },

    "agent-engineer": {
      "mode": "primary",
      "description": "meta-agent that designs, builds, evaluates, and packages AI agent systems",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "temperature": 0.2,
      "permission": {
        "webfetch": "allow",
        "websearch_cited": "allow",
        "codesearch": "allow",
        "edit": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        }
      }
    }
  }
}
