{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "4000",
    "DISABLE_UPDATES": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker version:*)",
      "Bash(docker info:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker-compose ps:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git rev-parse:*)",
      "Bash(*/dotfiles/assets/agent-wt-merge inspect:*)",
      "Bash(\"*/dotfiles/assets/agent-wt-merge\" inspect:*)",
      "Bash('*/dotfiles/assets/agent-wt-merge' inspect:*)",
      "Bash(*/dotfiles/assets/agent-wt-merge ff:*)",
      "Bash(\"*/dotfiles/assets/agent-wt-merge\" ff:*)",
      "Bash('*/dotfiles/assets/agent-wt-merge' ff:*)",
      "Bash(*/dotfiles/assets/agent-wt-merge no-ff:*)",
      "Bash(\"*/dotfiles/assets/agent-wt-merge\" no-ff:*)",
      "Bash('*/dotfiles/assets/agent-wt-merge' no-ff:*)",
      "Bash(*/dotfiles/.opencode/bin/agent-wt-merge inspect:*)",
      "Bash(\"*/dotfiles/.opencode/bin/agent-wt-merge\" inspect:*)",
      "Bash('*/dotfiles/.opencode/bin/agent-wt-merge' inspect:*)",
      "Bash(*/dotfiles/.opencode/bin/agent-wt-merge ff:*)",
      "Bash(\"*/dotfiles/.opencode/bin/agent-wt-merge\" ff:*)",
      "Bash('*/dotfiles/.opencode/bin/agent-wt-merge' ff:*)",
      "Bash(*/dotfiles/.opencode/bin/agent-wt-merge no-ff:*)",
      "Bash(\"*/dotfiles/.opencode/bin/agent-wt-merge\" no-ff:*)",
      "Bash('*/dotfiles/.opencode/bin/agent-wt-merge' no-ff:*)",
      "Bash(bd:*)",
      "Bash(command bd:*)",
      "Bash(ls:*)",
      "Bash(ll:*)",
      "Bash(pwd:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(cd:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(command -v:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm list:*)",
      "Bash(npm view:*)",
      "Bash(npx:*)",
      "Bash(node -v:*)",
      "Bash(node --version:*)",
      "Bash(node --check:*)",
      "Bash(bun install:*)",
      "Bash(bun run:*)",
      "Bash(echo:*)",
      "Bash(export:*)",
      "Bash(printenv:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(ps aux:*)",
      "Bash(pgrep:*)",
      "Bash(date:*)",
      "Bash(whoami:*)",
      "Bash(hostname:*)",
      "Bash(uname:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(df -h:*)",
      "Bash(du -sh:*)",
      "Bash(free -h:*)",
      "Bash(uptime:*)",
      "Bash(curl -s:*)",
      "Bash(curl --version:*)",
      "Bash(wget --version:*)",
      "Bash(claude:*)",
      "Read(**)",
      "Edit(**)",
      "Grep",
      "Glob",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:127.0.0.1)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gitlab.com)",
      "WebSearch",
      "TodoWrite",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskStop",
      "TaskOutput",
      "Agent",
      "mcp__cbm__search_graph",
      "mcp__cbm__trace_path",
      "mcp__cbm__get_architecture",
      "mcp__cbm__get_graph_schema",
      "mcp__cbm__get_code_snippet",
      "mcp__cbm__search_code",
      "mcp__cbm__list_projects",
      "mcp__cbm__index_status",
      "mcp__cbm__detect_changes"
    ],
    "deny": [
      "mcp__cbm__delete_project",
      "Bash(rm -rf /:*)",
      "Bash(sudo rm -rf /:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(passwd:*)",
      "Bash(sudo passwd:*)",
      "Bash(sudo useradd:*)",
      "Bash(sudo userdel:*)",
      "Bash(sudo chmod 777:*)",
      "Bash(nmap:*)",
      "Bash(masscan:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(cat .env:*)",
      "Bash(cat .env.local:*)",
      "Bash(cat .env.development:*)",
      "Bash(cat .env.production:*)",
      "Bash(cat .env.test:*)",
      "Bash(cat .envsitter/pepper:*)",
      "Bash(head .env:*)",
      "Bash(head .env.local:*)",
      "Bash(tail .env:*)",
      "Bash(tail .env.local:*)",
      "Bash(grep * .env:*)",
      "Bash(grep * .env.local:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.envsitter/pepper)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.envsitter/pepper)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Edit(./.envsitter/pepper)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.envsitter/pepper)",
      "Bash(exec < /dev/tcp/:*)",
      "Bash(exec > /dev/tcp/:*)"
    ],
    "ask": [
      "Bash(ai-wt cleanup:*)",
      "Bash(git worktree remove:*)",
      "Bash(git branch -d:*)",
      "Bash(*/dotfiles/assets/agent-wt-merge prepare-ci:*)",
      "Bash(\"*/dotfiles/assets/agent-wt-merge\" prepare-ci:*)",
      "Bash('*/dotfiles/assets/agent-wt-merge' prepare-ci:*)",
      "Bash(*/dotfiles/.opencode/bin/agent-wt-merge prepare-ci:*)",
      "Bash(\"*/dotfiles/.opencode/bin/agent-wt-merge\" prepare-ci:*)",
      "Bash('*/dotfiles/.opencode/bin/agent-wt-merge' prepare-ci:*)",
      "Bash(cc-commit:*)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/gate-bd-destructive.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/feature-ci-reminder.py\" pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/feature-ci-reminder.py\" post",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/feature-ci-reminder.py\" failure",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-pace@claude-pace-marketplace": true,
    "plannotator@plannotator": true,
    "cc-safety-net@cc-marketplace": true
  },
  "extraKnownMarketplaces": {
    "cc-marketplace": {
      "source": {
        "source": "github",
        "repo": "kenryu42/cc-marketplace"
      }
    },
    "claude-pace-marketplace": {
      "source": {
        "source": "github",
        "repo": "Astro-Han/claude-pace"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "awaySummaryEnabled": false,
  "effortLevel": "high",
  "theme": "dark"
}
