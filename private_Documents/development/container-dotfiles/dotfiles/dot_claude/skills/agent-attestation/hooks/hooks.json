{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/attest.mjs"], "timeout": 10}]}],
    "PostModelSwitch": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/attest.mjs"], "timeout": 10}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/attest.mjs"], "timeout": 10}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/attest.mjs"], "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/attest.mjs"], "timeout": 10}]}],
    "PostToolUse": [{"matcher": "Agent|Task|SubagentHandback", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/attest.mjs"], "timeout": 10}]}],
    "PreToolUse": [{"matcher": "Bash|PowerShell|SubagentHandback", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/attest.mjs"], "timeout": 10}]}]
  }
}
