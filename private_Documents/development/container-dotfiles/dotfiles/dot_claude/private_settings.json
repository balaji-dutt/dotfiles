{
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "enabledPlugins": {
    "claude-pace@claude-pace-marketplace": true,
    "plannotator@plannotator": true,
    "safety-net@cc-marketplace": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "4000"
  },
  "extraKnownMarketplaces": {
    "cc-marketplace": {
      "source": {
        "repo": "kenryu42/cc-marketplace",
        "source": "github"
      }
    },
    "claude-pace-marketplace": {
      "source": {
        "repo": "Astro-Han/claude-pace",
        "source": "github"
      }
    },
    "plannotator": {
      "source": {
        "repo": "backnotprop/plannotator",
        "source": "github"
      }
    }
  },
  "hooks": {
    "ElicitationResult": [
      {
        "hooks": [
          {
            "command": "sh -c '[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; mkdir -p /tmp/aoe-hooks/$AOE_INSTANCE_ID && printf running > /tmp/aoe-hooks/$AOE_INSTANCE_ID/status'",
            "type": "command"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "sh -c '[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; mkdir -p /tmp/aoe-hooks/$AOE_INSTANCE_ID && printf waiting > /tmp/aoe-hooks/$AOE_INSTANCE_ID/status'",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh -c '[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; mkdir -p /tmp/aoe-hooks/$AOE_INSTANCE_ID && printf running > /tmp/aoe-hooks/$AOE_INSTANCE_ID/status'",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "sh -c '[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; mkdir -p /tmp/aoe-hooks/$AOE_INSTANCE_ID && printf idle > /tmp/aoe-hooks/$AOE_INSTANCE_ID/status'",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh -c '[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; mkdir -p /tmp/aoe-hooks/$AOE_INSTANCE_ID && printf running > /tmp/aoe-hooks/$AOE_INSTANCE_ID/status'",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "claude-opus-4-7",
  "permissions": {
    "allow": [
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker version:*)",
      "Bash(docker info:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker-compose ps:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git rev-parse:*)",
      "Bash(bd:*)",
      "Bash(ls:*)",
      "Bash(ll:*)",
      "Bash(pwd:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(cd:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(command -v:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm list:*)",
      "Bash(npm view:*)",
      "Bash(npx:*)",
      "Bash(node -v:*)",
      "Bash(node --version:*)",
      "Bash(node --check:*)",
      "Bash(bun install:*)",
      "Bash(bun run:*)",
      "Bash(echo:*)",
      "Bash(export:*)",
      "Bash(printenv:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(ps aux:*)",
      "Bash(pgrep:*)",
      "Bash(date:*)",
      "Bash(whoami:*)",
      "Bash(hostname:*)",
      "Bash(uname:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(df -h:*)",
      "Bash(du -sh:*)",
      "Bash(free -h:*)",
      "Bash(uptime:*)",
      "Bash(curl -s:*)",
      "Bash(curl --version:*)",
      "Bash(wget --version:*)",
      "Bash(claude:*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Glob(**)",
      "Grep(**)",
      "LS(**)",
      "NotebookRead(**)",
      "NotebookEdit(**)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:127.0.0.1)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gitlab.com)",
      "WebSearch",
      "TodoRead",
      "TodoWrite",
      "Task"
    ],
    "ask": [
      "Bash(cc-commit:*)"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(sudo rm -rf /:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(passwd:*)",
      "Bash(sudo passwd:*)",
      "Bash(sudo useradd:*)",
      "Bash(sudo userdel:*)",
      "Bash(sudo chmod 777:*)",
      "Bash(nmap:*)",
      "Bash(masscan:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(cat .env:*)",
      "Bash(cat .env.local:*)",
      "Bash(cat .env.development:*)",
      "Bash(cat .env.production:*)",
      "Bash(cat .env.test:*)",
      "Bash(cat .envsitter/pepper:*)",
      "Bash(head .env:*)",
      "Bash(head .env.local:*)",
      "Bash(tail .env:*)",
      "Bash(tail .env.local:*)",
      "Bash(grep * .env:*)",
      "Bash(grep * .env.local:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.envsitter/pepper)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.envsitter/pepper)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Edit(./.envsitter/pepper)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.envsitter/pepper)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.development)",
      "Write(./.env.production)",
      "Write(./.env.test)",
      "Write(./.envsitter/pepper)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.development)",
      "Write(**/.env.production)",
      "Write(**/.env.test)",
      "Write(**/.envsitter/pepper)",
      "Bash(exec < /dev/tcp/:*)",
      "Bash(exec > /dev/tcp/:*)"
    ]
  },
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "type": "command"
  },
  "theme": "dark"
}