# Hook to filter command history before it is written
zshaddhistory() {
    emulate -L zsh
    local line="${1%%$'\n'}"
    local cmd="${line%% *}"

    # 1. Resolve the command if it is an alias
    local real_cmd="$cmd"
    if [[ -n "${aliases[$cmd]}" ]]; then
        # If it's an alias, grab the definition (e.g., "ls -la")
        # and extract just the first word ("ls")
        local alias_def="${aliases[$cmd]}"
        real_cmd="${alias_def%% *}"
    fi

    # 2. Check the RESOLVED command against cd/ls
    if [[ "$real_cmd" == "cd" || "$real_cmd" == "ls" ]]; then
        return 1
    fi

    # 3. Exclude commands that don't exist (using the original typed command)
    if ! whence "$cmd" > /dev/null; then
        return 1
    fi

    return 0
}

# Universal custom aliases
alias cd=" cd"

# Direnv initialization
(( ${+commands[direnv]} )) && emulate zsh -c "$(direnv hook zsh)"

# OpenCode env (trusted file)
case $- in
  *a*)
    set +a
    _opencode_restore_allexport=1
    ;;
  *)
    unset _opencode_restore_allexport
    ;;
esac

OPENCODE_ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.env"
if [ -n "${_opencode_restore_allexport:-}" ]; then
  export OPENCODE_ENV_FILE
fi

if [ -r "$OPENCODE_ENV_FILE" ]; then
  set -a
  . "$OPENCODE_ENV_FILE"

  if [ -z "${_opencode_restore_allexport:-}" ]; then
    set +a
  fi
elif [ -n "${_opencode_restore_allexport:-}" ]; then
  set -a
fi

unset _opencode_restore_allexport

# Enable Powerlevel10k instant prompt.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Source Powerlevel10k config
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Source FZF
source <(fzf --zsh)

# Source Antidote from the install location in the container
source /opt/antidote/antidote.zsh

# Initialize plugins statically
antidote load

# Define the path to persistent data directory
PERSISTENT_DATA_DIR="$HOME/persistent-data"
# Ensure the directory exists
mkdir -p "$PERSISTENT_DATA_DIR"

# Set HISTFILE
export HISTFILE="$PERSISTENT_DATA_DIR/.zsh_history"
export HISTSIZE=10000
export SAVEHIST=10000
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST

# Set language variables
export LC_ALL=en_GB.UTF-8
export LANG=en_GB.UTF-8

# Set parameters for zsh-autosuggestions
export ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# Set autoload for ZSH prompt
autoload -Uz promptinit && promptinit
# Set prompt to powerlevel10k
prompt powerlevel10k

# Plugin customizations for you-should-use and fzf-history-search
export YSU_MESSAGE_POSITION="after"
export ZSH_FZF_HISTORY_SEARCH_DATES_IN_SEARCH=0
# Set keywords to be excluded from ZSH History using MichaelAquilina/zsh-history-filter
export HISTORY_FILTER_EXCLUDE=("_KEY" "Bearer")

# Use eza aliases (eza is installed in the Dockerfile)
alias ls="eza -l --group-directories-first"
alias ll="eza -la --group-directories-first"
alias lt="eza -laT --sort=modified --reverse --color=always"
alias tree="eza --tree"

# Alias OpenTofu to tf command by default unless specified otherwise
export TF_CMD=tofu
tf() {
  # Accept values: tofu, opentofu, terraform
  local cmd="${TF_CMD:-tofu}"
  case "$cmd" in
    terraform) cmd="terraform" ;;
    tofu|opentofu) cmd="tofu" ;;  # package usually installs 'tofu' binary
    *) cmd="tofu" ;;
  esac
  command "$cmd" "$@"
}

# Set $EDITOR & $VISUAL to VSCode (this works great in devcontainers)
export VISUAL="$(command -v code) --wait"
EDITOR="$VISUAL"

# Update $PATH with Python user bin directory if it exists
PYTHON_USER_BIN_DIR="$HOME/.local/bin"
if [ -d "$PYTHON_USER_BIN_DIR" ]; then
    export PATH="$PYTHON_USER_BIN_DIR:$PATH"
fi

# Load nvm
if [ -d "/usr/local/share/nvm" ]; then
    export NVM_DIR="/usr/local/share/nvm"
elif [ -d "$HOME/.nvm" ]; then
    export NVM_DIR="$HOME/.nvm"
fi
[ -n "$NVM_DIR" ] && [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# This is added at the end of the file to avoid potential conflicts
if command -v smartcache >/dev/null 2>&1; then
    (( ${+commands[direnv]} && ${+commands[smartcache]} )) && emulate zsh -c "$(smartcache direnv hook zsh)"
else
    (( ${+commands[direnv]} )) && emulate zsh -c "$(direnv hook zsh)"
fi

# Initialize claude-code-router integration if available.
if (( ${+commands[ccr]} && ${+commands[claude]} )); then
    claude() {
        eval "$(ccr activate)"
        command claude "$@"
    }
fi

# 1. Bind the Up Arrow to the fzf_history_search widget
#    This widget (provided by joshskidmore/zsh-fzf-history-search) reads the
#    current command line buffer and uses it as the FZF query.
bind_fzf_history() {
    if zle -l fzf_history_search; then
        # 1. Bind Up Arrow to FZF (Search Mode)
        bindkey '^[[A' fzf_history_search
        bindkey '^[OA' fzf_history_search
        if [[ -n "${terminfo[kcuu1]}" ]]; then
            bindkey "${terminfo[kcuu1]}" fzf_history_search
        fi
# 2. Bind Ctrl+P/N to Standard History (Navigation Mode)
#    This allows you to just grab the last command without opening the FZF window.
        bindkey '^P' up-line-or-history
        bindkey '^N' down-line-or-history
    fi
}
# 3. Ensure this runs AFTER antidote loads plugins.
bind_fzf_history
