#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="${0##*/}"
: "${OPENCODE_PLANNOTATOR_VERBOSE:=1}"
: "${OPENCODE_PLANNOTATOR_LAUNCH_DELAY_SECONDS:=1}"
RUNTIME_ROOT="${XDG_RUNTIME_DIR:-/tmp}"
RUNTIME_ROOT="${RUNTIME_ROOT%/}"
LOCK_ROOT="$RUNTIME_ROOT/opencode-plannotator-${UID:-$(id -u)}"
DEFAULT_HOST_BUILD='{{ .plannotator_ports.host.build | join "," }}'
DEFAULT_HOST_CUSTOM='{{ .plannotator_ports.host.custom | join "," }}'
DEFAULT_DEVCONTAINER_BUILD='{{ .plannotator_ports.devcontainer.build | join "," }}'
DEFAULT_DEVCONTAINER_CUSTOM='{{ .plannotator_ports.devcontainer.custom | join "," }}'

die() {
  printf '%s: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

is_devcontainer() {
  [ "${DEVCONTAINER:-}" = "1" ] || [ -n "${REMOTE_CONTAINERS:-}" ] || [ -n "${CODESPACES:-}" ]
}

port_is_listening() {
  local port
  port="$1"

  (: >"/dev/tcp/127.0.0.1/$port") >/dev/null 2>&1 || \
    (: >"/dev/tcp/localhost/$port") >/dev/null 2>&1
}

select_pool() {
  local pool_name default_pool env_name
  pool_name="$1"

  case "$pool_name" in
    build)
      env_name="PLANNOTATOR_PORTS_BUILD"
      if is_devcontainer; then
        default_pool="$DEFAULT_DEVCONTAINER_BUILD"
      else
        default_pool="$DEFAULT_HOST_BUILD"
      fi
      ;;
    custom)
      env_name="PLANNOTATOR_PORTS_CUSTOM"
      if is_devcontainer; then
        default_pool="$DEFAULT_DEVCONTAINER_CUSTOM"
      else
        default_pool="$DEFAULT_HOST_CUSTOM"
      fi
      ;;
    *)
      die "unknown pool: $pool_name"
      ;;
  esac

  printf '%s' "${!env_name:-$default_pool}"
}

POOL_NAME="build"
if [[ "$SCRIPT_NAME" == *-custom ]]; then
  POOL_NAME="custom"
fi

POOL="$(select_pool "$POOL_NAME")"
[ -n "$POOL" ] || die "empty port pool for $POOL_NAME"
command -v flock >/dev/null 2>&1 || die "flock is required for Plannotator port locking"

IFS=',' read -r -a PORTS <<<"$POOL"
[ "${#PORTS[@]}" -gt 0 ] || die "empty port pool for $POOL_NAME"

mkdir -p "$LOCK_ROOT"

CHOSEN_PORT=""
LOCK_FD="9"
LOCK_PATH=""

for raw_port in "${PORTS[@]}"; do
  port="${raw_port//[[:space:]]/}"
  [[ "$port" =~ ^[0-9]+$ ]] || die "invalid port in $POOL_NAME pool: $raw_port"

  lock_path="$LOCK_ROOT/port-$port.lock"
  exec 9>"$lock_path"

  if ! flock -n "$LOCK_FD"; then
    exec 9>&-
    continue
  fi

  if port_is_listening "$port"; then
    flock -u "$LOCK_FD" || true
    exec 9>&-
    continue
  fi

  CHOSEN_PORT="$port"
  LOCK_PATH="$lock_path"
  break
done

[ -n "$CHOSEN_PORT" ] || die "no available Plannotator port in $POOL_NAME pool: $POOL"

export PLANNOTATOR_PORT="$CHOSEN_PORT"
export OPENCODE_PLANNOTATOR_POOL="$POOL_NAME"
export OPENCODE_PLANNOTATOR_LOCK="$LOCK_PATH"

if [ "${OPENCODE_PLANNOTATOR_VERBOSE:-}" = "1" ] || [ "${OPENCODE_PLANNOTATOR_DRY_RUN:-}" = "1" ]; then
  printf '%s: pool=%s port=%s lock=%s\n' "$SCRIPT_NAME" "$POOL_NAME" "$CHOSEN_PORT" "$LOCK_PATH" >&2
fi

if [ "${OPENCODE_PLANNOTATOR_DRY_RUN:-}" = "1" ]; then
  sleep "${OPENCODE_PLANNOTATOR_HOLD_SECONDS:-0}"
  flock -u "$LOCK_FD" || true
  exit 0
fi

if [ "$OPENCODE_PLANNOTATOR_VERBOSE" = "1" ] && \
  [ "$OPENCODE_PLANNOTATOR_LAUNCH_DELAY_SECONDS" != "0" ]; then
  sleep "$OPENCODE_PLANNOTATOR_LAUNCH_DELAY_SECONDS"
fi

OPENCODE_BIN="${OPENCODE_BIN:-}"
if [ -z "$OPENCODE_BIN" ]; then
  OPENCODE_BIN="$(command -v opencode || true)"
fi

[ -n "$OPENCODE_BIN" ] || die "opencode not found in PATH"
[ -x "$OPENCODE_BIN" ] || die "opencode is not executable: $OPENCODE_BIN"

exec "$OPENCODE_BIN" "$@"
