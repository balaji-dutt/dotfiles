#!/usr/bin/env python3
"""Create per-session Git worktrees for AI coding tools."""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import random
import re
import shlex
import shutil
import string
import subprocess
import sys
import tempfile
import unicodedata
from dataclasses import dataclass
from pathlib import Path
from typing import Any

try:  # Best-effort line editing for interactive prompts on POSIX systems.
    import readline  # noqa: F401
except ImportError:  # pragma: no cover - platform dependent fallback
    pass


SCRIPT_NAME = Path(sys.argv[0]).name
VERSION = 1
BRANCH_TYPES = ("feat", "fix", "chore", "docs", "refactor", "test", "build", "ci")
DEFAULT_PATH_TEMPLATE = "worktrees/{safe_branch}-{session_id}"
DEFAULT_STATE_DIR = ".ai-wt"
PROMPT_BACKENDS = {"auto", "gum", "plain"}


class AiWtError(Exception):
    """User-facing wrapper error."""


@dataclass
class Config:
    repo_root: Path
    git_common_dir: Path
    worktree_parent: Path | None
    path_template: str
    state_dir: Path
    base_ref: str
    delete_branch_on_cleanup: bool
    cleanup_dirty: str
    update_exclude: bool
    opencode_command: str | None
    claude_command: str | None
    submodule_init: bool


def eprint(message: str) -> None:
    print(f"{SCRIPT_NAME}: {message}", file=sys.stderr)


def die(message: str) -> None:
    raise AiWtError(message)


def run_git(
    repo_root: Path | None,
    args: list[str],
    *,
    check: bool = True,
    capture: bool = True,
    cwd: Path | None = None,
) -> subprocess.CompletedProcess[str]:
    cmd = ["git"]
    if repo_root is not None:
        cmd.extend(["-C", str(repo_root)])
    cmd.extend(args)
    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd else None,
        check=check,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )


def git_output(repo_root: Path | None, args: list[str], *, cwd: Path | None = None) -> str:
    result = run_git(repo_root, args, cwd=cwd)
    return result.stdout.strip()


def resolve_repo_root() -> Path:
    try:
        return Path(git_output(None, ["rev-parse", "--show-toplevel"])).resolve()
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "not a Git repository").strip()
        die(detail)


def resolve_git_common_dir(repo_root: Path) -> Path:
    try:
        raw = git_output(repo_root, ["rev-parse", "--path-format=absolute", "--git-common-dir"])
        return Path(raw).resolve()
    except subprocess.CalledProcessError:
        raw = git_output(repo_root, ["rev-parse", "--git-common-dir"])
        path = Path(raw)
        if not path.is_absolute():
            path = repo_root / path
        return path.resolve()


def git_config(repo_root: Path, key: str) -> str | None:
    result = run_git(repo_root, ["config", "--get", key], check=False)
    if result.returncode != 0:
        return None
    value = result.stdout.strip()
    return value if value else None


def parse_bool(value: str | bool | None, default: bool) -> bool:
    if value is None or value == "":
        return default
    if isinstance(value, bool):
        return value
    normalized = value.strip().lower()
    if normalized in {"1", "true", "yes", "on"}:
        return True
    if normalized in {"0", "false", "no", "off"}:
        return False
    die(f"invalid boolean value: {value}")


def resolve_path(repo_root: Path, value: str | None, default: str) -> Path:
    raw = value or default
    path = Path(raw).expanduser()
    if not path.is_absolute():
        path = repo_root / path
    return path.resolve()


def load_config(repo_root: Path, args: argparse.Namespace) -> Config:
    git_common_dir = resolve_git_common_dir(repo_root)

    def from_sources(attr: str, env: str, key: str, default: str | None = None) -> str | None:
        cli_value = getattr(args, attr, None)
        if cli_value not in (None, ""):
            return cli_value
        env_value = os.environ.get(env)
        if env_value not in (None, ""):
            return env_value
        git_value = git_config(repo_root, key)
        if git_value not in (None, ""):
            return git_value
        return default

    path_template = from_sources(
        "path_template",
        "AI_WT_PATH_TEMPLATE",
        "ai-wt.pathTemplate",
        DEFAULT_PATH_TEMPLATE,
    )
    state_raw = from_sources("state_dir", "AI_WT_STATE_DIR", "ai-wt.stateDir", DEFAULT_STATE_DIR)
    parent_raw = from_sources("worktree_parent", "AI_WT_WORKTREE_PARENT", "ai-wt.worktreeParent")
    base_ref = from_sources("base_ref", "AI_WT_BASE_REF", "ai-wt.baseRef", "HEAD") or "HEAD"
    cleanup_dirty = from_sources("cleanup_dirty", "AI_WT_CLEANUP_DIRTY", "ai-wt.cleanupDirty", "keep") or "keep"
    cleanup_dirty = cleanup_dirty.strip().lower()
    if cleanup_dirty not in {"keep", "delete"}:
        die("ai-wt.cleanupDirty must be 'keep' or 'delete'")

    delete_branch = parse_bool(
        from_sources(
            "delete_branch_on_cleanup",
            "AI_WT_DELETE_BRANCH_ON_CLEANUP",
            "ai-wt.deleteBranchOnCleanup",
        ),
        False,
    )
    update_exclude = parse_bool(
        from_sources("update_exclude", "AI_WT_UPDATE_EXCLUDE", "ai-wt.updateExclude"),
        True,
    )
    if getattr(args, "no_update_exclude", False):
        update_exclude = False

    submodule_init = parse_bool(
        from_sources("submodule_init", "AI_WT_SUBMODULE_INIT", "ai-wt.submoduleInit"),
        False,
    )
    if getattr(args, "submodule_init_flag", False):
        submodule_init = True
    if getattr(args, "no_submodule_init", False):
        submodule_init = False

    worktree_parent = None
    if parent_raw:
        worktree_parent = resolve_path(repo_root, parent_raw, "worktrees")

    return Config(
        repo_root=repo_root,
        git_common_dir=git_common_dir,
        worktree_parent=worktree_parent,
        path_template=path_template or DEFAULT_PATH_TEMPLATE,
        state_dir=resolve_path(repo_root, state_raw, DEFAULT_STATE_DIR),
        base_ref=base_ref,
        delete_branch_on_cleanup=delete_branch,
        cleanup_dirty=cleanup_dirty,
        update_exclude=update_exclude,
        opencode_command=from_sources("opencode_command", "AI_WT_OPENCODE_COMMAND", "ai-wt.opencodeCommand"),
        claude_command=from_sources("claude_command", "AI_WT_CLAUDE_COMMAND", "ai-wt.claudeCommand"),
        submodule_init=submodule_init,
    )


def slugify(value: str) -> str:
    normalized = unicodedata.normalize("NFKD", value)
    ascii_value = normalized.encode("ascii", "ignore").decode("ascii")
    lowered = ascii_value.lower()
    slug = re.sub(r"[^a-z0-9]+", "-", lowered).strip("-")
    slug = re.sub(r"-+", "-", slug)
    return slug


def validate_ref_name(repo_root: Path, ref_name: str) -> None:
    if not ref_name or ref_name.startswith("-"):
        die("branch name must not be empty or start with '-'")
    result = run_git(repo_root, ["check-ref-format", "--branch", ref_name], check=False)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "invalid branch name").strip()
        die(detail)


def build_session_name(repo_root: Path, branch_type: str, description: str) -> str:
    branch_type = branch_type.strip()
    if branch_type not in BRANCH_TYPES:
        die(f"branch type must be one of: {', '.join(BRANCH_TYPES)}")
    slug = slugify(description)
    if not slug:
        die("description must contain at least one ASCII letter or digit")
    ref_name = f"{branch_type}/{slug}"
    validate_ref_name(repo_root, ref_name)
    return ref_name


def prompt_for_branch_type_numbered() -> str:
    print("Branch type:")
    for index, branch_type in enumerate(BRANCH_TYPES, start=1):
        print(f"  {index}. {branch_type}")
    raw_type = input("Type [feat]: ").strip() or "feat"
    if raw_type.isdigit():
        position = int(raw_type)
        if position < 1 or position > len(BRANCH_TYPES):
            die("branch type selection is out of range")
        raw_type = BRANCH_TYPES[position - 1]
    return raw_type


def prompt_backend() -> str:
    backend = os.environ.get("AI_WT_PROMPT_BACKEND", "auto").strip().lower() or "auto"
    if backend not in PROMPT_BACKENDS:
        die("AI_WT_PROMPT_BACKEND must be one of: auto, gum, plain")
    return backend


def gum_path(backend: str) -> str | None:
    if backend == "plain":
        return None
    path = shutil.which("gum")
    if path is None and backend == "gum":
        die("gum not found in PATH; install gum or set AI_WT_PROMPT_BACKEND=plain")
    return path


def run_gum_prompt(args: list[str], *, backend: str) -> str | None:
    gum = gum_path(backend)
    if gum is None:
        return None
    result = subprocess.run(
        [gum, *args],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
    )
    if result.returncode != 0:
        die("branch prompt cancelled")
    return result.stdout.rstrip("\n")


def prompt_for_branch_type_gum(*, backend: str) -> str | None:
    return run_gum_prompt(
        [
            "choose",
            "--header",
            "Branch type",
            "--height",
            str(len(BRANCH_TYPES)),
            *BRANCH_TYPES,
        ],
        backend=backend,
    )


def prompt_for_description_gum(*, backend: str) -> str | None:
    return run_gum_prompt(["input", "--prompt", "Description: "], backend=backend)


def prompt_for_auto_plain() -> bool:
    while True:
        answer = input("Enable OpenCode --auto? [y/N]: ").strip().lower()
        if answer in {"", "n", "no"}:
            return False
        if answer in {"y", "yes"}:
            return True
        eprint("please answer yes or no")


def prompt_for_auto_gum(*, backend: str) -> bool | None:
    gum = gum_path(backend)
    if gum is None:
        return None
    result = subprocess.run(
        [gum, "confirm", "Enable OpenCode --auto?"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
    )
    if result.returncode == 0:
        return True
    if result.returncode == 1:
        return False
    die("auto prompt cancelled")


def prompt_for_auto() -> bool:
    backend = prompt_backend()
    selected = prompt_for_auto_gum(backend=backend)
    if selected is not None:
        return selected
    return prompt_for_auto_plain()


def prompt_for_branch(repo_root: Path) -> str:
    if not sys.stdin.isatty():
        die("branch is required when stdin is not interactive")
    backend = prompt_backend()
    raw_type = prompt_for_branch_type_gum(backend=backend)
    if raw_type is None:
        raw_type = prompt_for_branch_type_numbered()
    description = prompt_for_description_gum(backend=backend)
    if description is None:
        description = input("Description: ")
    description = description.strip()
    return build_session_name(repo_root, raw_type, description)


def safe_branch_component(branch: str) -> str:
    component = re.sub(r"[^A-Za-z0-9._-]+", "-", branch).strip(".-_")
    component = re.sub(r"-+", "-", component) or "branch"
    if len(component) <= 80:
        return component
    digest = hashlib.sha1(branch.encode("utf-8")).hexdigest()[:10]
    return f"{component[:69].rstrip('-')}-{digest}"


def generate_session_id(state_dir: Path) -> str:
    alphabet = string.hexdigits.lower()[:16]
    for _ in range(20):
        timestamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%d-%H%M%S")
        suffix = "".join(random.choice(alphabet) for _ in range(6))
        session_id = f"{timestamp}-{suffix}"
        if not (state_dir / "sessions" / f"{session_id}.json").exists():
            return session_id
    die("could not allocate a unique session id")


def path_inside(parent: Path, child: Path) -> bool:
    try:
        child.resolve().relative_to(parent.resolve())
        return True
    except ValueError:
        return False


def rel_to_repo(repo_root: Path, path: Path) -> str | None:
    try:
        return path.resolve().relative_to(repo_root.resolve()).as_posix()
    except ValueError:
        return None


def render_worktree_path(config: Config, branch: str, session_id: str) -> Path:
    safe_branch = safe_branch_component(branch)
    template = config.path_template
    if config.worktree_parent is not None and template == DEFAULT_PATH_TEMPLATE:
        template = "{safe_branch}-{session_id}"
    values = {
        "repo_root": str(config.repo_root),
        "branch": branch,
        "safe_branch": safe_branch,
        "session_id": session_id,
        "session-id": session_id,
    }
    def replace_field(match: re.Match[str]) -> str:
        key = match.group(1)
        if key not in values:
            die(f"unknown path template key: {key}")
        return values[key]

    rendered = re.sub(r"\{([A-Za-z0-9_-]+)\}", replace_field, template)
    if "{" in rendered or "}" in rendered:
        die("path template contains unsupported brace syntax")
    path = Path(rendered).expanduser()
    if config.worktree_parent is not None and not path.is_absolute():
        path = config.worktree_parent / path
    elif not path.is_absolute():
        path = config.repo_root / path
    return path.resolve()


def ensure_state(config: Config) -> None:
    config.state_dir.mkdir(parents=True, exist_ok=True)
    (config.state_dir / "sessions").mkdir(parents=True, exist_ok=True)


class RepoLock:
    def __init__(self, path: Path) -> None:
        self.path = path
        self.handle: Any = None

    def __enter__(self) -> "RepoLock":
        import fcntl

        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.handle = self.path.open("a+")
        fcntl.flock(self.handle.fileno(), fcntl.LOCK_EX)
        return self

    def __exit__(self, *_: object) -> None:
        import fcntl

        if self.handle is not None:
            fcntl.flock(self.handle.fileno(), fcntl.LOCK_UN)
            self.handle.close()


def git_check_ignored(repo_root: Path, rel_probe: str) -> bool:
    result = run_git(repo_root, ["check-ignore", "-q", "--no-index", rel_probe], check=False)
    return result.returncode == 0


def ensure_local_exclude(config: Config, path: Path) -> None:
    rel = rel_to_repo(config.repo_root, path)
    if rel is None:
        return
    rel = rel.strip("/")
    if not rel:
        return
    probe = f"{rel}/.ai-wt-ignore-probe"
    if git_check_ignored(config.repo_root, probe):
        return

    entry = f"/{rel}/"
    exclude_path = config.git_common_dir / "info" / "exclude"
    try:
        exclude_path.parent.mkdir(parents=True, exist_ok=True)
        existing = exclude_path.read_text(encoding="utf-8") if exclude_path.exists() else ""
        if any(line.strip() == entry for line in existing.splitlines()):
            return
        prefix = "" if not existing or existing.endswith("\n") else "\n"
        with exclude_path.open("a", encoding="utf-8") as handle:
            handle.write(f"{prefix}{entry}\n")
    except OSError as exc:
        eprint(f"warning: could not update {exclude_path}: {exc}")


def ensure_ignores(config: Config, worktree_path: Path) -> None:
    if not config.update_exclude:
        return
    ensure_local_exclude(config, config.state_dir)
    if path_inside(config.repo_root, worktree_path):
        parent = worktree_path.parent
        ensure_local_exclude(config, parent)


def branch_exists(repo_root: Path, branch: str) -> bool:
    result = run_git(repo_root, ["show-ref", "--verify", "--quiet", f"refs/heads/{branch}"], check=False)
    return result.returncode == 0


def create_worktree(config: Config, branch: str, worktree_path: Path) -> bool:
    if worktree_path.exists():
        die(f"worktree path already exists: {worktree_path}")
    existed = branch_exists(config.repo_root, branch)
    if existed:
        args = ["worktree", "add", str(worktree_path), branch]
    else:
        args = ["worktree", "add", "-b", branch, str(worktree_path), config.base_ref]
    try:
        run_git(config.repo_root, args, capture=False)
    except subprocess.CalledProcessError as exc:
        die(f"git worktree add failed with exit {exc.returncode}")
    if config.submodule_init:
        try:
            run_git(worktree_path, ["submodule", "update", "--init", "--recursive"], capture=False)
        except subprocess.CalledProcessError as exc:
            die(f"git submodule update failed with exit {exc.returncode}")
    return not existed


def metadata_path(config: Config, session_id: str) -> Path:
    return config.state_dir / "sessions" / f"{session_id}.json"


def write_metadata(config: Config, metadata: dict[str, Any]) -> None:
    metadata["updated_at"] = now_iso()
    path = metadata_path(config, metadata["session_id"])
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent), text=True)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        persisted = {key: value for key, value in metadata.items() if not key.startswith("_")}
        json.dump(persisted, handle, indent=2, sort_keys=True)
        handle.write("\n")
    Path(tmp_name).replace(path)


def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def read_metadata(path: Path) -> dict[str, Any] | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        eprint(f"warning: could not read {path}: {exc}")
        return None


def metadata_file_for(config: Config, metadata: dict[str, Any]) -> Path | None:
    raw_path = metadata.get("_metadata_path")
    if raw_path:
        return Path(str(raw_path))
    session_id = str(metadata.get("session_id", ""))
    if not session_id:
        return None
    return metadata_path(config, session_id)


def remove_metadata(config: Config, metadata: dict[str, Any]) -> bool:
    path = metadata_file_for(config, metadata)
    if path is None:
        eprint("could not remove session metadata: missing session id")
        return False
    try:
        path.unlink()
        metadata.pop("_metadata_path", None)
        return True
    except FileNotFoundError:
        metadata.pop("_metadata_path", None)
        return True
    except OSError as exc:
        eprint(f"could not remove session metadata {path}: {exc}")
        return False


def load_sessions(config: Config) -> list[dict[str, Any]]:
    sessions_dir = config.state_dir / "sessions"
    if not sessions_dir.exists():
        return []
    sessions: list[dict[str, Any]] = []
    for path in sorted(sessions_dir.glob("*.json")):
        metadata = read_metadata(path)
        if metadata is not None:
            metadata["_metadata_path"] = str(path)
            sessions.append(metadata)
    return sessions


def print_sessions(sessions: list[dict[str, Any]]) -> None:
    if not sessions:
        print("No ai-wt sessions found.")
        return
    print("SESSION ID                 TOOL      BRANCH                         STATUS        WORKTREE")
    for item in sessions:
        session_id = str(item.get("session_id", ""))
        tool = str(item.get("tool", ""))[:8]
        branch = str(item.get("branch", ""))[:30]
        status = str(item.get("cleanup_status", ""))[:13]
        path = str(item.get("worktree_path", ""))
        print(f"{session_id:26} {tool:8} {branch:30} {status:13} {path}")


def parse_command(value: str) -> list[str]:
    try:
        command = shlex.split(value)
    except ValueError as exc:
        die(f"could not parse command {value!r}: {exc}")
    if not command:
        die("configured command is empty")
    return command


def command_path(name: str) -> str | None:
    if os.sep in name:
        return name if os.access(name, os.X_OK) else None
    return shutil.which(name)


def build_tool_command(config: Config, tool: str, worktree_path: Path, tool_args: list[str]) -> tuple[list[str], Path]:
    if tool == "opencode":
        if config.opencode_command:
            base = parse_command(config.opencode_command)
            if any("{worktree}" in part for part in base):
                command = [part.replace("{worktree}", str(worktree_path)) for part in base]
            else:
                command = base
        else:
            opencode = command_path("opencode-plannotator") or command_path("opencode")
            if not opencode:
                die("opencode-plannotator or opencode not found in PATH")
            command = [opencode]
        return [*command, *tool_args], worktree_path

    if tool == "claude":
        for arg in tool_args:
            if arg == "--worktree" or arg == "-w" or arg.startswith("--worktree="):
                die("do not pass Claude --worktree/-w through ai-wt; ai-wt already created the worktree")
        if config.claude_command:
            command = parse_command(config.claude_command)
        else:
            claude = command_path("claude-plannotator") or command_path("claude")
            if not claude:
                die("claude-plannotator or claude not found in PATH")
            command = [claude]
        return [*command, *tool_args], worktree_path

    die(f"unsupported tool: {tool}")


def worktree_dirty(path: Path) -> bool:
    result = run_git(path, ["status", "--porcelain", "--untracked-files=all"], check=False)
    if result.returncode != 0:
        return True
    return bool(result.stdout.strip())


def remove_worktree(repo_root: Path, path: Path, force: bool, dry_run: bool) -> bool:
    args = ["worktree", "remove"]
    if force:
        args.append("--force")
    args.append(str(path))
    if dry_run:
        print("would run:", shlex.join(["git", "-C", str(repo_root), *args]))
        return True
    try:
        run_git(repo_root, args, capture=False)
        return True
    except subprocess.CalledProcessError as exc:
        eprint(f"git worktree remove failed with exit {exc.returncode}")
        return False


def delete_branch(repo_root: Path, branch: str, force: bool, dry_run: bool) -> bool:
    flag = "-D" if force else "-d"
    args = ["branch", flag, branch]
    if dry_run:
        print("would run:", shlex.join(["git", "-C", str(repo_root), *args]))
        return True
    try:
        run_git(repo_root, args, capture=False)
        return True
    except subprocess.CalledProcessError as exc:
        eprint(f"git branch {flag} failed with exit {exc.returncode}")
        return False


def cleanup_session(
    config: Config,
    metadata: dict[str, Any],
    *,
    delete: bool,
    force: bool,
    dry_run: bool,
    auto: bool,
) -> bool:
    path = Path(metadata["worktree_path"])
    branch = str(metadata.get("branch", ""))
    branch_created = bool(metadata.get("branch_created", False))
    ok = True
    cleanup_complete = False

    if path.exists():
        dirty = worktree_dirty(path)
        if dirty and not force:
            if auto:
                metadata["cleanup_status"] = "kept_dirty"
                write_metadata(config, metadata)
                eprint(f"kept dirty worktree: {path}")
                return True
            eprint(f"refusing to remove dirty worktree without --force: {path}")
            return False
        ok = remove_worktree(config.repo_root, path, force=force, dry_run=dry_run)
        if ok:
            metadata["cleanup_status"] = "removed_worktree" if not dry_run else "dry_run"
            cleanup_complete = True
    else:
        metadata["cleanup_status"] = "missing_worktree"
        cleanup_complete = True

    if delete and branch:
        if not branch_created and not force:
            eprint(f"refusing to delete pre-existing branch without --force: {branch}")
            ok = False
        elif branch_exists(config.repo_root, branch):
            ok = delete_branch(config.repo_root, branch, force=force, dry_run=dry_run) and ok
            if ok:
                metadata["cleanup_status"] = "removed_worktree_deleted_branch" if not dry_run else "dry_run"

    if not dry_run:
        if ok and cleanup_complete:
            ok = remove_metadata(config, metadata)
        else:
            write_metadata(config, metadata)
    return ok


def launch_child(command: list[str], cwd: Path) -> int:
    eprint(f"launching: {shlex.join(command)}")
    child = subprocess.Popen(command, cwd=str(cwd))
    try:
        return child.wait()
    except KeyboardInterrupt:
        return child.wait()


def split_passthrough(args: list[str]) -> tuple[list[str], list[str]]:
    if "--" not in args:
        return args, []
    index = args.index("--")
    return args[:index], args[index + 1 :]


def add_opencode_auto_option(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--auto",
        action="store_true",
        help="auto-approve OpenCode permissions that are not explicitly denied",
    )


def resolve_auto_choice(
    tool: str,
    *,
    explicit: bool,
    branch_prompted: bool,
    tool_args: list[str],
) -> bool:
    if tool != "opencode":
        return False
    if explicit or "--auto" in tool_args:
        return True
    if not branch_prompted:
        return False
    return prompt_for_auto()


def append_opencode_auto(command: list[str], tool: str, enabled: bool) -> list[str]:
    if not enabled:
        return command
    if tool != "opencode":
        die("--auto is only supported for OpenCode sessions")
    if "--auto" in command:
        return command
    return [*command, "--auto"]


def add_run_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--worktree-parent", help="parent directory for new managed worktrees")
    parser.add_argument("--path-template", help="template used to name new worktree paths")
    parser.add_argument("--state-dir", help="directory containing ai-wt session metadata")
    parser.add_argument("--base-ref", help="base ref used when creating a new branch")
    parser.add_argument(
        "--cleanup-dirty",
        choices=("keep", "delete"),
        help="whether automatic cleanup keeps or removes dirty worktrees",
    )
    parser.add_argument(
        "--delete-branch-on-cleanup",
        action="store_true",
        default=None,
        help="delete branches created by ai-wt during successful cleanup",
    )
    parser.add_argument(
        "--no-update-exclude",
        action="store_true",
        help="do not add local-only ignore entries for state/worktree paths",
    )
    parser.add_argument("--opencode-command", help="override the OpenCode command")
    parser.add_argument("--claude-command", help="override the Claude command")
    parser.add_argument(
        "--submodule-init",
        dest="submodule_init_flag",
        action="store_true",
        help="initialize submodules after creating a worktree",
    )
    parser.add_argument("--no-submodule-init", action="store_true", help="skip submodule initialization")


def parse_run_args(
    tool: str,
    raw_args: list[str],
    *,
    prog: str | None = None,
) -> tuple[argparse.Namespace, str | None, list[str]]:
    head, tool_args = split_passthrough(raw_args)
    parser = argparse.ArgumentParser(
        prog=prog or f"{SCRIPT_NAME} {tool}",
        description=f"Create a managed worktree and launch {tool} inside it.",
    )
    add_run_options(parser)
    if tool == "opencode":
        add_opencode_auto_option(parser)
    parser.add_argument(
        "branch",
        nargs="?",
        help="branch name to create or reuse; prompts interactively when omitted",
    )
    parsed = parser.parse_args(head)
    return parsed, parsed.branch, tool_args


def cmd_run(tool: str, raw_args: list[str], *, prog: str | None = None) -> int:
    parsed, branch, tool_args = parse_run_args(tool, raw_args, prog=prog)
    repo_root = resolve_repo_root()
    config = load_config(repo_root, parsed)
    ensure_state(config)
    branch_prompted = branch is None
    if branch is None:
        branch = prompt_for_branch(repo_root)
    auto = resolve_auto_choice(
        tool,
        explicit=bool(getattr(parsed, "auto", False)),
        branch_prompted=branch_prompted,
        tool_args=tool_args,
    )
    validate_ref_name(repo_root, branch)

    with RepoLock(config.state_dir / "lock"):
        session_id = generate_session_id(config.state_dir)
        worktree_path = render_worktree_path(config, branch, session_id)
        ensure_ignores(config, worktree_path)
        command, cwd = build_tool_command(config, tool, worktree_path, tool_args)
        command = append_opencode_auto(command, tool, auto)
        branch_created = create_worktree(config, branch, worktree_path)
        metadata: dict[str, Any] = {
            "version": VERSION,
            "session_id": session_id,
            "repo_root": str(config.repo_root),
            "git_common_dir": str(config.git_common_dir),
            "tool": tool,
            "tool_command": command,
            "branch": branch,
            "branch_created": branch_created,
            "base_ref": config.base_ref,
            "worktree_path": str(worktree_path),
            "created_at": now_iso(),
            "updated_at": now_iso(),
            "child_exit_status": None,
            "cleanup_status": "created",
        }
        write_metadata(config, metadata)

    exit_status = 125
    try:
        exit_status = launch_child(command, cwd)
        metadata["child_exit_status"] = exit_status
        write_metadata(config, metadata)
    finally:
        force_cleanup = config.cleanup_dirty == "delete"
        cleanup_session(
            config,
            metadata,
            delete=config.delete_branch_on_cleanup,
            force=force_cleanup,
            dry_run=False,
            auto=True,
        )
    return exit_status


def cmd_run_dispatch(raw_args: list[str]) -> int:
    if raw_args and raw_args[0] in {"-h", "--help"}:
        parser = argparse.ArgumentParser(
            prog=f"{SCRIPT_NAME} run",
            description="Create a managed worktree and launch an AI tool inside it.",
        )
        parser.add_argument("tool", choices=("opencode", "claude"), help="AI tool to launch")
        parser.add_argument("branch", nargs="?", help="branch name to create or reuse")
        add_run_options(parser)
        add_opencode_auto_option(parser)
        parser.epilog = "Use '--' after the branch to pass arguments to the selected tool."
        parser.print_help()
        return 0
    if not raw_args:
        die("run requires a tool: opencode or claude")
    tool = raw_args[0]
    if tool not in {"opencode", "claude"}:
        die("run tool must be opencode or claude")
    return cmd_run(tool, raw_args[1:], prog=f"{SCRIPT_NAME} run {tool}")


def cmd_name(raw_args: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog=f"{SCRIPT_NAME} name",
        description="Build a valid ai-wt branch name from a type and description.",
    )
    parser.add_argument("--type", required=True, choices=BRANCH_TYPES, help="branch type prefix")
    parser.add_argument("--description", required=True, help="short branch description to slugify")
    parsed = parser.parse_args(raw_args)
    repo_root = resolve_repo_root()
    print(build_session_name(repo_root, parsed.type, parsed.description))
    return 0


def cmd_list(raw_args: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog=f"{SCRIPT_NAME} list",
        description="List active or retained ai-wt sessions.",
    )
    parser.add_argument("--state-dir", help="directory containing ai-wt session metadata")
    parsed = parser.parse_args(raw_args)
    repo_root = resolve_repo_root()
    config = load_config(repo_root, parsed)
    print_sessions(load_sessions(config))
    return 0


def find_session(config: Config, target: str) -> dict[str, Any]:
    sessions = load_sessions(config)
    matches: list[dict[str, Any]] = []
    target_path = Path(target).expanduser()
    resolved_target: Path | None = None
    if target_path.is_absolute() or any(sep in target for sep in ("/", os.sep)):
        try:
            resolved_target = target_path.resolve()
        except OSError:
            resolved_target = target_path.absolute()
    for item in sessions:
        if item.get("session_id") == target or item.get("branch") == target:
            matches.append(item)
            continue
        if resolved_target is not None:
            try:
                if Path(str(item.get("worktree_path", ""))).resolve() == resolved_target:
                    matches.append(item)
            except OSError:
                pass
    if not matches:
        die(f"no managed session matches: {target}")
    unique = {item.get("session_id"): item for item in matches}
    if len(unique) > 1:
        die(f"ambiguous session target: {target}")
    return next(iter(unique.values()))


def stored_tool_command(metadata: dict[str, Any]) -> list[str]:
    command = metadata.get("tool_command")
    if not isinstance(command, list) or not all(isinstance(item, str) for item in command):
        die("session metadata does not contain a usable tool command")
    if not command:
        die("session metadata contains an empty tool command")
    return command


def next_resume_count(metadata: dict[str, Any]) -> int:
    try:
        return int(metadata.get("resume_count", 0) or 0) + 1
    except (TypeError, ValueError):
        return 1


def build_resume_tool_command(
    config: Config,
    tool: str,
    worktree_path: Path,
    tool_args: list[str],
    metadata: dict[str, Any],
    *,
    auto: bool,
) -> tuple[list[str], Path]:
    if auto and tool != "opencode":
        die("--auto is only supported for OpenCode sessions")
    if tool_args:
        command, cwd = build_tool_command(config, tool, worktree_path, tool_args)
    else:
        command = stored_tool_command(metadata)
        cwd = worktree_path
    return append_opencode_auto(command, tool, auto), cwd


def cmd_resume_list(raw_args: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog=f"{SCRIPT_NAME} resume list",
        description="List sessions that can be resumed.",
    )
    parser.add_argument("--state-dir", help="directory containing ai-wt session metadata")
    parsed = parser.parse_args(raw_args)
    repo_root = resolve_repo_root()
    config = load_config(repo_root, parsed)
    print_sessions(load_sessions(config))
    return 0


def cmd_resume(raw_args: list[str]) -> int:
    if raw_args and raw_args[0] == "list":
        return cmd_resume_list(raw_args[1:])

    head, tool_args = split_passthrough(raw_args)
    parser = argparse.ArgumentParser(
        prog=f"{SCRIPT_NAME} resume",
        description="Resume a retained ai-wt session in its existing worktree.",
    )
    add_run_options(parser)
    add_opencode_auto_option(parser)
    parser.add_argument(
        "target",
        help="session ID, exact branch name, or exact worktree path to resume",
    )
    parser.epilog = "Use 'resume list' to show resumable sessions."
    parsed = parser.parse_args(head)

    repo_root = resolve_repo_root()
    config = load_config(repo_root, parsed)
    ensure_state(config)
    metadata = find_session(config, parsed.target)
    raw_worktree_path = str(metadata.get("worktree_path", "")).strip()
    if not raw_worktree_path:
        die("session metadata does not contain a worktree path")
    worktree_path = Path(raw_worktree_path)
    if not worktree_path.exists():
        die(f"session worktree is missing: {worktree_path}; run '{SCRIPT_NAME} prune'")
    if not worktree_path.is_dir():
        die(f"session worktree is not a directory: {worktree_path}")

    tool = str(metadata.get("tool", ""))
    if tool not in {"opencode", "claude"}:
        die(f"session uses unsupported tool: {tool or '<missing>'}")
    command, cwd = build_resume_tool_command(
        config,
        tool,
        worktree_path,
        tool_args,
        metadata,
        auto=parsed.auto,
    )

    metadata["last_resumed_at"] = now_iso()
    metadata["resume_count"] = next_resume_count(metadata)
    metadata["cleanup_status"] = "resumed"
    write_metadata(config, metadata)

    exit_status = 125
    try:
        exit_status = launch_child(command, cwd)
        metadata["child_exit_status"] = exit_status
        write_metadata(config, metadata)
    finally:
        force_cleanup = config.cleanup_dirty == "delete"
        cleanup_session(
            config,
            metadata,
            delete=config.delete_branch_on_cleanup,
            force=force_cleanup,
            dry_run=False,
            auto=True,
        )
    return exit_status


def cmd_cleanup(raw_args: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog=f"{SCRIPT_NAME} cleanup",
        description="Remove a retained ai-wt worktree and optionally delete its branch.",
    )
    parser.add_argument("target", help="session ID, exact branch name, or exact worktree path")
    parser.add_argument("--delete", action="store_true", help="delete the branch after removing the worktree")
    parser.add_argument("--force", action="store_true", help="remove dirty worktrees and force branch deletion with --delete")
    parser.add_argument("--dry-run", action="store_true", help="print actions without removing anything")
    parser.add_argument("--state-dir", help="directory containing ai-wt session metadata")
    parsed = parser.parse_args(raw_args)
    repo_root = resolve_repo_root()
    config = load_config(repo_root, parsed)
    metadata = find_session(config, parsed.target)
    ok = cleanup_session(config, metadata, delete=parsed.delete, force=parsed.force, dry_run=parsed.dry_run, auto=False)
    return 0 if ok else 1


def cmd_prune(raw_args: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog=f"{SCRIPT_NAME} prune",
        description="Clean stale ai-wt metadata and remove clean retained worktrees.",
    )
    parser.add_argument("--force", action="store_true", help="remove dirty retained worktrees too")
    parser.add_argument("--dry-run", action="store_true", help="print actions without removing anything")
    parser.add_argument("--state-dir", help="directory containing ai-wt session metadata")
    parsed = parser.parse_args(raw_args)
    repo_root = resolve_repo_root()
    config = load_config(repo_root, parsed)
    ok = True
    for item in load_sessions(config):
        path = Path(str(item.get("worktree_path", "")))
        if path.exists():
            ok = cleanup_session(config, item, delete=False, force=parsed.force, dry_run=parsed.dry_run, auto=False) and ok
            continue
        meta = Path(str(item.get("_metadata_path", "")))
        if parsed.dry_run:
            print(f"would remove stale metadata: {meta}")
        else:
            if remove_metadata(config, item):
                print(f"removed stale metadata: {meta}")
            else:
                ok = False
    return 0 if ok else 1


def usage() -> str:
    return f"""Usage:
  {SCRIPT_NAME} opencode [branch] [-- tool args...]
  {SCRIPT_NAME} claude [branch] [-- tool args...]
  {SCRIPT_NAME} run <opencode|claude> [branch] [-- tool args...]
  {SCRIPT_NAME} resume list
  {SCRIPT_NAME} resume <session-id|branch|path> [-- tool args...]
  {SCRIPT_NAME} list
  {SCRIPT_NAME} cleanup <session-id|branch|path> [--delete] [--force] [--dry-run]
  {SCRIPT_NAME} prune [--dry-run] [--force]
  {SCRIPT_NAME} name --type <type> --description <text>

Commands:
  opencode  Create a managed worktree and launch OpenCode.
  claude    Create a managed worktree and launch Claude.
  run       Choose the tool explicitly before creating a worktree.
  resume    Relaunch a retained session in its existing worktree.
  list      Show retained session metadata.
  cleanup   Remove retained worktrees and optionally delete branches.
  prune     Remove stale metadata and clean retained worktrees.
  name      Build a valid branch name from a type and description.

Run '{SCRIPT_NAME} <command> --help' for command-specific options.
"""


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help"}:
        print(usage(), end="")
        return 0
    command = argv[0]
    try:
        if command in {"opencode", "claude"}:
            return cmd_run(command, argv[1:])
        if command == "run":
            return cmd_run_dispatch(argv[1:])
        if command == "name":
            return cmd_name(argv[1:])
        if command == "list":
            return cmd_list(argv[1:])
        if command == "resume":
            return cmd_resume(argv[1:])
        if command == "cleanup":
            return cmd_cleanup(argv[1:])
        if command == "prune":
            return cmd_prune(argv[1:])
        die(f"unknown command: {command}")
    except AiWtError as exc:
        eprint(str(exc))
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
