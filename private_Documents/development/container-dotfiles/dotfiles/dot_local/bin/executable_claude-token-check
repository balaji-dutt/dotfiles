#!/usr/bin/env bash
# Preflight check for whether Anthropic will still accept the local Claude Code
# credential, so an expired login surfaces before a session starts rather than
# as a mid-work `Run /login` prompt.
#
# `claude auth status` alone only reads local state and cannot tell whether the
# server still honours the credential, so this also probes the OAuth usage
# endpoint.
#
# Every credential found is probed and reported, but the exit status tracks the
# Claude Code credential alone. OpenCode keeps its own OAuth token in its own
# auth.json; Claude Code never reads it, so a stale OpenCode login is context
# rather than a reason to re-authenticate Claude Code.
#
# Exit 2 means "could not determine" and is deliberately distinct from exit 1
# "credential rejected"; a rate-limited or unreachable endpoint must never be
# reported as a dead token.
#
# The usage endpoint is undocumented and discovered from @slkiser/opencode-quota.
# If it changes shape or disappears, degrade to exit 2, never to exit 1.
set -Eeuo pipefail

readonly PROGRAM_NAME=claude-token-check
readonly USAGE_URL="https://api.anthropic.com/api/oauth/usage"
readonly OAUTH_BETA_HEADER="oauth-2025-04-20"
readonly KEYCHAIN_SERVICE="Claude Code-credentials"
readonly CREDENTIAL_TIMEOUT_SECONDS=3
readonly REQUEST_TIMEOUT_SECONDS=10

readonly EXIT_VALID=0
readonly EXIT_INVALID=1
readonly EXIT_INDETERMINATE=2

debug_enabled=0

note() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
}

debug() {
  ((debug_enabled)) || return 0
  printf '%s: debug: %s\n' "$PROGRAM_NAME" "$*" >&2
}

usage() {
  cat <<'EOF'
usage: claude-token-check [--debug] [--help]

Reports whether the local Claude Code credential is still accepted by Anthropic.

Every OAuth credential found on this machine is probed and printed on its own
line. An OpenCode credential is reported for context only; the exit status
describes the Claude Code credential, because that is the one a `claude`
session uses.

  --debug   Print each credential source and a truncated fingerprint. Never
            prints token material.

Exit codes:
  0  Valid; the usage endpoint accepted the Claude Code credential.
  1  Invalid; run `claude auth login`.
  2  Indeterminate; no Claude Code credential found, or it could not be checked.
EOF
}

resolve_python() {
  if command -v python3 >/dev/null 2>&1; then
    printf 'python3\n'
    return 0
  fi
  if command -v python >/dev/null 2>&1 \
    && python -c 'import sys; raise SystemExit(sys.version_info[0] != 3)' >/dev/null 2>&1; then
    printf 'python\n'
    return 0
  fi
  return 1
}

# Reads `claude auth status --json` and echoes true, false, or unknown.
# Upstream treats the JSON field as authoritative and only falls back to the
# exit code, so this does the same.
local_auth_state() {
  local python_bin=$1 output

  command -v claude >/dev/null 2>&1 || {
    printf 'unknown\n'
    return 0
  }

  if ! output=$(claude auth status --json 2>/dev/null); then
    printf 'unknown\n'
    return 0
  fi

  printf '%s' "$output" | "$python_bin" -c '
import json, sys

try:
    payload = json.load(sys.stdin)
except Exception:
    print("unknown")
    sys.exit(0)

if not isinstance(payload, dict):
    print("unknown")
    sys.exit(0)

for key in ("authenticated", "isAuthenticated", "loggedIn"):
    value = payload.get(key)
    if isinstance(value, bool):
        print("true" if value else "false")
        sys.exit(0)

print("unknown")
' 2>/dev/null || printf 'unknown\n'
}

# Echoes one row per credential as "<classes>\t<label>\t<fingerprint>\t<token>".
#
# The Claude Code row is always present; an empty token there means no
# credential was found, which is a distinct outcome from one that was rejected.
# Claude Code reads the macOS Keychain, falling back to the credentials file
# elsewhere, so those two are one credential class and the first hit wins.
# OpenCode's auth.json is a separate class and gets its own row. When both hold
# the same token the row is merged so the endpoint is only asked once.
discover_credentials() {
  local python_bin=$1

  "$python_bin" - "$KEYCHAIN_SERVICE" "$CREDENTIAL_TIMEOUT_SECONDS" <<'PY'
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

keychain_service = sys.argv[1]
timeout_seconds = float(sys.argv[2])
home = Path(os.path.expanduser("~"))


def fingerprint(token):
    return hashlib.sha256(token.encode("utf-8")).hexdigest()[:12]


def token_from_object(value):
    """Accept the credential shapes the upstream plugin accepts."""
    if not isinstance(value, dict):
        return None
    for candidate in (value.get("claudeAiOauth"), value.get("oauth"), value):
        if not isinstance(candidate, dict):
            continue
        for key in ("accessToken", "access_token", "token"):
            token = candidate.get(key)
            if isinstance(token, str) and token.strip():
                return token.strip()
    return None


def opencode_data_dirs():
    dirs = []
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        dirs.append(Path(xdg) / "opencode")
    dirs.append(home / ".local" / "share" / "opencode")
    if sys.platform == "darwin":
        dirs.append(home / "Library" / "Application Support" / "opencode")
    return dirs


def find_opencode():
    for directory in opencode_data_dirs():
        try:
            payload = json.loads((directory / "auth.json").read_text("utf-8"))
        except Exception:
            continue
        entry = payload.get("anthropic") if isinstance(payload, dict) else None
        if not isinstance(entry, dict) or entry.get("type") != "oauth":
            continue
        token = entry.get("access")
        if not isinstance(token, str) or not token.strip():
            continue
        expires = entry.get("expires")
        if isinstance(expires, (int, float)) and expires <= time.time() * 1000:
            continue
        return token.strip()
    return None


def find_keychain():
    if sys.platform != "darwin":
        return None
    try:
        result = subprocess.run(
            ["security", "find-generic-password", "-s", keychain_service, "-w"],
            capture_output=True,
            text=True,
            timeout=timeout_seconds,
        )
    except Exception:
        return None
    if result.returncode != 0:
        return None
    payload = result.stdout.strip()
    if not payload:
        return None
    try:
        parsed = json.loads(payload)
    except ValueError:
        return payload
    if isinstance(parsed, str) and parsed.strip():
        return parsed.strip()
    return token_from_object(parsed)


def find_credentials_file():
    try:
        parsed = json.loads((home / ".claude" / ".credentials.json").read_text("utf-8"))
    except Exception:
        return None
    return token_from_object(parsed)


def usable(token):
    """Reject anything that would break the one-row-per-credential TSV."""
    return bool(token) and not any(char in token for char in "\t\r\n")


claude_detail = "keychain"
claude_token = find_keychain()
if not usable(claude_token):
    claude_detail = "credentials-file"
    claude_token = find_credentials_file()

opencode_token = find_opencode()

if not usable(claude_token):
    claude_token = None
if not usable(opencode_token):
    opencode_token = None

rows = []
if claude_token and claude_token == opencode_token:
    rows.append(
        (
            "claude-code,opencode",
            "claude-code ({}) + opencode".format(claude_detail),
            fingerprint(claude_token),
            claude_token,
        )
    )
else:
    if claude_token:
        rows.append(
            (
                "claude-code",
                "claude-code ({})".format(claude_detail),
                fingerprint(claude_token),
                claude_token,
            )
        )
    else:
        rows.append(("claude-code", "claude-code", "", ""))
    if opencode_token:
        rows.append(
            ("opencode", "opencode", fingerprint(opencode_token), opencode_token)
        )

for row in rows:
    sys.stdout.write("\t".join(row) + "\n")
PY
}

# Echoes the HTTP status, or 000 when the request never completed. The token is
# passed through a curl config on stdin so it never appears in the process list.
probe_usage_endpoint() {
  local token=$1 response

  command -v curl >/dev/null 2>&1 || {
    printf '000\n'
    return 0
  }

  response=$(
    printf 'url = "%s"\nheader = "Authorization: Bearer %s"\nheader = "anthropic-beta: %s"\n' \
      "$USAGE_URL" "$token" "$OAUTH_BETA_HEADER" \
      | curl --config - \
        --silent \
        --output /dev/null \
        --write-out '%{http_code}' \
        --connect-timeout "$REQUEST_TIMEOUT_SECONDS" \
        --max-time "$REQUEST_TIMEOUT_SECONDS" \
        2>/dev/null
  ) || response=""

  printf '%s\n' "${response:-000}"
}

# Echoes "<verdict>\t<message>" for one probed credential. The remediation
# command differs per class because re-authenticating one does not touch the
# other.
verdict_for() {
  local classes=$1 status=$2 login_command

  case ",${classes}," in
    *,claude-code,*) login_command='claude auth login' ;;
    *) login_command='opencode auth login' ;;
  esac

  case $status in
    absent)
      printf 'INDETERMINATE:\tno credential found.\n'
      ;;
    200)
      printf 'VALID:\taccepted by Anthropic.\n'
      ;;
    401 | 403)
      printf 'INVALID:\trejected (HTTP %s). Run `%s`.\n' "$status" "$login_command"
      ;;
    000)
      printf 'INDETERMINATE:\tno response from the usage endpoint.\n'
      ;;
    *)
      printf 'INDETERMINATE:\tusage endpoint returned HTTP %s.\n' "$status"
      ;;
  esac
}

# Where a missing Claude Code credential would have been found. Keychain
# discovery is macOS-only, so the hint has to match the platform.
claude_code_search_hint() {
  if [[ ${OSTYPE:-} == darwin* ]]; then
    printf "the Keychain service '%s' or ~/.claude/.credentials.json\n" "$KEYCHAIN_SERVICE"
  else
    printf '~/.claude/.credentials.json\n'
  fi
}

main() {
  local python_bin auth_state discovery

  while (($#)); do
    case $1 in
      --debug) debug_enabled=1 ;;
      -h | --help | help)
        usage
        return 0
        ;;
      *)
        note "unknown argument: $1"
        usage >&2
        return "$EXIT_INDETERMINATE"
        ;;
    esac
    shift
  done

  if ! python_bin=$(resolve_python); then
    note 'Python 3 was not found; cannot inspect credentials'
    return "$EXIT_INDETERMINATE"
  fi

  auth_state=$(local_auth_state "$python_bin")
  debug "local auth state: $auth_state"

  if [[ $auth_state == false ]]; then
    printf 'INVALID: Claude reports no active login. Run `claude auth login`.\n'
    return "$EXIT_INVALID"
  fi

  discovery=$(discover_credentials "$python_bin") || discovery=""

  local classes label fingerprint token http_status
  local -a row_classes=() row_labels=() row_status=()
  while IFS=$'\t' read -r classes label fingerprint token; do
    [[ -n ${classes:-} ]] || continue
    row_classes+=("$classes")
    row_labels+=("$label")
    if [[ -z ${token:-} ]]; then
      row_status+=(absent)
      continue
    fi
    debug "credential: $label (fingerprint ${fingerprint})"
    http_status=$(probe_usage_endpoint "$token")
    debug "usage endpoint status for $label: $http_status"
    row_status+=("$http_status")
  done <<<"$discovery"

  local total=${#row_classes[@]}
  if ((total == 0)); then
    note 'no usable OAuth credential found in OpenCode, the Keychain, or the credentials file'
    printf 'INDETERMINATE: no credential available to verify.\n'
    return "$EXIT_INDETERMINATE"
  fi

  local index verdict word message
  local -a row_words=() row_messages=()
  local word_width=0 label_width=0
  for ((index = 0; index < total; index++)); do
    verdict=$(verdict_for "${row_classes[$index]}" "${row_status[$index]}")
    word=${verdict%%$'\t'*}
    message=${verdict#*$'\t'}
    row_words+=("$word")
    row_messages+=("$message")
    # Only the Claude Code row can be absent; discovery omits the OpenCode row
    # entirely rather than emitting one with no token.
    case ${row_status[$index]} in
      absent) note "no Claude Code credential in $(claude_code_search_hint)" ;;
      200 | 401 | 403) ;;
      000) note "the usage endpoint could not be reached for ${row_labels[$index]}" ;;
      *) note "unexpected status for ${row_labels[$index]}: ${row_status[$index]}" ;;
    esac
    if ((${#word} > word_width)); then
      word_width=${#word}
    fi
    if ((${#row_labels[$index]} > label_width)); then
      label_width=${#row_labels[$index]}
    fi
  done

  local exit_code="$EXIT_INDETERMINATE"
  for ((index = 0; index < total; index++)); do
    printf '%-*s %-*s  %s\n' \
      "$word_width" "${row_words[$index]}" \
      "$label_width" "${row_labels[$index]}" \
      "${row_messages[$index]}"

    case ",${row_classes[$index]}," in
      *,claude-code,*)
        case ${row_status[$index]} in
          200) exit_code="$EXIT_VALID" ;;
          401 | 403) exit_code="$EXIT_INVALID" ;;
          *) exit_code="$EXIT_INDETERMINATE" ;;
        esac
        ;;
    esac
  done

  return "$exit_code"
}

main "$@"
