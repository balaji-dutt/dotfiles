{{- if ne .chezmoi.os "windows" -}}
{{- /* not Windows: do nothing */ -}}
{{- else -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$Dest = "{{ .chezmoi.destDir }}"

function Remove-RelPath {
  param([Parameter(Mandatory=$true)][string]$Rel)

  if ([string]::IsNullOrWhiteSpace($Rel)) { return }

  # Safety checks
  if ([IO.Path]::IsPathRooted($Rel)) {
    throw "Refusing rooted path: $Rel"
  }
  if ($Rel -match '(^|[\\/])\.\.([\\/]|$)') {
    throw "Refusing traversal path: $Rel"
  }

  $Abs = Join-Path -Path $Dest -ChildPath $Rel

  if (Test-Path -LiteralPath $Abs) {
    if ($env:CHEZMOI_WRONG_APPLY_DRYRUN -eq '1') {
      Write-Host "[dry-run] would remove: $Abs"
    } else {
      Write-Host "removing: $Abs"
      Remove-Item -LiteralPath $Abs -Recurse -Force -ErrorAction SilentlyContinue
    }
  }
}

# WARNING: keep this list curated; these are TARGET-relative paths under your Windows destDir.
$RepoMetadata = @(
  "ansible",
  "assets",
  "archive",
  "configs",
  "docs",
  "brewfile.txt",
  "bootstrap-wsl.sh",
  ".local\config\gitignore_global.txt",
  ".ansible.cfg",
  "README.md",
  "TODO.md",
  "AGENTS.md",
  "CLAUDE.md",
  "Documents\development\container-dotfiles\dotfiles\configs",
  ".claude-code-router",
  "bin\ccr_launcher.sh",
  "Library\LaunchAgents\com.user.ccr.plist",
  # Legacy singular OpenCode path; keep to clean stale pre-rename applies.
  ".config\opencode\command"
)

$PlatformCleanup = @(
  # If bin/code should never be in native Windows home:
  "bin\code",
  "bin\macos_ssh_agent_relay.sh",
  "Library\LaunchAgents\com.user.ssh-agent-relay.plist",

  # macOS/Linux leftovers that should not exist on Windows:
  ".config\direnv",
  ".config\lazygit",
  ".config\mise",
  ".config\sublime-merge",
  ".config\doom",
  "Library",
  ".zpreztorc",
  "bin\vnc_monitor.sh"

  # Optional: if you ever accidentally wrote container-dotfiles into Windows home and want it gone:
  # "Documents\development\container-dotfiles"
)

foreach ($p in $RepoMetadata)     { Remove-RelPath $p }
foreach ($p in $PlatformCleanup)  { Remove-RelPath $p }
{{- end -}}
