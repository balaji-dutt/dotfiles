{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
set -euo pipefail

# configs/host-ai-plugin-refresh.jsonc hash: {{ include "configs/host-ai-plugin-refresh.jsonc" | sha256sum }}

config_path={{ printf "%s/configs/host-ai-plugin-refresh.jsonc" .chezmoi.sourceDir | quote }}
# Read at runtime rather than via `include` so this script's text - and therefore
# the onchange trigger above - stays keyed to the manifest alone. Including
# settings-base.json here would re-run the whole refresh, package-cache removal
# included, on every unrelated settings edit.
settings_path={{ printf "%s/dot_claude/settings-base.json" .chezmoi.sourceDir | quote }}

if ! command -v python3 >/dev/null 2>&1; then
  echo "INFO: python3 command not found; skipping host AI plugin refresh."
  exit 0
fi

python3 - "$config_path" "$settings_path" <<'PY'
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
settings_path = Path(sys.argv[2])
SCHEMA_REF = "./schemas/host-ai-plugin-refresh.v1.schema.json"
dry_run = bool(os.environ.get("HOST_AI_PLUGIN_REFRESH_DRY_RUN"))
# Claude plugin problems are reported per plugin and re-raised as a non-zero
# exit at the end, so one bad plugin does not skip the remaining plugins or the
# OpenCode cache refresh.
claude_failures = []


def strip_jsonc(text):
    result = []
    index = 0
    in_string = False
    escaped = False
    while index < len(text):
        char = text[index]
        next_char = text[index + 1] if index + 1 < len(text) else ""

        if in_string:
            result.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
            continue

        if char == '"':
            in_string = True
            result.append(char)
            index += 1
            continue

        if char == "/" and next_char == "/":
            index += 2
            while index < len(text) and text[index] not in "\r\n":
                index += 1
            continue

        if char == "/" and next_char == "*":
            index += 2
            while index + 1 < len(text) and not (
                text[index] == "*" and text[index + 1] == "/"
            ):
                index += 1
            index += 2
            continue

        result.append(char)
        index += 1

    return "".join(result)


def run_checked(command, env=None):
    return subprocess.run(
        command,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        env=env,
    )


def run_capture(command):
    # Keeps stderr out of stdout so machine-readable output stays parseable;
    # run_checked merges the two and would corrupt JSON with any CLI warning.
    # Discarded rather than piped, matching the PowerShell port's `2>$null`.
    return subprocess.run(
        command,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )


def run_claude_checked(arguments):
    environment = os.environ.copy()
    environment["CLAUDE_CODE_PLUGIN_KEEP_MARKETPLACE_ON_FAILURE"] = "1"
    return run_checked(["claude", *arguments], env=environment)


def command_exists(command):
    return shutil.which(command) is not None


def require_object(value, name):
    if not isinstance(value, dict):
        print(f"ERROR: {name} must be an object.")
        sys.exit(1)
    return value


def require_list(value, name):
    if not isinstance(value, list):
        print(f"ERROR: {name} must be a list.")
        sys.exit(1)
    return value


def claude_plugin_identity(plugin_id):
    plugin_name, separator, marketplace = plugin_id.rpartition("@")
    if not separator or not plugin_name or not marketplace:
        raise ValueError(
            "Claude plugin id must use the canonical "
            f"'<plugin>@<marketplace>' form: {plugin_id}"
        )
    return plugin_name, marketplace


def load_manifest():
    try:
        text = config_path.read_text(encoding="utf-8")
    except FileNotFoundError:
        print(f"ERROR: Host AI plugin refresh config not found: {config_path}")
        sys.exit(1)

    try:
        manifest = json.loads(strip_jsonc(text))
    except json.JSONDecodeError as exc:
        print(f"ERROR: Invalid host AI plugin refresh JSONC: {exc}")
        sys.exit(1)
    if not isinstance(manifest, dict):
        print("ERROR: Host AI plugin refresh config root must be an object.")
        sys.exit(1)
    if manifest.get("$schema") != SCHEMA_REF:
        print(f"ERROR: Host AI plugin refresh $schema must be {SCHEMA_REF!r}.")
        sys.exit(1)
    if manifest.get("schema_version") != 1:
        print("ERROR: Host AI plugin refresh schema_version must be 1.")
        sys.exit(1)
    return manifest


def claude_plugins(manifest):
    claude = require_object(manifest.get("claude", {}), "claude")
    plugins = require_list(claude.get("plugins", []), "claude.plugins")
    parsed = []
    for index, plugin in enumerate(plugins, start=1):
        plugin = require_object(plugin, f"claude.plugins[{index}]")
        plugin_id = plugin.get("id")
        scope = plugin.get("scope", "user")
        enabled = plugin.get("enabled", True)
        if not isinstance(plugin_id, str) or not plugin_id.strip():
            print(f"ERROR: claude.plugins[{index}].id must be a non-empty string.")
            sys.exit(1)
        if not isinstance(scope, str) or not scope.strip():
            print(f"ERROR: claude.plugins[{index}].scope must be a non-empty string.")
            sys.exit(1)
        if not isinstance(enabled, bool):
            print(f"ERROR: claude.plugins[{index}].enabled must be a boolean.")
            sys.exit(1)
        if enabled:
            try:
                plugin_name, marketplace = claude_plugin_identity(plugin_id)
            except ValueError as exc:
                print(f"ERROR: {exc}")
                sys.exit(1)
            parsed.append(
                {
                    "id": plugin_id,
                    "name": plugin_name,
                    "marketplace": marketplace,
                    "scope": scope,
                }
            )
    return parsed


def load_enabled_plugins():
    try:
        text = settings_path.read_text(encoding="utf-8")
    except FileNotFoundError:
        print(f"ERROR: Claude settings base not found: {settings_path}")
        sys.exit(1)

    try:
        settings = json.loads(text)
    except json.JSONDecodeError as exc:
        print(f"ERROR: Invalid Claude settings base JSON: {exc}")
        sys.exit(1)

    settings = require_object(settings, "settings-base.json")
    return require_object(
        settings.get("enabledPlugins", {}), "settings-base.json enabledPlugins"
    )


def validate_claude_enablement(manifest, plugins):
    # The plugin id is duplicated across the refresh manifest and the settings
    # base that actually enables it. Nothing else cross-checks the pair, so a
    # rename in one file used to surface only as an opaque `claude plugin
    # update` failure part-way through the refresh.
    claude = require_object(manifest.get("claude", {}), "claude")
    manifest_ids = {
        entry.get("id")
        for entry in require_list(claude.get("plugins", []), "claude.plugins")
    }
    enabled_ids = {plugin["id"] for plugin in plugins}
    settings_ids = {
        plugin_id
        for plugin_id, value in load_enabled_plugins().items()
        if value is True
    }

    problems = []
    for plugin_id in sorted(enabled_ids - settings_ids):
        problems.append(
            f"ERROR: Claude plugin {plugin_id!r} is enabled in {config_path} "
            f"but not enabled in {settings_path}."
        )
    for plugin_id in sorted(settings_ids - manifest_ids):
        problems.append(
            f"ERROR: Claude plugin {plugin_id!r} is enabled in {settings_path} "
            f"but absent from {config_path}."
        )

    if problems:
        for problem in problems:
            print(problem)
        print(
            "ERROR: Claude plugin ids must match between the refresh manifest "
            "and the settings base. Reconcile both files and re-apply."
        )
        sys.exit(1)


def opencode_plugins(manifest):
    opencode = require_object(manifest.get("opencode", {}), "opencode")
    plugins = require_list(opencode.get("plugins", []), "opencode.plugins")
    parsed = []
    for index, plugin in enumerate(plugins, start=1):
        plugin = require_object(plugin, f"opencode.plugins[{index}]")
        package = plugin.get("package")
        enabled = plugin.get("enabled", True)
        if not isinstance(package, str) or not package.strip():
            print(f"ERROR: opencode.plugins[{index}].package must be a non-empty string.")
            sys.exit(1)
        if not isinstance(enabled, bool):
            print(f"ERROR: opencode.plugins[{index}].enabled must be a boolean.")
            sys.exit(1)
        if not enabled:
            continue

        cache_install = plugin.get("cacheInstall")
        parsed_install = None
        if cache_install is not None:
            cache_install = require_object(
                cache_install, f"opencode.plugins[{index}].cacheInstall"
            )
            version = plugin.get("version")
            if not isinstance(version, str) or not version.strip():
                print(
                    f"ERROR: opencode.plugins[{index}].version must be a "
                    "non-empty string when cacheInstall is configured."
                )
                sys.exit(1)
            legacy_peer_deps = cache_install.get("legacyPeerDeps", False)
            ignore_scripts = cache_install.get("ignoreScripts", True)
            if not isinstance(legacy_peer_deps, bool):
                print(
                    f"ERROR: opencode.plugins[{index}].cacheInstall."
                    "legacyPeerDeps must be a boolean."
                )
                sys.exit(1)
            if not isinstance(ignore_scripts, bool):
                print(
                    f"ERROR: opencode.plugins[{index}].cacheInstall."
                    "ignoreScripts must be a boolean."
                )
                sys.exit(1)

            dependencies = require_list(
                cache_install.get("dependencies", []),
                f"opencode.plugins[{index}].cacheInstall.dependencies",
            )
            parsed_dependencies = []
            for dependency_index, dependency in enumerate(dependencies, start=1):
                dependency = require_object(
                    dependency,
                    f"opencode.plugins[{index}].cacheInstall.dependencies"
                    f"[{dependency_index}]",
                )
                dependency_package = dependency.get("package")
                dependency_version = dependency.get("version")
                if not isinstance(dependency_package, str) or not dependency_package.strip():
                    print(
                        f"ERROR: opencode.plugins[{index}].cacheInstall.dependencies"
                        f"[{dependency_index}].package must be a non-empty string."
                    )
                    sys.exit(1)
                if not isinstance(dependency_version, str) or not dependency_version.strip():
                    print(
                        f"ERROR: opencode.plugins[{index}].cacheInstall.dependencies"
                        f"[{dependency_index}].version must be a non-empty string."
                    )
                    sys.exit(1)
                parsed_dependencies.append(
                    {"package": dependency_package, "version": dependency_version}
                )

            parsed_install = {
                "legacyPeerDeps": legacy_peer_deps,
                "ignoreScripts": ignore_scripts,
                "dependencies": parsed_dependencies,
            }

        parsed.append(
            {
                "package": package,
                "version": plugin.get("version"),
                "cacheInstall": parsed_install,
            }
        )
    return parsed


def installed_claude_plugin_ids():
    # `claude plugin update` only accepts ids that already have an install
    # record, so the refresh has to know which manifest entries are missing
    # before it picks a subcommand. Returns None when the installed set cannot
    # be determined, which callers treat as "try both".
    result = run_capture(["claude", "plugin", "list", "--json"])
    if result.returncode != 0:
        return None

    try:
        parsed = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None

    if not isinstance(parsed, list):
        return None

    return {
        entry["id"]
        for entry in parsed
        if isinstance(entry, dict)
        and isinstance(entry.get("id"), str)
        and entry["id"].strip()
    }


def claude_plugin_actions(plugin, installed_ids):
    if installed_ids is None:
        # Unknown or stale install state: update first so an installed plugin
        # is not reinstalled, then fall back when Claude rejects the record.
        return ["update", "install"]
    if plugin["id"] in installed_ids:
        return ["update", "install"]
    return ["install"]


def claude_plugin_update_missing(result):
    return bool(
        re.search(r'Plugin\s+"[^"]+"\s+not found', result.stdout, re.IGNORECASE)
    )


def add_claude_failure(failure):
    if failure not in claude_failures:
        claude_failures.append(failure)


def claude_marketplace_names(plugins):
    names = []
    for plugin in plugins:
        if plugin["marketplace"] not in names:
            names.append(plugin["marketplace"])
    return names


def claude_marketplace_inventory():
    result = run_capture(["claude", "plugin", "marketplace", "list", "--json"])
    if result.returncode != 0:
        return None, (
            "claude plugin marketplace list --json exited "
            f"{result.returncode}"
        )
    try:
        records = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        return None, f"invalid marketplace list JSON: {exc}"
    if not isinstance(records, list):
        return None, "marketplace list JSON must be an array"
    return records, None


def validate_claude_marketplace_catalog(marketplace, plugins, records):
    matches = [
        record
        for record in records
        if isinstance(record, dict) and record.get("name") == marketplace
    ]
    if len(matches) != 1:
        return {
            "available": False,
            "error": f"expected one marketplace registration, found {len(matches)}",
            "catalog_path": None,
        }

    install_location = matches[0].get("installLocation")
    if not isinstance(install_location, str) or not install_location.strip():
        return {
            "available": False,
            "error": "installLocation must be a non-empty absolute path",
            "catalog_path": None,
        }
    install_path = Path(install_location)
    if not install_path.is_absolute():
        return {
            "available": False,
            "error": "installLocation must be a non-empty absolute path",
            "catalog_path": None,
        }

    catalog_path = install_path / ".claude-plugin" / "marketplace.json"
    if not catalog_path.is_file():
        return {
            "available": False,
            "error": f"catalog is missing: {catalog_path}",
            "catalog_path": catalog_path,
        }
    try:
        catalog = json.loads(catalog_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "available": False,
            "error": f"catalog JSON is invalid: {exc}",
            "catalog_path": catalog_path,
        }
    entries = catalog.get("plugins") if isinstance(catalog, dict) else None
    if not isinstance(entries, list):
        return {
            "available": False,
            "error": "catalog plugins must be an array",
            "catalog_path": catalog_path,
        }
    catalog_names = {
        entry.get("name")
        for entry in entries
        if isinstance(entry, dict) and isinstance(entry.get("name"), str)
    }
    missing = [plugin["name"] for plugin in plugins if plugin["name"] not in catalog_names]
    if missing:
        return {
            "available": False,
            "error": "catalog does not publish: " + ", ".join(missing),
            "catalog_path": catalog_path,
        }
    return {"available": True, "error": None, "catalog_path": catalog_path}


def sync_claude_plugin(plugin, actions):
    verb = "Refreshing"
    if len(actions) == 1:
        verb = "Updating" if actions[0] == "update" else "Installing"
    print(f"INFO: {verb} Claude Code plugin {plugin['id']!r}.")

    attempts = []
    for action in actions:
        arguments = [
            "plugin",
            action,
            "--scope",
            plugin["scope"],
            plugin["id"],
        ]
        result = run_claude_checked(arguments)
        if result.returncode == 0:
            return True
        attempts.append((action, result))
        if (
            action == "update"
            and "install" in actions
            and not claude_plugin_update_missing(result)
        ):
            break

    # Only surfaced once every action failed, so the expected "not installed"
    # noise from a probing update stays hidden when the install then succeeds.
    for action, result in attempts:
        print(f"ERROR: Failed to {action} Claude Code plugin {plugin['id']!r}.")
        if result.stdout.strip():
            print(result.stdout.rstrip())
    return False


def refresh_claude(plugins):
    if not plugins:
        print("INFO: No Claude Code plugins configured for refresh.")
        return
    if not command_exists("claude"):
        print("INFO: claude command not found; skipping Claude Code plugin refresh.")
        return

    marketplace_names = claude_marketplace_names(plugins)
    if dry_run:
        for marketplace in marketplace_names:
            print(
                "INFO: Would run: claude plugin marketplace update "
                f"{marketplace}"
            )
    else:
        for marketplace in marketplace_names:
            print(f"INFO: Updating Claude Code plugin marketplace {marketplace!r}.")
            result = run_claude_checked(
                ["plugin", "marketplace", "update", marketplace]
            )
            if result.returncode != 0:
                print(
                    "ERROR: Failed to update Claude Code plugin marketplace "
                    f"{marketplace!r}."
                )
                if result.stdout.strip():
                    print(result.stdout.rstrip())
                # A preserved catalog may still satisfy plugin operations, but
                # retry because this refresh did not reach the remote source.
                add_claude_failure(f"marketplace:{marketplace}")

    marketplace_available = {}
    if not dry_run:
        records, inventory_error = claude_marketplace_inventory()
        if inventory_error:
            print(
                "ERROR: Could not validate Claude Code marketplace catalogs: "
                f"{inventory_error}"
            )
        for marketplace in marketplace_names:
            marketplace_plugins = [
                plugin
                for plugin in plugins
                if plugin["marketplace"] == marketplace
            ]
            catalog = (
                validate_claude_marketplace_catalog(
                    marketplace, marketplace_plugins, records
                )
                if not inventory_error
                else {
                    "available": False,
                    "error": inventory_error,
                    "catalog_path": None,
                }
            )
            marketplace_available[marketplace] = catalog["available"]
            if catalog["available"]:
                print(
                    "INFO: Validated Claude Code plugin marketplace "
                    f"{marketplace!r}: {catalog['catalog_path']}"
                )
            else:
                print(
                    "ERROR: Claude Code plugin marketplace "
                    f"{marketplace!r} is unavailable: {catalog['error']}"
                )
                add_claude_failure(f"marketplace:{marketplace}")

    installed_ids = installed_claude_plugin_ids()
    if installed_ids is None:
        print(
            "INFO: Could not read installed Claude plugins; falling back to "
            "update-then-install."
        )

    for plugin in plugins:
        actions = claude_plugin_actions(plugin, installed_ids)
        if dry_run:
            for action in actions:
                print(
                    "INFO: Would run: claude plugin "
                    f"{action} --scope {plugin['scope']} {plugin['id']}"
                )
            continue

        if not marketplace_available[plugin["marketplace"]]:
            print(
                f"ERROR: Skipping Claude Code plugin {plugin['id']!r} because "
                f"marketplace {plugin['marketplace']!r} is unavailable."
            )
            continue

        if not sync_claude_plugin(plugin, actions):
            add_claude_failure(plugin["id"])

    print("INFO: Restart Claude Code to use refreshed plugins.")


def opencode_cache_root():
    fallback = Path.home() / ".cache" / "opencode"
    if command_exists("opencode"):
        result = run_checked(["opencode", "debug", "paths"])
        if result.returncode == 0:
            for line in result.stdout.splitlines():
                parts = line.split(maxsplit=1)
                if len(parts) == 2 and parts[0] == "cache" and parts[1].strip():
                    return Path(parts[1].strip()).expanduser()
        elif result.stdout.strip():
            print("INFO: Could not read OpenCode debug paths; using default cache path.")
            print(result.stdout.rstrip())
    else:
        print("INFO: opencode command not found; using default OpenCode cache path.")
    return fallback


OPENCODE_PROCESS_NAMES = {"opencode", "opencode.exe"}
NO_TTY_VALUES = {"", "?", "??", "-", "none"}


def basename(value):
    return Path(value).name.lower()


def is_opencode_process(args, comm=""):
    if args and basename(args[0]) in OPENCODE_PROCESS_NAMES:
        return True
    return comm.lower() in OPENCODE_PROCESS_NAMES


def read_proc_status(proc_dir):
    name = ""
    state = ""
    try:
        for line in (proc_dir / "status").read_text(encoding="utf-8").splitlines():
            if line.startswith("Name:"):
                name = line.split(":", 1)[1].strip()
            elif line.startswith("State:"):
                value = line.split(":", 1)[1].strip()
                state = value[:1]
    except (OSError, UnicodeDecodeError):
        pass
    return name, state


def read_proc_tty_nr(proc_dir):
    try:
        stat_text = (proc_dir / "stat").read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None
    close_paren = stat_text.rfind(")")
    if close_paren == -1:
        return None
    fields = stat_text[close_paren + 2 :].split()
    if len(fields) < 5:
        return None
    try:
        return int(fields[4])
    except ValueError:
        return None


def read_proc_cwd(proc_dir):
    try:
        return os.readlink(proc_dir / "cwd")
    except OSError:
        return ""


def classify_opencode_process(pid, stat, tty, command, cwd=""):
    stat = stat or ""
    tty = tty or ""
    if "Z" in stat.upper():
        reason = "zombie"
        blocking = False
    elif tty in NO_TTY_VALUES:
        reason = "detached"
        blocking = False
    else:
        reason = "blocking"
        blocking = True
    return {
        "pid": str(pid),
        "stat": stat or "unknown",
        "tty": tty or "unknown",
        "command": command or "opencode",
        "cwd": cwd,
        "reason": reason,
        "blocking": blocking,
    }


def proc_opencode_processes():
    proc_root = Path("/proc")
    current_pid = os.getpid()
    processes = []
    for proc_dir in proc_root.iterdir():
        if not proc_dir.name.isdigit() or int(proc_dir.name) == current_pid:
            continue
        try:
            raw_cmdline = (proc_dir / "cmdline").read_bytes()
        except OSError:
            continue
        args = [arg.decode("utf-8", "ignore") for arg in raw_cmdline.split(b"\0") if arg]
        comm, state = read_proc_status(proc_dir)
        if not is_opencode_process(args, comm):
            continue
        tty_nr = read_proc_tty_nr(proc_dir)
        tty = "none" if tty_nr == 0 else f"tty_nr={tty_nr}" if tty_nr is not None else "unknown"
        command = " ".join(args) if args else comm
        processes.append(classify_opencode_process(proc_dir.name, state, tty, command, read_proc_cwd(proc_dir)))
    return processes


def lsof_cwd(pid):
    if not command_exists("lsof"):
        return ""
    result = run_checked(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"])
    if result.returncode != 0:
        return ""
    for line in result.stdout.splitlines():
        if line.startswith("n"):
            return line[1:]
    return ""


def ps_opencode_processes():
    if not command_exists("ps"):
        print("INFO: Could not determine OpenCode process details; ps command not found.")
        return []
    result = run_checked(["ps", "-axo", "pid=,stat=,tty=,args=", "-ww"])
    if result.returncode != 0:
        print("INFO: Could not determine OpenCode process details from ps output.")
        if result.stdout.strip():
            print(result.stdout.rstrip())
        return []

    current_pid = str(os.getpid())
    processes = []
    for line in result.stdout.splitlines():
        parts = line.strip().split(None, 3)
        if len(parts) != 4:
            continue
        pid, stat, tty, command = parts
        if pid == current_pid:
            continue
        args = command.split()
        if not is_opencode_process(args):
            continue
        processes.append(classify_opencode_process(pid, stat, tty, command, lsof_cwd(pid)))
    return processes


def opencode_processes():
    proc_root = Path("/proc")
    if proc_root.is_dir():
        return proc_opencode_processes()
    return ps_opencode_processes()


def opencode_process_detail(process):
    parts = [
        f"pid={process['pid']}",
        f"stat={process['stat']}",
        f"tty={process['tty']}",
    ]
    if process["cwd"]:
        parts.append(f"cwd={process['cwd']}")
    parts.append(f"command={process['command']}")
    return " ".join(parts)


def log_opencode_processes(processes):
    if not processes:
        print("INFO: No OpenCode processes detected.")
        return
    for process in processes:
        if process["blocking"]:
            print("INFO: Blocking OpenCode process: " + opencode_process_detail(process))
        else:
            print(
                f"INFO: Ignoring {process['reason']} OpenCode process: "
                + opencode_process_detail(process)
            )


def detect_cached_versions(packages_dir, package_names):
    detections = []
    missing = []
    for package_name in package_names:
        package_path = Path(*package_name.split("/"))
        pattern = f"**/node_modules/{package_path.as_posix()}/package.json"
        matches = sorted(packages_dir.glob(pattern)) if packages_dir.is_dir() else []
        if not matches:
            missing.append(package_name)
            continue
        seen = set()
        for package_json in matches:
            try:
                data = json.loads(package_json.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as exc:
                print(f"INFO: Could not read cached package metadata {package_json}: {exc}")
                continue
            name = data.get("name", package_name)
            version = data.get("version", "unknown")
            key = (name, version)
            if key not in seen:
                detections.append((name, version, package_json))
                seen.add(key)
    return detections, missing


def cache_package_dir(packages_dir, package_name, version):
    parts = package_name.split("/")
    parts[-1] = f"{parts[-1]}@{version}"
    return packages_dir.joinpath(*parts)


def installed_package_version(install_dir, package_name):
    package_json = install_dir / "node_modules" / Path(*package_name.split("/")) / "package.json"
    try:
        data = json.loads(package_json.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return data.get("version")


def cache_install_satisfied(install_dir, plugin):
    if installed_package_version(install_dir, plugin["package"]) != plugin["version"]:
        return False
    for dependency in plugin["cacheInstall"]["dependencies"]:
        if (
            installed_package_version(install_dir, dependency["package"])
            != dependency["version"]
        ):
            return False
    return True


def install_opencode_cache_plugin(
    packages_dir, plugin, running, cache_will_be_removed
):
    install = plugin["cacheInstall"]
    target_dir = cache_package_dir(
        packages_dir, plugin["package"], plugin["version"]
    )
    if not (dry_run and cache_will_be_removed) and cache_install_satisfied(
        target_dir, plugin
    ):
        print(
            f"INFO: OpenCode cache install already satisfied for "
            f"{plugin['package']}@{plugin['version']}: {target_dir}"
        )
        return

    if target_dir.exists() and running:
        print(
            "ERROR: OpenCode is running and the existing compatibility cache "
            f"is incomplete: {target_dir}"
        )
        print("ERROR: Exit OpenCode and apply the dotfiles again to replace it safely.")
        sys.exit(1)

    if not command_exists("npm"):
        print(
            "ERROR: npm is required for the configured OpenCode cache install "
            f"{plugin['package']}@{plugin['version']}."
        )
        sys.exit(1)

    staging_dir = target_dir.parent / f".{target_dir.name}.installing-{os.getpid()}"
    package_specs = [f"{plugin['package']}@{plugin['version']}"] + [
        f"{dependency['package']}@{dependency['version']}"
        for dependency in install["dependencies"]
    ]
    command = ["npm", "install", "--prefix", str(staging_dir)]
    if install["ignoreScripts"]:
        command.append("--ignore-scripts")
    if install["legacyPeerDeps"]:
        command.append("--legacy-peer-deps")
    command.extend(package_specs)

    if dry_run:
        print("INFO: Would stage OpenCode compatibility cache: " + shlex.join(command))
        print(f"INFO: Would publish OpenCode compatibility cache: {target_dir}")
        return

    target_dir.parent.mkdir(parents=True, exist_ok=True)
    if staging_dir.exists():
        shutil.rmtree(staging_dir)
    print(
        f"INFO: Staging OpenCode compatibility cache for "
        f"{plugin['package']}@{plugin['version']}."
    )
    result = run_checked(command)
    if result.returncode != 0:
        shutil.rmtree(staging_dir, ignore_errors=True)
        print(
            f"ERROR: Failed to install OpenCode compatibility cache for "
            f"{plugin['package']}@{plugin['version']}."
        )
        if result.stdout.strip():
            print(result.stdout.rstrip())
        sys.exit(result.returncode)

    if not cache_install_satisfied(staging_dir, plugin):
        shutil.rmtree(staging_dir, ignore_errors=True)
        print(
            f"ERROR: Staged OpenCode compatibility cache failed version "
            f"validation for {plugin['package']}@{plugin['version']}."
        )
        sys.exit(1)

    if target_dir.exists() and running:
        if cache_install_satisfied(target_dir, plugin):
            shutil.rmtree(staging_dir, ignore_errors=True)
            print(
                "INFO: OpenCode populated the compatibility cache during "
                f"installation; keeping: {target_dir}"
            )
            return
        shutil.rmtree(staging_dir, ignore_errors=True)
        print(
            "ERROR: OpenCode populated an incomplete compatibility cache "
            f"during installation: {target_dir}"
        )
        print("ERROR: Exit OpenCode and apply the dotfiles again to replace it safely.")
        sys.exit(1)
    if target_dir.exists():
        shutil.rmtree(target_dir)
    staging_dir.replace(target_dir)
    print(f"INFO: Published OpenCode compatibility cache: {target_dir}")


def refresh_opencode(plugins):
    cache_root = opencode_cache_root()
    packages_dir = cache_root / "packages"
    package_names = [plugin["package"] for plugin in plugins]
    processes = opencode_processes()
    running = any(process["blocking"] for process in processes)
    cache_will_be_removed = not running and packages_dir.exists()

    print(f"INFO: OpenCode cache root: {cache_root}")
    print(f"INFO: OpenCode packages cache exists: {'yes' if packages_dir.is_dir() else 'no'}")
    print(f"INFO: OpenCode blocking session: {'yes' if running else 'no'}")
    log_opencode_processes(processes)

    detections, missing = detect_cached_versions(packages_dir, package_names)
    if detections:
        print("INFO: Detected cached OpenCode plugin versions:")
        for name, version, package_json in detections:
            print(f"INFO:   {name}@{version} ({package_json})")
    else:
        print("INFO: No cached OpenCode plugin package versions detected.")
    for package_name in missing:
        print(f"INFO: No cached OpenCode package metadata found for {package_name!r}.")

    if running:
        print("INFO: OpenCode blocking session detected; not removing package cache.")
    elif not packages_dir.exists():
        print("INFO: OpenCode packages cache is absent; nothing to remove.")
    elif dry_run:
        print(f"INFO: Would remove OpenCode packages cache: {packages_dir}")
    else:
        print(f"INFO: Removing OpenCode packages cache: {packages_dir}")
        shutil.rmtree(packages_dir)

    for plugin in plugins:
        if plugin["cacheInstall"] is not None:
            install_opencode_cache_plugin(
                packages_dir, plugin, running, cache_will_be_removed
            )

    print("INFO: Launch or restart OpenCode to repopulate the plugin cache.")


def main():
    manifest = require_object(load_manifest(), "manifest")
    claude_enabled = claude_plugins(manifest)
    validate_claude_enablement(manifest, claude_enabled)
    refresh_claude(claude_enabled)
    refresh_opencode(opencode_plugins(manifest))

    if claude_failures:
        print(
            "ERROR: One or more Claude Code plugin refreshes failed: "
            + ", ".join(sorted(claude_failures))
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
