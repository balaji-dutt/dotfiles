{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

{{- $promptfooPackage := joinPath .chezmoi.sourceDir "configs/promptfoo-runtime/package.json" }}
# package.json hash: {{ include $promptfooPackage | sha256sum }}
{{- $promptfooLock := joinPath .chezmoi.sourceDir "configs/promptfoo-runtime/package-lock.json" }}
# package-lock.json hash: {{ include $promptfooLock | sha256sum }}

set -euo pipefail

runtime_dir="$HOME/.local/share/promptfoo-runtime"
command mkdir -p -- "$runtime_dir"
command cp -f -- "{{ .chezmoi.sourceDir }}/configs/promptfoo-runtime/package.json" \
    "$runtime_dir/package.json"
command cp -f -- "{{ .chezmoi.sourceDir }}/configs/promptfoo-runtime/package-lock.json" \
    "$runtime_dir/package-lock.json"

(
    cd "$runtime_dir"
    mise exec -- npm ci
)

(
    cd "$runtime_dir"
    mise exec -- node --input-type=module <<'NODE'
for (const packageName of [
  'promptfoo',
  '@opencode-ai/sdk',
  '@anthropic-ai/claude-agent-sdk',
  '@anthropic-ai/sdk',
]) {
  import.meta.resolve(packageName);
}
NODE
)

mise exec -- "$runtime_dir/node_modules/.bin/promptfoo" --version
echo "Promptfoo runtime and provider SDKs are ready."
{{- end }}
