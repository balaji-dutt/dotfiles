{{- if ne .chezmoi.os "windows" -}}
{{- /* not Windows: do nothing */ -}}
{{- else -}}
$ErrorActionPreference = "Stop"

{{ $data := (get . "data" | default dict) }}
{{ $windows := (get $data "windows" | default dict) }}
{{ $powershellDirOverride := (get $windows "powershell_dir" | default "") }}

$SourceDir = "{{ .chezmoi.sourceDir }}"
$documentsDir = [Environment]::GetFolderPath("MyDocuments")
$powershellDir = Join-Path $documentsDir "PowerShell"

if ("{{ $powershellDirOverride }}") {
  $powershellDir = "{{ $powershellDirOverride }}"
}

$Mappings = @(
  @{
    Src = Join-Path $SourceDir "private_Documents\development\vscode-workspace"
    Dst = "F:\Balaji\Development\vscode-workspace"
  },
  @{
    Src = Join-Path $SourceDir "private_Documents\PowerShell"
    Dst = $powershellDir
  }
)

function Convert-Component([string]$name) {
  if ($name.StartsWith("dot_"))        { return "." + $name.Substring(4) }
  if ($name.StartsWith("private_"))    { return $name.Substring(8) }
  if ($name.StartsWith("readonly_"))   { return $name.Substring(9) }
  if ($name.StartsWith("executable_")) { return $name.Substring(11) }
  return $name
}

function Convert-RelativePath([string]$rel) {
  $parts = $rel -split "[/\\]"
  ($parts | ForEach-Object { Convert-Component $_ }) -join "\"
}

function Ensure-Dir([string]$path) {
  if (-not (Test-Path -LiteralPath $path)) {
    New-Item -ItemType Directory -Force -Path $path | Out-Null
  }
}

function Ensure-ParentDir([string]$path) {
  $parent = Split-Path -Parent $path
  if ($parent) { Ensure-Dir $parent }
}

function Render-Or-CopyFile([string]$srcFile, [string]$dstFile) {
  Ensure-ParentDir $dstFile

  if ($srcFile.EndsWith(".tmpl")) {
    # Render template. PowerShell captures stdout as an array of lines.
    $lines = & chezmoi execute-template --file $srcFile
    $text  = ($lines -join "`n")

    # Strip .tmpl extension
    $dstFileNoTmpl = $dstFile.Substring(0, $dstFile.Length - 5)
    Ensure-ParentDir $dstFileNoTmpl

    # Write UTF-8 without BOM
    $utf8NoBom = New-Object System.Text.UTF8Encoding($false)
    [System.IO.File]::WriteAllText($dstFileNoTmpl, $text, $utf8NoBom)
  } else {
    Copy-Item -Force -LiteralPath $srcFile -Destination $dstFile
  }
}

foreach ($m in $Mappings) {
  $srcRoot = $m.Src
  $dstRoot = $m.Dst

  if (-not (Test-Path -LiteralPath $srcRoot)) {
    Write-Host "chezmoi windows-sync: source missing, skipping: $srcRoot"
    continue
  }

  Ensure-Dir $dstRoot
  Write-Host "chezmoi windows-sync: syncing $srcRoot -> $dstRoot"

  Get-ChildItem -LiteralPath $srcRoot -Recurse -Force | ForEach-Object {
    $rel = $_.FullName.Substring($srcRoot.Length).TrimStart('\','/')
    if ($rel -eq "") { return }

    $relConverted = Convert-RelativePath $rel
    $dstPath = Join-Path $dstRoot $relConverted

    if ($_.PSIsContainer) {
      Ensure-Dir $dstPath
      return
    }

    Render-Or-CopyFile $_.FullName $dstPath
  }
}

# Remove stale non-Windows config trees if they were applied previously.
$cleanupPaths = @(
  ".config\doom",
  ".config\lazygit",
  ".config\sublime-merge"
)

foreach ($rel in $cleanupPaths) {
  $abs = Join-Path $HOME $rel
  if (Test-Path -LiteralPath $abs -PathType Container) {
    try {
      Remove-Item -LiteralPath $abs -Recurse -Force -ErrorAction Stop
      if (-not (Test-Path -LiteralPath $abs)) {
        Write-Host "chezmoi windows-sync: removed stale path $abs"
      } else {
        Write-Warning "chezmoi windows-sync: stale path still exists after cleanup: $abs"
      }
    } catch {
      Write-Warning "chezmoi windows-sync: failed to remove stale path $abs : $($_.Exception.Message)"
    }
  }
}
{{- end -}}
