#!/bin/bash
# macOS-only guard via chezmoi template
{{- if ne .chezmoi.os "darwin" }}
exit 0
{{- end }}

set -e

APP_NAME="CopyQ.app"
APP_PATH="/Applications/$APP_NAME"
CACHE_DIR="${HOME}/.cache/chezmoi-copyq"
LAST_CHECK_FILE="${CACHE_DIR}/last-check"
CHECK_INTERVAL=$((7 * 24 * 60 * 60))  # 7 days in seconds (matches .chezmoiexternal.toml refreshPeriod)

# Ensure cache directory exists
mkdir -p "$CACHE_DIR"

# --- Rate Limiting ---
# Skip GitHub API call if we checked recently (unless app is missing)
if [[ -f "$LAST_CHECK_FILE" ]] && [[ -d "$APP_PATH" ]]; then
    LAST_CHECK=$(cat "$LAST_CHECK_FILE")
    NOW=$(date +%s)
    ELAPSED=$((NOW - LAST_CHECK))
    if [[ $ELAPSED -lt $CHECK_INTERVAL ]]; then
        exit 0  # Silent exit - checked recently
    fi
fi

echo "Checking for CopyQ updates..."

# --- Fetch Latest Version from GitHub ---
if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq is required to parse GitHub release info"
    exit 1
fi

GITHUB_RESPONSE=$(curl -sL "https://api.github.com/repos/hluk/CopyQ/releases/latest")

# Check for rate limit
if echo "$GITHUB_RESPONSE" | grep -q "API rate limit exceeded"; then
    echo "GitHub API rate limit exceeded, skipping update check."
    exit 0
fi

LATEST_VERSION=$(echo "$GITHUB_RESPONSE" | jq -r '.tag_name | sub("^v"; "")')

ARCH=$(uname -m)
if [[ "$ARCH" == "arm64" ]]; then
    DOWNLOAD_URL=$(echo "$GITHUB_RESPONSE" | jq -r '
        .assets[]
        | select(.name | test("macos-[0-9]+-m[^.]+\\.dmg$"))
        | .browser_download_url
    ' | head -1)
else
    DOWNLOAD_URL=$(echo "$GITHUB_RESPONSE" | jq -r '
        .assets[]
        | select(.name | test("macos-[0-9]+\\.dmg$"))
        | .browser_download_url
    ' | head -1)
fi

if [[ -z "$LATEST_VERSION" ]] || [[ "$LATEST_VERSION" == "null" ]] || [[ -z "$DOWNLOAD_URL" ]]; then
    echo "Error: Could not parse GitHub release info"
    exit 1
fi

# Update last check timestamp (we successfully queried GitHub)
date +%s > "$LAST_CHECK_FILE"

# --- Version Comparison ---
normalize_version_component() {
    local value
    value="$1"
    value="${value%%[^0-9]*}"
    if [[ -z "$value" ]]; then
        value="0"
    fi
    printf '%s\n' "$value"
}

compare_versions() {
    local left right max_parts index left_component right_component
    local left_parts right_parts
    left="$1"
    right="$2"

    IFS=. read -r -a left_parts <<< "$left"
    IFS=. read -r -a right_parts <<< "$right"

    max_parts="${#left_parts[@]}"
    if (( ${#right_parts[@]} > max_parts )); then
        max_parts="${#right_parts[@]}"
    fi

    for ((index = 0; index < max_parts; index += 1)); do
        left_component="$(normalize_version_component "${left_parts[$index]:-0}")"
        right_component="$(normalize_version_component "${right_parts[$index]:-0}")"
        if (( 10#$left_component < 10#$right_component )); then
            printf '%s\n' "-1"
            return 0
        fi
        if (( 10#$left_component > 10#$right_component )); then
            printf '%s\n' "1"
            return 0
        fi
    done

    printf '%s\n' "0"
}

INSTALLED_VERSION=""
if [[ -d "$APP_PATH" ]]; then
    INSTALLED_VERSION=$(defaults read "$APP_PATH/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || echo "")
fi

if [[ -n "$INSTALLED_VERSION" ]]; then
    VERSION_COMPARE=$(compare_versions "$INSTALLED_VERSION" "$LATEST_VERSION")
    if [[ "$VERSION_COMPARE" == "0" ]]; then
        echo "CopyQ ${INSTALLED_VERSION} is up to date."
        exit 0
    fi
    if [[ "$VERSION_COMPARE" == "1" ]]; then
        echo "CopyQ ${INSTALLED_VERSION} is newer than latest release ${LATEST_VERSION}; skipping update."
        exit 0
    fi
fi

if [[ -n "$INSTALLED_VERSION" ]]; then
    echo "Updating CopyQ: ${INSTALLED_VERSION} -> ${LATEST_VERSION}"
else
    echo "Installing CopyQ ${LATEST_VERSION}..."
fi

# --- Download and Install ---
TEMP_DIR=$(mktemp -d /tmp/copyq.XXXXXX)
TEMP_DMG="$TEMP_DIR/copyq.dmg"

curl -fsSL "$DOWNLOAD_URL" -o "$TEMP_DMG"

if [[ ! -f "$TEMP_DMG" ]]; then
    echo "Error: DMG download failed"
    rm -rf "$TEMP_DIR"
    exit 1
fi

# Mount DMG (plist output is captured; nothing is printed)
ATTACH_OUTPUT=$(hdiutil attach "$TEMP_DMG" -nobrowse -plist)

# Extract mount point from plist XML
MOUNT_POINT=$(echo "$ATTACH_OUTPUT" \
  | grep -A 1 "<key>mount-point</key>" \
  | grep "<string>" \
  | head -1 \
  | sed 's/.*<string>\(.*\)<\/string>.*/\1/')

if [[ -z "$MOUNT_POINT" ]] || [[ ! -d "$MOUNT_POINT" ]]; then
    echo "Error: could not determine DMG mount point"
    echo "$ATTACH_OUTPUT"
    rm -rf "$TEMP_DIR"
    exit 1
fi

if [[ ! -d "$MOUNT_POINT/$APP_NAME" ]]; then
    echo "Error: $APP_NAME not found in mounted DMG"
    ls -la "$MOUNT_POINT" || true
    hdiutil detach "$MOUNT_POINT" -quiet || true
    rm -rf "$TEMP_DIR"
    exit 1
fi

# Remove old version if exists, then copy new
[[ -d "$APP_PATH" ]] && rm -rf "$APP_PATH"
cp -R "$MOUNT_POINT/$APP_NAME" /Applications/

# Unmount and cleanup
hdiutil detach "$MOUNT_POINT" -quiet
rm -rf "$TEMP_DIR"

# --- Gatekeeper Bypass ---
xattr -d com.apple.quarantine "$APP_PATH" 2>/dev/null || true
codesign --force --deep --sign - "$APP_PATH"

echo "CopyQ ${LATEST_VERSION} installed successfully."
