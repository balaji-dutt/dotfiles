{{- if ne .chezmoi.os "windows" -}}
{{- /* not Windows: do nothing */ -}}
{{- else -}}
# configs/host-ai-plugin-refresh.jsonc hash: {{ include "configs/host-ai-plugin-refresh.jsonc" | sha256sum }}

$ErrorActionPreference = "Stop"

$ConfigPath = Join-Path '{{ .chezmoi.sourceDir }}' 'configs\host-ai-plugin-refresh.jsonc'
# Read at runtime rather than via `include` so this script's text - and therefore
# the onchange trigger above - stays keyed to the manifest alone. Including
# settings-base.json here would re-run the whole refresh, package-cache removal
# included, on every unrelated settings edit.
$SettingsBasePath = Join-Path '{{ .chezmoi.sourceDir }}' 'dot_claude\settings-base.json'
$DryRun = -not [string]::IsNullOrWhiteSpace($env:HOST_AI_PLUGIN_REFRESH_DRY_RUN)
# Claude plugin problems are reported per plugin and re-raised as a non-zero
# exit at the end, so one bad plugin does not skip the remaining plugins or the
# OpenCode cache refresh.
$script:ClaudeFailures = @()

function ConvertFrom-JsoncText {
  param([Parameter(Mandatory=$true)] [string] $Text)

  $withoutBlocks = [regex]::Replace($Text, "/\*.*?\*/", "", [System.Text.RegularExpressions.RegexOptions]::Singleline)
  $withoutLines = [regex]::Replace($withoutBlocks, "(?m)^([^`"\r\n]*(?:`"(?:\\.|[^`"\\])*`"[^`"\r\n]*)*?)//.*$", '$1')
  return $withoutLines | ConvertFrom-Json
}

function Get-JsonProperty {
  param(
    [Parameter(Mandatory=$true)] $Object,
    [Parameter(Mandatory=$true)] [string] $Name,
    $Default = $null
  )

  $property = $Object.PSObject.Properties[$Name]
  if ($null -eq $property) { return $Default }
  return $property.Value
}

function Test-ObjectList {
  param([Parameter(Mandatory=$true)] $Value)

  if ($Value -is [string]) { return $false }
  if ($Value -isnot [System.Collections.IEnumerable]) { return $false }
  return $true
}

function Invoke-External {
  param(
    [Parameter(Mandatory=$true)] [string] $Command,
    [Parameter(Mandatory=$true)] [string[]] $Arguments
  )

  $output = & $Command @Arguments 2>&1
  $exitCode = $LASTEXITCODE
  if ($null -eq $exitCode) { $exitCode = 0 }

  return [pscustomobject]@{
    ExitCode = $exitCode
    Output = (($output | Out-String).TrimEnd())
  }
}

function Invoke-ExternalJson {
  param(
    [Parameter(Mandatory=$true)] [string] $Command,
    [Parameter(Mandatory=$true)] [string[]] $Arguments
  )

  # Keeps stderr out of stdout so machine-readable output stays parseable;
  # Invoke-External merges the two and would corrupt JSON with any CLI warning.
  $output = & $Command @Arguments 2>$null
  $exitCode = $LASTEXITCODE
  if ($null -eq $exitCode) { $exitCode = 0 }

  return [pscustomobject]@{
    ExitCode = $exitCode
    # -join, not Out-String: native command output is already a string[] of
    # lines, so joining reproduces stdout verbatim without routing a
    # machine-readable payload through the formatting engine. Matches the POSIX
    # port, which reads result.stdout raw.
    Output = (($output -join "`n").TrimEnd())
  }
}

function Get-ClaudePlugins {
  param([Parameter(Mandatory=$true)] $Manifest)

  $claude = Get-JsonProperty $Manifest "claude"
  if ($null -eq $claude -or $claude -is [array]) {
    Write-Host "ERROR: claude must be an object."
    exit 1
  }

  $plugins = Get-JsonProperty $claude "plugins" @()
  if (-not (Test-ObjectList $plugins)) {
    Write-Host "ERROR: claude.plugins must be a list."
    exit 1
  }

  $parsed = @()
  foreach ($plugin in @($plugins)) {
    $pluginId = Get-JsonProperty $plugin "id"
    $scope = Get-JsonProperty $plugin "scope" "user"
    $enabled = Get-JsonProperty $plugin "enabled" $true
    if ($pluginId -isnot [string] -or [string]::IsNullOrWhiteSpace($pluginId)) {
      Write-Host "ERROR: Claude plugin id must be a non-empty string."
      exit 1
    }
    if ($scope -isnot [string] -or [string]::IsNullOrWhiteSpace($scope)) {
      Write-Host "ERROR: Claude plugin scope must be a non-empty string."
      exit 1
    }
    if ($enabled -isnot [bool]) {
      Write-Host "ERROR: Claude plugin enabled must be a boolean."
      exit 1
    }
    if ($enabled) {
      $parsed += [pscustomobject]@{ Id = $pluginId; Scope = $scope }
    }
  }
  return $parsed
}

function Get-EnabledPluginIds {
  if (-not (Test-Path -LiteralPath $SettingsBasePath)) {
    Write-Host "ERROR: Claude settings base not found: $SettingsBasePath"
    exit 1
  }

  try {
    $settings = Get-Content -Raw -LiteralPath $SettingsBasePath | ConvertFrom-Json
  } catch {
    Write-Host "ERROR: Invalid Claude settings base JSON: $($_.Exception.Message)"
    exit 1
  }

  # Absent enabledPlugins is treated as empty, matching the POSIX port's
  # settings.get("enabledPlugins", {}); the mismatch is then reported per plugin
  # rather than as a shape error.
  $enabledPlugins = Get-JsonProperty $settings "enabledPlugins" ([pscustomobject]@{})
  if ($enabledPlugins -is [array]) {
    Write-Host "ERROR: settings-base.json enabledPlugins must be an object."
    exit 1
  }

  return @($enabledPlugins.PSObject.Properties | Where-Object { $_.Value -is [bool] -and $_.Value } | ForEach-Object { $_.Name })
}

# The plugin id is duplicated across the refresh manifest and the settings base
# that actually enables it. Nothing else cross-checks the pair, so a rename in
# one file used to surface only as an opaque `claude plugin update` failure
# part-way through the refresh.
function Test-ClaudeEnablement {
  param(
    [Parameter(Mandatory=$true)] $Manifest,
    [Parameter(Mandatory=$true)] [AllowEmptyCollection()] [array] $Plugins
  )

  $claude = Get-JsonProperty $Manifest "claude"
  if ($null -eq $claude -or $claude -is [array]) {
    Write-Host "ERROR: claude must be an object."
    exit 1
  }

  $manifestIds = @(Get-JsonProperty $claude "plugins" @() | ForEach-Object { Get-JsonProperty $_ "id" })
  $enabledIds = @($Plugins | ForEach-Object { $_.Id })
  $settingsIds = @(Get-EnabledPluginIds)

  # -cnotcontains, not -notcontains: the latter compares case-insensitively and
  # would wave through a case-only drift that the POSIX port's set difference
  # rejects.
  $problems = @()
  foreach ($pluginId in @($enabledIds | Where-Object { $settingsIds -cnotcontains $_ } | Sort-Object)) {
    $problems += "ERROR: Claude plugin '$pluginId' is enabled in $ConfigPath but not enabled in $SettingsBasePath."
  }
  foreach ($pluginId in @($settingsIds | Where-Object { $manifestIds -cnotcontains $_ } | Sort-Object)) {
    $problems += "ERROR: Claude plugin '$pluginId' is enabled in $SettingsBasePath but absent from $ConfigPath."
  }

  if ($problems.Count -gt 0) {
    foreach ($problem in $problems) { Write-Host $problem }
    Write-Host "ERROR: Claude plugin ids must match between the refresh manifest and the settings base. Reconcile both files and re-apply."
    exit 1
  }
}

function Get-OpenCodePlugins {
  param([Parameter(Mandatory=$true)] $Manifest)

  $opencode = Get-JsonProperty $Manifest "opencode"
  if ($null -eq $opencode -or $opencode -is [array]) {
    Write-Host "ERROR: opencode must be an object."
    exit 1
  }

  $plugins = Get-JsonProperty $opencode "plugins" @()
  if (-not (Test-ObjectList $plugins)) {
    Write-Host "ERROR: opencode.plugins must be a list."
    exit 1
  }

  $parsed = @()
  foreach ($plugin in @($plugins)) {
    $package = Get-JsonProperty $plugin "package"
    $enabled = Get-JsonProperty $plugin "enabled" $true
    if ($package -isnot [string] -or [string]::IsNullOrWhiteSpace($package)) {
      Write-Host "ERROR: OpenCode package must be a non-empty string."
      exit 1
    }
    if ($enabled -isnot [bool]) {
      Write-Host "ERROR: OpenCode package enabled must be a boolean."
      exit 1
    }
    if (-not $enabled) { continue }

    $cacheInstall = Get-JsonProperty $plugin "cacheInstall"
    $parsedInstall = $null
    if ($null -ne $cacheInstall) {
      if ($cacheInstall -isnot [System.Management.Automation.PSCustomObject]) {
        Write-Host "ERROR: OpenCode cacheInstall must be an object."
        exit 1
      }

      $version = Get-JsonProperty $plugin "version"
      if ($version -isnot [string] -or [string]::IsNullOrWhiteSpace($version)) {
        Write-Host "ERROR: OpenCode package version must be a non-empty string when cacheInstall is configured."
        exit 1
      }
      $legacyPeerDeps = Get-JsonProperty $cacheInstall "legacyPeerDeps" $false
      $ignoreScripts = Get-JsonProperty $cacheInstall "ignoreScripts" $true
      if ($legacyPeerDeps -isnot [bool]) {
        Write-Host "ERROR: OpenCode cacheInstall legacyPeerDeps must be a boolean."
        exit 1
      }
      if ($ignoreScripts -isnot [bool]) {
        Write-Host "ERROR: OpenCode cacheInstall ignoreScripts must be a boolean."
        exit 1
      }

      $dependencies = Get-JsonProperty $cacheInstall "dependencies" @()
      if (-not (Test-ObjectList $dependencies)) {
        Write-Host "ERROR: OpenCode cacheInstall dependencies must be a list."
        exit 1
      }
      $parsedDependencies = @()
      foreach ($dependency in @($dependencies)) {
        $dependencyPackage = Get-JsonProperty $dependency "package"
        $dependencyVersion = Get-JsonProperty $dependency "version"
        if ($dependencyPackage -isnot [string] -or [string]::IsNullOrWhiteSpace($dependencyPackage)) {
          Write-Host "ERROR: OpenCode cacheInstall dependency package must be a non-empty string."
          exit 1
        }
        if ($dependencyVersion -isnot [string] -or [string]::IsNullOrWhiteSpace($dependencyVersion)) {
          Write-Host "ERROR: OpenCode cacheInstall dependency version must be a non-empty string."
          exit 1
        }
        $parsedDependencies += [pscustomobject]@{
          Package = $dependencyPackage
          Version = $dependencyVersion
        }
      }

      $parsedInstall = [pscustomobject]@{
        LegacyPeerDeps = $legacyPeerDeps
        IgnoreScripts = $ignoreScripts
        Dependencies = $parsedDependencies
      }
    }

    $parsed += [pscustomobject]@{
      Package = $package
      Version = (Get-JsonProperty $plugin "version")
      CacheInstall = $parsedInstall
    }
  }
  return $parsed
}

function Get-InstalledClaudePluginIds {
  # `claude plugin update` only accepts ids that already have an install
  # record, so the refresh has to know which manifest entries are missing
  # before it picks a subcommand. Returns $null when the installed set cannot
  # be determined, which callers treat as "try both".
  $listed = Invoke-ExternalJson -Command "claude" -Arguments @("plugin", "list", "--json")
  if ($listed.ExitCode -ne 0) { return $null }

  try {
    # -NoEnumerate: piping unrolls a single-element JSON array into a bare
    # object, which would then fail the list check and hide a known install set.
    $parsed = ConvertFrom-Json -InputObject $listed.Output -NoEnumerate
  } catch {
    return $null
  }

  if ($null -eq $parsed -or -not (Test-ObjectList $parsed)) { return $null }

  $ids = [System.Collections.Generic.HashSet[string]]::new()
  foreach ($entry in $parsed) {
    $id = Get-JsonProperty $entry "id"
    if ($id -is [string] -and -not [string]::IsNullOrWhiteSpace($id)) {
      [void] $ids.Add($id)
    }
  }
  # `,` keeps the set intact: a bare `return` unrolls it, so an empty set would
  # arrive as $null (misread as "unknown") and a one-entry set as a bare string,
  # whose .Contains() is a substring match rather than an exact id match.
  return ,$ids
}

function Get-ClaudePluginActions {
  param(
    [Parameter(Mandatory=$true)] $Plugin,
    $InstalledIds
  )

  # Unknown install state: update first so an installed plugin is not
  # reinstalled, then fall back to install for the missing case.
  if ($null -eq $InstalledIds) { return @("update", "install") }
  if ($InstalledIds.Contains($Plugin.Id)) { return @("update") }
  return @("install")
}

function Sync-ClaudePlugin {
  param(
    [Parameter(Mandatory=$true)] $Plugin,
    [Parameter(Mandatory=$true)] [string[]] $Actions
  )

  $verb = "Refreshing"
  if ($Actions.Count -eq 1) {
    $verb = if ($Actions[0] -eq "update") { "Updating" } else { "Installing" }
  }
  Write-Host "INFO: $verb Claude Code plugin '$($Plugin.Id)'."

  $attempts = @()
  foreach ($action in $Actions) {
    $arguments = @("plugin", $action, "--scope", $Plugin.Scope, $Plugin.Id)
    $result = Invoke-External -Command "claude" -Arguments $arguments
    if ($result.ExitCode -eq 0) { return $true }
    $attempts += [pscustomobject]@{ Action = $action; Result = $result }
  }

  # Only surfaced once every action failed, so the expected "not installed"
  # noise from a probing update stays hidden when the install then succeeds.
  foreach ($attempt in $attempts) {
    Write-Host "ERROR: Failed to $($attempt.Action) Claude Code plugin '$($Plugin.Id)'."
    if ($attempt.Result.Output) { Write-Host $attempt.Result.Output }
  }
  return $false
}

function Update-ClaudePlugins {
  param([Parameter(Mandatory=$true)] [object[]] $Plugins)

  if ($Plugins.Count -eq 0) {
    Write-Host "INFO: No Claude Code plugins configured for refresh."
    return
  }
  if (-not (Get-Command claude -ErrorAction SilentlyContinue)) {
    Write-Host "INFO: claude command not found; skipping Claude Code plugin refresh."
    return
  }

  if ($DryRun) {
    Write-Host "INFO: Would run: claude plugin marketplace update"
  } else {
    Write-Host "INFO: Updating Claude Code plugin marketplaces."
    $marketplace = Invoke-External -Command "claude" -Arguments @("plugin", "marketplace", "update")
    if ($marketplace.ExitCode -ne 0) {
      Write-Host "ERROR: Failed to update Claude Code plugin marketplaces."
      if ($marketplace.Output) { Write-Host $marketplace.Output }
      # Not fatal: cached marketplace metadata can still satisfy the per-plugin
      # install/update below.
      $script:ClaudeFailures += "marketplace"
    }
  }

  $installedIds = Get-InstalledClaudePluginIds
  if ($null -eq $installedIds) {
    Write-Host "INFO: Could not read installed Claude plugins; falling back to update-then-install."
  }

  foreach ($plugin in $Plugins) {
    # @() is load-bearing: a one-element return unrolls to a bare string, and
    # $Actions[0] on a string would then yield a char.
    $actions = @(Get-ClaudePluginActions -Plugin $plugin -InstalledIds $installedIds)
    if ($DryRun) {
      foreach ($action in $actions) {
        Write-Host "INFO: Would run: claude plugin $action --scope $($plugin.Scope) $($plugin.Id)"
      }
      continue
    }

    if (-not (Sync-ClaudePlugin -Plugin $plugin -Actions $actions)) {
      $script:ClaudeFailures += $plugin.Id
    }
  }

  Write-Host "INFO: Restart Claude Code to use refreshed plugins."
}

function Get-OpenCodeCacheRoot {
  $fallback = Join-Path $HOME ".cache\opencode"
  if (Get-Command opencode -ErrorAction SilentlyContinue) {
    $paths = Invoke-External -Command "opencode" -Arguments @("debug", "paths")
    if ($paths.ExitCode -eq 0) {
      foreach ($line in ($paths.Output -split "`r?`n")) {
        if ($line -match "^cache\s+(.+)$") {
          return $Matches[1].Trim()
        }
      }
    } else {
      Write-Host "INFO: Could not read OpenCode debug paths; using default cache path."
      if ($paths.Output) { Write-Host $paths.Output }
    }
  } else {
    Write-Host "INFO: opencode command not found; using default OpenCode cache path."
  }
  return $fallback
}

function Get-OpenCodeProcessDetails {
  $details = @()

  if (Get-Command Get-CimInstance -ErrorAction SilentlyContinue) {
    try {
      foreach ($process in @(Get-CimInstance Win32_Process -Filter "Name = 'opencode.exe'" -ErrorAction Stop)) {
        $details += [pscustomobject]@{
          Id = $process.ProcessId
          SessionId = $process.SessionId
          ParentProcessId = $process.ParentProcessId
          Path = $process.ExecutablePath
          CommandLine = $process.CommandLine
        }
      }
      return $details
    } catch {
      Write-Host "INFO: Could not read OpenCode process command lines: $($_.Exception.Message)"
    }
  }

  foreach ($process in @(Get-Process -Name "opencode" -ErrorAction SilentlyContinue)) {
    $path = $null
    try { $path = $process.Path } catch { $path = $null }
    $details += [pscustomobject]@{
      Id = $process.Id
      SessionId = $process.SessionId
      ParentProcessId = $null
      Path = $path
      CommandLine = $null
    }
  }
  return $details
}

function Write-OpenCodeProcessDetails {
  param([Parameter(Mandatory=$true)] [object[]] $Processes)

  if ($Processes.Count -eq 0) {
    Write-Host "INFO: No OpenCode processes detected."
    return
  }

  foreach ($process in $Processes) {
    $parts = @(
      "pid=$($process.Id)",
      "session=$($process.SessionId)"
    )
    if ($null -ne $process.ParentProcessId) { $parts += "parent=$($process.ParentProcessId)" }
    if (-not [string]::IsNullOrWhiteSpace($process.Path)) { $parts += "path=$($process.Path)" }
    if (-not [string]::IsNullOrWhiteSpace($process.CommandLine)) { $parts += "command=$($process.CommandLine)" }
    Write-Host "INFO: Blocking OpenCode process: $($parts -join ' ')"
  }
}

function Get-CachedOpenCodeVersions {
  param(
    [Parameter(Mandatory=$true)] [string] $PackagesDir,
    [Parameter(Mandatory=$true)] [string[]] $Packages
  )

  $detections = @()
  $missing = @()
  foreach ($package in $Packages) {
    $segments = @("node_modules") + ($package -split "/") + @("package.json")
    $tail = [System.IO.Path]::Combine([string[]]$segments)
    $found = $false
    if (Test-Path -LiteralPath $PackagesDir -PathType Container) {
      foreach ($packageJson in Get-ChildItem -LiteralPath $PackagesDir -Recurse -Filter package.json -File -ErrorAction SilentlyContinue) {
        $normalized = $packageJson.FullName.Replace("/", "\")
        if (-not $normalized.EndsWith($tail, [System.StringComparison]::OrdinalIgnoreCase)) {
          continue
        }
        $found = $true
        try {
          $data = Get-Content -Raw -LiteralPath $packageJson.FullName | ConvertFrom-Json
          $detections += [pscustomobject]@{
            Name = (Get-JsonProperty $data "name" $package)
            Version = (Get-JsonProperty $data "version" "unknown")
            Path = $packageJson.FullName
          }
        } catch {
          Write-Host "INFO: Could not read cached package metadata $($packageJson.FullName): $($_.Exception.Message)"
        }
      }
    }
    if (-not $found) { $missing += $package }
  }
  return [pscustomobject]@{ Detections = $detections; Missing = $missing }
}


function Get-OpenCodeCachePackageDir {
  param(
    [Parameter(Mandatory=$true)] [string] $PackagesDir,
    [Parameter(Mandatory=$true)] [string] $Package,
    [Parameter(Mandatory=$true)] [string] $Version
  )

  $segments = @($Package -split "/")
  $segments[$segments.Count - 1] = "$($segments[$segments.Count - 1])@$Version"
  $result = $PackagesDir
  foreach ($segment in $segments) { $result = Join-Path $result $segment }
  return $result
}


function Get-InstalledOpenCodePackageVersion {
  param(
    [Parameter(Mandatory=$true)] [string] $InstallDir,
    [Parameter(Mandatory=$true)] [string] $Package
  )

  $packageJson = Join-Path $InstallDir "node_modules"
  foreach ($segment in @($Package -split "/")) { $packageJson = Join-Path $packageJson $segment }
  $packageJson = Join-Path $packageJson "package.json"
  if (-not (Test-Path -LiteralPath $packageJson -PathType Leaf)) { return $null }
  try {
    $data = Get-Content -Raw -LiteralPath $packageJson | ConvertFrom-Json
    return (Get-JsonProperty $data "version")
  } catch {
    return $null
  }
}


function Test-OpenCodeCacheInstallSatisfied {
  param(
    [Parameter(Mandatory=$true)] [string] $InstallDir,
    [Parameter(Mandatory=$true)] $Plugin
  )

  $installed = Get-InstalledOpenCodePackageVersion -InstallDir $InstallDir -Package $Plugin.Package
  if ($installed -cne $Plugin.Version) { return $false }
  foreach ($dependency in @($Plugin.CacheInstall.Dependencies)) {
    $installed = Get-InstalledOpenCodePackageVersion -InstallDir $InstallDir -Package $dependency.Package
    if ($installed -cne $dependency.Version) { return $false }
  }
  return $true
}


function Install-OpenCodeCachePlugin {
  param(
    [Parameter(Mandatory=$true)] [string] $PackagesDir,
    [Parameter(Mandatory=$true)] $Plugin,
    [Parameter(Mandatory=$true)] [bool] $Running,
    [Parameter(Mandatory=$true)] [bool] $CacheWillBeRemoved
  )

  $targetDir = Get-OpenCodeCachePackageDir -PackagesDir $PackagesDir -Package $Plugin.Package -Version $Plugin.Version
  if (-not ($DryRun -and $CacheWillBeRemoved) -and (Test-OpenCodeCacheInstallSatisfied -InstallDir $targetDir -Plugin $Plugin)) {
    Write-Host "INFO: OpenCode cache install already satisfied for $($Plugin.Package)@$($Plugin.Version): $targetDir"
    return
  }

  if ($Running -and (Test-Path -LiteralPath $targetDir)) {
    Write-Host "ERROR: OpenCode is running and the existing compatibility cache is incomplete: $targetDir"
    Write-Host "ERROR: Exit OpenCode and apply the dotfiles again to replace it safely."
    exit 1
  }
  if (-not (Get-Command npm -ErrorAction SilentlyContinue)) {
    Write-Host "ERROR: npm is required for the configured OpenCode cache install $($Plugin.Package)@$($Plugin.Version)."
    exit 1
  }

  $targetParent = Split-Path -Parent $targetDir
  $targetLeaf = Split-Path -Leaf $targetDir
  $stagingDir = Join-Path $targetParent ".$targetLeaf.installing-$PID"
  $specs = @("$($Plugin.Package)@$($Plugin.Version)")
  foreach ($dependency in @($Plugin.CacheInstall.Dependencies)) {
    $specs += "$($dependency.Package)@$($dependency.Version)"
  }
  $arguments = @("install", "--prefix", $stagingDir)
  if ($Plugin.CacheInstall.IgnoreScripts) { $arguments += "--ignore-scripts" }
  if ($Plugin.CacheInstall.LegacyPeerDeps) { $arguments += "--legacy-peer-deps" }
  $arguments += $specs

  if ($DryRun) {
    Write-Host "INFO: Would stage OpenCode compatibility cache: npm $($arguments -join ' ')"
    Write-Host "INFO: Would publish OpenCode compatibility cache: $targetDir"
    return
  }

  New-Item -ItemType Directory -Path $targetParent -Force | Out-Null
  if (Test-Path -LiteralPath $stagingDir) {
    Remove-Item -LiteralPath $stagingDir -Recurse -Force
  }
  Write-Host "INFO: Staging OpenCode compatibility cache for $($Plugin.Package)@$($Plugin.Version)."
  $install = Invoke-External -Command "npm" -Arguments $arguments
  if ($install.ExitCode -ne 0) {
    if (Test-Path -LiteralPath $stagingDir) { Remove-Item -LiteralPath $stagingDir -Recurse -Force }
    Write-Host "ERROR: Failed to install OpenCode compatibility cache for $($Plugin.Package)@$($Plugin.Version)."
    if ($install.Output) { Write-Host $install.Output }
    exit $install.ExitCode
  }
  if (-not (Test-OpenCodeCacheInstallSatisfied -InstallDir $stagingDir -Plugin $Plugin)) {
    Remove-Item -LiteralPath $stagingDir -Recurse -Force
    Write-Host "ERROR: Staged OpenCode compatibility cache failed version validation for $($Plugin.Package)@$($Plugin.Version)."
    exit 1
  }

  if ($Running -and (Test-Path -LiteralPath $targetDir)) {
    if (Test-OpenCodeCacheInstallSatisfied -InstallDir $targetDir -Plugin $Plugin) {
      Remove-Item -LiteralPath $stagingDir -Recurse -Force
      Write-Host "INFO: OpenCode populated the compatibility cache during installation; keeping: $targetDir"
      return
    }
    Remove-Item -LiteralPath $stagingDir -Recurse -Force
    Write-Host "ERROR: OpenCode populated an incomplete compatibility cache during installation: $targetDir"
    Write-Host "ERROR: Exit OpenCode and apply the dotfiles again to replace it safely."
    exit 1
  }
  if (Test-Path -LiteralPath $targetDir) { Remove-Item -LiteralPath $targetDir -Recurse -Force }
  Move-Item -LiteralPath $stagingDir -Destination $targetDir
  Write-Host "INFO: Published OpenCode compatibility cache: $targetDir"
}


function Update-OpenCodeCache {
  param([Parameter(Mandatory=$true)] [object[]] $Plugins)

  $cacheRoot = Get-OpenCodeCacheRoot
  $packagesDir = Join-Path $cacheRoot "packages"
  $packages = @($Plugins | ForEach-Object { $_.Package })
  $processes = @(Get-OpenCodeProcessDetails)
  $running = $processes.Count -gt 0
  $cacheWillBeRemoved = -not $running -and (Test-Path -LiteralPath $packagesDir)

  Write-Host "INFO: OpenCode cache root: $cacheRoot"
  Write-Host "INFO: OpenCode packages cache exists: $(if (Test-Path -LiteralPath $packagesDir -PathType Container) { 'yes' } else { 'no' })"
  Write-Host "INFO: OpenCode blocking session: $(if ($running) { 'yes' } else { 'no' })"
  Write-OpenCodeProcessDetails -Processes $processes

  $versions = Get-CachedOpenCodeVersions -PackagesDir $packagesDir -Packages $packages
  if ($versions.Detections.Count -gt 0) {
    Write-Host "INFO: Detected cached OpenCode plugin versions:"
    foreach ($detection in $versions.Detections) {
      Write-Host "INFO:   $($detection.Name)@$($detection.Version) ($($detection.Path))"
    }
  } else {
    Write-Host "INFO: No cached OpenCode plugin package versions detected."
  }
  foreach ($package in $versions.Missing) {
    Write-Host "INFO: No cached OpenCode package metadata found for '$package'."
  }

  if ($running) {
    Write-Host "INFO: OpenCode blocking session detected; not removing package cache."
  } elseif (-not (Test-Path -LiteralPath $packagesDir)) {
    Write-Host "INFO: OpenCode packages cache is absent; nothing to remove."
  } elseif ($DryRun) {
    Write-Host "INFO: Would remove OpenCode packages cache: $packagesDir"
  } else {
    Write-Host "INFO: Removing OpenCode packages cache: $packagesDir"
    Remove-Item -LiteralPath $packagesDir -Recurse -Force
  }

  foreach ($plugin in $Plugins) {
    if ($null -ne $plugin.CacheInstall) {
      Install-OpenCodeCachePlugin -PackagesDir $packagesDir -Plugin $plugin -Running $running -CacheWillBeRemoved $cacheWillBeRemoved
    }
  }

  Write-Host "INFO: Launch or restart OpenCode to repopulate the plugin cache."
}

try {
  $manifest = ConvertFrom-JsoncText -Text (Get-Content -Raw -LiteralPath $ConfigPath)
} catch {
  Write-Host "ERROR: Invalid host AI plugin refresh JSONC: $($_.Exception.Message)"
  exit 1
}

$claudePlugins = @(Get-ClaudePlugins -Manifest $manifest)
Test-ClaudeEnablement -Manifest $manifest -Plugins $claudePlugins
Update-ClaudePlugins -Plugins $claudePlugins
Update-OpenCodeCache -Plugins @(Get-OpenCodePlugins -Manifest $manifest)

if ($script:ClaudeFailures.Count -gt 0) {
  $failed = ($script:ClaudeFailures | Sort-Object) -join ", "
  Write-Host "ERROR: One or more Claude Code plugin refreshes failed: $failed"
  exit 1
}
{{- end -}}
