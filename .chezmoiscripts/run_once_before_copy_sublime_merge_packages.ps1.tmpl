{{- if ne .chezmoi.os "windows" -}}
{{- /* not Windows: do nothing */ -}}
{{- else -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

if (-not $env:GITHUB_API_TOKEN) {
  Write-Host "ERROR: GITHUB_API_TOKEN is not set."
  Write-Host "This script uses the GitHub API and will likely hit rate limits without a token."
  Write-Host ""
  Write-Host "Run: `$env:GITHUB_API_TOKEN=..."
  Write-Host "Then rerun chezmoi apply."
  exit 1
}

$userPackages = Join-Path $env:APPDATA "Sublime Merge\Packages\User"
$tempRoot = Join-Path $env:TEMP ("smerge-packages-" + [guid]::NewGuid().ToString("N"))
$zipPath = Join-Path $tempRoot "Packages.zip"
$extractDir = Join-Path $tempRoot "extract"

$headers = @{
  Authorization = "Bearer $env:GITHUB_API_TOKEN"
  Accept = "application/vnd.github+json"
  "User-Agent" = "chezmoi-smerge-packages"
}

New-Item -ItemType Directory -Force -Path $tempRoot | Out-Null

try {
  $tagsUrl = "https://api.github.com/repos/sublimehq/Packages/tags?per_page=1"
  $tags = Invoke-RestMethod -Uri $tagsUrl -Headers $headers -Method Get
  if (-not $tags -or -not $tags[0].zipball_url) {
    throw "Unable to resolve latest tag zipball URL."
  }

  Invoke-WebRequest -Uri $tags[0].zipball_url -Headers $headers -OutFile $zipPath -UseBasicParsing
  New-Item -ItemType Directory -Force -Path $extractDir | Out-Null
  Expand-Archive -Path $zipPath -DestinationPath $extractDir -Force

  $syntaxFile = Get-ChildItem -Path $extractDir -Recurse -File -Filter "Git Commit.sublime-syntax" | Select-Object -First 1
  if (-not $syntaxFile) {
    throw "Git Commit.sublime-syntax not found in archive."
  }

  $gitFormatsDir = Split-Path -Parent $syntaxFile.FullName
  if (-not (Test-Path -LiteralPath $gitFormatsDir)) {
    throw "Git Formats directory not found in archive."
  }

  if (-not (Test-Path -LiteralPath $userPackages)) {
    New-Item -ItemType Directory -Force -Path $userPackages | Out-Null
  }

  $targetDir = Join-Path $userPackages "Git Formats"
  if (Test-Path -LiteralPath $targetDir) {
    Remove-Item -LiteralPath $targetDir -Recurse -Force
  }

  Copy-Item -LiteralPath $gitFormatsDir -Destination $targetDir -Recurse -Force

  $targetFile = Join-Path $targetDir "Git Commit.sublime-syntax"
  $syntaxSource = Join-Path '{{ .chezmoi.sourceDir }}' 'configs\sublime-merge\Git Commit.sublime-syntax'
  if (-not (Test-Path -LiteralPath $syntaxSource)) {
    throw "Sublime Merge Git Commit syntax source not found: $syntaxSource"
  }

  $syntaxContents = [System.IO.File]::ReadAllText($syntaxSource, [System.Text.Encoding]::UTF8)
  $syntaxContents = [regex]::Replace($syntaxContents, "\r?\n", "`r`n")
  $utf8NoBom = New-Object System.Text.UTF8Encoding($false)
  [System.IO.File]::WriteAllText($targetFile, $syntaxContents, $utf8NoBom)
} finally {
  if (Test-Path -LiteralPath $tempRoot) {
    Remove-Item -LiteralPath $tempRoot -Recurse -Force
  }
}
{{- end -}}
