#!/bin/bash
set -euo pipefail

{{- $isWSL := get . "isWSL" | default false -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $osrel := get .chezmoi.kernel "osrelease" | default "" | lower -}}
{{- $isWSL = or $isWSL ($osrel | contains "microsoft") -}}
{{- end -}}
{{- if $isWSL }}

{{- $wslProvisionInputs := list
  "ansible/wsl-playbook.yml"
  "ansible/tasks/apt-repos.yml"
  "ansible/tasks/base-packages.yml"
  "ansible/tasks/zsh-setup.yml"
  "ansible/tasks/system-config.yml"
  "ansible/tasks/ubuntu-extras.yml"
  "ansible/tasks/debian-dev-tools.yml"
  "ansible/tasks/certificates.yml"
  "ansible/tasks/onepassword-setup.yml"
  ".chezmoidata.yaml"
  "configs/packages.yaml"
  "configs/mise.toml"
  "configs/mise_wsl2.toml"
  "configs/uv_tools.txt"
  "configs/npm_globals.txt"
  "configs/npm_globals_linux.txt"
  "configs/npm_globals_linux_debian.txt"
  "configs/bun_globals.txt"
}}
{{- range $path := $wslProvisionInputs }}
{{- $input := joinPath $.chezmoi.sourceDir $path }}
# {{ $path }} hash: {{ if stat $input }}{{ include $input | sha256sum }}{{ else }}missing{{ end }}
{{- end }}

echo "=== WSL2 Provisioning via Ansible ==="

export PATH="$HOME/.local/bin:$PATH"
export ANSIBLE_CONFIG="{{ .chezmoi.sourceDir }}/ansible/ansible.cfg"

if ! command -v ansible-playbook &> /dev/null; then
    echo "ERROR: Ansible not found. Run bootstrap-wsl.sh first."
    exit 1
fi

DISTRO_ID="{{ .chezmoi.osRelease.id }}"
DISTRO_VERSION="{{ .chezmoi.osRelease.versionID }}"

echo "Detected distro: ${DISTRO_ID} ${DISTRO_VERSION}"

ansible-playbook "{{ .chezmoi.sourceDir }}/ansible/wsl-playbook.yml" \
    --ask-become-pass \
    -e "distro_id=${DISTRO_ID}" \
    -e "distro_version=${DISTRO_VERSION}" \
    -e "chezmoi_source_dir={{ .chezmoi.sourceDir }}" \
    -e "lazygit_version={{ .lazygit_version }}" \
    -e "beads_version={{ .beads_version }}" \
    -e "dolt_version={{ .dolt_version }}" \
    -e "plannotator_version={{ .plannotator_version }}" \
    {{- if .CERTPATH }}
    -e {{ printf "%q" (printf "cert_path=%s" (.CERTPATH | toJson)) }} \
    {{- end }}
    {{- if .CERTFILES }}
    -e {{ printf "%q" (printf "cert_files=%s" (.CERTFILES | toJson)) }} \
    {{- end }}
    {{- if .homelab.nfs_server }}
    -e "nfs_server={{ .homelab.nfs_server }}" \
    {{- end }}
    {{- if .homelab.nfs_path }}
    -e "nfs_path={{ .homelab.nfs_path }}" \
    {{- end }}
    {{- if .homelab.windows_user }}
    -e "windows_user={{ .homelab.windows_user }}" \
    {{- end }}
    {{- if .onepassword.url }}
    -e "op_url={{ .onepassword.url }}" \
    {{- end }}
    {{- if .onepassword.email }}
    -e "op_email={{ .onepassword.email }}" \
    {{- end }}

echo "=== WSL2 Provisioning Complete ==="
{{- end }}
