#!/usr/bin/env bash
set -euo pipefail

{{- $isWSL2 := get . "isWSL2" | default false -}}
{{- if eq .chezmoi.os "linux" }}
{{- $osrel := get .chezmoi.kernel "osrelease" | default "" | lower }}
{{- $isWSL2 = or $isWSL2 (and ($osrel | contains "microsoft") ($osrel | contains "wsl2")) }}
{{- end }}
{{- $isDebianWSL2 := or (get . "isDebianWSL2" | default false) (and $isWSL2 (eq .chezmoi.osRelease.id "debian")) -}}
{{- if not $isDebianWSL2 }}
exit 0
{{- end }}

if [[ -z "${WSL_DISTRO_NAME:-}" ]]; then
  exit 0
fi

SOURCE_DIR="{{ .chezmoi.sourceDir }}"
OVERLAY_ROOT="$SOURCE_DIR/private_Documents/development/container-dotfiles/devcontainers"

shopt -s globstar nullglob
templates=("$OVERLAY_ROOT"/**/dot_devcontainer/devcontainer.json.tmpl)

for tmpl in "${templates[@]}"; do
  repo_name="$(basename "$(dirname "$(dirname "$tmpl")")")"
  repo_dir="/mnt/devdrive/$repo_name"

  if [[ ! -d "$repo_dir/.devcontainer" ]]; then
    continue
  fi

  dest_dir="$repo_dir/.devcontainer/personal-wsl"
  dest_file="$dest_dir/devcontainer.json"
  tmp_file="$(mktemp)"

  mkdir -p "$dest_dir"
  chezmoi execute-template --file "$tmpl" >"$tmp_file"

  if [[ ! -f "$dest_file" ]] || ! cmp -s "$tmp_file" "$dest_file"; then
    install -m 0644 "$tmp_file" "$dest_file"
  fi

  rm -f "$tmp_file"
done
