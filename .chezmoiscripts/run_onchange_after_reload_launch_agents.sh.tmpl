{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# private_Library/LaunchAgents/com.user.vncmonitor.plist.tmpl hash: {{ include "private_Library/LaunchAgents/com.user.vncmonitor.plist.tmpl" | sha256sum }}
# private_Library/LaunchAgents/com.ssh-add-keychain.plist.tmpl hash: {{ include "private_Library/LaunchAgents/com.ssh-add-keychain.plist.tmpl" | sha256sum }}
# private_Library/LaunchAgents/Environment.plist.tmpl hash: {{ include "private_Library/LaunchAgents/Environment.plist.tmpl" | sha256sum }}
# private_Library/LaunchAgents/com.user.nfs-dot-clean.plist.tmpl hash: {{ include "private_Library/LaunchAgents/com.user.nfs-dot-clean.plist.tmpl" | sha256sum }}

echo "Reloading LaunchAgents..."

# Function to reload an agent
reload_agent() {
    local plist="$1"
    local label="$2"

    # Check if the plist file exists
    if [ ! -f "$plist" ]; then
        echo "Warning: Plist file not found: $plist"
        return
    fi

    # Unload if currently loaded
    if launchctl list "$label" &>/dev/null; then
        echo "Unloading $label..."
        launchctl unload "$plist"
    fi

    # Load the agent
    echo "Loading $label..."
    if launchctl load "$plist"; then
        echo "Successfully loaded $label"
    else
        echo "Failed to load $label"
    fi
}

# Function to retire a removed agent and its stale target files.
retire_agent() {
    local service_target="$1"
    local plist="$2"
    local helper="$3"
    local runtime_dir="$4"
    local stdout_log="$5"
    local stderr_log="$6"

    echo "Retiring ${service_target##*/}..."
    launchctl bootout "$service_target" >/dev/null 2>&1 || \
        launchctl remove "${service_target##*/}" >/dev/null 2>&1 || true
    rm -f "$plist" "$helper"
    rm -f "$stdout_log" "$stderr_log"
    rm -rf "$runtime_dir"
}

# Expand the home directory for the plist paths
HOME_DIR="{{ .chezmoi.homeDir }}"
retire_agent "gui/$(id -u)/com.user.ssh-agent-relay" \
  "$HOME_DIR/Library/LaunchAgents/com.user.ssh-agent-relay.plist" \
  "$HOME_DIR/bin/macos_ssh_agent_relay.sh" \
  "/tmp/macos-ssh-agent" \
  "/tmp/com.user.ssh-agent-relay.out" \
  "/tmp/com.user.ssh-agent-relay.err"

reload_agent "$HOME_DIR/Library/LaunchAgents/com.user.vncmonitor.plist" "com.user.vncmonitor"
reload_agent "$HOME_DIR/Library/LaunchAgents/com.ssh-add-keychain.plist" "com.ssh-add-keychain"
reload_agent "$HOME_DIR/Library/LaunchAgents/Environment.plist" "Environment"
reload_agent "$HOME_DIR/Library/LaunchAgents/com.user.nfs-dot-clean.plist" "com.user.nfs-dot-clean"

{{- end -}}
