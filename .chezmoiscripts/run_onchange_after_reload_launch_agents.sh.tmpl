{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# private_Library/LaunchAgents/com.user.vncmonitor.plist.tmpl hash: {{ include "private_Library/LaunchAgents/com.user.vncmonitor.plist.tmpl" | sha256sum }}
# private_Library/LaunchAgents/com.ssh-add-keychain.plist hash: {{ include "private_Library/LaunchAgents/com.ssh-add-keychain.plist" | sha256sum }}
# private_Library/LaunchAgents/Environment.plist.tmpl hash: {{ include "private_Library/LaunchAgents/Environment.plist.tmpl" | sha256sum }}

echo "Reloading LaunchAgents..."

# Function to reload an agent
reload_agent() {
    local plist="$1"
    local label="$2"

    # Check if the plist file exists
    if [ ! -f "$plist" ]; then
        echo "Warning: Plist file not found: $plist"
        return
    fi

    # Unload if currently loaded
    if launchctl list "$label" &>/dev/null; then
        echo "Unloading $label..."
        launchctl unload "$plist"
    fi

    # Load the agent
    echo "Loading $label..."
    if launchctl load "$plist"; then
        echo "Successfully loaded $label"
    else
        echo "Failed to load $label"
    fi
}

# Expand the home directory for the plist paths
HOME_DIR="{{ .chezmoi.homeDir }}"

reload_agent "$HOME_DIR/Library/LaunchAgents/com.user.vncmonitor.plist" "com.user.vncmonitor"
reload_agent "$HOME_DIR/Library/LaunchAgents/com.ssh-add-keychain.plist" "com.ssh-add-keychain"
reload_agent "$HOME_DIR/Library/LaunchAgents/Environment.plist" "Environment"

{{- end -}}
