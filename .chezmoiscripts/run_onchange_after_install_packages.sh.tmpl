{{- $isWSL := get . "isWSL" | default false -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $osrel := get .chezmoi.kernel "osrelease" | default "" | lower -}}
{{- $isWSL = or $isWSL ($osrel | contains "microsoft") -}}
{{- end -}}
{{- if and (ne .chezmoi.os "windows") (not $isWSL) -}}
#!/bin/bash

# ============================================================================
# WATCH TRIGGERS (Conditional)
# ============================================================================
# We use a variable for the path, check if it exists (stat), and only THEN include it.

{{- $mise := joinPath .chezmoi.sourceDir "configs/mise.toml" }}
# config/mise.toml hash: {{ if stat $mise }}{{ include $mise | sha256sum }}{{ else }}empty{{ end }}

# Rendered into ~/.config/mise/conf.d/95-beads-dolt.toml. Hash the two values
# rather than all of .chezmoidata.yaml, which changes often enough that every
# unrelated pin bump would re-run the whole hydration.
# beads/dolt pins: {{ .beads_version }}/{{ .dolt_version }}

# Rendered into ~/.config/mise/conf.d/96-codebase-memory-mcp.toml. Keep this
# trigger narrow so unrelated .chezmoidata.yaml changes do not rerun hydration.
# codebase-memory-mcp pin: {{ .codebase_memory_mcp_version }}

{{- $npm := joinPath .chezmoi.sourceDir "configs/npm_globals.txt" }}
# npm_globals.txt hash: {{ if stat $npm }}{{ include $npm | sha256sum }}{{ else }}empty{{ end }}

{{- if $isWSL }}
{{- if eq .chezmoi.osRelease.id "debian" }}
{{- $npm_linux := joinPath .chezmoi.sourceDir "configs/npm_globals_linux_debian.txt" }}
# npm_globals_linux_debian.txt hash: {{ if stat $npm_linux }}{{ include $npm_linux | sha256sum }}{{ else }}empty{{ end }}
{{- else }}
{{- $npm_linux := joinPath .chezmoi.sourceDir "configs/npm_globals_linux.txt" }}
# npm_globals_linux.txt hash: {{ if stat $npm_linux }}{{ include $npm_linux | sha256sum }}{{ else }}empty{{ end }}
{{- end }}
{{- end }}

{{- $bun := joinPath .chezmoi.sourceDir "configs/bun_globals.txt" }}
# bun_globals.txt hash: {{ if stat $bun }}{{ include $bun | sha256sum }}{{ else }}empty{{ end }}

{{- $uv := joinPath .chezmoi.sourceDir "configs/uv_tools.txt" }}
# uv_tools.txt hash: {{ if stat $uv }}{{ include $uv | sha256sum }}{{ else }}empty{{ end }}

set -e

echo "Starting Hydration of non-brew packages..."

# Define the absolute path to your configs
CONFIG_DIR="{{ .chezmoi.sourceDir }}/configs"

is_windows_mounted_path() {
  local candidate resolved
  candidate="$1"

  if command -v readlink >/dev/null 2>&1; then
    resolved="$(readlink -f -- "$candidate" 2>/dev/null || printf '%s' "$candidate")"
  else
    resolved="$candidate"
  fi

  [[ "$candidate" == /mnt/[[:alpha:]]/* || "$resolved" == /mnt/[[:alpha:]]/* ]]
}

prepend_path_entry() {
  local entry path_value
  entry="$1"
  path_value="${PATH:-}"

  [[ -d "$entry" ]] || return 0

  case ":$path_value:" in
    *":$entry:"*) ;;
    *) export PATH="$entry${path_value:+:$path_value}" ;;
  esac
}

resolve_native_path_command() {
  local tool candidate entry found_windows path_value
  tool="$1"
  found_windows=""

  {{- if $isWSL }}
  for entry in "$HOME/.local/share/mise/shims" "$HOME/.local/bin" "$HOME/.bun/bin" "$HOME/bin"; do
    prepend_path_entry "$entry"
  done
  {{- end }}

  path_value="${PATH:-}"
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    candidate="${entry%/}/$tool"
    [[ -x "$candidate" && ! -d "$candidate" ]] || continue

    {{- if $isWSL }}
    if is_windows_mounted_path "$candidate"; then
      found_windows="${found_windows}${found_windows:+, }$candidate"
      continue
    fi
    {{- end }}

    printf '%s\n' "$candidate"
    return 0
  done < <(printf '%s' "$path_value" | tr ':' '\n')

    {{- if $isWSL }}
  if [[ -n "$found_windows" ]]; then
    echo "❌Error: only Windows-mounted candidates found for $tool: $found_windows" >&2
    return 1
  fi
  {{- end }}

  echo "❌Error: required command not found: $tool" >&2
  return 1
}

resolve_mise_managed_command() {
  local tool mise_bin resolved
  tool="$1"

  [[ "$tool" != "mise" ]] || return 1

  mise_bin="$(resolve_native_path_command mise 2>/dev/null)" || return 1
  resolved="$(env -u ComSpec -u COMSPEC -u npm_config_script_shell -u NPM_CONFIG_SCRIPT_SHELL \
    "$mise_bin" which "$tool" 2>/dev/null || true)"

  [[ -n "$resolved" && -x "$resolved" && ! -d "$resolved" ]] || return 1
  {{- if $isWSL }}
  is_windows_mounted_path "$resolved" && return 1
  {{- end }}

  printf '%s\n' "$resolved"
  return 0
}

resolve_native_command() {
  local tool
  tool="$1"

  resolve_mise_managed_command "$tool" && return 0
  resolve_native_path_command "$tool"
}

run_native_command() {
  local tool tool_bin
  tool="$1"
  shift
  tool_bin="$(resolve_native_command "$tool")" || return 1
  env -u ComSpec -u COMSPEC -u npm_config_script_shell -u NPM_CONFIG_SCRIPT_SHELL \
    "$tool_bin" "$@"
}

run_manifest_lines() {
  local manifest_file tool
  manifest_file="$1"
  tool="$2"
  shift 2

  while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^# ]] && continue
    run_native_command "$tool" "$@" "$line"
  done < "$manifest_file"
}

# 1. ENSURE BREW & MISE ARE AVAILABLE
if [[ -d "/opt/homebrew/bin" ]]; then
  export PATH="/opt/homebrew/bin:$PATH"
elif [[ -d "/usr/local/bin" ]]; then
  export PATH="/usr/local/bin:$PATH"
fi

if ! resolve_native_command mise >/dev/null 2>&1; then
    echo "❌Error: mise not found. Please run 'brew install mise' first."
    exit 1
fi

# 2. ACTIVATE MISE ENVIRONMENT
eval "$(run_native_command mise activate bash)"

echo "Installing Runtimes from mise.toml..."
run_native_command mise install -y
run_native_command mise reshim

# 3. HYDRATE NPM GLOBAL PACKAGES
NPM_FILE="$CONFIG_DIR/npm_globals.txt"
if [ -s "$NPM_FILE" ]; then
    echo "Syncing NPM global packages..."
    run_manifest_lines "$NPM_FILE" npm install -g
fi

{{- if $isWSL }}
{{- if eq .chezmoi.osRelease.id "debian" }}
NPM_LINUX_FILE="$CONFIG_DIR/npm_globals_linux_debian.txt"
{{- else }}
NPM_LINUX_FILE="$CONFIG_DIR/npm_globals_linux.txt"
{{- end }}
if [ -s "$NPM_LINUX_FILE" ]; then
    echo "Syncing Linux-specific NPM packages..."
    run_manifest_lines "$NPM_LINUX_FILE" npm install -g
fi
{{- end }}

# 5. HYDRATE BUN GLOBAL PACKAGES
BUN_FILE="$CONFIG_DIR/bun_globals.txt"
if [ -s "$BUN_FILE" ]; then
    echo "Syncing Bun global packages..."
    if resolve_native_command bun >/dev/null 2>&1; then
        run_manifest_lines "$BUN_FILE" bun add -g
    fi
fi

# 6. HYDRATE UV TOOLS
UV_FILE="$CONFIG_DIR/uv_tools.txt"
if [ -s "$UV_FILE" ]; then
    echo "Syncing UV Tools..."

    if resolve_native_command uv >/dev/null 2>&1; then
        while IFS= read -r tool; do
            [[ -z "$tool" || "$tool" =~ ^# ]] && continue
            # Check if already installed to save time
            if ! run_native_command uv tool list | grep -q "^$tool "; then
                echo "   + Installing $tool..."
                run_native_command uv tool install "$tool" --force
            fi
        done < "$UV_FILE"
    else
        echo "uv binary not found. Check mise install."
    fi
fi

echo "Hydration Complete."

{{- end -}}
