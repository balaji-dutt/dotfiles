{{- $osrel := "" -}}
{{- $isWSL := false -}}
{{- $isWSL2 := false -}}
{{- $isDebianWSL2 := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $osrel = (get .chezmoi.kernel "osrelease" | default "" | lower) -}}
{{- $isWSL = or (get . "isWSL" | default false) ($osrel | contains "microsoft") -}}
{{- $isWSL2 = or (get . "isWSL2" | default false) (and $isWSL ($osrel | contains "wsl2")) -}}
{{- end -}}
{{- $isDebianWSL2 = or (get . "isDebianWSL2" | default false) (and $isWSL2 (eq .chezmoi.osRelease.id "debian")) -}}
{{- $isDevcontainerHost := or (get . "isDevcontainerHost" | default false) (eq .chezmoi.os "darwin") $isDebianWSL2 -}}
{{- if $isDevcontainerHost -}}
#!/usr/bin/env bash
set -euo pipefail

# assets/render-container-configs.sh hash: {{ include "assets/render-container-configs.sh" | sha256sum }}
# private_dot_config/opencode/private_opencode.env.tmpl hash: {{ include "private_dot_config/opencode/private_opencode.env.tmpl" | sha256sum }}

echo "INFO: Container render inputs changed; run ./assets/render-container-configs.sh before rebuilding devcontainers."
echo "INFO: Also rerun it whenever the underlying 1Password secrets rotate."
{{- end -}}
