{{- $osrel := "" -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $osrel = (.chezmoi.kernel.osrelease | lower) -}}
{{- end -}}
{{- $isWSL2 := and (eq .chezmoi.os "linux") ($osrel | contains "microsoft") ($osrel | contains "wsl2") -}}
{{- $isDevcontainerHost := or (eq .chezmoi.os "darwin") (and $isWSL2 (eq .chezmoi.osRelease.id "debian")) -}}
{{- if $isDevcontainerHost -}}
#!/usr/bin/env bash
set -euo pipefail

# assets/render-container-configs.sh hash: {{ include "assets/render-container-configs.sh" | sha256sum }}
# private_dot_config/opencode/private_opencode.env.tmpl hash: {{ include "private_dot_config/opencode/private_opencode.env.tmpl" | sha256sum }}

echo "INFO: Container render inputs changed; run ./assets/render-container-configs.sh before rebuilding devcontainers."
echo "INFO: Also rerun it whenever the underlying 1Password secrets rotate."
{{- end -}}
