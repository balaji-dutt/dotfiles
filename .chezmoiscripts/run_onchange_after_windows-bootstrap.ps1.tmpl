{{- if ne .chezmoi.os "windows" -}}
{{- /* not Windows */ -}}
{{- else -}}
$ErrorActionPreference = "Stop"

Write-Host "== Windows bootstrap (chezmoi run_once) =="

# =========================
# Desired PATH entries (edit here)
# =========================
$DesiredUserPathEntries = @(
  @{ Path = "$HOME\.local"; Create = $true;  Position = "Append" }
  @{ Path = "C:\Program Files\Docker\Docker"; Create = $false; Position = "Prepend"  }
  # Enables use of `smerge` from Terminal
  @{ Path = "C:\Program Files\Sublime Merge"; Create = $false; Position = "Prepend"  }
  # Enables use of `subl` from Terminal
  @{ Path = "C:\Program Files\Sublime Text"; Create = $false; Position = "Prepend"  }
)

# =========================
# Implementation
# =========================
function Resolve-PathForEnvPath {
  param([Parameter(Mandatory)][string] $Path)

  $p = $Path.Trim().Trim('"')

  if ($p.StartsWith('~')) {
    $p = Join-Path $HOME $p.Substring(1)
  }

  $p = [Environment]::ExpandEnvironmentVariables($p)

  # Normalize (doesn't require path to exist)
  return [System.IO.Path]::GetFullPath($p).TrimEnd('\','/')
}

function Ensure-Directory {
  param([Parameter(Mandatory)][string] $Path)

  if (-not (Test-Path -LiteralPath $Path)) {
    New-Item -ItemType Directory -Force -Path $Path | Out-Null
    Write-Host "Created: $Path"
  } else {
    Write-Host "Exists:  $Path"
  }
}

function Update-PathString {
  # Pure function: takes a PATH string and returns an updated PATH string
  param(
    [Parameter(Mandatory)][AllowEmptyString()][string] $CurrentPath,
    [Parameter(Mandatory)][object[]] $Entries,
    [switch] $SkipMissing
  )

  $parts = $CurrentPath -split ';' | Where-Object { $_ -and $_.Trim() -ne '' }

  $existingNorm = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
  foreach ($part in $parts) {
    [void]$existingNorm.Add((Resolve-PathForEnvPath $part))
  }

  $toPrepend = New-Object 'System.Collections.Generic.List[string]'
  $toAppend  = New-Object 'System.Collections.Generic.List[string]'

  foreach ($e in $Entries) {
    $raw = [string]$e.Path
    if ([string]::IsNullOrWhiteSpace($raw)) { continue }

    $path = Resolve-PathForEnvPath $raw

    $create = [bool]($e.PSObject.Properties.Name -contains 'Create' -and $e.Create)
    $position =
      if ($e.PSObject.Properties.Name -contains 'Position' -and $e.Position) { [string]$e.Position }
      else { 'Prepend' }

    if ($create) {
      Ensure-Directory $path
    } elseif (-not (Test-Path -LiteralPath $path)) {
      $msg = "Missing path (won't add): $path"
      if ($SkipMissing) { Write-Warning $msg; continue }
      throw $msg
    }

    if ($existingNorm.Contains($path)) {
      # Already present: don't add again (and we don't reorder)
      continue
    }

    [void]$existingNorm.Add($path)

    switch ($position.ToLowerInvariant()) {
      'prepend' { [void]$toPrepend.Add($path) }
      'append'  { [void]$toAppend.Add($path) }
      default   { throw "Invalid Position '$position' for entry '$raw'. Use Prepend or Append." }
    }
  }

  if ($toPrepend.Count -eq 0 -and $toAppend.Count -eq 0) {
    return $CurrentPath
  }

  return (@($toPrepend.ToArray()) + $parts + @($toAppend.ToArray())) -join ';'
}

function Get-EnvironmentPath([string]$Scope) {
  return [Environment]::GetEnvironmentVariable('Path', $Scope)
}

function Set-EnvironmentPath([string]$Value, [string]$Scope) {
  [Environment]::SetEnvironmentVariable('Path', $Value, $Scope)
}

function Add-ToEnvPath {
  [CmdletBinding(SupportsShouldProcess)]
  param(
    [Parameter(Mandatory)]
    [object[]] $Entries,

    [ValidateSet('User','Machine')]
    [string] $Scope = 'User',

    # When an entry doesn't exist and Create=$false:
    # - default: throw (fail fast)
    # - with -SkipMissing: warn and skip
    [switch] $SkipMissing,

    # Also update the current PowerShell session immediately
    [switch] $UpdateSession = $true
  )

  # 1) Update persistent PATH (User or Machine)
  $currentPersistent = Get-EnvironmentPath -Scope $Scope
  if ([string]::IsNullOrWhiteSpace($currentPersistent)) { $currentPersistent = '' }

  $newPersistent = Update-PathString -CurrentPath $currentPersistent -Entries $Entries -SkipMissing:$SkipMissing

  if ($newPersistent -ne $currentPersistent) {
    if ($PSCmdlet.ShouldProcess("$Scope PATH", "Set PATH")) {
      Set-EnvironmentPath -Value $newPersistent -Scope $Scope
      Write-Host "Updated $Scope PATH (persistent)."
    }
  } else {
    Write-Host "No changes needed for $Scope PATH (persistent)."
  }

  # 2) Update current session PATH immediately (Process)
  if ($UpdateSession) {
    $currentProcess = Get-EnvironmentPath -Scope Process

    if ([string]::IsNullOrWhiteSpace($currentProcess)) {
      # PS 5.1 compatible replacement for: $env:Path ?? ''
      $currentProcess = $env:Path
      if ($null -eq $currentProcess) { $currentProcess = '' }
    }

    $newProcess = Update-PathString -CurrentPath $currentProcess -Entries $Entries -SkipMissing:$SkipMissing

    if ($newProcess -ne $currentProcess) {
      Set-EnvironmentPath -Value $newProcess -Scope Process
      $env:Path = $newProcess
      Write-Host "Updated current session PATH (immediate; no restart needed for this session)."
    } else {
      Write-Host "No changes needed for current session PATH."
    }
  } else {
    Write-Host "Note: restart your terminal for PATH changes to take effect in new sessions."
  }
}

function Update-PowerShellProfile {
  param([Parameter(Mandatory)][string] $ProfilePath)

  $snippet = @'
# Load Claude Code Environment variables (chezmoi-managed)
$globalEnv = Join-Path $HOME ".config\powershell\claude-env.ps1"
if (Test-Path -LiteralPath $globalEnv) { . $globalEnv }

# Load local overrides/secrets if you use them
$localEnv = Join-Path $HOME ".config\powershell\claude-env.local.ps1"
if (Test-Path -LiteralPath $localEnv) { . $localEnv }
'@

  $profileDir = Split-Path -Parent $ProfilePath
  New-Item -ItemType Directory -Force -Path $profileDir | Out-Null
  if (-not (Test-Path -LiteralPath $ProfilePath)) {
    New-Item -ItemType File -Force -Path $ProfilePath | Out-Null
  }

  $profileText = [string](Get-Content -LiteralPath $ProfilePath -Raw)
  if ($profileText -notmatch [regex]::Escape("claude-env.ps1")) {
    Add-Content -LiteralPath $ProfilePath -Value "`r`n$snippet`r`n"
    Write-Host "Updated pwsh profile to source claude env: $ProfilePath"
  } else {
    Write-Host "pwsh profile already sources claude env: $ProfilePath"
  }
}

function Invoke-WindowsBootstrap {
  Add-ToEnvPath -Scope User -Entries $DesiredUserPathEntries
  Update-PowerShellProfile -ProfilePath $PROFILE.CurrentUserCurrentHost
  Write-Host "== Done =="
}

if ($MyInvocation.InvocationName -ne '.') {
  Invoke-WindowsBootstrap
}
{{- end -}}
