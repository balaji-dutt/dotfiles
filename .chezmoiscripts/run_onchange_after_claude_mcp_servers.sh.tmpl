{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
set -euo pipefail

# configs/claude-mcp.json hash: {{ include "configs/claude-mcp.json" | sha256sum }}
# assets/claude-mcp-apply.py hash: {{ include "assets/claude-mcp-apply.py" | sha256sum }}

config_path={{ printf "%s/configs/claude-mcp.json" .chezmoi.sourceDir | quote }}
applier_path={{ printf "%s/assets/claude-mcp-apply.py" .chezmoi.sourceDir | quote }}

if ! command -v claude >/dev/null 2>&1; then
  echo "INFO: claude command not found; skipping Claude MCP configuration."
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "INFO: python3 command not found; skipping Claude MCP configuration."
  exit 0
fi

if [[ ! -f "$applier_path" ]]; then
  echo "ERROR: Claude MCP applier not found: $applier_path"
  exit 1
fi

python3 "$applier_path" "$config_path"

{{ end -}}
