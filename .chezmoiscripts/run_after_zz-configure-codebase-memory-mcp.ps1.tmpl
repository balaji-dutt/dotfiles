{{- if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = "Stop"

$CbmPath = Join-Path (Join-Path $HOME ".local") "codebase-memory-mcp.exe"
# CBM bounds its own startup contention, in sequence: a 10s version-cohort
# deadline followed by a 120s startup-transition backstop. Kill the CLI sooner
# and a force-killed lock holder is left for the next run to wait out.
$CbmTimeoutSeconds = 150

function Invoke-CbmNative {
  param(
    [Parameter(Mandatory)][string] $Path,
    [Parameter(Mandatory)][AllowEmptyCollection()][string[]] $Arguments,
    [Parameter(Mandatory)][ValidateRange(1, 300)][int] $TimeoutSeconds,
    [switch] $AllowFailure
  )

  $startInfo = [System.Diagnostics.ProcessStartInfo]::new()
  $startInfo.FileName = $Path
  $startInfo.UseShellExecute = $false
  $startInfo.CreateNoWindow = $true
  $startInfo.RedirectStandardOutput = $true
  $startInfo.RedirectStandardError = $true
  foreach ($argument in $Arguments) {
    [void] $startInfo.ArgumentList.Add($argument)
  }

  $process = [System.Diagnostics.Process]::new()
  $process.StartInfo = $startInfo
  try {
    if (-not $process.Start()) {
      throw "Could not start '$Path'."
    }

    $stdoutTask = $process.StandardOutput.ReadToEndAsync()
    $stderrTask = $process.StandardError.ReadToEndAsync()
    $timedOut = -not $process.WaitForExit($TimeoutSeconds * 1000)
    if ($timedOut) {
      try {
        $process.Kill($true)
      } catch {
        try { $process.Kill() } catch { }
      }
      [void] $process.WaitForExit(2000)
    }

    $stillRunning = -not $process.HasExited
    $stdout = ""
    $stderr = ""
    $exitCode = $null
    if (-not $stillRunning) {
      $exitCode = $process.ExitCode
      $outputDeadline = [DateTime]::UtcNow.AddSeconds(2)
      try {
        $remaining = [Math]::Max(0, [int]($outputDeadline - [DateTime]::UtcNow).TotalMilliseconds)
        if ($stdoutTask.Wait($remaining)) {
          $stdout = $stdoutTask.GetAwaiter().GetResult()
        } else {
          $timedOut = $true
        }
      } catch {
        $timedOut = $true
      }
      try {
        $remaining = [Math]::Max(0, [int]($outputDeadline - [DateTime]::UtcNow).TotalMilliseconds)
        if ($stderrTask.Wait($remaining)) {
          $stderr = $stderrTask.GetAwaiter().GetResult()
        } else {
          $timedOut = $true
        }
      } catch {
        $timedOut = $true
      }
    }

    if ($AllowFailure) {
      return [pscustomobject]@{
        ExitCode     = $exitCode
        Stdout       = $stdout.Trim()
        Stderr       = $stderr.Trim()
        TimedOut     = $timedOut
        StillRunning = $stillRunning
        ProcessId    = $process.Id
      }
    }

    if ($timedOut) {
      throw "Timed out running '$Path' with arguments '$($Arguments -join ' ')'."
    }

    if ($exitCode -ne 0) {
      $detail = @($stdout, $stderr) |
        Where-Object { -not [string]::IsNullOrWhiteSpace($_) } |
        Join-String -Separator "`n"
      throw "codebase-memory-mcp exited with code ${exitCode}: $detail"
    }

    return $stdout.Trim()
  } finally {
    $process.Dispose()
  }
}

# The CBM CLI refuses to start, or waits out its own coordination deadlines,
# while any other CBM process holds the daemon admission gate. Neither outcome
# is conclusive until none are running.
function Invoke-CbmConfigOrSkip {
  param(
    [Parameter(Mandatory)][string[]] $Arguments,
    [Parameter(Mandatory)][string] $Path,
    [Parameter(Mandatory)][ValidateRange(1, 300)][int] $TimeoutSeconds
  )

  $result = Invoke-CbmNative -Path $Path -Arguments $Arguments -TimeoutSeconds $TimeoutSeconds -AllowFailure
  if (-not $result.TimedOut -and $result.ExitCode -eq 0) {
    return [pscustomobject]@{ Skipped = $false; Value = $result.Stdout }
  }

  $detail = @(
    if ($result.TimedOut) { "no complete response within $TimeoutSeconds seconds" }
    $result.Stdout
    $result.Stderr
  ) |
    Where-Object { -not [string]::IsNullOrWhiteSpace($_) } |
    Join-String -Separator " "

  # A killed child can outlive its own timeout, so it must not count as the
  # live session that excuses the failure.
  $live = @(
    Get-Process -Name "codebase-memory-mcp" -ErrorAction SilentlyContinue |
      Where-Object { $_.Id -ne $result.ProcessId }
  )
  if ($live.Count -gt 0) {
    Write-Warning "codebase-memory-mcp CLI did not complete while CBM sessions are active; auto_index was not verified this run. CBM reported: $detail"
    return [pscustomobject]@{ Skipped = $true; Value = $null }
  }

  if ($result.TimedOut) {
    throw "codebase-memory-mcp $($Arguments -join ' ') did not finish within $TimeoutSeconds seconds and no CBM session explains the delay: $detail"
  }

  throw "codebase-memory-mcp $($Arguments -join ' ') exited with code $($result.ExitCode): $detail"
}

function Invoke-CbmAutoIndexConfigure {
  param(
    [string] $Path = $CbmPath,
    [ValidateRange(1, 300)][int] $TimeoutSeconds = $CbmTimeoutSeconds
  )

  if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
    throw "codebase-memory-mcp is not installed at '$Path'."
  }

  Write-Host "INFO: verifying codebase-memory-mcp auto_index; this waits up to $TimeoutSeconds seconds for CBM startup coordination."

  $read = Invoke-CbmConfigOrSkip -Arguments @("config", "get", "auto_index") -Path $Path -TimeoutSeconds $TimeoutSeconds
  if ($read.Skipped) {
    return
  }

  if ($read.Value -ne "true") {
    $applied = Invoke-CbmConfigOrSkip -Arguments @("config", "set", "auto_index", "true") -Path $Path -TimeoutSeconds $TimeoutSeconds
    if ($applied.Skipped) {
      return
    }

    $read = Invoke-CbmConfigOrSkip -Arguments @("config", "get", "auto_index") -Path $Path -TimeoutSeconds $TimeoutSeconds
    if ($read.Skipped) {
      return
    }
  }

  if ($read.Value -ne "true") {
    throw "codebase-memory-mcp auto_index verification failed."
  }

  Write-Host "INFO: codebase-memory-mcp auto_index is enabled for the active cache."
}

if ($MyInvocation.InvocationName -ne '.') {
  Invoke-CbmAutoIndexConfigure
}
{{- end -}}
