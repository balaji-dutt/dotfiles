{{- if eq .chezmoi.os "windows" -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

$helper = Join-Path '{{ .chezmoi.sourceDir | replace "'" "''" }}' 'assets/cbm-prune-orphans.py'
$repoRoot = '{{ .chezmoi.workingTree | replace "'" "''" }}'
$pythonCommand = $null
$pythonPrefix = @()

foreach ($candidate in @(
  @{ Name = "python3"; Prefix = @() },
  @{ Name = "python"; Prefix = @() },
  @{ Name = "py"; Prefix = @("-3") }
)) {
  $command = Get-Command $candidate.Name -ErrorAction SilentlyContinue
  if (-not $command) {
    continue
  }
  $probeArguments = @($candidate.Prefix) + @(
    "-c"
    "import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)"
  )
  try {
    & $command.Source @probeArguments 2>$null
    $probeExitCode = $LASTEXITCODE
  } catch {
    $probeExitCode = -1
  }
  if ($probeExitCode -eq 0) {
    $pythonCommand = $command.Source
    $pythonPrefix = $candidate.Prefix
    break
  }
}

if (-not $pythonCommand) {
  Write-Warning "Python 3.9 or newer is unavailable; orphaned CBM indexes were not pruned."
  exit 0
}

$arguments = @($pythonPrefix) + @("-I", $helper, "--apply", "--keep", $repoRoot)
& $pythonCommand @arguments
if ($LASTEXITCODE -ne 0) {
  throw "CBM index pruning failed with exit code $LASTEXITCODE."
}
{{- end -}}
