{{- if ne .chezmoi.os "windows" -}}
{{- /* not Windows: do nothing */ -}}
{{- else -}}
# Install or upgrade the standard codebase-memory-mcp binary to the version
# pinned in .chezmoidata.yaml. Bumping the pin changes the rendered script and
# causes chezmoi to run it again.
#
# mise provisions macOS and WSL2. Dev Containers use their pinned feature
# installer. This hook owns only the native Windows binary; MCP client
# configuration remains under chezmoi.
#
# Change trigger:
# codebase_memory_mcp_version: {{ .codebase_memory_mcp_version }}

$ErrorActionPreference = "Stop"
$ProgressPreference    = "SilentlyContinue"

$CbmVersion = "{{ .codebase_memory_mcp_version }}"
$Repo       = "DeusData/codebase-memory-mcp"
$InstallDir = Join-Path $HOME ".local"
$BinPath    = Join-Path $InstallDir "codebase-memory-mcp.exe"
$CacheDir   = $env:CBM_CACHE_DIR
$CbmVersionTimeoutSeconds = 5
$CbmStopTimeoutSeconds    = 10
$CbmExitTimeoutSeconds    = 5

if ([string]::IsNullOrWhiteSpace($CacheDir)) {
  $CacheDir = Join-Path (Join-Path $HOME ".cache") "codebase-memory-mcp"
}

if ([string]::IsNullOrWhiteSpace($CbmVersion)) {
  throw "codebase_memory_mcp_version is empty in .chezmoidata.yaml"
}

function Get-NativeReleaseArchitecture {
  $architecture = ""

  try {
    $architecture = [System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString()
  } catch {
    # RuntimeInformation is unavailable on some older Windows PowerShell hosts.
  }

  if ([string]::IsNullOrWhiteSpace($architecture)) {
    if (-not [string]::IsNullOrWhiteSpace($env:PROCESSOR_ARCHITEW6432)) {
      $architecture = $env:PROCESSOR_ARCHITEW6432
    } else {
      $architecture = $env:PROCESSOR_ARCHITECTURE
    }
  }

  switch ($architecture) {
    "X64"   { return "amd64" }
    "AMD64" { return "amd64" }
    "ARM64" { return "arm64" }
    default  { throw "Unsupported Windows architecture for codebase-memory-mcp: $architecture" }
  }
}

function Get-CbmVersion {
  param([Parameter(Mandatory)][string] $Path)

  if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
    return ""
  }

  try {
    $result = Invoke-CbmNative -Path $Path -Arguments @("--version") -TimeoutSeconds $CbmVersionTimeoutSeconds
    if ($result.TimedOut) {
      Write-Warning "Timed out reading the codebase-memory-mcp version from '$Path'."
      return ""
    }
    if ($result.ExitCode -ne 0) {
      return ""
    }
  } catch {
    return ""
  }

  $versionText = [string] $result.Output
  $versionMatch = [regex]::Match(
    $versionText,
    '(?<!\d)(\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?)(?![0-9A-Za-z.-])'
  )

  if ($versionMatch.Success) {
    return $versionMatch.Groups[1].Value
  }

  return ""
}

function Invoke-CbmNative {
  param(
    [Parameter(Mandatory)][string] $Path,
    [Parameter(Mandatory)][AllowEmptyCollection()][string[]] $Arguments,
    [Parameter(Mandatory)][ValidateRange(1, 300)][int] $TimeoutSeconds
  )

  $startInfo = [System.Diagnostics.ProcessStartInfo]::new()
  $startInfo.FileName = $Path
  $startInfo.UseShellExecute = $false
  $startInfo.CreateNoWindow = $true
  $startInfo.RedirectStandardOutput = $true
  $startInfo.RedirectStandardError = $true
  foreach ($argument in $Arguments) {
    [void] $startInfo.ArgumentList.Add($argument)
  }

  $process = [System.Diagnostics.Process]::new()
  $process.StartInfo = $startInfo
  try {
    if (-not $process.Start()) {
      throw "Could not start '$Path'."
    }

    $stdoutTask = $process.StandardOutput.ReadToEndAsync()
    $stderrTask = $process.StandardError.ReadToEndAsync()
    $timedOut = -not $process.WaitForExit($TimeoutSeconds * 1000)
    if ($timedOut) {
      try {
        $process.Kill($true)
      } catch {
        try { $process.Kill() } catch { }
      }
      [void] $process.WaitForExit(2000)
    }

    $stillRunning = -not $process.HasExited
    $stdout = ""
    $stderr = ""
    $exitCode = $null
    if (-not $stillRunning) {
      $exitCode = $process.ExitCode
      $outputDeadline = [DateTime]::UtcNow.AddSeconds(2)
      try {
        $remaining = [Math]::Max(0, [int]($outputDeadline - [DateTime]::UtcNow).TotalMilliseconds)
        if ($stdoutTask.Wait($remaining)) {
          $stdout = $stdoutTask.GetAwaiter().GetResult()
        } else {
          $timedOut = $true
        }
      } catch {
        $timedOut = $true
      }
      try {
        $remaining = [Math]::Max(0, [int]($outputDeadline - [DateTime]::UtcNow).TotalMilliseconds)
        if ($stderrTask.Wait($remaining)) {
          $stderr = $stderrTask.GetAwaiter().GetResult()
        } else {
          $timedOut = $true
        }
      } catch {
        $timedOut = $true
      }
    }

    return [pscustomobject]@{
      ExitCode = $exitCode
      Output = @($stdout, $stderr) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Join-String -Separator "`n"
      TimedOut = $timedOut
      StillRunning = $stillRunning
      ProcessId = $process.Id
    }
  } finally {
    $process.Dispose()
  }
}

function Get-NormalizedExecutablePath {
  param([Parameter(Mandatory)][string] $Path)

  $separators = [char[]]@(
    [System.IO.Path]::DirectorySeparatorChar,
    [System.IO.Path]::AltDirectorySeparatorChar
  )
  return [System.IO.Path]::GetFullPath($Path).TrimEnd($separators)
}

function Test-SameExecutablePath {
  param(
    [Parameter(Mandatory)][string] $First,
    [Parameter(Mandatory)][string] $Second
  )

  try {
    $firstPath = Get-NormalizedExecutablePath -Path $First
    $secondPath = Get-NormalizedExecutablePath -Path $Second
    return [string]::Equals($firstPath, $secondPath, [System.StringComparison]::OrdinalIgnoreCase)
  } catch {
    return $false
  }
}

function Get-CodingAgentProcessState {
  $details = @()
  $cimError = $null

  if (Get-Command Get-CimInstance -ErrorAction SilentlyContinue) {
    try {
      $filter = "Name = 'claude.exe' OR Name = 'opencode.exe'"
      foreach ($process in @(Get-CimInstance Win32_Process -Filter $filter -ErrorAction Stop)) {
        $details += [pscustomobject]@{
          Name = $process.Name
          Id = $process.ProcessId
          SessionId = $process.SessionId
          ParentProcessId = $process.ParentProcessId
          Path = $process.ExecutablePath
        }
      }
      return [pscustomobject]@{
        Status = $(if ($details.Count) { "Running" } else { "Stopped" })
        Processes = @($details)
        Error = $null
      }
    } catch {
      $cimError = $_.Exception.Message
    }
  }

  $details = @()
  try {
    foreach ($process in @(Get-Process -ErrorAction Stop | Where-Object { $_.ProcessName -iin @("claude", "opencode") })) {
      $processPath = $null
      try { $processPath = $process.Path } catch { }
      $details += [pscustomobject]@{
        Name = $process.ProcessName + ".exe"
        Id = $process.Id
        SessionId = $process.SessionId
        ParentProcessId = $null
        Path = $processPath
      }
    }
    return [pscustomobject]@{
      Status = $(if ($details.Count) { "Running" } else { "Stopped" })
      Processes = @($details)
      Error = $null
    }
  } catch {
    $errors = @($cimError, $_.Exception.Message) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) }
    return [pscustomobject]@{ Status = "Unknown"; Processes = @(); Error = ($errors -join "; ") }
  }
}

function Write-CodingAgentProcessDetails {
  param([Parameter(Mandatory)][AllowEmptyCollection()][object[]] $Processes)

  foreach ($process in $Processes) {
    $parts = @("name=$($process.Name)", "pid=$($process.Id)")
    if ($null -ne $process.SessionId) { $parts += "session=$($process.SessionId)" }
    if ($null -ne $process.ParentProcessId) { $parts += "parent=$($process.ParentProcessId)" }
    if (-not [string]::IsNullOrWhiteSpace($process.Path)) { $parts += "path=$($process.Path)" }
    Write-Host "INFO: Blocking coding-agent process: $($parts -join ' ')"
  }
}

function Assert-CodingAgentsStopped {
  param([Parameter(Mandatory)][string] $Phase)

  $state = Get-CodingAgentProcessState
  if ($state.Status -eq "Stopped") {
    return
  }
  if ($state.Status -eq "Running") {
    Write-CodingAgentProcessDetails -Processes @($state.Processes)
    throw "Claude Code or OpenCode is running; deferred $Phase. Exit both applications and run chezmoi apply again from standalone PowerShell."
  }
  throw "Could not safely inspect Claude Code and OpenCode processes; deferred ${Phase}: $($state.Error). Run chezmoi apply again from standalone PowerShell."
}

function Get-ManagedCbmProcessState {
  param([Parameter(Mandatory)][string] $ManagedPath)

  $details = @()
  $cimError = $null
  if (Get-Command Get-CimInstance -ErrorAction SilentlyContinue) {
    try {
      $unresolved = @()
      foreach ($process in @(Get-CimInstance Win32_Process -Filter "Name = 'codebase-memory-mcp.exe'" -ErrorAction Stop)) {
        if ([string]::IsNullOrWhiteSpace($process.ExecutablePath)) {
          $unresolved += $process.ProcessId
          continue
        }
        if (Test-SameExecutablePath -First $process.ExecutablePath -Second $ManagedPath) {
          $details += [pscustomobject]@{
            Id = $process.ProcessId
            SessionId = $process.SessionId
            ParentProcessId = $process.ParentProcessId
            Path = $process.ExecutablePath
          }
        }
      }
      if ($unresolved.Count -eq 0) {
        return [pscustomobject]@{ Status = "Known"; Processes = @($details); Error = $null }
      }
      $cimError = "CIM did not expose executable paths for PID(s): $($unresolved -join ', ')"
    } catch {
      $cimError = $_.Exception.Message
    }
  }

  $details = @()
  try {
    foreach ($process in @(Get-Process -ErrorAction Stop | Where-Object { $_.ProcessName -ieq "codebase-memory-mcp" })) {
      $processPath = $null
      try { $processPath = $process.Path } catch { }
      if ([string]::IsNullOrWhiteSpace($processPath)) {
        throw "Could not read the executable path for codebase-memory-mcp PID $($process.Id)"
      }
      if (Test-SameExecutablePath -First $processPath -Second $ManagedPath) {
        $details += [pscustomobject]@{
          Id = $process.Id
          SessionId = $process.SessionId
          ParentProcessId = $null
          Path = $processPath
        }
      }
    }
    return [pscustomobject]@{ Status = "Known"; Processes = @($details); Error = $null }
  } catch {
    $errors = @($cimError, $_.Exception.Message) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) }
    return [pscustomobject]@{ Status = "Unknown"; Processes = @(); Error = ($errors -join "; ") }
  }
}

function Write-ManagedCbmProcessDetails {
  param([Parameter(Mandatory)][AllowEmptyCollection()][object[]] $Processes)

  foreach ($process in $Processes) {
    $parts = @("pid=$($process.Id)")
    if ($null -ne $process.SessionId) { $parts += "session=$($process.SessionId)" }
    if ($null -ne $process.ParentProcessId) { $parts += "parent=$($process.ParentProcessId)" }
    $parts += "path=$($process.Path)"
    Write-Host "INFO: Managed codebase-memory-mcp process: $($parts -join ' ')"
  }
}

function Stop-CbmProcessById {
  param(
    [Parameter(Mandatory)][int] $Id,
    [Parameter(Mandatory)][string] $ManagedPath
  )

  $process = Get-Process -Id $Id -ErrorAction Stop
  $processPath = $null
  try { $processPath = $process.Path } catch { }
  if ([string]::IsNullOrWhiteSpace($processPath) -or -not (Test-SameExecutablePath -First $processPath -Second $ManagedPath)) {
    throw "Refusing to stop PID $Id because its executable path no longer matches '$ManagedPath'."
  }
  Stop-Process -Id $Id -Force -ErrorAction Stop
}

function Wait-ForManagedCbmProcessesToExit {
  param(
    [Parameter(Mandatory)][string] $ManagedPath,
    [Parameter(Mandatory)][ValidateRange(0, 60)][int] $TimeoutSeconds
  )

  $deadline = [DateTime]::UtcNow.AddSeconds($TimeoutSeconds)
  do {
    $state = Get-ManagedCbmProcessState -ManagedPath $ManagedPath
    if ($state.Status -eq "Unknown" -or $state.Processes.Count -eq 0) {
      return $state
    }
    if ([DateTime]::UtcNow -ge $deadline) {
      return $state
    }
    Start-Sleep -Milliseconds 250
  } while ($true)
}

function Stop-CbmForUpgrade {
  param([Parameter(Mandatory)][string] $ManagedPath)

  try {
    $shutdown = Invoke-CbmNative -Path $ManagedPath -Arguments @("daemon", "stop") -TimeoutSeconds $CbmStopTimeoutSeconds
    if ($shutdown.TimedOut) {
      Write-Warning "codebase-memory-mcp daemon stop timed out after $CbmStopTimeoutSeconds seconds; checking for stale managed processes."
    } elseif ($shutdown.ExitCode -ne 0) {
      Write-Warning "codebase-memory-mcp daemon stop exited with code $($shutdown.ExitCode); checking for stale managed processes."
    }
  } catch {
    Write-Warning "Could not request codebase-memory-mcp daemon shutdown; checking for stale managed processes."
  }

  $state = Get-ManagedCbmProcessState -ManagedPath $ManagedPath
  if ($state.Status -eq "Unknown") {
    throw "Could not safely inspect managed codebase-memory-mcp processes: $($state.Error)"
  }
  if ($state.Processes.Count -eq 0) {
    return
  }

  Assert-CodingAgentsStopped -Phase "stale codebase-memory-mcp cleanup"
  Write-ManagedCbmProcessDetails -Processes @($state.Processes)
  foreach ($process in $state.Processes) {
    Stop-CbmProcessById -Id $process.Id -ManagedPath $ManagedPath
  }

  $remaining = Wait-ForManagedCbmProcessesToExit -ManagedPath $ManagedPath -TimeoutSeconds $CbmExitTimeoutSeconds
  if ($remaining.Status -eq "Unknown") {
    throw "Could not verify managed codebase-memory-mcp process exit: $($remaining.Error)"
  }
  if ($remaining.Processes.Count) {
    Write-ManagedCbmProcessDetails -Processes @($remaining.Processes)
    throw "Managed codebase-memory-mcp process cleanup did not finish within $CbmExitTimeoutSeconds seconds; the existing binary was left in place."
  }
}

function Move-FileWithRetry {
  param(
    [Parameter(Mandatory)][string] $Source,
    [Parameter(Mandatory)][string] $Destination,
    [int] $Attempts = 6
  )

  $lastError = $null
  for ($attempt = 1; $attempt -le $Attempts; $attempt++) {
    try {
      Move-Item -LiteralPath $Source -Destination $Destination -ErrorAction Stop
      return
    } catch {
      $lastError = $_
      if ($attempt -lt $Attempts) {
        Start-Sleep -Milliseconds (250 * $attempt)
      }
    }
  }

  throw "Could not move '$Source' to '$Destination': $($lastError.Exception.Message)"
}

function Remove-RetiredBinaries {
  param([Parameter(Mandatory)][string] $Directory)

  Get-ChildItem -LiteralPath $Directory -Filter "codebase-memory-mcp.exe.retired-*" -File -ErrorAction SilentlyContinue |
    Remove-Item -Force -ErrorAction SilentlyContinue
}

function Invoke-CbmInstaller {
New-Item -ItemType Directory -Force -Path $CacheDir | Out-Null

$InstalledVersion = Get-CbmVersion -Path $BinPath
if ($InstalledVersion -eq $CbmVersion) {
  Remove-RetiredBinaries -Directory $InstallDir
  Write-Host "codebase-memory-mcp $InstalledVersion already installed; nothing to do."
  return
}

if ($InstalledVersion) {
  Write-Host "Updating codebase-memory-mcp: $InstalledVersion -> $CbmVersion"
} else {
  Write-Host "Installing codebase-memory-mcp $CbmVersion..."
}

Assert-CodingAgentsStopped -Phase "codebase-memory-mcp download"

$ReleaseArchitecture = Get-NativeReleaseArchitecture
$Asset                = "codebase-memory-mcp-windows-$ReleaseArchitecture.zip"
$BaseUrl              = "https://github.com/$Repo/releases/download/v$CbmVersion"
$TempDir              = Join-Path ([System.IO.Path]::GetTempPath()) ("codebase-memory-mcp-" + [System.Guid]::NewGuid().ToString("N"))
$ArchivePath          = Join-Path $TempDir $Asset
$ChecksumsPath        = Join-Path $TempDir "checksums.txt"
$ExtractDir           = Join-Path $TempDir "extract"
$StagedPath           = $BinPath + ".new-" + [System.Guid]::NewGuid().ToString("N")
$RetiredPath          = $null
$InstallSucceeded     = $false

New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null
New-Item -ItemType Directory -Force -Path $TempDir | Out-Null

try {
  Invoke-WebRequest -Uri "$BaseUrl/checksums.txt" -OutFile $ChecksumsPath -UseBasicParsing
  Invoke-WebRequest -Uri "$BaseUrl/$Asset" -OutFile $ArchivePath -UseBasicParsing

  $checksumPattern = '^(?<sha>[0-9A-Fa-f]{64})\s+\*?' + [regex]::Escape($Asset) + '\s*$'
  $checksumMatches = @()
  foreach ($line in (Get-Content -LiteralPath $ChecksumsPath)) {
    $lineMatch = [regex]::Match($line, $checksumPattern)
    if ($lineMatch.Success) {
      $checksumMatches += $lineMatch.Groups["sha"].Value.ToLowerInvariant()
    }
  }

  if ($checksumMatches.Count -ne 1) {
    throw "Expected exactly one valid SHA-256 entry for $Asset; found $($checksumMatches.Count)"
  }

  $ExpectedSha = $checksumMatches[0]
  $ActualSha   = (Get-FileHash -LiteralPath $ArchivePath -Algorithm SHA256).Hash.ToLowerInvariant()
  if ($ExpectedSha -ne $ActualSha) {
    throw "SHA-256 mismatch for $Asset (expected $ExpectedSha, got $ActualSha)"
  }

  Expand-Archive -LiteralPath $ArchivePath -DestinationPath $ExtractDir -Force
  $candidates = @(
    Get-ChildItem -LiteralPath $ExtractDir -Recurse -File |
      Where-Object { $_.Name -eq "codebase-memory-mcp.exe" }
  )
  if ($candidates.Count -ne 1) {
    throw "Expected exactly one codebase-memory-mcp.exe in $Asset; found $($candidates.Count)"
  }

  $CandidatePath    = $candidates[0].FullName
  $CandidateVersion = Get-CbmVersion -Path $CandidatePath
  if ($CandidateVersion -ne $CbmVersion) {
    throw "Downloaded binary reported version '$CandidateVersion'; expected '$CbmVersion'"
  }

  Copy-Item -LiteralPath $CandidatePath -Destination $StagedPath -ErrorAction Stop

  if (Test-Path -LiteralPath $BinPath -PathType Leaf) {
    Assert-CodingAgentsStopped -Phase "codebase-memory-mcp binary replacement"
    Stop-CbmForUpgrade -ManagedPath $BinPath

    $RetiredPath = $BinPath + ".retired-" + (Get-Date -Format "yyyyMMddHHmmss") + "-" + [System.Guid]::NewGuid().ToString("N")
    Move-FileWithRetry -Source $BinPath -Destination $RetiredPath
  }

  try {
    Move-FileWithRetry -Source $StagedPath -Destination $BinPath
    $PublishedVersion = Get-CbmVersion -Path $BinPath
    if ($PublishedVersion -ne $CbmVersion) {
      throw "Installed binary reported version '$PublishedVersion'; expected '$CbmVersion'"
    }
  } catch {
    $installError = $_
    $rollbackError = $null

    try {
      if (Test-Path -LiteralPath $BinPath -PathType Leaf) {
        Remove-Item -LiteralPath $BinPath -Force -ErrorAction Stop
      }
      if ($RetiredPath -and (Test-Path -LiteralPath $RetiredPath -PathType Leaf)) {
        Move-FileWithRetry -Source $RetiredPath -Destination $BinPath
      }
    } catch {
      $rollbackError = $_
    }

    if ($rollbackError) {
      throw "codebase-memory-mcp installation failed: $($installError.Exception.Message). Rollback also failed: $($rollbackError.Exception.Message)"
    }
    throw $installError
  }

  $InstallSucceeded = $true
  Write-Host "codebase-memory-mcp $CbmVersion installed to $BinPath"
} finally {
  if (Test-Path -LiteralPath $StagedPath -PathType Leaf) {
    Remove-Item -LiteralPath $StagedPath -Force -ErrorAction SilentlyContinue
  }
  Remove-Item -LiteralPath $TempDir -Recurse -Force -ErrorAction SilentlyContinue
  if ($InstallSucceeded) {
    Remove-RetiredBinaries -Directory $InstallDir
  }
}
}

if ($MyInvocation.InvocationName -ne ".") {
  Invoke-CbmInstaller
}
{{- end }}
