{{- if eq (env "SHELL") "/bin/zsh" -}}
{{-   if eq .chezmoi.os "linux" -}}
HISTFILE=~/.histfile
HISTSIZE=3000 #due to hist_expire_dups_first
SAVEHIST=2000
setopt inc_append_history autocd extendedglob notify hist_ignore_space hist_ignoredups extended_history share_history hist_verify hist_expire_dups_first

unsetopt beep
bindkey -e

zstyle :compinstall filename '${ZDOTDIR:-~}/.zshrc'

autoload -Uz compinit
compinit
autoload colors zsh/terminfo

export PATH="$HOME/bin/:$PATH"
PS1="("'%10<...<%~%<<'"|"'%t'")"$'\n'%{$fg_bold[yellow]%}%B[-%m-]%b%{$reset_color%}%#" "
{{ "\n" -}}
{{-   end -}}
# Universal custom aliases
alias cd=" cd"
{{- if ne .chezmoi.os "darwin" -}}
alias less="less -R"
alias more="less -R -X"
{{- end -}}
alias cz="chezmoi"
# Prompt for 1Password sign-in
alias ops=' eval $(op signin)'

{{- if eq .chezmoi.os "darwin" -}}
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

source <(fzf --zsh)

#Fix for Window Title
# precmd () {
# print -Pn "\e]2;%n@%m: %2c\a"
# print -Pn "\e]1;%l\a"
# }

# source antidote
{{- if lookPath "brew"}}
source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
{{- end}}

# initialize plugins statically with ${ZDOTDIR:-~}/.zsh_plugins.txt
antidote load

# Set HISTFILE to be machine-specific
HISTFILE=${ZDOTDIR:-$HOME}/.m4mbp_zsh_history

# Set language variables
export LC_ALL=en_GB.UTF-8
export LANG=en_GB.UTF-8
export LC_MESSAGES=en_GB.UTF-8
export LC_TIME=en_SG.UTF-8
export LC_NUMERIC=en_SG.UTF-8
export LC_MONETARY=en_SG.UTF-8
export LANGUAGE=en_GB:en_US

# Universal custom aliases
alias cd=" cd"
# Set keywords to be excluded from ZSH History using MichaelAquilina/zsh-history-filter
export HISTORY_FILTER_EXCLUDE=("_KEY" "Bearer")
alias ls="ls --color=always"
alias ll=" LC_COLLATE=C ls -lah --color=always"
alias lt=" LC_COLLATE=C ls -lahtr --color=always"
alias less="less -R"
alias more="less -R -X"
alias cz="chezmoi"
alias czp="chezmoi --config $HOME/.config/chezmoi-private/chezmoi.toml --source $HOME/Documents/development/private-dotfiles"

# Set $EDITOR to nano if available else fallback to vi
# else set $EDITOR & $VISUAL to VSCode
EDITOR="$(command -v nano 2>/dev/null || command -v vi)"

if command -v code >/dev/null 2>&1 \
&& [ "$SSH_TTY$DISPLAY" = "${DISPLAY#*:[1-9][0-9]}" ]; then
  export VISUAL="$(command -v code) --wait"
  EDITOR="$VISUAL"
fi

# Prompt for 1Password sign-in
alias ops=' eval $(op signin)'

#Add variables used by homelab-IaC repo
export CERTPATH="{{ .CERTPATH }}"
export LOCALCERTPATH=$HOME/Documents/development/keys
alias cdcert=' cd "$CERTPATH"'

#Update $PATH
export PATH=$HOME/Applications:~/.emacs.d/bin/:$HOME/Library/Python/3.11/bin:$PATH

#Disable Fork Safety as it tends to break Ansible
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Initialize fasd with smartcache if available, or directly if only fasd is available
{{- $hasFasder := false -}}
{{- if lookPath "fasder" -}}
{{-   $hasFasder = true -}}
{{- end -}}
{{- if $hasFasder}}
if command -v smartcache >/dev/null 2>&1; then
    smartcache eval fasder --init auto aliases
else
    eval "$(fasder --init auto aliases)"
fi
{{- end}}

# This is added at the end of the file to avoid potential conflicts
eval "$(direnv hook zsh)"
{{- end -}}