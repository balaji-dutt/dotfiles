    source "$_beads_helpers"
fi
unset _beads_helpers

# Direnv initialization (export part) - MUST be before P10k instant prompt
{{- if lookPath "direnv" }}
# This line is for direnv export, run if direnv command exists
(( ${+commands[direnv]} )) && eval "$(direnv export zsh)"
{{- end }}

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
 source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

_zsh_helper="${HOME}/.local/share/zsh/20-fzf-and-macos.zsh"
if [ -r "$_zsh_helper" ]; then
    source "$_zsh_helper"
fi
unset _zsh_helper

_zsh_helper="${HOME}/.local/share/zsh/30-opencode-env.zsh"
if [ -r "$_zsh_helper" ]; then
    source "$_zsh_helper"
fi
unset _zsh_helper

# source antidote from brew (macOS) or ~/.antidote (WSL2)
if [ -d "$HOME/.antidote" ]; then
    # WSL2/Ansible installation path
    source "$HOME/.antidote/antidote.zsh"
elif (( ${+commands[brew]} )); then
    # macOS/Homebrew installation path
    source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
fi

# WSL2: some upstream repos used by antidote can trigger git fsck
# errors (e.g., zeroPaddedFilemode). Avoid persisting this in ~/.gitconfig
# by applying the fsck relaxation only for the git processes spawned by
# antidote.
if [[ -n "${WSL_DISTRO_NAME:-}" ]] && (( ${+functions[antidote]} )); then
  if (( ! ${+functions[_antidote_orig]} )); then
    functions -c antidote _antidote_orig
  fi

  antidote() {
    GIT_CONFIG_COUNT=3 \
    GIT_CONFIG_KEY_0=fetch.fsck.zeroPaddedFilemode \
    GIT_CONFIG_VALUE_0=ignore \
    GIT_CONFIG_KEY_1=receive.fsck.zeroPaddedFilemode \
    GIT_CONFIG_VALUE_1=ignore \
    GIT_CONFIG_KEY_2=fsck.zeroPaddedFilemode \
    GIT_CONFIG_VALUE_2=ignore \
    _antidote_orig "$@"
  }
fi

if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    setopt AUTO_CD
fi

# Initialize plugins statically with ${ZDOTDIR:-~}/.zsh_plugins.txt.
# If a backup restore leaves an empty static cache newer than the bundle file,
# antidote will otherwise source the empty cache and skip every plugin.
if (( ${+functions[antidote]} )); then
    _antidote_bundle="${ZDOTDIR:-$HOME}/.zsh_plugins.txt"
    _antidote_static="${_antidote_bundle:r}.zsh"
    if [[ -s "$_antidote_bundle" && -f "$_antidote_static" && ! -s "$_antidote_static" ]]; then
        command rm -f -- "$_antidote_static"
    fi
    antidote load "$_antidote_bundle" "$_antidote_static"
    unset _antidote_bundle _antidote_static
fi

