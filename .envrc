#!/usr/bin/env bash

# Optional convenience: make repo-local asset scripts runnable without
# ./assets/ while you're inside this repository.
#
# Primary supported entrypoint is the managed ~/bin wrapper
# sync-devcontainer-all.sh, which works even when direnv does not load.
# direnv evaluates .envrc from the repo root, so $PWD is stable here.
PATH_add "$PWD/assets"

# Convenience hint for interactive usage.
export DOTFILES_DEVCONTAINER_SYNC_ALL_CMD="sync-devcontainer-all.sh"

# Set Dolt Data Directory to a location inside the repo, since
# .beads/config.yaml customizes Dolt server settings.
export BEADS_DOLT_CLI_DIR="$PWD/.beads/dolt"

# WSL2 needs a stable per-checkout Dolt server port because native Windows uses
# it as a client. Other POSIX hosts should let Beads manage its ephemeral runtime
# port in .beads/dolt-server.port. Preserve any port the caller chose explicitly.
#
# bd does not reliably bind the per-project port its own help describes, so the
# value is pinned as dolt.port in .beads/config.local.yaml, which bd does honour.
# That file is gitignored, so a fresh clone has no pin and one is written here.
# An existing pin wins: bd reads the file, so the exported variable has to agree
# with it or every consumer of the variable targets a port nothing listens on.
if [ -n "${WSL_DISTRO_NAME:-}" ] && [ -z "${BEADS_DOLT_SERVER_PORT:-}" ]; then
  _beads_local_config="$PWD/.beads/config.local.yaml"
  _beads_pinned_port=$(
    sed -n 's/^dolt\.port:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
      "$_beads_local_config" 2>/dev/null | head -n 1
  )

  if [ -n "$_beads_pinned_port" ]; then
    export BEADS_DOLT_SERVER_PORT="$_beads_pinned_port"
  else
    _beads_port_key="$PWD|$(uname -s 2>/dev/null || printf 'unknown')|${WSL_DISTRO_NAME:-}"

    if [ -r /etc/os-release ]; then
      # shellcheck source=/dev/null
      _beads_os_id=$(
        . /etc/os-release
        printf '%s' "${ID:-}"
      )
      _beads_port_key="$_beads_port_key|$_beads_os_id"
      unset _beads_os_id
    fi

    _beads_cksum_output=$(printf '%s' "$_beads_port_key" | cksum)
    _beads_port_hash=${_beads_cksum_output%% *}
    export BEADS_DOLT_SERVER_PORT=$((20000 + (_beads_port_hash % 20000)))
    unset _beads_port_key _beads_cksum_output _beads_port_hash

    if [ -d "$PWD/.beads" ]; then
      printf 'dolt.port: %s\n' "$BEADS_DOLT_SERVER_PORT" >> "$_beads_local_config"
    fi
  fi

  unset _beads_local_config _beads_pinned_port
fi
