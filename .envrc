#!/usr/bin/env bash

# Optional convenience: make repo-local asset scripts runnable without
# ./assets/ while you're inside this repository.
#
# Primary supported entrypoint is the managed ~/bin wrapper
# sync-devcontainer-all.sh, which works even when direnv does not load.
# direnv evaluates .envrc from the repo root, so $PWD is stable here.
PATH_add "$PWD/assets"

# Convenience hint for interactive usage.
export DOTFILES_DEVCONTAINER_SYNC_ALL_CMD="sync-devcontainer-all.sh"

# Set Dolt Data Directory to a location inside the repo, since
# .beads/config.yaml customizes Dolt server settings.
export BEADS_DOLT_CLI_DIR="$PWD/.beads/dolt"

# Pick a stable per-checkout Dolt server port for Beads. A single tracked
# dolt.port collides across Windows and WSL2 clones that share a network stack,
# while Beads' OS-assigned ephemeral fallback can move between restarts. Hash the
# checkout path plus platform/distro identity into a high user-port range, unless
# the caller already chose an explicit port.
if [ -z "${BEADS_DOLT_SERVER_PORT:-}" ]; then
  _beads_port_key="$PWD|$(uname -s 2>/dev/null || printf 'unknown')|${WSL_DISTRO_NAME:-}"

  if [ -r /etc/os-release ]; then
    # shellcheck source=/dev/null
    _beads_os_id=$(
      . /etc/os-release
      printf '%s' "${ID:-}"
    )
    _beads_port_key="$_beads_port_key|$_beads_os_id"
    unset _beads_os_id
  fi

  _beads_cksum_output=$(printf '%s' "$_beads_port_key" | cksum)
  _beads_port_hash=${_beads_cksum_output%% *}
  export BEADS_DOLT_SERVER_PORT=$((20000 + (_beads_port_hash % 20000)))
  unset _beads_port_key _beads_cksum_output _beads_port_hash
fi
