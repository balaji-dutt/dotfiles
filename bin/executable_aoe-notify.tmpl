#!/usr/bin/env bash
set -Eeuo pipefail

DEFAULT_BRIDGE_URL="http://host.docker.internal:6789/notify"

debug() {
  case "${AOE_NOTIFY_DEBUG:-}" in
    1|true|TRUE|yes|YES|on|ON)
      printf 'aoe-notify: %s\n' "$*" >&2
      ;;
  esac
}

# Portable lowercase for bash 3.2 (macOS /bin/bash) compatibility.
to_lower() {
  printf '%s' "${1-}" | tr '[:upper:]' '[:lower:]'
}

# Append a single line per invocation so we can prove AoE actually fires the
# hook. Useful when banners do not appear: a missing line means the hook was
# never invoked, a present line with backend=none means every backend failed.
log_finish() {
  local backend=$1
  local rc=$2
  local status=$3
  local path
  path=${XDG_CACHE_HOME:-$HOME/.cache}/aoe-notify.log
  mkdir -p "${path%/*}" 2>/dev/null || return 0
  printf '%s status=%s backend=%s rc=%s pid=%s ppid=%s instance=%s session=%q project=%q new_status=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$status" "$backend" "$rc" \
    "$$" "$PPID" \
    "${AOE_INSTANCE_ID:-}" \
    "${AOE_SESSION_TITLE:-}" \
    "${AOE_PROJECT_PATH:-}" \
    "${AOE_NEW_STATUS:-}" \
    >> "$path" 2>/dev/null || true
}

json_escape() {
  local value=${1-}
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\b'/\\b}
  value=${value//$'\f'/\\f}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

bridge_endpoint() {
  local raw=${1-}

  if [[ -z $raw ]]; then
    return 1
  fi

  case "$raw" in
    1|true|TRUE|yes|YES|on|ON)
      raw=$DEFAULT_BRIDGE_URL
      ;;
    0|false|FALSE|no|NO|off|OFF)
      return 1
      ;;
  esac

  if [[ $raw != http://* && $raw != https://* ]]; then
    raw="http://$raw"
  fi

  raw=${raw%/}
  if [[ $raw != */notify ]]; then
    raw="$raw/notify"
  fi

  printf '%s' "$raw"
}

is_devcontainer() {
  [[ ${DEVCONTAINER:-} == 1 || -f /.dockerenv || -f /run/.containerenv ]]
}

try_bridge() {
  local url=$1
  local title=$2
  local message=$3
  local timeout=${AOE_NOTIFY_TIMEOUT_SECONDS:-1}
  local payload output rc

  command -v curl >/dev/null 2>&1 || return 1

  payload=$(printf '{"title":"%s","message":"%s"}' \
    "$(json_escape "$title")" \
    "$(json_escape "$message")")

  output=$(curl \
    --fail \
    --silent \
    --show-error \
    --connect-timeout "$timeout" \
    --max-time "$timeout" \
    --header 'Content-Type: application/json' \
    --data "$payload" \
    "$url" 2>&1) || rc=$?
  rc=${rc:-0}

  if [[ $rc -eq 0 ]]; then
    debug "sent notification through bridge: $url"
    return 0
  fi

  debug "bridge failed ($rc): $output"
  return 1
}

# Preferred macOS backend. Unlike osascript, terminal-notifier has its own
# bundle ID, so it registers in System Settings > Notifications and can be
# granted permission. osascript notifications attribute to "Script Editor",
# which does not appear in the Notifications list until it is launched as the
# foreground app -- a chicken-and-egg problem when invoked from a child
# process like aoe-notify.
try_terminal_notifier() {
  local status=$1
  local title=$2
  local message=$3

  [[ $(uname -s 2>/dev/null) == Darwin ]] || return 1
  command -v terminal-notifier >/dev/null 2>&1 || return 1

  local -a args=(
    -title "$title"
    -message "$message"
    -group "agent-of-empires"
    -sender com.apple.Terminal
  )
  if [[ $status == error ]]; then
    args+=(-sound Basso)
  fi

  terminal-notifier "${args[@]}" >/dev/null 2>&1
}

try_macos() {
  local title=$1
  local message=$2

  [[ $(uname -s 2>/dev/null) == Darwin ]] || return 1
  command -v osascript >/dev/null 2>&1 || return 1

  osascript \
    -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
    -e 'end run' \
    "$title" \
    "$message" >/dev/null 2>&1
}

try_windows_popup() {
  local title=$1
  local message=$2

  command -v powershell.exe >/dev/null 2>&1 || return 1

  powershell.exe \
    -NoProfile \
    -NonInteractive \
    -ExecutionPolicy Bypass \
    -Command '$title = $args[0]; $message = $args[1]; $wshell = New-Object -ComObject Wscript.Shell; $null = $wshell.Popup($message, 5, $title, 0 + 64)' \
    "$title" \
    "$message" >/dev/null 2>&1
}

try_notify_send() {
  local status=$1
  local title=$2
  local message=$3
  local urgency=normal

  command -v notify-send >/dev/null 2>&1 || return 1
  if [[ $status == error ]]; then
    urgency=critical
  fi

  notify-send \
    --app-name='Agent of Empires' \
    --urgency="$urgency" \
    "$title" \
    "$message" >/dev/null 2>&1
}

main() {
  local status=${1:-${AOE_NEW_STATUS:-}}
  local subject title message bridge_raw bridge_url

  status=$(to_lower "$status")

  case "$status" in
    waiting)
      title='AoE: Waiting'
      subject=${AOE_SESSION_TITLE:-An Agent of Empires session}
      message="$subject is waiting for input"
      ;;
    error)
      title='AoE: Error'
      subject=${AOE_SESSION_TITLE:-An Agent of Empires session}
      message="$subject hit an error"
      ;;
    *)
      debug "ignored status: ${status:-<empty>}"
      log_finish ignored 0 "${status:-}"
      return 0
      ;;
  esac

  if [[ -n ${AOE_PROJECT_PATH:-} ]]; then
    message="$message in $(basename "$AOE_PROJECT_PATH")"
  fi

  bridge_raw=${AOE_NOTIFY_BRIDGE_URL:-${DEV_NOTIFY_BRIDGE:-}}
  if bridge_url=$(bridge_endpoint "$bridge_raw"); then
    if try_bridge "$bridge_url" "$title" "$message"; then
      log_finish bridge 0 "$status"
      return 0
    fi
  elif is_devcontainer; then
    if try_bridge "$DEFAULT_BRIDGE_URL" "$title" "$message"; then
      log_finish bridge 0 "$status"
      return 0
    fi
  fi

  if try_terminal_notifier "$status" "$title" "$message"; then
    log_finish terminal-notifier 0 "$status"
    return 0
  fi
  if try_macos "$title" "$message"; then
    log_finish osascript 0 "$status"
    return 0
  fi
  if try_windows_popup "$title" "$message"; then
    log_finish powershell 0 "$status"
    return 0
  fi
  if try_notify_send "$status" "$title" "$message"; then
    log_finish notify-send 0 "$status"
    return 0
  fi

  debug 'no notification backend succeeded'
  log_finish none 1 "$status"
  return 0
}

main "$@"
