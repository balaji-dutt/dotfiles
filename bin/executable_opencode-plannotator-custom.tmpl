#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="${0##*/}"
DEFAULT_HOST_BUILD='{{ .plannotator_ports.host.build }}'
DEFAULT_HOST_CUSTOM='{{ .plannotator_ports.host.custom }}'
DEFAULT_DEVCONTAINER_BUILD='{{ .plannotator_ports.devcontainer.build }}'
DEFAULT_DEVCONTAINER_CUSTOM='{{ .plannotator_ports.devcontainer.custom }}'

die() {
  printf '%s: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

is_devcontainer() {
  [ "${DEVCONTAINER:-}" = "1" ] || [ -n "${REMOTE_CONTAINERS:-}" ] || [ -n "${CODESPACES:-}" ]
}

select_range() {
  local profile_name default_range env_name
  profile_name="$1"

  case "$profile_name" in
    build)
      env_name="PLANNOTATOR_PORTS_BUILD"
      if is_devcontainer; then
        default_range="$DEFAULT_DEVCONTAINER_BUILD"
      else
        default_range="$DEFAULT_HOST_BUILD"
      fi
      ;;
    custom)
      env_name="PLANNOTATOR_PORTS_CUSTOM"
      if is_devcontainer; then
        default_range="$DEFAULT_DEVCONTAINER_CUSTOM"
      else
        default_range="$DEFAULT_HOST_CUSTOM"
      fi
      ;;
    *)
      die "unknown profile: $profile_name"
      ;;
  esac

  printf '%s' "${!env_name:-$default_range}"
}

PROFILE_NAME="build"
if [[ "$SCRIPT_NAME" == *-custom ]]; then
  PROFILE_NAME="custom"
fi

PORT_RANGE="$(select_range "$PROFILE_NAME")"
[ -n "$PORT_RANGE" ] || die "empty port range for $PROFILE_NAME"

export PLANNOTATOR_PORT="$PORT_RANGE"
export OPENCODE_PLANNOTATOR_POOL="$PROFILE_NAME"

: "${ANTHROPIC_SYSTEM_PROMPT_PATH:=/dev/null}"
export ANTHROPIC_SYSTEM_PROMPT_PATH

if [ "${OPENCODE_PLANNOTATOR_VERBOSE:-}" = "1" ] || [ "${OPENCODE_PLANNOTATOR_DRY_RUN:-}" = "1" ]; then
  printf '%s: profile=%s range=%s\n' "$SCRIPT_NAME" "$PROFILE_NAME" "$PORT_RANGE" >&2
fi

if [ "${OPENCODE_PLANNOTATOR_DRY_RUN:-}" = "1" ]; then
  exit 0
fi

OPENCODE_BIN="${OPENCODE_BIN:-}"
if [ -z "$OPENCODE_BIN" ]; then
  OPENCODE_BIN="$(command -v opencode || true)"
fi

[ -n "$OPENCODE_BIN" ] || die "opencode not found in PATH"
[ -x "$OPENCODE_BIN" ] || die "opencode is not executable: $OPENCODE_BIN"

export OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=1
export OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1

exec "$OPENCODE_BIN" "$@"
