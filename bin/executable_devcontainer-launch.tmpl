#!/usr/bin/env bash
set -euo pipefail

MANIFEST_PATH="${DEVCONTAINER_LAUNCH_MANIFEST:-{{ .chezmoi.homeDir }}/Documents/development/dotfiles/configs/devcontainer-sync.jsonc}"

usage() {
  cat >&2 <<'USAGE'
Usage:
  devcontainer-launch --list
  devcontainer-launch <name-or-alias> [shell|up|rebuild|rebuild-no-cache|stop|down]
  devcontainer-launch <name-or-alias> status [--json | --plain]
  devcontainer-launch <name-or-alias> exec [--existing] -- <command> [args...]

Environment overrides use each launcher's env_prefix, for example:
  HOMELAB_IAC_WORKSPACE=/path/to/workspace
  HOMELAB_IAC_CONFIG=/path/to/devcontainer.json
  HOMELAB_IAC_SHELL='zsh -l'

Interactive shell/exec terminal overrides (empty value sends nothing):
  DEVCONTAINER_LAUNCH_TERM=xterm-256color
  DEVCONTAINER_LAUNCH_COLORTERM=truecolor
USAGE
}

die() {
  printf 'devcontainer-launch: %s\n' "$*" >&2
  exit 1
}

is_wsl2() {
  local osrelease
  osrelease="$(tr '[:upper:]' '[:lower:]' </proc/sys/kernel/osrelease 2>/dev/null || true)"

  [[ "$osrelease" == *microsoft* && "$osrelease" == *wsl2* ]]
}

os_release_id() {
  if [[ -r /etc/os-release ]]; then
    # shellcheck source=/dev/null
    . /etc/os-release
    printf '%s' "${ID:-}"
  fi
}

is_debian_wsl2() {
  [[ "$(uname -s 2>/dev/null || true)" == "Linux" ]] || return 1
  is_wsl2 && [[ "$(os_release_id)" == "debian" ]]
}

detect_platform() {
  local uname_s
  uname_s="$(uname -s 2>/dev/null || true)"

  if [[ "$uname_s" == "Darwin" ]]; then
    printf 'darwin\n'
    return 0
  fi

  if is_debian_wsl2; then
    printf 'wsl2-debian\n'
    return 0
  fi

  return 1
}

require_file() {
  local path label
  path="$1"
  label="$2"
  [[ -f "$path" ]] || die "$label not found: $path"
}

require_dir() {
  local path label
  path="$1"
  label="$2"
  [[ -d "$path" ]] || die "$label not found: $path"
}

prepend_mise_shims() {
  local mise_shims path_value
  mise_shims="${HOME}/.local/share/mise/shims"
  path_value="${PATH:-}"

  if [[ -d "$mise_shims" ]]; then
    case ":$path_value:" in
      *":$mise_shims:"*) ;;
      *) export PATH="$mise_shims${path_value:+:$path_value}" ;;
    esac
  fi
}

RESOLVED_NATIVE_PATH=""
NATIVE_PATH_WINDOWS_CANDIDATES=""
DEVCONTAINER_CMD=()
DOCKER_CMD=()
IDENTITY_LABELS=()
DISCOVERY=""
SELECTED_ID=""
SELECTED_STATE=""
TERMINAL_ENV_ARGS=()

host_supports_256_colors() {
  local colors
  case "${TERM:-}" in
    ""|dumb) return 1 ;;
    *-256color|*-direct) return 0 ;;
  esac
  case "${COLORTERM:-}" in
    truecolor|24bit) return 0 ;;
  esac
  colors="$(tput colors 2>/dev/null || true)"
  [[ "$colors" =~ ^[0-9]+$ ]] && (( colors >= 256 ))
}

add_terminal_env() {
  local name value
  name="$1"
  value="$2"
  [[ -n "$value" ]] || return 0
  [[ "$value" != *[[:cntrl:]]* ]] || die "DEVCONTAINER_LAUNCH_$name must not contain control characters"
  TERMINAL_ENV_ARGS+=(--remote-env "$name=$value")
}

resolve_terminal_env() {
  TERMINAL_ENV_ARGS=()
  [[ -t 0 && -t 1 ]] || return 0

  if [[ -n "${DEVCONTAINER_LAUNCH_TERM+set}" ]]; then
    add_terminal_env TERM "$DEVCONTAINER_LAUNCH_TERM"
  elif host_supports_256_colors; then
    add_terminal_env TERM xterm-256color
  fi

  if [[ -n "${DEVCONTAINER_LAUNCH_COLORTERM+set}" ]]; then
    add_terminal_env COLORTERM "$DEVCONTAINER_LAUNCH_COLORTERM"
  elif [[ "${COLORTERM:-}" == "truecolor" || "${COLORTERM:-}" == "24bit" ]] && host_supports_256_colors; then
    add_terminal_env COLORTERM "$COLORTERM"
  fi
}

is_windows_mounted_path() {
  local platform path
  platform="$1"
  path="$2"

  [[ "$platform" == "wsl2-debian" && "$path" =~ ^/mnt/[[:alpha:]]/ ]]
}

resolve_native_path_command() {
  local platform tool candidate path_entry found_windows path_value
  platform="$1"
  tool="$2"
  found_windows=""
  path_value="${PATH:-}"

  RESOLVED_NATIVE_PATH=""
  NATIVE_PATH_WINDOWS_CANDIDATES=""

  while IFS= read -r path_entry; do
    [[ -n "$path_entry" ]] || continue
    candidate="${path_entry%/}/$tool"
    [[ -x "$candidate" && ! -d "$candidate" ]] || continue

    if is_windows_mounted_path "$platform" "$candidate"; then
      found_windows="${found_windows}${found_windows:+, }$candidate"
      continue
    fi

    RESOLVED_NATIVE_PATH="$candidate"
    return 0
  done < <(printf '%s' "$path_value" | tr ':' '\n')

  NATIVE_PATH_WINDOWS_CANDIDATES="$found_windows"
  return 1
}

resolve_mise_devcontainer_command() {
  local platform mise_bin install_root wrapper_path
  platform="$1"

  [[ "$platform" == "wsl2-debian" ]] || return 1
  resolve_native_path_command "$platform" mise || return 1
  mise_bin="$RESOLVED_NATIVE_PATH"

  install_root="$(env -u ComSpec -u COMSPEC -u npm_config_script_shell -u NPM_CONFIG_SCRIPT_SHELL "$mise_bin" where "npm:@devcontainers/cli" 2>/dev/null || true)"
  [[ -n "$install_root" && -d "$install_root" ]] || return 1
  is_windows_mounted_path "$platform" "$install_root" && return 1

  wrapper_path="$install_root/devcontainer"
  [[ -f "$wrapper_path" ]] || return 1
  is_windows_mounted_path "$platform" "$wrapper_path" && return 1

  DEVCONTAINER_CMD=(sh "$wrapper_path")
  return 0
}

resolve_devcontainer_command() {
  local platform devcontainer_windows_candidates
  platform="$1"
  DEVCONTAINER_CMD=()

  if [[ -n "${DEVCONTAINER_CLI:-}" ]]; then
    [[ -x "$DEVCONTAINER_CLI" && ! -d "$DEVCONTAINER_CLI" ]] || die "DEVCONTAINER_CLI is not executable: $DEVCONTAINER_CLI"
    is_windows_mounted_path "$platform" "$DEVCONTAINER_CLI" && die "DEVCONTAINER_CLI points to a Windows-mounted path on WSL2: $DEVCONTAINER_CLI"
    DEVCONTAINER_CMD=("$DEVCONTAINER_CLI")
    return 0
  fi

  if resolve_native_path_command "$platform" devcontainer; then
    DEVCONTAINER_CMD=("$RESOLVED_NATIVE_PATH")
    return 0
  fi

  devcontainer_windows_candidates="$NATIVE_PATH_WINDOWS_CANDIDATES"

  if resolve_mise_devcontainer_command "$platform"; then
    return 0
  fi

  if [[ -n "$devcontainer_windows_candidates" ]]; then
    die "only Windows-mounted devcontainer CLI candidates were found on WSL2: $devcontainer_windows_candidates. Install the native mise-managed npm:@devcontainers/cli tool in Debian WSL2."
  fi

  die "devcontainer CLI is required; install the native mise-managed npm:@devcontainers/cli tool"
}

resolve_docker_command() {
  local platform docker_windows_candidates
  platform="$1"
  DOCKER_CMD=()

  if [[ -n "${DOCKER_CLI:-}" ]]; then
    [[ -x "$DOCKER_CLI" && ! -d "$DOCKER_CLI" ]] || die "DOCKER_CLI is not executable: $DOCKER_CLI"
    is_windows_mounted_path "$platform" "$DOCKER_CLI" && die "DOCKER_CLI points to a Windows-mounted path on WSL2: $DOCKER_CLI"
    DOCKER_CMD=("$DOCKER_CLI")
    return 0
  fi

  if resolve_native_path_command "$platform" docker; then
    DOCKER_CMD=("$RESOLVED_NATIVE_PATH")
    return 0
  fi

  docker_windows_candidates="$NATIVE_PATH_WINDOWS_CANDIDATES"

  if [[ -n "$docker_windows_candidates" ]]; then
    die "only Windows-mounted docker CLI candidates were found on WSL2: $docker_windows_candidates. Install a native Docker CLI in Debian WSL2."
  fi

  die "docker CLI is required for container discovery"
}

discover_containers() {
  DISCOVERY="$(python3 - "${DOCKER_CMD[0]}" "$1" "$LAUNCHER_NAME" \
    "$WORKSPACE_FOLDER" "$CONFIG_PATH" "${IDENTITY_LABELS[@]}" <<'PY'
import json
import re
import subprocess
import sys

docker, platform, name, workspace, config = sys.argv[1:6]
labels = dict(item.split("=", 1) for item in sys.argv[6:])
folder_key = "devcontainer.local_folder"
config_key = "devcontainer.config_file"


def docker_output(*args):
    try:
        result = subprocess.run([docker, *args], capture_output=True, text=True)
    except OSError:
        raise SystemExit("devcontainer-launch: failed to execute Docker")
    if result.returncode:
        raise SystemExit(f"devcontainer-launch: Docker {args[0]} failed (exit {result.returncode}); inspect Docker connectivity/container state")
    return result.stdout


def path_aliases(native, configured):
    values = {native, configured}
    if platform == "wsl2-debian":
        for authority in ("wsl.localhost", "wsl$"):
            values.add("\\\\" + authority + "\\Debian" + native.replace("/", "\\"))
    return values


folders = path_aliases(workspace, labels[folder_key])
configs = path_aliases(config, labels[config_key])
queries = [labels] + [{folder_key: folder} for folder in sorted(folders)]
ids = set()
for query in queries:
    args = ["ps", "-aq", "--no-trunc"]
    for key, value in query.items():
        args += ["--filter", f"label={key}={value}"]
    for container_id in docker_output(*args).splitlines():
        if not re.fullmatch(r"[0-9a-f]{64}", container_id):
            raise SystemExit("devcontainer-launch: invalid full container ID from Docker")
        ids.add(container_id)


def expression(value):
    return "{" * 2 + value + "}" * 2


label_fields = [json.dumps(key) + ":" + expression("json (index .Config.Labels " + json.dumps(key) + ")") for key in labels]
template = ('{"id":' + expression("json .Id") + ',"state":' + expression("json .State.Status")
            + ',"labels":{' + ",".join(label_fields) + '}}')
matches, conflicts = [], []
for container_id in sorted(ids):
    try:
        container = json.loads(docker_output("inspect", "--type", "container", "--format", template, container_id))
        observed = container["labels"]
        if container["id"] != container_id or not isinstance(container["state"], str) or not container["state"]:
            raise ValueError("invalid container state")
        if not isinstance(observed, dict) or any(value is not None and not isinstance(value, str) for value in observed.values()):
            raise ValueError("invalid labels")
    except (ValueError, KeyError, TypeError):
        raise SystemExit("devcontainer-launch: invalid container inspection from Docker")
    safe = {"id": container_id, "state": container["state"],
            "labels": {key: observed.get(key) for key in labels}}
    if all(observed.get(key) == value for key, value in labels.items()):
        matches.append(safe)
    elif observed.get(folder_key) in folders and observed.get(config_key) in configs:
        conflicts.append(safe)

ambiguous = len(matches) > 1
selection = "ambiguous" if ambiguous else "conflict" if conflicts else "unique" if matches else "missing"
print(json.dumps({"schema_version": 1, "launcher": name, "platform": platform,
                  "workspace_folder": workspace, "config": config, "identity_labels": labels,
                  "matches": matches, "conflicts": conflicts, "ambiguous": ambiguous, "selection": selection}))
PY
  )" || return 1
}

select_container() {
  local selection
  selection="$(python3 - "$DISCOVERY" <<'PY'
import json
import sys

report = json.loads(sys.argv[1])
if report["selection"] in ("ambiguous", "conflict"):
    ids = ", ".join(item["id"] for item in report["matches"] + report["conflicts"])
    raise SystemExit(f"devcontainer-launch: {report['selection']} identity: {ids}. Run status --plain; inspect/correct identity or explicitly resolve duplicates before retrying.")
if report["matches"]:
    match = report["matches"][0]
    if match["state"] not in ("created", "running", "paused", "restarting", "removing", "exited", "dead"):
        raise SystemExit("devcontainer-launch: unknown container state")
    print(match["id"], match["state"])
PY
  )" || return 1
  SELECTED_ID="${selection%% *}"
  SELECTED_STATE="${selection#* }"
}

require_running_container() {
  [[ -n "$SELECTED_ID" ]] || die "no existing container found; run up separately to create/start it"
  [[ "$SELECTED_STATE" == "running" ]] || die "existing container $SELECTED_ID is $SELECTED_STATE; run up separately to start it"
}

render_status() {
  local platform mode plain heading details styled gum_bin
  platform="$1"
  mode="$2"
  if [[ "$mode" == "--json" ]]; then
    printf '%s\n' "$DISCOVERY"
    return 0
  fi
  plain="$(python3 - "$DISCOVERY" <<'PY'
import json
import sys
import unicodedata

report = json.loads(sys.argv[1])


def text(value):
    return "".join(char if not unicodedata.category(char).startswith("C") else f"\\u{ord(char):04x}" for char in str(value))


print(f"{text(report['launcher'])}: {report['selection']}")
print(f"Platform: {text(report['platform'])}")
print(f"Workspace: {text(report['workspace_folder'])}")
print(f"Config: {text(report['config'])}")
print("Identity:")
for key, value in report["identity_labels"].items():
    print(f"  {text(key)}={text(value)}")
for field in ("matches", "conflicts"):
    print(f"{field.capitalize()}: {len(report[field])}")
    for item in report[field]:
        print(f"  {item['id']}  {text(item['state'])}")
        for key, value in item["labels"].items():
            print(f"    {text(key)}={text(value)}")
if report["selection"] in ("ambiguous", "conflict"):
    print("Next: inspect/correct identity or explicitly resolve duplicates; lifecycle actions are refused.")
elif report["selection"] == "missing" or report["matches"][0]["state"] != "running":
    print("Next: run up separately to create/start the container.")
else:
    print("Next: exec --existing -- <command> runs without starting or creating a container.")
PY
  )" || return 1
  if [[ "$mode" != "--plain" && -t 1 && -n "${TERM:-}" && "${TERM:-}" != "dumb" && -z "${NO_COLOR:-}" ]] && \
    resolve_native_path_command "$platform" gum; then
    gum_bin="$RESOLVED_NATIVE_PATH"
    heading="${plain%%$'\n'*}"
    details="${plain#*$'\n'}"
    if styled="$(CLICOLOR_FORCE=1 "$gum_bin" style --bold -- "$heading" </dev/null 2>/dev/null)"; then
      printf '%s\n%s\n' "$styled" "$details"
      return 0
    fi
  fi
  printf '%s\n' "$plain"
}

prepare_devcontainer_action() {
  local platform
  platform="$1"

  require_dir "$WORKSPACE_FOLDER" "workspace folder"
  require_file "$CONFIG_PATH" "devcontainer config"
  resolve_devcontainer_command "$platform"
  devcontainer_args=(--workspace-folder "$WORKSPACE_FOLDER" --config "$CONFIG_PATH" --docker-path "${DOCKER_CMD[0]}")
  local label
  for label in "${IDENTITY_LABELS[@]}"; do
    devcontainer_args+=(--id-label "$label")
  done
}

list_launchers() {
  local platform
  platform="$1"

  python3 - "$MANIFEST_PATH" "$platform" <<'PY'
import json
import sys
from pathlib import Path


def strip_json_comments(payload: str) -> str:
    out = []
    in_string = False
    string_char = ""
    escape = False
    i = 0
    while i < len(payload):
        ch = payload[i]
        nxt = payload[i + 1] if i + 1 < len(payload) else ""
        if in_string:
            out.append(ch)
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == string_char:
                in_string = False
            i += 1
            continue
        if ch in ('"', "'"):
            in_string = True
            string_char = ch
            out.append(ch)
            i += 1
            continue
        if ch == "/" and nxt == "/":
            i += 2
            while i < len(payload) and payload[i] not in "\r\n":
                i += 1
            continue
        if ch == "/" and nxt == "*":
            i += 2
            while i + 1 < len(payload) and not (payload[i] == "*" and payload[i + 1] == "/"):
                i += 1
            i += 2
            continue
        out.append(ch)
        i += 1
    return "".join(out)


def strip_jsonc_trailing_commas(payload: str) -> str:
    out = []
    in_string = False
    string_char = ""
    escape = False
    i = 0
    while i < len(payload):
        ch = payload[i]
        if in_string:
            out.append(ch)
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == string_char:
                in_string = False
            i += 1
            continue
        if ch in ('"', "'"):
            in_string = True
            string_char = ch
            out.append(ch)
            i += 1
            continue
        if ch == ",":
            j = i + 1
            while j < len(payload) and payload[j] in " \t\r\n":
                j += 1
            if j < len(payload) and payload[j] in "]}":
                i += 1
                continue
        out.append(ch)
        i += 1
    return "".join(out)


def parse_jsonc(path: Path) -> dict:
    raw = path.read_text(encoding="utf-8")
    return json.loads(strip_jsonc_trailing_commas(strip_json_comments(raw)))


manifest = parse_jsonc(Path(sys.argv[1]))
schema_ref = "./schemas/devcontainer-sync.v1.schema.json"
if manifest.get("$schema") != schema_ref:
    raise SystemExit(f"Manifest $schema must be {schema_ref!r}")
if manifest.get("schema_version") != 1:
    raise SystemExit("Manifest schema_version must be 1")
platform = sys.argv[2]

found = False
for name, spec in sorted(manifest.get("devcontainers", {}).items()):
    launcher = spec.get("launcher", {})
    if not launcher.get("enabled"):
        continue
    if platform not in launcher.get("platforms", {}):
        continue
    aliases = launcher.get("aliases", [])
    alias_text = f" aliases={','.join(aliases)}" if aliases else ""
    display = launcher.get("display_name", name)
    print(f"{name}\t{display}{alias_text}")
    found = True

if not found:
    print(f"No launchers configured for platform: {platform}")
PY
}

resolve_launcher() {
  local platform name
  platform="$1"
  name="$2"

  python3 - "$MANIFEST_PATH" "$platform" "$name" <<'PY'
import json
import os
import re
import shlex
import sys
from pathlib import Path


def strip_json_comments(payload: str) -> str:
    out = []
    in_string = False
    string_char = ""
    escape = False
    i = 0
    while i < len(payload):
        ch = payload[i]
        nxt = payload[i + 1] if i + 1 < len(payload) else ""
        if in_string:
            out.append(ch)
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == string_char:
                in_string = False
            i += 1
            continue
        if ch in ('"', "'"):
            in_string = True
            string_char = ch
            out.append(ch)
            i += 1
            continue
        if ch == "/" and nxt == "/":
            i += 2
            while i < len(payload) and payload[i] not in "\r\n":
                i += 1
            continue
        if ch == "/" and nxt == "*":
            i += 2
            while i + 1 < len(payload) and not (payload[i] == "*" and payload[i + 1] == "/"):
                i += 1
            i += 2
            continue
        out.append(ch)
        i += 1
    return "".join(out)


def strip_jsonc_trailing_commas(payload: str) -> str:
    out = []
    in_string = False
    string_char = ""
    escape = False
    i = 0
    while i < len(payload):
        ch = payload[i]
        if in_string:
            out.append(ch)
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == string_char:
                in_string = False
            i += 1
            continue
        if ch in ('"', "'"):
            in_string = True
            string_char = ch
            out.append(ch)
            i += 1
            continue
        if ch == ",":
            j = i + 1
            while j < len(payload) and payload[j] in " \t\r\n":
                j += 1
            if j < len(payload) and payload[j] in "]}":
                i += 1
                continue
        out.append(ch)
        i += 1
    return "".join(out)


def parse_jsonc(path: Path) -> dict:
    raw = path.read_text(encoding="utf-8")
    return json.loads(strip_jsonc_trailing_commas(strip_json_comments(raw)))


def env_prefix_for(name: str, launcher: dict) -> str:
    explicit = launcher.get("env_prefix")
    if explicit:
        return explicit
    return re.sub(r"[^A-Z0-9]+", "_", name.upper()).strip("_")


def expand_path(value: str, home: str, workspace: str) -> str:
    return value.replace("{home}", home).replace("{workspace}", workspace)


def shell_array(name: str, values: list[str]) -> str:
    return f"{name}=({shlex.join(values)})"


manifest = parse_jsonc(Path(sys.argv[1]))
schema_ref = "./schemas/devcontainer-sync.v1.schema.json"
if manifest.get("$schema") != schema_ref:
    raise SystemExit(f"Manifest $schema must be {schema_ref!r}")
if manifest.get("schema_version") != 1:
    raise SystemExit("Manifest schema_version must be 1")
platform = sys.argv[2]
requested = sys.argv[3]
home = os.path.expanduser("~")

matches = []
for name, spec in manifest.get("devcontainers", {}).items():
    launcher = spec.get("launcher", {})
    if not launcher.get("enabled"):
        continue
    platforms = launcher.get("platforms", {})
    if platform not in platforms:
        continue
    aliases = launcher.get("aliases", [])
    if requested == name or requested in aliases:
        matches.append((name, launcher, platforms[platform]))

if not matches:
    raise SystemExit(f"No launcher named or aliased {requested!r} for platform {platform!r}")
if len(matches) > 1:
    names = ", ".join(name for name, _, _ in matches)
    raise SystemExit(f"Launcher name or alias {requested!r} is ambiguous: {names}")

name, launcher, platform_spec = matches[0]
prefix = env_prefix_for(name, launcher)

workspace = expand_path(platform_spec["workspace_folder"], home, "")
workspace = os.environ.get(f"{prefix}_WORKSPACE", workspace)
workspace = os.path.abspath(workspace)
config = expand_path(platform_spec["config"], home, workspace)
config = os.environ.get(f"{prefix}_CONFIG", config)
config = os.path.abspath(config)

labels = platform_spec.get("identity_labels", {
    "devcontainer.local_folder": "{workspace}", "devcontainer.config_file": "{config}"})
if not isinstance(labels, dict) or not {"devcontainer.local_folder", "devcontainer.config_file"} <= labels.keys():
    raise SystemExit("identity_labels must contain devcontainer.local_folder and devcontainer.config_file")
tokens = {"home": home, "workspace": workspace, "config": config,
          "workspace_backslashes": workspace.replace("/", "\\")}
expanded_labels = []
for key, value in labels.items():
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", key) or key == "devcontainer.metadata":
        raise SystemExit("Invalid identity label key")
    if not isinstance(value, str):
        raise SystemExit("Identity label values must be strings")
    value = re.sub(r"\{(home|workspace|config|workspace_backslashes)\}", lambda match: tokens[match[1]], value)
    if not value or re.search(r"[\x00-\x1f\x7f-\x9f]", value):
        raise SystemExit("Identity label values must be nonempty and contain no control characters")
    expanded_labels.append(f"{key}={value}")

shell_spec = os.environ.get(f"{prefix}_SHELL")
if shell_spec:
    shell = shlex.split(shell_spec)
else:
    shell = launcher.get("shell", ["zsh", "-l"])

if not isinstance(shell, list) or not shell or not all(isinstance(item, str) and item for item in shell):
    raise SystemExit(f"Invalid shell for launcher {name!r}")

print(f"LAUNCHER_NAME={shlex.quote(name)}")
print(f"LAUNCHER_DISPLAY_NAME={shlex.quote(launcher.get('display_name', name))}")
print(f"LAUNCHER_ENV_PREFIX={shlex.quote(prefix)}")
print(f"WORKSPACE_FOLDER={shlex.quote(workspace)}")
print(f"CONFIG_PATH={shlex.quote(config)}")
print(shell_array("SHELL_CMD", shell))
print(shell_array("IDENTITY_LABELS", expanded_labels))
PY
}

main() {
  local platform action requested resolved mode existing

  platform="$(detect_platform)" || die "unsupported platform; supported platforms are macOS and Debian WSL2"

  prepend_mise_shims
  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  require_file "$MANIFEST_PATH" "launcher manifest"

  if [[ "${1:-}" == "--list" ]]; then
    list_launchers "$platform"
    return 0
  fi

  if [[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    return 2
  fi

  requested="$1"
  shift
  action="${1:-shell}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  resolved="$(resolve_launcher "$platform" "$requested")" || die "failed to resolve launcher: $requested"
  eval "$resolved"

  local -a devcontainer_args=()
  existing=false
  mode=""
  case "$action" in
    exec)
      if [[ "${1:-}" == "--existing" ]]; then
        existing=true
        shift
      fi
      if [[ "${1:-}" == "--" ]]; then shift; fi
      [[ $# -gt 0 ]] || die "exec action requires a command"
      resolve_terminal_env
      ;;
    status)
      [[ $# -le 1 ]] || die "status accepts only one of --json or --plain"
      mode="${1:-}"
      [[ -z "$mode" || "$mode" == "--json" || "$mode" == "--plain" ]] || die "unknown status option: $mode"
      ;;
    shell|up|rebuild|rebuild-no-cache|stop|down)
      [[ $# -eq 0 ]] || die "unexpected arguments for $action"
      if [[ "$action" == "shell" ]]; then resolve_terminal_env; fi
      ;;
    -h|--help|help) usage; return 0 ;;
    *) usage; die "unknown action: $action" ;;
  esac

  resolve_docker_command "$platform"
  discover_containers "$platform"
  if [[ "$action" == "status" ]]; then
    render_status "$platform" "$mode"
    return 0
  fi
  select_container

  case "$action" in
    shell|exec)
      prepare_devcontainer_action "$platform"
      if [[ "$existing" == false ]]; then
        "${DEVCONTAINER_CMD[@]}" up "${devcontainer_args[@]}" >/dev/null
        discover_containers "$platform"
        select_container
      fi
      require_running_container
      if [[ "$action" == "shell" ]]; then set -- "${SHELL_CMD[@]}"; fi
      exec "${DEVCONTAINER_CMD[@]}" exec "${devcontainer_args[@]}" ${TERMINAL_ENV_ARGS[@]+"${TERMINAL_ENV_ARGS[@]}"} \
        --container-id "$SELECTED_ID" -- "$@"
      ;;
    up)
      prepare_devcontainer_action "$platform"
      exec "${DEVCONTAINER_CMD[@]}" up "${devcontainer_args[@]}"
      ;;
    rebuild)
      prepare_devcontainer_action "$platform"
      exec "${DEVCONTAINER_CMD[@]}" up "${devcontainer_args[@]}" --remove-existing-container
      ;;
    rebuild-no-cache)
      prepare_devcontainer_action "$platform"
      exec "${DEVCONTAINER_CMD[@]}" up "${devcontainer_args[@]}" --remove-existing-container --build-no-cache
      ;;
    stop)
      if [[ -n "$SELECTED_ID" && "$SELECTED_STATE" == "running" ]]; then
        "${DOCKER_CMD[@]}" stop "$SELECTED_ID"
      elif [[ -n "$SELECTED_ID" ]]; then
        printf 'devcontainer-launch: container %s for %s is %s; no stop requested\n' "$SELECTED_ID" "$LAUNCHER_NAME" "$SELECTED_STATE" >&2
      else
        printf 'devcontainer-launch: no container to stop for %s\n' "$LAUNCHER_NAME" >&2
      fi
      ;;
    down)
      if [[ -n "$SELECTED_ID" ]]; then
        "${DOCKER_CMD[@]}" rm -f "$SELECTED_ID"
      else
        printf 'devcontainer-launch: no container to remove for %s\n' "$LAUNCHER_NAME" >&2
      fi
      ;;
  esac
}

main "$@"
