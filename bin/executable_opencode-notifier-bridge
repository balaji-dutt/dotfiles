#!/usr/bin/env bash
set -Eeuo pipefail

die() {
  printf 'opencode-notifier-bridge: %s\n' "$*" >&2
  exit 1
}

is_aoe_session() {
  local session

  if [[ -n ${AOE_INSTANCE_ID:-} ]]; then
    return 0
  fi

  if [[ -n ${TMUX:-} ]] && command -v tmux >/dev/null 2>&1; then
    session=$(tmux display-message -p '#S' 2>/dev/null) || session=""
    case "$session" in
      aoe_*) return 0 ;;
    esac
  fi

  return 1
}

is_wsl2() {
  local osrelease

  [[ $(uname -s 2>/dev/null) == Linux ]] || return 1
  [[ -r /proc/sys/kernel/osrelease ]] || return 1
  osrelease=$(tr '[:upper:]' '[:lower:]' </proc/sys/kernel/osrelease 2>/dev/null || true)
  [[ $osrelease == *microsoft* && $osrelease == *wsl2* ]]
}

is_devcontainer() {
  [[ ${DEVCONTAINER:-} == 1 || -f /.dockerenv || -f /run/.containerenv ]]
}

is_wsl2_host() {
  is_wsl2 && ! is_devcontainer
}

opencode_owner_is_auto() {
  local process_pid=$PPID
  local process_ppid process_comm process_args comm_name argv_name
  local hops=0
  local -r max_hops=8

  while ((process_pid > 1 && hops < max_hops)); do
    process_ppid=$(ps -o ppid= -p "$process_pid" 2>/dev/null) || return 1
    process_comm=$(ps -o comm= -p "$process_pid" 2>/dev/null) || return 1
    process_args=$(ps -o args= -p "$process_pid" 2>/dev/null) || return 1

    process_ppid=${process_ppid//[[:space:]]/}
    process_comm=${process_comm#"${process_comm%%[![:space:]]*}"}
    process_args=${process_args#"${process_args%%[![:space:]]*}"}
    [[ $process_ppid =~ ^[0-9]+$ ]] || return 1

    comm_name=${process_comm##*/}
    argv_name=${process_args%%[[:space:]]*}
    argv_name=${argv_name##*/}

    if [[ $comm_name == opencode || $comm_name == opencode.exe ||
          $argv_name == opencode || $argv_name == opencode.exe ]]; then
      [[ $process_args =~ (^|[[:space:]])--auto($|[[:space:]]) ]]
      return
    fi

    ((process_ppid != process_pid)) || return 1
    process_pid=$process_ppid
    ((hops += 1))
  done

  return 1
}

parse_args() {
  title=""
  message=""
  event=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title|-title)
        shift
        [[ $# -gt 0 ]] || die 'missing value for --title'
        title=$1
        ;;
      --message|-message)
        shift
        [[ $# -gt 0 ]] || die 'missing value for --message'
        message=$1
        ;;
      --event|-event)
        shift
        [[ $# -gt 0 ]] || die 'missing value for --event'
        event=$1
        ;;
    esac
    shift || true
  done

  if [[ -z $title ]]; then
    title='OpenCode'
    if [[ -n $event ]]; then
      title="OpenCode - $event"
    fi
  fi
}

try_terminal_notifier() {
  [[ $(uname -s 2>/dev/null) == Darwin ]] || return 1
  command -v terminal-notifier >/dev/null 2>&1 || return 1

  terminal-notifier \
    -title "$title" \
    -message "$message" \
    -group opencode \
    -sender com.apple.Terminal \
    >/dev/null 2>&1
}

try_windows_banner() {
  local powershell_bin script_path

  if command -v powershell.exe >/dev/null 2>&1; then
    powershell_bin=powershell.exe
  elif [[ -x /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe ]]; then
    powershell_bin=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
  elif [[ -x /mnt/c/Windows/SysWOW64/WindowsPowerShell/v1.0/powershell.exe ]]; then
    powershell_bin=/mnt/c/Windows/SysWOW64/WindowsPowerShell/v1.0/powershell.exe
  else
    return 1
  fi

  command -v wslpath >/dev/null 2>&1 || return 1
  [[ -f $HOME/.local/windows-notify.ps1 ]] || return 1
  script_path=$(wslpath -w "$HOME/.local/windows-notify.ps1") || return 1

  "$powershell_bin" \
    -NoProfile \
    -NonInteractive \
    -ExecutionPolicy Bypass \
    -File "$script_path" -Title "$title" -Message "$message" \
    >/dev/null
}

main() {
  if is_aoe_session && ! is_wsl2_host; then
    exit 0
  fi

  parse_args "$@"

  if [[ $event == permission ]] && opencode_owner_is_auto; then
    exit 0
  fi

  if try_terminal_notifier; then
    exit 0
  fi

  if is_wsl2_host && try_windows_banner; then
    exit 0
  fi

  printf 'opencode-notifier-bridge: no notification backend succeeded\n' >&2
  exit 0
}

main "$@"
