#!/usr/bin/env bash
set -euo pipefail

# If we're inside a VS Code Remote (WSL) terminal, use the remote-cli "code"
if [[ -n "${VSCODE_IPC_HOOK_CLI:-}" ]]; then
  remote_code="$(ls -td "$HOME"/.vscode-server/bin/*/bin/remote-cli 2>/dev/null | head -n 1)/code"
  if [[ -x "$remote_code" ]]; then
    exec "$remote_code" "$@"
  fi
fi

# Fallback: use Windows VS Code CLI
exec "/mnt/c/Program Files/Microsoft VS Code/bin/code" "$@"
