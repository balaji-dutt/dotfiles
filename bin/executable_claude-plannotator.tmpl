#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="${0##*/}"
DEFAULT_HOST_CLAUDE='{{ .plannotator_ports.host.claude }}'
DEFAULT_DEVCONTAINER_CLAUDE='{{ .plannotator_ports.devcontainer.claude }}'

die() {
  printf '%s: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

is_devcontainer() {
  [ "${DEVCONTAINER:-}" = "1" ] || [ -n "${REMOTE_CONTAINERS:-}" ] || [ -n "${CODESPACES:-}" ]
}

select_range() {
  local default_range

  if is_devcontainer; then
    default_range="$DEFAULT_DEVCONTAINER_CLAUDE"
  else
    default_range="$DEFAULT_HOST_CLAUDE"
  fi

  printf '%s' "${PLANNOTATOR_PORTS_CLAUDE:-$default_range}"
}

PROFILE_NAME="claude"
PORT_RANGE="$(select_range)"
[ -n "$PORT_RANGE" ] || die "empty port range for $PROFILE_NAME"

export PLANNOTATOR_PORT="$PORT_RANGE"
export CLAUDE_PLANNOTATOR_POOL="$PROFILE_NAME"

if [ "${CLAUDE_PLANNOTATOR_VERBOSE:-}" = "1" ] || [ "${CLAUDE_PLANNOTATOR_DRY_RUN:-}" = "1" ]; then
  printf '%s: profile=%s range=%s\n' "$SCRIPT_NAME" "$PROFILE_NAME" "$PORT_RANGE" >&2
fi

if [ "${CLAUDE_PLANNOTATOR_DRY_RUN:-}" = "1" ]; then
  exit 0
fi

CLAUDE_BIN="${CLAUDE_BIN:-}"
if [ -z "$CLAUDE_BIN" ]; then
  CLAUDE_BIN="$(command -v claude || true)"
fi

[ -n "$CLAUDE_BIN" ] || die "claude not found in PATH"
[ -x "$CLAUDE_BIN" ] || die "claude is not executable: $CLAUDE_BIN"

exec "$CLAUDE_BIN" "$@"
