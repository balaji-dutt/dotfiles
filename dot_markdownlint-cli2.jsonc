{
  "ignores": [
    "**/.claude/**",
    "**/chezmoi-diff*/**",

    // temp files written directly into /tmp \
    "**/tmp/claude-prompt-*",
    "**/tmp/claude-*",

    // macOS: /tmp often resolves to /private/tmp
    "**/private/tmp/claude-prompt-*",
    "**/private/tmp/claude-*",

    // OpenCode/macOS temp files
    "**/var/folders/**/T/**",
    "**/private/var/folders/**/T/**"
  ],
  "frontMatter": "(^---\\s*$[^]*?^---\\s*$)(\\r\\n|\\r|\\n|$)"
}
