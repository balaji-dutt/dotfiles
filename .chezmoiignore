{{- /* SECTION 1: Ignore MacOS specific files if NOT on macOS (Linux/Windows) */ -}}
{{ if ne .chezmoi.os "darwin" }}
Library
bin/vnc_monitor.sh
{{ end }}

{{- /* SECTION 1b: Global gitignore is managed by Windows/macOS */ -}}
{{ if eq .chezmoi.os "linux" }}
.gitignore_global
{{ end }}

{{- /* Section 1a: Ignore Doom files if NOT on macOS or Ubuntu WSL2 */ -}}
{{ if and (ne .chezmoi.os "darwin") (not (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") (.chezmoi.kernel.osrelease | lower | contains "microsoft"))) }}
.config/doom
{{ end }}

{{- /* SECTION 2: Ignore Linux specific files if NOT on Linux (macOS/Windows) */ -}}
{{ if ne .chezmoi.os "linux" }}
.config/lazygit
.config/sublime-merge
{{ end }}

{{- /* SECTION 3: Specific Ignore for WSL2 */ -}}
{{- /* Logic: Must be Linux AND Kernel must contain 'microsoft' */ -}}
{{ if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
# Apply container-dotfiles on WSL2, but never apply .devcontainer dirs.
Documents/development/container-dotfiles/**/.devcontainer
Documents/development/container-dotfiles/**/.devcontainer/**
{{ end }}

{{- /* SECTION 3a: Ignore files if not on WSL2 */ -}}
{{- if not (and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft")) }}
bin/code
{{- end }}

{{- /* SECTION 4: Windows minimal whitelist */ -}}
{{ if eq .chezmoi.os "windows" }}
# Ignore everything by default (including dotfiles)...
**/*
**/.*

# ...then allow-list the Windows-managed targets.
!/.claude/
!/.claude/**
!/.gitconfig
!/.gitignore_global
!/.markdownlint-cli2.jsonc

# Allow all chezmoi repo metadata/templates.
!/.chezmoi*

# Keep scripts ignored on Windows (they are primarily bash-oriented).
/.chezmoiscripts/
/.chezmoiscripts/**

# Keep Documents root ignored on Windows (as otherwise chezmoi tries to replace the symlink in %USERPROFILE%)
/Documents/

# Allow-list the specific Documents subtree we want on Windows.
!/Documents/development/container-dotfiles/**/.devcontainer/
!/Documents/development/container-dotfiles/**/.devcontainer/**
{{ end }}

{{- /* SECTION 4: Global Ignores */ -}}
ansible/
ansible/**
assets/
assets/**
archive/
archive/**
configs/
configs/**
# Exclude rendered container configs
private_Documents/development/container-dotfiles/dotfiles/configs/
docs/
docs/**
brewfile.txt
bootstrap-wsl.sh
.local/config/gitignore_global.txt
.ansible.cfg
README.md
TODO.md
AGENTS.md
CLAUDE.md