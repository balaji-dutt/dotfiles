{{/* ----------
   Shared detection helpers (safe on all OSes)
   ---------- */}}
{{ $os := .chezmoi.os }}
{{ $isLinux := eq $os "linux" }}
{{ $isDarwin := eq $os "darwin" }}
{{ $isWindows := eq $os "windows" }}

{{ $osrel := "" }}
{{ $osID := "" }}
{{ $isWSL := false }}
{{ $isWSL2 := false }}
{{ $isDebianWSL2 := false }}
{{ $isUbuntuWSL2 := false }}
{{ $isDevcontainerHost := false }}

{{ if $isLinux }}
  {{ $osrel = (get .chezmoi.kernel "osrelease" | default "" | lower) }}
  {{ $osID  = (get .chezmoi.osRelease "id" | default "") }}
  {{ $isWSL = or (get . "isWSL" | default false) ($osrel | contains "microsoft") }}
  {{ $isWSL2 = or (get . "isWSL2" | default false) (and $isWSL ($osrel | contains "wsl2")) }}
{{ end }}
{{ $isDebianWSL2 = or (get . "isDebianWSL2" | default false) (and $isWSL2 (eq $osID "debian")) }}
{{ $isUbuntuWSL2 = or (get . "isUbuntuWSL2" | default false) (and $isWSL2 (eq $osID "ubuntu")) }}
{{ $isDevcontainerHost = or (get . "isDevcontainerHost" | default false) $isDarwin $isDebianWSL2 }}

{{/* Ignore macOS-specific files if NOT on macOS (Linux/Windows) */}}
{{ if not $isDarwin }}
Library
bin/vnc_monitor.sh
bin/nfs_dot_clean.sh
.agent-of-empires
.agent-of-empires/**
{{/* WSL2 gets its bd pin from ansible, which must write it before
     `mise install -y` runs in the provision before-script. */}}
.config/mise/conf.d/95-beads-dolt.toml
{{ end }}

{{/* OpenCode notifier bridge is used on macOS and WSL2 only. */}}
{{ if not (or $isDarwin $isWSL2) }}
bin/opencode-notifier-bridge
{{ end }}

{{/*  Placeholder for Linux */}}
{{ if $isLinux }}
{{ end }}

{{/* Ignore Linux specific files if NOT on Linux (macOS/Windows) */}}
{{ if not $isLinux }}
.config/lazygit
.config/sublime-merge
{{ end }}

{{/* ----------
  bin/code should exist ONLY on WSL2
  Global gitignore is managed by Windows/macOS (ignore on WSL2)
   ---------- */}}
{{ if not $isWSL2 }}
bin/code
.gitignore_global
{{ end }}

{{/* Devcontainer helpers should exist ONLY on macOS or Debian WSL2 */}}
{{ if not $isDevcontainerHost }}
bin/devcontainer-launch
bin/sync-devcontainer-all.sh
Documents/development/vscode-workspace/container-homelab-IaC.code-workspace
{{ end }}

{{/* container-dotfiles should NOT exist on WSL2 excluding Debian */}}
{{ if and $isWSL2 (not $isDebianWSL2) }}
Documents/development/container-dotfiles/
Documents/development/container-dotfiles/**
{{ end }}

{{/* PowerShell should only exist on Windows */}}
{{ if not $isWindows }}
AppData
AppData/**
Documents/PowerShell
.config/powershell
.local/ai-wt.py
.local/ai-wt.cmd
.local/oc-commit.ps1
.local/oc-commit.cmd
.local/cc-commit.ps1
.local/cc-commit.cmd
{{ end }}

