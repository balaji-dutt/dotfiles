{{- /* SECTION 1: Ignore MacOS specific files if NOT on macOS (Linux/Windows) */ -}}
{{ if ne .chezmoi.os "darwin" }}
Library
bin/vnc_monitor.sh
{{ end }}

{{- /* SECTION 1b: Global gitignore is managed by Windows/macOS */ -}}
{{ if eq .chezmoi.os "linux" }}
.gitignore_global
{{ end }}

{{- /* Section 1a: Ignore Doom files if NOT on macOS or Ubuntu WSL2 */ -}}
{{ if and (ne .chezmoi.os "darwin") (not (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") (.chezmoi.kernel.osrelease | lower | contains "microsoft"))) }}
.config/doom
{{ end }}

{{- /* SECTION 2: Ignore Linux specific files if NOT on Linux (macOS/Windows) */ -}}
{{ if ne .chezmoi.os "linux" }}
.config/lazygit
.config/sublime-merge
{{ end }}

{{- /* SECTION 3: Ignore files if not on WSL2 */ -}}
{{- if not (and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft")) }}
bin/code
{{ end -}}

{{- /* SECTION 4: Windows minimal whitelist */ -}}
{{ if eq .chezmoi.os "windows" }}
# Ignore everything by default
**/*
**/.*

# Allow chezmoi metadata
!/.chezmoi*

# Allow dotfiles that are shared across environments
!/.claude/
!/.claude/**
!/.gitconfig
!/.gitignore_global
!/.markdownlint-cli2.jsonc

# Allow other Windows configuration files
# Example: !/AppData/Roaming/espanso/match/base.yml

# Keep chezmoi scripts ignored by default on Windows since most of the scripts rely on Bash
/.chezmoiscripts/
/.chezmoiscripts/**

# Only allow Windows specific scripts
!.chezmoiscripts/windows-sync.ps1
{{ end }}

{{- /* SECTION 4: Global Ignores */ -}}
ansible/
ansible/**
assets/
assets/**
archive/
archive/**
configs/
configs/**
# Exclude rendered container configs
private_Documents/development/container-dotfiles/dotfiles/configs/
docs/
docs/**
brewfile.txt
bootstrap-wsl.sh
.local/config/gitignore_global.txt
.ansible.cfg
README.md
