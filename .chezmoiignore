{{/* ----------
   Shared detection helpers (safe on all OSes)
   ---------- */}}
{{ $os := .chezmoi.os }}
{{ $isLinux := eq $os "linux" }}
{{ $isDarwin := eq $os "darwin" }}
{{ $isWindows := eq $os "windows" }}

{{ $osrel := "" }}
{{ $osID := "" }}
{{ $isWSL2 := false }}

{{ if $isLinux }}
  {{ $osrel = (get .chezmoi.kernel "osrelease" | default "" | lower) }}
  {{ $osID  = (get .chezmoi.osRelease "id" | default "") }}
  {{ $isWSL2 = and ($osrel | contains "microsoft") ($osrel | contains "wsl2") }}
{{ end }}

{{/* Ignore macOS-specific files if NOT on macOS (Linux/Windows) */}}
{{ if not $isDarwin }}
Library
bin/vnc_monitor.sh
.agent-of-empires
.agent-of-empires/**
{{ end }}

{{/* Keep Linux/XDG AoE config off macOS */}}
{{ if $isDarwin }}
.config/agent-of-empires
.config/agent-of-empires/**
{{ end }}

{{/*  Placeholder for Linux */}}
{{ if $isLinux }}
{{ end }}

{{/* Section 1a: Ignore Doom files if NOT on macOS or Ubuntu WSL2 */}}
{{ if and (not $isDarwin) (not (and $isWSL2 (eq $osID "ubuntu"))) }}
.config/doom
{{ end }}

{{/* Ignore Linux specific files if NOT on Linux (macOS/Windows) */}}
{{ if not $isLinux }}
.config/lazygit
.config/sublime-merge
{{ end }}

{{/* ----------
  bin/code should exist ONLY on WSL2
  Global gitignore is managed by Windows/macOS (ignore on WSL2)
   ---------- */}}
{{ if not $isWSL2 }}
bin/code
.gitignore_global
{{ end }}

{{/* container-dotfiles should NOT exist on WSL2 excluding Debian */}}
{{ if and $isWSL2 (ne $osID "debian") }}
Documents/development/container-dotfiles/
Documents/development/container-dotfiles/**
{{ end }}

{{/* PowerShell should only exist on Windows */}}
{{ if not $isWindows }}
AppData
AppData/**
Documents/PowerShell
.config/powershell
{{ end }}

{{/* Windows minimal whitelist */}}
{{ if $isWindows }}
# Ignore everything by default
**/*
**/.*

# Allow chezmoi metadata
!/.chezmoi*

# Allow dotfiles that are shared across environments
!/.claude/
!/.claude/**
!/.gitconfig
!/.gitignore_global
!/.markdownlint-cli2.jsonc

# Keep scripts ignored by default on Windows, but allow specific PS scripts.
# (Must unignore parent dir too)
# Note: use target names (run_* prefix stripped) for run_once scripts.
/.chezmoiscripts/**
!/.chezmoiscripts/
!/.chezmoiscripts/windows-sync.ps1
!/.chezmoiscripts/99-cleanup-wrong-apply.ps1
!/.chezmoiscripts/windows-bootstrap.ps1
!/.chezmoiscripts/copy_sublime_merge_packages.ps1
!/.chezmoiscripts/10-dotfiles-commit-template.ps1
!/.chezmoiscripts/windows-zz-register-startup-tasks.ps1

# Windows specific paths
!/.config/
/.config/*
!/.config/powershell/
!/.config/powershell/**
!/.config/opencode/
!/.config/opencode/**
# Keep non-Windows Linux/macOS config trees ignored.
.config/doom
.config/doom/**
.config/direnv
.config/direnv/**
.config/lazygit
.config/lazygit/**
.config/mise
.config/mise/**
.config/sublime-merge
.config/sublime-merge/**
# !/Documents/
# !/Documents/PowerShell/
# !/Documents/PowerShell/**
!/AppData/
!/AppData/Roaming/
!/AppData/Roaming/Sublime Merge/
!/AppData/Roaming/Sublime Merge/**
!/AppData/Roaming/espanso/
!/AppData/Roaming/espanso/**
!/AppData/Roaming/yt-dlp/
!/AppData/Roaming/yt-dlp/**
{{ end }}

{{/* Global Ignores (repo metadata / stuff that should not be applied anywhere) */}}
ansible/
ansible/**
/assets/
/assets/**
archive/
archive/**
configs/
configs/**
docs/
docs/**
.claude-code-router/
.claude-code-router/**
bin/ccr_launcher.sh
Library/LaunchAgents/com.user.ccr.plist
# Exclude rendered container configs
Documents/development/container-dotfiles/dotfiles/configs/
Documents/development/container-dotfiles/dotfiles/configs/**
brewfile.txt
bootstrap-wsl.sh
.local/config/gitignore_global.txt
.ansible.cfg
README.md
TODO.md
AGENTS.md
CLAUDE.md
