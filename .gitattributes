# Preserve line endings for chezmoi files
.chezmoi.toml.tmpl text eol=lf
.chezmoiignore text eol=lf

# Preserve line endings for Claude Code files to avoid interpreter/diff issues on Windows
.claude/hooks/*.sh text eol=lf
.claude/settings.json text eol=lf
.claude/agents/*.md text eol=lf

# Provenance-checked AI assets must retain generator and mirror bytes on Windows.
dot_claude/agents/*.md text eol=lf
dot_claude/skills/** text=auto eol=lf
private_dot_config/opencode/agents/*.md text eol=lf
private_dot_config/opencode/skills/** text=auto eol=lf
private_Documents/development/container-dotfiles/dotfiles/dot_claude/agents/** text=auto eol=lf
private_Documents/development/container-dotfiles/dotfiles/dot_claude/skills/** text=auto eol=lf
private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/agents/** text=auto eol=lf
private_Documents/development/container-dotfiles/dotfiles/private_dot_config/opencode/skills/** text=auto eol=lf

# Shell scripts must remain LF to be valid on Linux/WSL
*.sh text eol=lf
private_dot_config/git/template/hooks/executable_pre-commit text eol=lf
private_dot_config/git/template/hooks/executable_prepare-commit-msg text eol=lf
private_Documents/development/container-dotfiles/dotfiles/private_dot_config/git/template/hooks/executable_pre-commit text eol=lf
private_Documents/development/container-dotfiles/dotfiles/private_dot_config/git/template/hooks/executable_prepare-commit-msg text eol=lf

# But PowerShell scripts must remain CRLF to be valid on Windows.
*.ps1.tmpl text eol=crlf

# Browser policy artifacts are hash-checked; keep vendored bytes stable.
configs/browser-policies/** -text

# Shared Sublime Merge syntax payload is copied byte-for-byte on macOS/WSL.
configs/sublime-merge/*.sublime-syntax text eol=lf
